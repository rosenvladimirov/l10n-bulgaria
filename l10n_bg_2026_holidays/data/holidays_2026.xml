<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- БГ официални празници 2026 г. (по чл. 154 КТ)                -->
        <!--                                                              -->
        <!-- resource_id=False + calendar_id=False → глобален прaздник    -->
        <!-- (важи за всички работни календари във всички компании).      -->
        <!--                                                              -->
        <!-- date_from = 00:00:00 на деня (БГ time), date_to = 23:59:59       -->
        <!--                                                                  -->
        <!-- 🚨 DEF-140 — офсетът НЕ е константен. България е EET (+2) зимно  -->
        <!-- и EEST (+3) лятно време, а полетата се пазят в UTC:              -->
        <!--   зимно: 22:00:00 ден преди · 21:59:59 същия ден                 -->
        <!--   лятно: 21:00:00 ден преди · 20:59:59 същия ден                 -->
        <!-- Досега всичките 14 записа бяха с +2. Деветте в лятното време     -->
        <!-- (10-13.04, 01.05, 06.05, 24.05, 06.09, 22.09) свършваха в        -->
        <!-- 00:59:59 местно на СЛЕДВАЩИЯ ден ⇒ всеки от тях се четеше като   -->
        <!-- ДВА почивни дни. Измерено от Пламена 14.08.2026: числителят на   -->
        <!-- пода 18 вместо 17 (8,65 EUR надвнесени) и ден мигрира от „НОИ    -->
        <!-- работен" в „НОИ неработен" в болничния сплит.                    -->
        <!-- Границите тук са пресметнати през Europe/Sofia, не наум.         -->
        <!--                                                              -->
        <!-- Православният Великден 2026 г. — 12 април                     -->
        <!-- ============================================================ -->

        <!-- Fixed holidays -->

        <record id="bg_holiday_2026_new_year" model="resource.calendar.leaves">
            <field name="name">Нова година</field>
            <field name="date_from">2025-12-31 22:00:00</field>
            <field name="date_to">2026-01-01 21:59:59</field>
            <field name="resource_id" eval="False"/>
            <field name="calendar_id" eval="False"/>
            <field name="time_type">leave</field>
        </record>

        <record id="bg_holiday_2026_liberation_day" model="resource.calendar.leaves">
