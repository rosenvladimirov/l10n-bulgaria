<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_model_list" model="ir.ui.view">
        <field name="name">ai.model.list</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="tier"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_model_form" model="ir.ui.view">
        <field name="name">ai.model.form</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Claude Sonnet 4.6"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="claude-sonnet-4-6"/>
                            <field name="tier"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Optional note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_model" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ai.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menuitem-ът е в views/menu.xml — parent-ът menu_ai_pipeline_root
         се дефинира там и при ЧИСТ install този файл се зарежда преди него -->
</odoo>
