<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_nra_api" model="ir.module.category">
        <field name="name">NRA API</field>
        <field name="description">Access rights for NRA API declarations</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_nra_api" model="res.groups.privilege">
        <field name="name">NRA Declarations</field>
        <field name="category_id" ref="module_category_nra_api" />
        <field name="sequence">50</field>
    </record>

    <!-- User group: can view and create declarations -->
    <record id="group_nra_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_nra_api" />
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- Manager group: can configure API, submit declarations -->
    <record id="group_nra_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_nra_api" />
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_nra_user'))]" />
    </record>

    <!-- Record rules -->
    <record id="nra_declaration_company_rule" model="ir.rule">
        <field name="name">NRA Declaration: multi-company</field>
        <field name="model_id" ref="model_nra_declaration" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_nra_user'))]" />
    </record>
</odoo>
