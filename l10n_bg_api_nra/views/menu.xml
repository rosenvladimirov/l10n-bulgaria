<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Standalone application root — appears in Apps launcher with NAP icon.
         Previously parent="account.menu_finance"; switched to application
         in 19.0.1.1.0 so the declarations have first-class app placement
         rather than being buried under Accounting > Reporting. -->
    <menuitem id="menu_nra_root"
              name="NRA Declarations"
              sequence="40"
              web_icon="l10n_bg_api_nra,static/description/icon.png"
              groups="l10n_bg_api_nra.group_nra_user" />

    <!-- Shared sub-categories — plug-in modules add their items here.
         Empty categories are auto-hidden by Odoo when no children exist. -->
    <menuitem id="menu_nra_insurance"
              name="Insurance"
              parent="menu_nra_root"
              sequence="10" />

    <menuitem id="menu_nra_labor"
              name="Labor Records"
              parent="menu_nra_root"
              sequence="20" />

    <menuitem id="menu_nra_tax"
              name="Tax"
              parent="menu_nra_root"
              sequence="30" />

    <!-- All declarations -->
    <menuitem id="menu_nra_all"
              name="All Declarations"
              parent="menu_nra_root"
              action="action_nra_declaration"
              sequence="90" />

    <!-- Credentials wizard -->
    <menuitem id="menu_nra_credentials"
              name="NRA Registrations"
              parent="menu_nra_root"
              action="action_nra_credentials_wizard"
              sequence="95"
              groups="l10n_bg_api_nra.group_nra_manager" />

</odoo>
