<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Standalone application root — appears in Apps launcher with NAP icon.
         Previously parent="account.menu_finance"; switched to application
         in 18.0.1.4.0 so the declarations have first-class app placement
         rather than being buried under Accounting > Reporting. -->
    <menuitem id="menu_nra_root"
              name="NRA Declarations"
              sequence="40"
              web_icon="l10n_bg_api_nra,static/description/icon.png"
              groups="l10n_bg_api_nra.group_nra_user" />

    <!-- Insurance declarations submenu -->
    <menuitem id="menu_nra_insurance"
              name="Insurance"
              parent="menu_nra_root"
              sequence="10" />

    <menuitem id="menu_nra_declaration_d1"
              name="Declaration Form 1 (D1)"
              parent="menu_nra_insurance"
              action="action_nra_declaration_d1"
              sequence="10" />

    <menuitem id="menu_nra_declaration_d6"
              name="Declaration Form 6 (D6)"
              parent="menu_nra_insurance"
              action="action_nra_declaration_d6"
              sequence="20" />

    <!-- Tax declarations submenu -->
    <menuitem id="menu_nra_tax"
              name="Tax"
              parent="menu_nra_root"
              sequence="30" />

    <menuitem id="menu_nra_declaration_vat"
              name="VAT Declaration"
              parent="menu_nra_tax"
              action="action_nra_declaration_vat"
              sequence="10" />

    <menuitem id="menu_nra_declaration_vies"
              name="VIES Declaration"
              parent="menu_nra_tax"
              action="action_nra_declaration_vies"
              sequence="20" />

    <!-- All declarations -->
    <menuitem id="menu_nra_all"
              name="All Declarations"
              parent="menu_nra_root"
              action="action_nra_declaration"
              sequence="90" />

</odoo>
