<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        H-18 audit-file UI — inherits the base nra.declaration form.
        New page "H-18 Audit (e-shop)" is visible only when
        declaration_type == 'h18_eshop'.
    -->
    <record id="nra_declaration_form_h18" model="ir.ui.view">
        <field name="name">nra.declaration.form.h18</field>
        <field name="model">nra.declaration</field>
        <field name="inherit_id" ref="nra_declaration_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_collect_h18_orders" type="object"
                        string="Collect online orders"
                        invisible="declaration_type != 'h18_eshop' or state != 'draft'"
                        class="btn-secondary"/>
                <button name="action_h18_generate_xml" type="object"
                        string="Generate audit XML"
                        invisible="declaration_type != 'h18_eshop' or state not in ('draft','generated')"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="H-18 Audit (e-shop)" name="h18_eshop"
                      invisible="declaration_type != 'h18_eshop'">
                    <group>
                        <group string="E-shop registration">
                            <field name="eshop_uid"/>
                            <field name="eshop_type"/>
                            <field name="eshop_domain"/>
                        </group>
                        <group string="Totals (preview)">
                            <field name="h18_order_count"/>
                            <field name="h18_total_orders"/>
                            <field name="h18_refund_count"/>
                            <field name="h18_total_refunds"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders" name="h18_orders">
                            <field name="h18_order_line_ids">
                                <list editable="bottom">
                                    <field name="ord_n"/>
                                    <field name="ord_d"/>
                                    <field name="doc_n"/>
                                    <field name="doc_date"/>
                                    <field name="ord_total1" sum="Total1"/>
                                    <field name="ord_disc" sum="Discount"/>
                                    <field name="ord_vat" sum="VAT"/>
                                    <field name="ord_total2" sum="Total"/>
                                    <field name="paym"/>
                                    <field name="art_count"/>
                                    <field name="trans_n" optional="hide"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="ord_n"/>
                                                <field name="ord_d"/>
                                                <field name="doc_n"/>
                                                <field name="doc_date"/>
                                                <field name="paym"/>
                                            </group>
                                            <group>
                                                <field name="ord_total1"/>
                                                <field name="ord_disc"/>
                                                <field name="ord_vat"/>
                                                <field name="ord_total2"/>
                                                <field name="pos_n"/>
                                                <field name="trans_n"/>
                                                <field name="proc_id"/>
                                            </group>
                                        </group>
                                        <field name="art_line_ids">
                                            <list editable="bottom">
                                                <field name="art_name"/>
                                                <field name="art_quant"/>
                                                <field name="art_price"/>
                                                <field name="art_vat_rate"/>
                                                <field name="art_vat" sum="VAT"/>
                                                <field name="art_sum" sum="Total"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Refunds" name="h18_refunds">
                            <field name="h18_refund_line_ids">
                                <list editable="bottom">
                                    <field name="r_ord_n"/>
                                    <field name="r_amount" sum="Refunded"/>
                                    <field name="r_date"/>
                                    <field name="r_paym"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Filtered action — конкретно за H-18 декларациите (отделна
        входна точка от меню; общата action_nra_declaration все още
        работи за всички типове).
    -->
    <record id="action_nra_declaration_h18" model="ir.actions.act_window">
        <field name="name">H-18 Audit (e-shop)</field>
        <field name="res_model">nra.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('declaration_type', '=', 'h18_eshop')]</field>
        <field name="context">{'default_declaration_type': 'h18_eshop'}</field>
    </record>


</odoo>
