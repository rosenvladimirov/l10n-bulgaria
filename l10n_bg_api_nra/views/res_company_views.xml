<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_nra_api" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_bg_api_nra</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group name="l10n_bg_nra_api" string="NRA API Configuration (НАП API)"
                       groups="l10n_bg_api_nra.group_nra_manager">
                    <group>
                        <field name="l10n_bg_nra_api_enabled" />
                        <field name="l10n_bg_nra_test_mode"
                               invisible="not l10n_bg_nra_api_enabled" />
                        <field name="l10n_bg_nra_token_user_id" readonly="1"
                               invisible="not l10n_bg_nra_api_enabled" />
                        <field name="l10n_bg_nra_token_expiry" readonly="1"
                               invisible="not l10n_bg_nra_api_enabled" />
                    </group>
                    <group colspan="2" invisible="not l10n_bg_nra_api_enabled">
                        <button name="%(l10n_bg_api_nra.action_nra_credentials_wizard)d"
                                string="Set API Credentials"
                                type="action"
                                class="btn-primary"
                                icon="fa-key" />
                        <button name="action_nra_test_connection"
                                string="Test Connection"
                                type="object"
                                class="btn-secondary"
                                icon="fa-plug" />
                        <button name="action_nra_clear_token"
                                string="Clear Token"
                                type="object"
                                class="btn-secondary"
                                icon="fa-eraser" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
