<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_nra_api" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_bg_api_nra</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group name="l10n_bg_nra_api"
                       groups="l10n_bg_api_nra.group_nra_manager">
                    <div colspan="2"
                         class="col-lg-6 w-100 mt-4 mb-3 o_horizontal_separator text-uppercase fw-bolder small d-flex">
                        <span>NRA API Configuration (НАП API)</span>
                        <button name="%(l10n_bg_api_nra.action_nra_credentials_wizard)d"
                                type="action"
                                string="Set API Credentials"
                                class="btn btn-link ms-auto text-end lh-1 h-100 p-0"
                                invisible="not l10n_bg_nra_api_enabled" />
                    </div>
                    <field name="l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_auth_mode"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_test_mode"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_taxpayer_pin_type"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_user_pin_type"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_insurance_fund"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_token_user_id" readonly="1"
                           invisible="not l10n_bg_nra_api_enabled" />
                    <field name="l10n_bg_nra_token_expiry" readonly="1"
                           invisible="not l10n_bg_nra_api_enabled" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
