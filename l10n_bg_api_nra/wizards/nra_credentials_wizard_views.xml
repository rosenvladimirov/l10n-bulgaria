<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nra_credentials_wizard_view_form" model="ir.ui.view">
        <field name="name">nra.credentials.wizard.form</field>
        <field name="model">nra.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="NRA API Credentials">
                <sheet>
                    <group>
                        <p colspan="2" class="text-muted">
                            Credentials are stored encrypted in your personal
                            crypto wallet (PBKDF2 + Fernet). A fallback copy of
                            the token is also kept in system parameters
                            (ir.config_parameter) for cron jobs and other users.
                        </p>
                    </group>
                    <group string="API Authentication">
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="auth_mode" widget="radio" />
                        <field name="api_key" password="True" />
                        <field name="api_secret" password="True"
                               invisible="auth_mode != 'oauth'"
                               required="auth_mode == 'oauth'" />
                        <field name="access_token"
                               invisible="auth_mode != 'direct_token'"
                               required="auth_mode == 'direct_token'"
                               placeholder="eyJhbGciOiJSUzI1NiIs..." />
                    </group>
                    <group string="QES Certificate (for declaration submission)">
                        <p colspan="2" class="text-muted">
                            Upload your .p12/.pfx file and enter the PIN.
                            The PIN and certificate will be extracted
                            automatically. Required for D1/D6/ETZ submissions.
                        </p>
                        <field name="certificate_file"
                               filename="certificate_filename" />
                        <field name="certificate_filename" invisible="1" />
                        <field name="certificate_password" password="True"
                               placeholder="QES PIN" />
                    </group>
                    <group string="Extracted Credentials"
                           invisible="not user_pin and not user_signature">
                        <field name="user_pin" />
                        <field name="user_signature" widget="text"
                               placeholder="Auto-filled from certificate upload" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_credentials"
                            string="Save Credentials"
                            type="object"
                            class="btn-primary"
                            icon="fa-lock" />
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-secondary"
                            icon="fa-plug" />
                    <button name="action_clear_token"
                            string="Clear Token"
                            type="object"
                            class="btn-secondary"
                            icon="fa-eraser" />
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nra_credentials_wizard" model="ir.actions.act_window">
        <field name="name">Set NRA API Credentials</field>
        <field name="res_model">nra.credentials.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
