<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nra_credentials_wizard_view_form" model="ir.ui.view">
        <field name="name">nra.credentials.wizard.form</field>
        <field name="model">nra.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="NRA API Credentials">
                <sheet>
                    <group>
                        <p colspan="2" class="text-muted">
                            Enter your NRA API credentials. They will be stored
                            securely in your encrypted crypto wallet, not in the database.
                        </p>
                    </group>
                    <group string="API Authentication">
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="api_key" password="True" />
                        <field name="api_secret" password="True" />
                    </group>
                    <group string="User Identification (for declaration submission)">
                        <p colspan="2" class="text-muted">
                            Required for submitting declarations. The User PIN must match
                            the КЕП certificate holder and must be authorized to submit
                            declarations for the taxpayer (company).
                        </p>
                        <field name="user_pin" password="True" />
                        <field name="user_signature" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_credentials"
                            string="Save Credentials"
                            type="object"
                            class="btn-primary"
                            icon="fa-lock" />
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nra_credentials_wizard" model="ir.actions.act_window">
        <field name="name">Set NRA API Credentials</field>
        <field name="res_model">nra.credentials.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
