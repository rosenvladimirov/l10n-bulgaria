<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 2026-05-21 refactor: ACL не зависи от тези групи (всички internal
             users имат CRUD според ir.model.access.csv; видимостта се
             контролира от ir.rule по user_id). Групите остават като UI
             маркери на чувствителни бутони (Generate Keys / Export Private
             Key) и за категоризация в Settings → Users → Permissions. -->

        <!-- Privilege for Crypto Wallet groups -->
        <record id="privilege_crypto_wallet" model="res.groups.privilege">
            <field name="name">Crypto Wallet</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="sequence">100</field>
        </record>

        <!-- UI marker groups (NOT used for ACL — само за полета/бутони) -->
        <record id="group_crypto_wallet_read" model="res.groups">
            <field name="name">Read Access</field>
            <field name="privilege_id" ref="privilege_crypto_wallet"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_crypto_wallet_write" model="res.groups">
            <field name="name">Write Access</field>
            <field name="privilege_id" ref="privilege_crypto_wallet"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_read'))]"/>
        </record>

        <record id="group_crypto_wallet_generate" model="res.groups">
            <field name="name">Generate Keys</field>
            <field name="privilege_id" ref="privilege_crypto_wallet"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_write'))]"/>
        </record>

        <record id="group_crypto_wallet_export" model="res.groups">
            <field name="name">Export Access</field>
            <field name="privilege_id" ref="privilege_crypto_wallet"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_read'))]"/>
        </record>

        <record id="group_crypto_wallet_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_crypto_wallet"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_generate')), (4, ref('group_crypto_wallet_export')), (4, ref('base.group_system'))]"/>
        </record>

        <!-- Record Rules — owner-based visibility (groups → НЕ влизат тук) -->

        <!-- Internal user вижда + променя САМО собствените си wallet-и. -->
        <record id="crypto_wallet_owner_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Own Records</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-company isolation (само при активиран multi_company group). -->
        <record id="crypto_wallet_company_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Company Isolation</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[
                '|',
                ('user_id.company_ids', 'in', user.company_ids.ids),
                ('user_id.company_id', '=', user.company_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_multi_company'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
