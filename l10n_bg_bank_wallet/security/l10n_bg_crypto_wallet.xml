<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Groups -->
        <record id="group_crypto_wallet_read" model="res.groups">
            <field name="name">Crypto Wallet: Read Access</field>
            <field name="category_id" ref="base.module_category_administration"/>
        </record>

        <record id="group_crypto_wallet_write" model="res.groups">
            <field name="name">Crypto Wallet: Write Access</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_read'))]"/>
        </record>

        <record id="group_crypto_wallet_generate" model="res.groups">
            <field name="name">Crypto Wallet: Generate Keys</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_write'))]"/>
        </record>

        <record id="group_crypto_wallet_export" model="res.groups">
            <field name="name">Crypto Wallet: Export Access</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_read'))]"/>
        </record>

        <record id="group_crypto_wallet_admin" model="res.groups">
            <field name="name">Crypto Wallet: Administrator</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_crypto_wallet_generate')), (4, ref('group_crypto_wallet_export'))]"/>
        </record>

        <!-- Record Rules for crypto.wallet -->

        <!-- Rule 1: Users can only see their own wallets -->
        <record id="crypto_wallet_user_own_rule" model="ir.rule">
            <field name="name">Crypto Wallet: User Own Records</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crypto_wallet_read'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 2: Users can write to their own wallets -->
        <record id="crypto_wallet_user_write_rule" model="ir.rule">
            <field name="name">Crypto Wallet: User Write Own Records</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crypto_wallet_write'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 3: Administrators can access all wallets -->
        <record id="crypto_wallet_admin_all_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Admin All Access</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_crypto_wallet_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule 4: Restrict sensitive operations (only for admin) -->
        <record id="crypto_wallet_sensitive_operations_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Sensitive Operations</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crypto_wallet_export')), (4, ref('group_crypto_wallet_generate'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Rule 9: Company-based isolation (if multi-company) -->
        <record id="crypto_wallet_company_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Company Isolation</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[
                '|',
                ('user_id.company_ids', 'in', user.company_ids.ids),
                ('user_id.company_id', '=', user.company_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_multi_company'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Rule 10: Audit trail access (read-only for auditors) -->
        <record id="crypto_wallet_audit_rule" model="ir.rule">
            <field name="name">Crypto Wallet: Audit Access</field>
            <field name="model_id" ref="model_crypto_wallet"/>
            <field name="domain_force">[('created_date', '>=', (DateTime.today() - relativedelta(days=90)).strftime('%Y-%m-%d %H:%M:%S'))]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
