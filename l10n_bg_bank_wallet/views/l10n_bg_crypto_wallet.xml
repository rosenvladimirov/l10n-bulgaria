<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="crypto_wallet_tree_view" model="ir.ui.view">
        <field name="name">crypto.wallet.list</field>
        <field name="model">crypto.wallet</field>
        <field name="arch" type="xml">
            <list string="Crypto Wallets" create="1" edit="1" delete="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="is_locked" widget="boolean_toggle"/>
                <field name="created_date"/>
                <field name="last_accessed"/>
                <button name="action_unlock_wallet"
                        type="object"
                        string="Unlock"
                        icon="fa-unlock"
                        invisible="not is_locked"/>
                <button name="lock_wallet"
                        type="object"
                        string="Lock"
                        icon="fa-lock"
                        invisible="is_locked"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="crypto_wallet_form_view" model="ir.ui.view">
        <field name="name">crypto.wallet.form</field>
        <field name="model">crypto.wallet</field>
        <field name="arch" type="xml">
            <form string="Crypto Wallet">
                <header>
                    <button name="action_unlock_wallet"
                            type="object"
                            string="Unlock Wallet"
                            class="btn-primary"
                            invisible="not is_locked"/>
                    <button name="lock_wallet"
                            type="object"
                            string="Lock Wallet"
                            class="btn-secondary"
                            invisible="is_locked"/>
                    <button name="action_change_master_password"
                            type="object"
                            string="Change Master Password"
                            class="btn-warning"/>
                    <button name="action_export_wallet"
                            type="object"
                            string="Export Wallet"
                            class="btn-info"/>
                    <field name="is_locked" widget="boolean_toggle" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_manage_keys"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-key">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Keys</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Wallet Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="created_date" readonly="1"/>
                            <field name="last_accessed" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_locked" readonly="1"/>
                            <field name="salt" readonly="1" password="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Wallet Content" invisible="is_locked">
                            <group>
                                <field name="decrypted_keys" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                            </group>
                        </page>
                        <page string="Key Management" invisible="is_locked">
                            <group>
                                <button name="action_add_key"
                                        type="object"
                                        string="Add Key"
                                        class="btn-primary"/>
                                <button name="action_list_keys"
                                        type="object"
                                        string="Show All Keys"
                                        class="btn-info"/>
                            </group>
                        </page>
                        <page string="Encrypted Data">
                            <group>
                                <field name="encrypted_data" widget="text" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="crypto_wallet_search_view" model="ir.ui.view">
        <field name="name">crypto.wallet.search</field>
        <field name="model">crypto.wallet</field>
        <field name="arch" type="xml">
            <search string="Search in Wallets">
                <field name="name" string="Wallet Name"/>
                <field name="user_id" string="User"/>
                <filter string="My Wallets"
                        name="my_wallets"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Locked"
                        name="locked"
                        domain="[('is_locked', '=', True)]"/>
                <filter string="Unlocked"
                        name="unlocked"
                        domain="[('is_locked', '=', False)]"/>
                <separator/>
                <filter string="Created This Month"
                        name="this_month"
                        domain="[('created_date', '&gt;=', datetime.datetime.now().replace(day=1))]"/>
                <group expand="0" string="Group By">
                    <filter string="By User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="By Status" name="group_by_status" context="{'group_by': 'is_locked'}"/>
                    <filter string="By Creation Month" name="group_by_month" context="{'group_by': 'created_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="crypto_wallet_action" model="ir.actions.act_window">
        <field name="name">Crypto Wallets</field>
        <field name="res_model">crypto.wallet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_wallets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first crypto wallet!
            </p>
            <p>
                Crypto wallets allow you to securely store
                passwords, API keys and other sensitive data.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="crypto_wallet_menu_root"
              name="Crypto Wallets"
              web_icon="l10n_bg_bank_wallet,static/description/icon.png"
              sequence="100"/>

    <menuitem id="crypto_wallet_menu"
              name="Wallets"
              parent="crypto_wallet_menu_root"
              action="crypto_wallet_action"
              sequence="10"/>

</odoo>
