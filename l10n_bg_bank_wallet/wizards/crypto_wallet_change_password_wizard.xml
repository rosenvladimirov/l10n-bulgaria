<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Change Password Wizard Form View -->
    <record id="view_crypto_wallet_change_password_wizard_form" model="ir.ui.view">
        <field name="name">crypto.wallet.change.password.wizard.form</field>
        <field name="model">crypto.wallet.change.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Master Password">
                <div class="alert alert-warning" role="alert">
                    <strong>Внимание!</strong><br/>
                    Промяната на главната парола ще прекриптира всички данни в портфела.
                    Моля, запазете новата парола на сигурно място.
                </div>
                <sheet>
                    <group string="Current Password">
                        <field name="use_current_user_password"/>
                        <field name="old_password" password="True"
                               invisible="use_current_user_password"
                               placeholder="Enter current master password..."/>
                    </group>

                    <group string="New Password">
                        <field name="new_password" password="True"
                               placeholder="Enter new password..."/>
                        <field name="confirm_password" password="True"
                               placeholder="Confirm new password..."/>
                    </group>

                    <group string="Additional Options">
                        <field name="update_user_password"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Change Password" name="change_password" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Change and Unlock" name="change_password_and_unlock"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
