<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Generate Keypair Wizard Form View -->
    <record id="view_crypto_wallet_generate_keypair_wizard_form" model="ir.ui.view">
        <field name="name">crypto.wallet.generate.keypair.wizard.form</field>
        <field name="model">crypto.wallet.generate.keypair.wizard</field>
        <field name="arch" type="xml">
            <form string="Генериране на двойка ключове">
                <!-- Информация -->
                <div class="alert alert-info" role="alert" invisible="context.get('show_generation_result')">
                    <strong>Генериране на криптографски ключове</strong><br/>
                    Генерирайте двойка ключове (частен и публичен) за криптографски операции.
                    Ключовете ще бъдат автоматично съхранени в портфела.
                </div>

                <!-- Резултат -->
                <div class="alert alert-success" role="alert" invisible="not context.get('show_generation_result')">
                    <strong>Ключовете са генерирани успешно!</strong><br/>
                    Двойката ключове е създадена и запазена в портфела.
                </div>

                <sheet>
                    <!-- Настройки за генериране -->
                    <group string="Настройки на ключовете" invisible="context.get('show_generation_result')">
                        <group>
                            <field name="wallet_id" readonly="1"/>
                            <field name="key_name" placeholder="напр. my_ssl_cert"/>
                            <field name="key_type"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Описание на предназначението..."/>
                        </group>
                    </group>

                    <!-- Резултат от генерирането -->
                    <group string="Резултат" invisible="not context.get('show_generation_result')">
                        <field name="generation_result" widget="text" readonly="1"
                               options="{'max_height': 200}" nolabel="1"/>
                    </group>

                    <group string="Генерирани ключове" invisible="not context.get('show_generation_result')">
                        <group>
                            <field name="private_key_name" readonly="1"/>
                            <field name="public_key_name" readonly="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <!-- Бутони за генериране -->
                    <div invisible="context.get('show_generation_result')">
                        <button string="Генерирай ключове" name="generate_keypair" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Генерирай и добави още" name="generate_and_add_another"
                                type="object" class="btn-secondary"/>
                        <button string="Отказ" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </div>

                    <!-- Бутони за резултата -->
                    <div invisible="not context.get('show_generation_result')">
                        <button string="Покажи частен ключ" name="view_private_key" type="object"
                                class="btn-info"/>
                        <button string="Покажи публичен ключ" name="view_public_key" type="object"
                                class="btn-info"/>
                        <button string="Готово" class="btn-primary" special="cancel" data-hotkey="q"/>
                    </div>
                </footer>
            </form>
        </field>
    </record>

</odoo>
