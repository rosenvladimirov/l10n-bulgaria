<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Формата на wizard-а за импорт на ключове от ZIP -->
    <record id="view_crypto_wallet_import_wizard_form" model="ir.ui.view">
        <field name="name">crypto.wallet.import.wizard.form</field>
        <field name="model">crypto.wallet.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import keys from ZIP">
                <sheet>
                    <group>
                        <field name="wallet_id" readonly="1"/>
                        <field name="zip_file" filename="zip_filename"/>
                        <field name="zip_filename" invisible="1"/>
                        <field name="zip_password" password="True"/>
                    </group>
                    <group string="Destination wallet credentials">
                        <field name="use_user_password"/>
                        <field name="master_password"
                               password="True"
                               invisible="use_user_password"
                               required="not use_user_password"/>
                    </group>
                    <group string="Conflict resolution">
                        <field name="overwrite"/>
                    </group>
                    <group string="Result"
                           invisible="not context.get('show_import_result')">
                        <field name="result_imported" readonly="1"/>
                        <field name="result_skipped" readonly="1"/>
                        <field name="result_overwritten" readonly="1"/>
                        <field name="result_summary" readonly="1"
                               nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Import" type="object"
                            name="action_import"
                            class="btn-primary"
                            invisible="context.get('show_import_result')"/>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action — отваря wizard-а с pre-filled wallet_id от текущия record -->
    <record id="action_crypto_wallet_import_wizard" model="ir.actions.act_window">
        <field name="name">Import keys from ZIP</field>
        <field name="res_model">crypto.wallet.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_wallet_id': active_id}</field>
        <field name="binding_model_id" ref="model_crypto_wallet"/>
    </record>

</odoo>
