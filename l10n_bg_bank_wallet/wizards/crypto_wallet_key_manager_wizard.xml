<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Key Manager Wizard Form View -->
    <record id="view_crypto_wallet_key_manager_form" model="ir.ui.view">
        <field name="name">crypto.wallet.key.manager.form</field>
        <field name="model">crypto.wallet.key.manager</field>
        <field name="arch" type="xml">
            <form string="Мениджър на ключове">
                <!-- Основна информация -->
                <div class="alert alert-info" role="alert" invisible="context.get('show_key_data')">
                    <strong>Мениджър на ключове</strong><br/>
                    Управлявайте ключовете в криптирания портфел.
                </div>

                <!-- Показване на данни на ключ -->
                <div class="alert alert-success" role="alert" invisible="not context.get('show_key_data')">
                    <strong>Данни на ключа</strong><br/>
                    Информация за избрания ключ от портфела.
                </div>

                <sheet>
                    <!-- Състояние на портфела -->
                    <group string="Информация за портфела" invisible="context.get('show_key_data')">
                        <group>
                            <field name="wallet_id" readonly="1"/>
                            <field name="is_wallet_locked" readonly="1" widget="boolean_button"
                                   options="{'terminology': {'string_true': 'Заключен', 'string_false': 'Отключен'}}"/>
                        </group>
                        <group>
                            <field name="keys_count" readonly="1"/>
                        </group>
                    </group>

                    <!-- Списък с ключове -->
                    <group string="Ключове в портфела" invisible="context.get('show_key_data')">
                        <field name="key_list" widget="text" readonly="1"
                               options="{'max_height': 200}" nolabel="1"/>
                    </group>

                    <!-- Операции с ключове -->
                    <group string="Операции с ключ" invisible="context.get('show_key_data')">
                        <group>
                            <field name="selected_key_name" placeholder="Въведете името на ключа..."/>
                        </group>
                    </group>

                    <!-- Показване на данни на ключ -->
                    <group string="Данни на ключа" invisible="not context.get('show_key_data')">
                        <group>
                            <field name="selected_key_name" readonly="1"/>
                            <field name="selected_key_type" readonly="1"/>
                            <field name="selected_key_created" readonly="1"/>
                        </group>
                        <group>
                            <field name="selected_key_data" widget="text" readonly="1"
                                   options="{'max_height': 300}" nolabel="1"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <!-- Бутони за мениджъра -->
                    <div invisible="context.get('show_key_data')">
                        <!-- Управление на портфела -->
                        <button string="Отключи портфела" name="unlock_wallet" type="object"
                                class="btn-warning" invisible="not is_wallet_locked"/>

                        <!-- Операции с ключове -->
                        <button string="Добави ключ" name="add_key" type="object"
                                class="btn-primary"/>
                        <button string="Генерирай двойка" name="generate_keypair" type="object"
                                class="btn-secondary"/>

                        <!-- Операции с избран ключ -->
                        <button string="Покажи ключ" name="view_key" type="object"
                                class="btn-info"/>
                        <button string="Премахни ключ" name="remove_key" type="object"
                                class="btn-danger"
                                confirm="Сигурни ли сте, че искате да премахнете този ключ?"/>
                        <button string="Експортирай ключ" name="export_key" type="object"
                                class="btn-secondary"/>

                        <!-- Други -->
                        <button string="Обнови" name="refresh_keys" type="object"
                                class="btn-light"/>
                        <button string="Затвори" class="btn-secondary" special="cancel"/>
                    </div>

                    <!-- Бутони за показване на ключ -->
                    <div invisible="not context.get('show_key_data')">
                        <button string="Назад" class="btn-primary" special="cancel"/>
                    </div>
                </footer>
            </form>
        </field>
    </record>

</odoo>
