<odoo>
    <data>
        <record id="view_bank_import_confirmation_wizard_form" model="ir.ui.view">
            <field name="name">bank.import.confirmation.wizard.form</field>
            <field name="model">bank.import.confirmation.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Bank Import">
                    <group>
                        <field name="bank_id" invisible="1"/>
                        <field name="period_display"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <footer>
                        <button name="action_confirm_import" 
                                type="object" 
                                string="Confirm Import" 
                                class="btn-primary"/>
                        <button name="action_cancel" 
                                type="object" 
                                string="Cancel" 
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
