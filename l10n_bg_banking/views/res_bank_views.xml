<odoo>
    <data>
        <record id="view_res_bank_form_ex" model="ir.ui.view">
            <field name="name">res.bank.form.extend</field>
            <field name="inherit_id" ref="base.view_res_bank_form"/>
            <field name="model">res.bank</field>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='communication_details']" position="after">
                    <group name="infopay_details" string="Infopay API Configuration">
                        <field name="infopay_api_url"/>
                        <field name="infopay_client_id"/>
                        <field name="infopay_access_token" password="True"/>
                        
                        <field name="infopay_session_id" readonly="1"/>
                        <field name="infopay_session_expiry" readonly="1"/>
                        
                        <field name="bank_code"/>
                        <field name="account_iban"/>

                        <button name="action_test_infopay_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-secondary"/>
                        
                        <button name="action_import_infopay_statements"
                                type="object"
                                string="Import Infopay Statement"
                                class="btn-primary"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
