<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_bg_banking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.bg.banking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="InfoPay Banking Integration" string="InfoPay Banking Integration" name="l10n_bg_banking">
                    <block title="Configuration" name="infopay_configuration">
                        <setting id="infopay_api_settings" title="API Configuration" string="API Configuration" help="Configure InfoPay API connection settings">
                            <div class="content-group">
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="infopay_api_url" string="API URL"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="infopay_api_url" placeholder="https://integration.infopay.bg"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="infopay_client_id" string="Client ID"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="infopay_client_id" placeholder="Your Client ID"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="infopay_access_token" string="Access Token"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="infopay_access_token" password="True" placeholder="Your Access Token"/>
                                    </div>
                                </div>
                                <div class="content-group mt8">
                                    <button name="action_configure_journals" type="object" string="Configure Journals" class="btn-primary"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="infopay_integration_period" title="Integration Period" string="Integration Period" help="Configure the period for transaction import">
                            <div class="content-group">
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="integration_year" string="Year"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="integration_year"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="integration_month" string="Month"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="integration_month"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <setting id="infopay_status" title="Status" string="Status" help="Current status of InfoPay integration">
                            <div class="content-group">
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="infopay_status" string="Status"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="infopay_status" readonly="1"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 o_light_label">
                                        <label for="configured_journals_count" string="Configured Journals"/>
                                    </div>
                                    <div class="col-lg-8">
                                        <field name="configured_journals_count" readonly="1"/>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
