<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_l10n_bg_ekatte_sync_form" model="ir.ui.view">
            <field name="name">l10n.bg.ekatte.sync.form</field>
            <field name="model">l10n.bg.ekatte.sync</field>
            <field name="arch" type="xml">
                <form string="EKATTE Sync Run">
                    <header>
                        <button name="action_run"
                                string="Run Sync Now"
                                type="object"
                                class="btn-primary"
                                invisible="state in ('running','done')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,running,done"/>
                    </header>
                    <sheet>
                        <h1><field name="name" readonly="1"/></h1>
                        <group>
                            <group string="Source">
                                <field name="source_url"/>
                                <field name="source_attachment_id"
                                       domain="[('mimetype','in',['application/zip','application/x-dbf','application/octet-stream'])]"/>
                            </group>
                            <group string="Timing">
                                <field name="date_started"/>
                                <field name="date_finished"/>
                            </group>
                        </group>
                        <group string="Results">
                            <field name="records_created"/>
                            <field name="records_updated"/>
                            <field name="records_skipped"/>
                        </group>
                        <field name="error_message" readonly="1"
                               invisible="state != 'error'"/>
                        <field name="notes" placeholder="Internal notes…"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_l10n_bg_ekatte_sync_list" model="ir.ui.view">
            <field name="name">l10n.bg.ekatte.sync.list</field>
            <field name="model">l10n.bg.ekatte.sync</field>
            <field name="arch" type="xml">
                <list string="EKATTE Sync Runs">
                    <field name="name"/>
                    <field name="date_started"/>
                    <field name="date_finished"/>
                    <field name="state"
                           widget="badge"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'error'"
                           decoration-info="state == 'running'"/>
                    <field name="records_created"/>
                    <field name="records_updated"/>
                </list>
            </field>
        </record>

        <record id="action_l10n_bg_ekatte_sync" model="ir.actions.act_window">
            <field name="name">EKATTE Sync Runs</field>
            <field name="res_model">l10n.bg.ekatte.sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_l10n_bg_ekatte_sync"
                  name="EKATTE Sync"
                  parent="contacts.res_partner_menu_config"
                  action="action_l10n_bg_ekatte_sync"
                  sequence="80"
                  groups="base.group_partner_manager"/>
    </data>
</odoo>
