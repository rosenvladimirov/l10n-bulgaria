#. module: l10n_bg_claude_artifact_blog
#. odoo-python
#: code:addons/l10n_bg_claude_artifact_blog/models/claude_artifact.py:0
msgid ""
"<p>Coverage: <b>%(pct).1f%%</b> — source %(src)s words, article %(got)s "
"words, missing %(lost)s, dropped on purpose %(dropped)s.</p>%(sample)s"
msgstr ""
"<p>Покритие: <b>%(pct).1f%%</b> — източник %(src)s думи, статия %(got)s "
"думи, липсват %(lost)s, изхвърлени нарочно %(dropped)s.</p>%(sample)s"

#. module: l10n_bg_claude_artifact_blog
#: model:ir.model.fields,help:l10n_bg_claude_artifact_blog.field_claude_snippet_rule__standalone
msgid ""
"A standalone block becomes its own <section>. A non-standalone one is merged"
" into the surrounding text section, the way headings of level 3 and "
"paragraphs belong together."
msgstr ""
"Самостоятелният блок става собствена секция. Несамостоятелният влиза в "
"текстовата секция около него — както заглавията от трето ниво и абзаците "
