<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Артефактите са лични: чуждата чернова не се вижда. Дизайнерът с
             права над сайта вижда своите; системният администратор — всички. -->
        <record id="claude_artifact_rule_own" model="ir.rule">
            <field name="name">Claude artifact: own records</field>
            <field name="model_id" ref="model_claude_artifact"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('website.group_website_designer'))]"/>
        </record>
        <record id="claude_artifact_rule_all" model="ir.rule">
            <field name="name">Claude artifact: all records</field>
            <field name="model_id" ref="model_claude_artifact"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
