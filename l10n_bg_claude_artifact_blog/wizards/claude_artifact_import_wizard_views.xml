<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="claude_artifact_import_wizard_view_form" model="ir.ui.view">
        <field name="name">claude.artifact.import.wizard.form</field>
        <field name="model">claude.artifact.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Claude Artifact">
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="source_format"/>
                            <field name="upload_file" filename="upload_filename"/>
                            <field name="upload_filename" invisible="1"/>
                            <field name="source_url" widget="url"/>
                            <field name="session_ref"/>
                        </group>
                        <group string="Target">
                            <field name="name"/>
                            <field name="blog_id"/>
                            <field name="author_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="build_now"/>
                        </group>
                    </group>
                    <group string="Or paste the source" invisible="upload_file">
                        <field name="pasted_source" nolabel="1"
                               placeholder="Paste the artifact HTML or Markdown here."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="claude_artifact_import_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Artifact</field>
        <field name="res_model">claude.artifact.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
