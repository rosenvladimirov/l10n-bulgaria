<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_ai_tokenizer_reindex" model="ir.cron">
        <field name="name">AI Tokenizer — re-index stale documents</field>
        <field name="model_id" ref="model_ai_composite_document"/>
        <field name="state">code</field>
        <field name="code">model.cron_reindex_stale(batch_size=50)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
