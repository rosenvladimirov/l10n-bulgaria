#. module: l10n_bg_claude_terminal
#: model_terms:ir.ui.view,arch_db:l10n_bg_claude_terminal.res_config_settings_view_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                                <b>Keys need rotation.</b>\n"
"                                Rotate API keys in their upstream consoles\n"
"                                (Anthropic / Qdrant / Voyage / OpenAI / MCP),\n"
"                                paste the new values above, then click the\n"
"                                button below."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                                <b>Ключовете се нуждаят от ротация.</b>\n"
"                                Ротирайте API ключовете в конзолите на доставчиците\n"
"                                (Anthropic / Qdrant / Voyage / OpenAI / MCP),\n"
"                                поставете новите стойности по-горе и натиснете\n"
"                                бутона по-долу."

#. module: l10n_bg_claude_terminal
#: model_terms:ir.ui.view,arch_db:l10n_bg_claude_terminal.res_config_settings_view_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                No Anthropic key synced yet. Configure the MCP Server URL and Token above,\n"
"                                then click <b>Reload from MCP</b>."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                Все още няма синхронизиран Anthropic ключ. Конфигурирайте URL и токена на MCP сървъра по-горе,\n"
"                                след което натиснете <b>Презареди от MCP</b>."

#. module: l10n_bg_claude_terminal
#: model_terms:ir.ui.view,arch_db:l10n_bg_claude_terminal.res_config_settings_view_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                Алтернатива на ръчното попълване — wizard в 5 стъпки:\n"
"                                качи ZIP, прегледай ключове, избери потребители, приложи, тествай."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                Алтернатива на ръчното попълване — wizard в 5 стъпки:\n"
"                                качи ZIP, прегледай ключове, избери потребители, приложи, тествай."

#. module: l10n_bg_claude_terminal
#: model_terms:ir.ui.view,arch_db:l10n_bg_claude_terminal.view_claude_terminal_setup_wizard_form
msgid ""
"<strong>Company-level ключове</strong> (MCP, Qdrant, Ollama, Embeddings)\n"
"                                се записват веднъж на фирмата.<br/>\n"
"                                <strong>Per-user полетата</strong> (Claude Terminal URL/тема, Anthropic ключ,\n"
"                                Odoo URL/db/протокол) се записват на всеки избран потребител."
msgstr ""
"<strong>Фирмените ключове</strong> (MCP, Qdrant, Ollama, Embeddings)\n"
"                                се записват веднъж на фирмата.<br/>\n"
"                                <strong>Полетата на потребител</strong> (Claude Terminal URL/тема, Anthropic ключ,\n"
"                                Odoo URL/db/протокол) се записват на всеки избран потребител."

#. module: l10n_bg_claude_terminal
#: model_terms:ir.ui.view,arch_db:l10n_bg_claude_terminal.view_claude_terminal_setup_wizard_form
