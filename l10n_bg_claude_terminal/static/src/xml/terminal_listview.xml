<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<!-- AI button next to New in list view -->
<t t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
        <button type="button"
                class="btn btn-secondary"
                t-on-click="openClaudeTerminal">
            AI
        </button>
    </xpath>
</t>

<!-- Modal dialog with terminal -->
<t t-name="l10n_bg_claude_terminal.TerminalDialog" owl="1">
    <Dialog size="'lg'" header="false" footer="false" withBodyPadding="false"
            contentClass="'ct-dialog-content'">
        <button class="ct-dialog-close" t-on-click="props.close" title="Close">
            <i class="fa fa-times"/>
        </button>
        <iframe t-if="props.url"
                t-att-src="iframeSrc"
                class="ct-dialog-iframe"
                sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
                allow="clipboard-read; clipboard-write"/>
        <div t-else="" class="ct-dialog-empty">
            <i class="fa fa-cog"/>
            <p>Configure terminal URL in Settings → Preferences → Claude Terminal</p>
        </div>
    </Dialog>
</t>

</templates>
