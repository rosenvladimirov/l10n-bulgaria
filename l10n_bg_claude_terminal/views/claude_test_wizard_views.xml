<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="claude_terminal_test_wizard_form" model="ir.ui.view">
        <field name="name">claude.terminal.test.wizard.form</field>
        <field name="model">claude.terminal.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Connection Test Results">
                <sheet>
                    <group string="Odoo RPC Connector">
                        <field name="odoo_status" widget="badge"
                               decoration-success="odoo_status == 'ok'"
                               decoration-warning="odoo_status == 'warn'"
                               decoration-danger="odoo_status == 'error'"
                               decoration-muted="odoo_status == 'skip'"/>
                        <field name="odoo_message"/>
                    </group>
                    <group string="MCP Server">
                        <field name="mcp_status" widget="badge"
                               decoration-success="mcp_status == 'ok'"
                               decoration-warning="mcp_status == 'warn'"
                               decoration-danger="mcp_status == 'error'"
                               decoration-muted="mcp_status == 'skip'"/>
                        <field name="mcp_message"/>
                    </group>
                    <group string="Web Session">
                        <field name="web_status" widget="badge"
                               decoration-success="web_status == 'ok'"
                               decoration-warning="web_status == 'warn'"
                               decoration-danger="web_status == 'error'"
                               decoration-muted="web_status == 'skip'"/>
                        <field name="web_message"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_claude_terminal_test_wizard" model="ir.actions.act_window">
        <field name="name">Test Connections</field>
        <field name="res_model">claude.terminal.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
