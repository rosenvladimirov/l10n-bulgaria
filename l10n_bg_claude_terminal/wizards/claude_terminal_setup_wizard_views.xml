<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_claude_terminal_setup_wizard_form" model="ir.ui.view">
        <field name="name">claude.terminal.setup.wizard.form</field>
        <field name="model">claude.terminal.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Claude Terminal — Setup">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="provision,upload,review,users,apply,test"/>
                </header>
                <sheet>

                    <!-- ═══════════════════ STEP 0: PROVISION (optional) ═══════════ -->
                    <group invisible="state != 'provision'">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <h4>Стъпка 0 от 5: Нова MCP инстанция (опционално)</h4>
                            <p>
                                Ако вече имате конфигурационен ZIP от съществуваща MCP
                                инстанция — оставете чекбокса празен и натиснете
                                <strong>Напред</strong> за да преминете към качване.
                            </p>
                            <p class="mb-0">
                                Ако нямате инстанция — маркирайте <strong>"Създай нова MCP инстанция"</strong>,
                                въведете парола (мин. 8 символа) и wizard-ът автоматично ще:
                            </p>
                            <ol class="mb-0 mt-2">
                                <li>се свърже с v3 provisioning сървъра (<field name="provision_v3_url" readonly="1" nolabel="1" class="oe_inline"/>)</li>
                                <li>създаде ваша MCP инстанция (Docker stack + DNS)</li>
                                <li>генерира AES-encrypted ZIP с вашата парола</li>
                                <li>премине автоматично към стъпка 2 (преглед)</li>
                            </ol>
                        </div>
                        <field name="create_new_instance"/>
                        <group invisible="not create_new_instance" col="2">
                            <field name="provision_company_vat" readonly="1"
                                   help="Tenant id will be normalised from the VAT number, e.g. BG123456789 → bg123456789"/>
                            <field name="provision_password" password="True"
                                   required="create_new_instance"
                                   placeholder="At least 8 characters — keep it safe"/>
                            <field name="provision_email"
                                   placeholder="admin@company.bg"/>
                            <field name="provision_v3_url" readonly="1"/>
                            <field name="provision_api_key_set" widget="boolean_toggle" readonly="1"/>
                        </group>
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="not create_new_instance or provision_company_vat">
                            <strong>⚠ Фирмата няма ДДС номер.</strong>
                            Tenant id-то се извлича от ДДС номера. Попълнете го в
                            Settings → Companies → <em>{вашата фирма}</em> → ДДС номер,
                            след това отворете wizard-а наново.
                        </div>
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="not create_new_instance or (provision_v3_url and provision_api_key_set)">
                            <strong>⚠ Конфигурация липсва.</strong>
                            Settings → Technical → Parameters → System Parameters:
                            <ul class="mb-0">
                                <li><code>claude_terminal.provisioning_v3_url</code> — URL на v3 server (напр. <code>https://v3.mcpworks.net</code>)</li>
                                <li><code>claude_terminal.provisioning_api_key</code> — API ключ от админа на v3</li>
                            </ul>
                        </div>
                        <group invisible="not provisioned_client_id" col="2">
                            <field name="provisioned_client_id" readonly="1"/>
                            <field name="provisioned_mcp_url" readonly="1"/>
                            <field name="provision_log" widget="text" nolabel="1" readonly="1" colspan="2"/>
                        </group>
                    </group>

                    <!-- ═══════════════════ STEP 1: UPLOAD ═══════════════════ -->
                    <group invisible="state != 'upload'">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <h4>Стъпка 1 от 5: Качете конфигурационен файл</h4>
                            <p>
                                Изтеглете ZIP файла от MCP сървъра (<code>mcp_terminal_get_config</code> tool)
                                с временна парола. Качете го тук и въведете показаната парола.
                            </p>
                        </div>
                        <field name="config_file" filename="config_filename" required="state == 'upload'"/>
                        <field name="config_filename" invisible="1"/>
                        <field name="zip_password" password="True" required="state == 'upload'"
                               placeholder="Temporary password from MCP server"/>
                    </group>

                    <!-- ═══════════════════ STEP 2: REVIEW ═══════════════════ -->
                    <group invisible="state != 'review'">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <h4>Стъпка 2 от 5: Прегледайте ключовете</h4>
                            <p>
                                Извлечените стойности от конфигурацията. Можете да ги
                                редактирате преди прилагане. Празните полета НЕ заместват съществуващи стойности.
                            </p>
                        </div>
                        <group string="MCP server" col="2">
                            <field name="cfg_mcp_url"/>
                            <field name="cfg_mcp_token" password="True"/>
                            <field name="cfg_mcp_client_id"/>
                            <field name="cfg_mcp_api_key" password="True"/>
                        </group>
                        <group string="Anthropic (for users)" col="2">
                            <field name="cfg_anthropic_api_key" password="True"/>
                        </group>
                        <group string="Qdrant (vector DB for tokenisation)" col="2">
                            <field name="cfg_qdrant_url"/>
                            <field name="cfg_qdrant_api_key" password="True"/>
                            <field name="cfg_qdrant_collection_prefix"/>
                        </group>
                        <group string="Embeddings" col="2">
                            <field name="cfg_embedding_provider"/>
                            <field name="cfg_embedding_api_key" password="True"/>
                            <field name="cfg_ollama_url"/>
                            <field name="cfg_ollama_model"/>
                        </group>
                        <group string="Claude Terminal (per-user)" col="2">
                            <field name="cfg_terminal_url"
                                   placeholder="https://terminal.mcp.odoo-shell.space"/>
                            <field name="cfg_terminal_theme"/>
                        </group>
                        <group string="Odoo RPC Connector (per-user)" col="2">
                            <field name="external_odoo_url"/>
                            <field name="cfg_odoo_protocol"/>
                            <field name="cfg_odoo_verify_ssl"/>
                        </group>
                        <group string="Raw JSON (read-only)">
                            <field name="parsed_payload" widget="text" nolabel="1" readonly="1"/>
                        </group>
                    </group>

                    <!-- ═══════════════════ STEP 3: USERS ═══════════════════ -->
                    <group invisible="state != 'users'">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <h4>Стъпка 3 от 5: Изберете потребители</h4>
                            <p>
                                <strong>Company-level ключове</strong> (MCP, Qdrant, Ollama, Embeddings)
                                се записват веднъж на фирмата.<br/>
                                <strong>Per-user полетата</strong> (Claude Terminal URL/тема, Anthropic ключ,
                                Odoo URL/db/протокол) се записват на всеки избран потребител.
                            </p>
                            <p class="mb-0 mt-2">
                                ⚠ <strong>Odoo API Key остава празен</strong> — всеки потребител трябва
                                сам да го генерира (в собствения си профил → <em>Account Security → New
                                API Key</em>) и да го пейства в полето <em>Odoo RPC Connector → API Key</em>.
                                Това е защита срещу credential leak.
                            </p>
                        </div>
                        <field name="company_id"/>
                        <field name="apply_to_company"/>
                        <field name="user_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Select users to activate"/>
                    </group>

                    <!-- ═══════════════════ STEP 4: APPLY ═══════════════════ -->
                    <group invisible="state != 'apply'">
                        <div class="alert alert-success" role="alert" colspan="2"
                             invisible="not applied_company and applied_user_count == 0">
                            <h4>Стъпка 4 от 5: Прилагане завършено</h4>
                        </div>
                        <div class="alert alert-warning" role="alert" colspan="2"
                             invisible="applied_company or applied_user_count != 0">
                            <h4>Стъпка 4 от 5: Нищо не е приложено</h4>
                        </div>
                        <group col="2">
                            <field name="applied_company"/>
                            <field name="applied_user_count"/>
                        </group>
                        <field name="apply_log" widget="text" nolabel="1" readonly="1"/>
                    </group>

                    <!-- ═══════════════════ STEP 5: TEST ═══════════════════ -->
                    <group invisible="state != 'test'">
                        <div class="alert alert-info" role="alert" colspan="2">
                            <h4>Стъпка 5 от 5: Тестване на връзките</h4>
                            <p>Извършва се ping към MCP, Anthropic API и Qdrant.</p>
                        </div>
                        <group col="3">
                            <field name="test_mcp_ok" widget="boolean_toggle" readonly="1"/>
                            <field name="test_anthropic_ok" widget="boolean_toggle" readonly="1"/>
                            <field name="test_qdrant_ok" widget="boolean_toggle" readonly="1"/>
                        </group>
                        <field name="test_log" widget="text" nolabel="1" readonly="1"/>
                    </group>

                </sheet>
                <footer>
                    <!-- Step 0 (provision): only Next + Cancel -->
                    <button name="action_next" type="object" string="Next →"
                            class="btn-primary" invisible="state != 'provision'"/>

                    <!-- Step 1 (upload): Back + Next -->
                    <button name="action_back" type="object" string="← Back"
                            invisible="state != 'upload'"/>
                    <button name="action_next" type="object" string="Next →"
                            class="btn-primary" invisible="state != 'upload'"/>

                    <!-- Steps 2-4: Back + Next -->
                    <button name="action_back" type="object" string="← Back"
                            invisible="state in ('provision', 'upload', 'test')"/>
                    <button name="action_next" type="object" string="Next →"
                            class="btn-primary"
                            invisible="state in ('provision', 'upload', 'test')"/>

                    <!-- Step 5 (test): Re-test + Close -->
                    <button name="action_run_tests" type="object" string="Test Again"
                            invisible="state != 'test'"/>
                    <button special="cancel" string="Close" class="btn-secondary"
                            invisible="state != 'test'"/>

                    <!-- Cancel everywhere except final -->
                    <button special="cancel" string="Cancel"
                            invisible="state == 'test'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_claude_terminal_setup_wizard" model="ir.actions.act_window">
        <field name="name">Настройка на Claude Terminal</field>
        <field name="res_model">claude.terminal.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Wizard launched from Settings → MCP Server section button (no menu item) -->

</odoo>
