<?xml version="1.0" encoding="utf-8"?>
<!-- Справочник на КН по години -->
<odoo>
    <record id="view_l10n_bg_cn_code_list" model="ir.ui.view">
        <field name="name">l10n.bg.cn.code.list</field>
        <field name="model">l10n.bg.cn.code</field>
        <field name="arch" type="xml">
            <list string="Combined Nomenclature" editable="bottom">
                <field name="year"/>
                <field name="code"/>
                <field name="hs6" optional="show"/>
                <field name="name"/>
                <field name="supplementary_unit" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_bg_cn_code_form" model="ir.ui.view">
        <field name="name">l10n.bg.cn.code.form</field>
        <field name="model">l10n.bg.cn.code</field>
        <field name="arch" type="xml">
            <form string="Combined Nomenclature Code">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="hs6"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="supplementary_unit"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="name" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_bg_cn_code_search" model="ir.ui.view">
        <field name="name">l10n.bg.cn.code.search</field>
        <field name="model">l10n.bg.cn.code</field>
        <field name="arch" type="xml">
            <search string="Combined Nomenclature">
                <field name="code"/>
                <field name="hs6"/>
                <field name="name"/>
                <field name="year"/>
                <separator/>
                <filter string="With Supplementary Unit" name="with_su"
                        domain="[('supplementary_unit', '!=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Year" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="HS6" name="group_by_hs6" context="{'group_by': 'hs6'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_bg_cn_code" model="ir.actions.act_window">
        <field name="name">Combined Nomenclature</field>
        <field name="res_model">l10n.bg.cn.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_bg_cn_code_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Load the Combined Nomenclature of the year
            </p>
            <p>
                Use "Import Combined Nomenclature" with the NC8_TARIC sheet
                of the NRA or the CN file of the NSI. While the nomenclature
                of a year is empty, only the format of the codes is checked.
            </p>
        </field>
    </record>
</odoo>
