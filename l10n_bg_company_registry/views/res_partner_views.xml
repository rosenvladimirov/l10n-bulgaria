<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.property.form.l10n_bg</field>
        <field name="model">res.partner</field>
        <field name="priority">2</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_bg_uic']" position="replace">
                <field name="l10n_bg_uic"
                       readonly="parent_id"
                       widget="l10n_bg_uic_with_fetch"
                       options="{'button_icon': 'fa-download', 'button_title': 'Download from registry'}"
                       decoration-info="l10n_bg_uic_type == 'bg_uic' and vat"/>
            </xpath>
        </field>
    </record>
</odoo>
