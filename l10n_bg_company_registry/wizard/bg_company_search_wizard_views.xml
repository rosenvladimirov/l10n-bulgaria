
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_bg_company_search_wizard_form" model="ir.ui.view">
        <field name="name">bg.company.search.wizard.form</field>
        <field name="model">bg.company.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Данни от търговски регистър">
                <sheet>
                    <group>
                        <field name="partner_id" invisible="1"/>
                        <field name="data_fetched" invisible="1"/>
                        <field name="company_data_json" invisible="1"/>

                        <group>
                            <field name="eik" placeholder="Въведете ЕИК (9 или 13 цифри)"/>
                        </group>
                    </group>

                    <group>
                        <button name="action_fetch_data"
                                string="Изтегли данни от регистър"
                                type="object"
                                class="btn-primary"
                                icon="fa-download"/>
                    </group>

                    <separator string="Данни за компанията"
                               invisible="not data_fetched"/>

                    <group invisible="not data_fetched">
                        <group>
                            <field name="display_eik"/>
                            <field name="display_vat"/>
                            <field name="display_legal_form_bg"/>
                            <field name="display_registration_date"/>
                        </group>
                        <group>
                            <field name="display_name_bg"/>
                            <field name="display_name_en"/>
                            <field name="display_activity_code"/>
                        </group>
                    </group>

                    <group invisible="not data_fetched">
                        <group colspan="2">
                            <field name="display_activity_description" nolabel="1"/>
                        </group>
                    </group>

                    <separator string="Адрес"
                               invisible="not data_fetched"/>

                    <group invisible="not data_fetched">
                        <group>
                            <field name="display_city"/>
                            <field name="display_postal_code"/>
                        </group>
                        <group>
                            <field name="display_street"/>
                        </group>
                    </group>

                    <group invisible="not data_fetched">
                        <field name="display_address_bg" nolabel="1"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_populate_partner"
                            string="Попълни партньор с данни"
                            type="object"
                            class="btn-primary"
                            invisible="not data_fetched or not partner_id"
                            icon="fa-check"/>
                    <button string="Затвори"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_bg_company_search_wizard" model="ir.actions.act_window">
        <field name="name">Данни от търговски регистър</field>
        <field name="res_model">bg.company.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
