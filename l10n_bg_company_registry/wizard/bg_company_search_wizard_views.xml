<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_bg_company_search_wizard_form" model="ir.ui.view">
        <field name="name">bg.company.search.wizard.form</field>
        <field name="model">bg.company.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Commercial register data">
                <sheet>
                    <group>
                        <field name="partner_id" invisible="1" force_save="1"/>
                        <field name="data_fetched" invisible="1" force_save="1"/>
                        <field name="company_data_json" invisible="1" force_save="1"/>
                        <field name="original_eik" invisible="1" force_save="1"/>
                        <field name="eik_changed" invisible="1" force_save="1"/>

                        <group>
                            <field name="eik" placeholder="Enter EIC (9 or 13 digits)"/>
                        </group>
                    </group>

                    <group>
                        <button name="action_fetch_data"
                                string="Download data from registry"
                                type="object"
                                class="btn-primary"
                                icon="fa-download"/>
                    </group>

                    <separator string="Company data"
                               invisible="not data_fetched"/>

                    <group invisible="not data_fetched">
                        <group>
                            <field name="display_eik"/>
                            <field name="display_vat"/>
                            <field name="display_legal_form_bg"/>
                            <field name="display_registration_date"/>
                        </group>
                        <group>
                            <field name="display_name_bg" force_save="1"/>
                            <field name="display_name_en" force_save="1"/>
                            <field name="display_activity_code"/>
                        </group>
                    </group>

                    <group invisible="not data_fetched">
                        <group colspan="2">
                            <field name="display_activity_description" nolabel="1"/>
                        </group>
                    </group>

                    <separator string="Address"
                               invisible="not data_fetched"/>

                    <group invisible="not data_fetched">
                        <group>
                            <field name="display_country_id" force_save="1"/>
                            <field name="display_state_id" force_save="1"/>
                            <field name="display_city_id" force_save="1"/>
                        </group>
                        <group>
                            <field name="display_postal_code" force_save="1"/>
                            <field name="display_street" force_save="1"/>
                        </group>
                    </group>

                    <group invisible="not data_fetched">
                        <field name="display_address_bg"
                               string="Full address (from register)"
                               nolabel="1"
                               widget="text"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_populate_partner"
                            string="Fill in partner data"
                            type="object"
                            class="btn-primary"
                            invisible="not data_fetched or not partner_id"
                            icon="fa-check"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_bg_company_search_wizard" model="ir.actions.act_window">
        <field name="name">Commercial register data</field>
        <field name="res_model">bg.company.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
