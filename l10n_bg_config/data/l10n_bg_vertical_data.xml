        <field name="name">AI / Tooling (optional)</field>
        <field name="sequence">110</field>
        <field name="edition">ce</field>
        <field name="description">In-Odoo Claude terminal, AI pipeline, TARIC/invoice AI. Infrastructure — optional.</field>
