<?xml version="1.0" encoding="utf-8" ?>
<!-- Seed на инсталационните вертикали V0–V12 + подредени стъпки.
     Методология (кой-след-кой + междинни конфигурации) по каталога на
     l10n_bg модулите. noupdate=0: канонична методология, пропагира при -u.
     install_module стъпки = реален button_immediate_install (НЕ upgrade);
     липсващ модул → стъпка „unavailable" (read-only, не блокира). -->
<odoo noupdate="0">

    <!-- ═══ V0 — Foundation & Config ═══ -->
    <record id="vertical_v0" model="l10n.bg.vertical">
        <field name="code">V0</field>
        <field name="name">Foundation &amp; Config</field>
        <field name="sequence">0</field>
        <field name="edition">ce</field>
        <field name="description">Core Bulgarian localization foundation. Everything else depends on this. Requires the BG chart of accounts loaded.</field>
    </record>
    <record id="v0_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_config (foundation)</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_config</field>
        <field name="skip_if_auto_install" eval="True"/>
    </record>
    <record id="v0_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">20</field>
        <field name="name">Set company country = Bulgaria, load the BG chart of accounts, set UIC/VAT</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Set the company country to Bulgaria, load the Bulgarian chart of accounts for the company, and fill the company UIC (ЕИК/БУЛСТАТ) and VAT number. The chart MUST be loaded before any reporting/VAT/tax module works correctly.</field>
    </record>
    <record id="v0_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">30</field>
        <field name="name">Install l10n_bg_city</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_city</field>
    </record>
    <record id="v0_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">40</field>
        <field name="name">Install l10n_bg_address_extended</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_address_extended</field>
        <field name="optional" eval="True"/>
    </record>
    <record id="v0_s50" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">50</field>
        <field name="name">Install l10n_bg_tax_offices</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_tax_offices</field>
    </record>
    <record id="v0_s60" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v0"/>
        <field name="sequence">60</field>
        <field name="name">Install l10n_bg_company_registry</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_company_registry</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V1 — Partner / Geo Multilang ═══ -->
    <record id="vertical_v1" model="l10n.bg.vertical">
        <field name="code">V1</field>
        <field name="name">Partner &amp; Geographic Multilingual</field>
        <field name="sequence">10</field>
        <field name="edition">ce</field>
        <field name="description">Bilingual partner/master data with transliteration.</field>
    </record>
    <record id="v1_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v1"/>
        <field name="sequence">10</field>
        <field name="name">Set database languages (bg_BG + en_US)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Activate bg_BG and en_US languages before installing transliteration so existing names get processed.</field>
    </record>
    <record id="v1_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v1"/>
        <field name="sequence">20</field>
        <field name="name">Install partner_multilang</field>
        <field name="step_type">install_module</field>
        <field name="module_name">partner_multilang</field>
    </record>
    <record id="v1_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v1"/>
        <field name="sequence">30</field>
        <field name="name">Install l10n_bg_multilang</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_multilang</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V2 — Accounting &amp; КИД industry packs ═══ -->
    <record id="vertical_v2" model="l10n.bg.vertical">
        <field name="code">V2</field>
        <field name="name">Accounting &amp; КИД Industry Packs</field>
        <field name="sequence">20</field>
        <field name="edition">ce</field>
        <field name="description">Chart-of-accounts industry tailoring via КИД sectors. Reload the chart and have an accountant verify the resulting accounts.</field>
    </record>
    <record id="v2_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v2"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_config_plugins_industry_map</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_config_plugins_industry_map</field>
    </record>
    <record id="v2_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v2"/>
        <field name="sequence">20</field>
        <field name="name">Install industry pack(s): agriculture / manufacturing / construction / nonprofit</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Install only the l10n_bg_config_plugins_industry_* packs relevant to the company (agriculture=A, manufacturing=C, construction=F, nonprofit=S). Each adds its КИД sector to the company and reloads the chart automatically.</field>
    </record>
    <record id="v2_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v2"/>
        <field name="sequence">30</field>
        <field name="name">Select КИД sectors / reload chart / accountant sign-off</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Set the company's active КИД sectors (or fill the init КИД codes), reload the chart template, and have the accountant verify the resulting account set (sector account CSVs are sourced from НСС/ЗСч).</field>
    </record>
    <record id="v2_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v2"/>
        <field name="sequence">40</field>
        <field name="name">Optional config plugins (NSI expenses / payroll accounts / art.69§2 / art.82§2)</field>
        <field name="step_type">config_action</field>
        <field name="action_xmlid">l10n_bg_config.action_account_plugins_wizard</field>
        <field name="instruction">Use the Config Plugins wizard to install NSI expense / social-security / special-VAT account plugins, then reload the chart. Accountant sign-off required.</field>
        <field name="edition">opl</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V3 — VAT &amp; НАП Reporting ═══ -->
    <record id="vertical_v3" model="l10n.bg.vertical">
        <field name="code">V3</field>
        <field name="name">VAT &amp; НАП Reporting</field>
        <field name="sequence">30</field>
        <field name="edition">ee</field>
        <field name="description">VAT ledgers + NRA declaration submission. Requires a loaded chart and an unlocked wallet.</field>
    </record>
    <record id="v3_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_reports_audit</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_reports_audit</field>
        <field name="skip_if_auto_install" eval="True"/>
    </record>
    <record id="v3_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">20</field>
        <field name="name">Install l10n_bg_reports_config</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_reports_config</field>
    </record>
    <record id="v3_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">30</field>
        <field name="name">Install l10n_bg_bank_wallet &amp; create/unlock wallet</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_bank_wallet</field>
    </record>
    <record id="v3_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">40</field>
        <field name="name">Each credential owner creates and unlocks their wallet</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">The NRA token owner (and any InfoPay credential owner) must create + unlock their password-derived wallet before API submission works.</field>
    </record>
    <record id="v3_s50" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">50</field>
        <field name="name">Install l10n_bg_api_nra</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_api_nra</field>
    </record>
    <record id="v3_s60" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">60</field>
        <field name="name">Configure NRA mode (test/prod), token owner, authenticate once</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">In Settings set the NRA test/production mode and the token-owner user; the owner authenticates once so the wallet stores the NRA access token. Optionally override the sandbox base URL.</field>
    </record>
    <record id="v3_s70" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">70</field>
        <field name="name">Install l10n_bg_vat_reports (EE)</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_vat_reports</field>
        <field name="skip_if_auto_install" eval="True"/>
        <field name="channel_group">vat_engine</field>
    </record>
    <record id="v3_s80" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v3"/>
        <field name="sequence">80</field>
        <field name="name">Verify NRA tag mapping &amp; VAT ledger boxes (accountant)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Map account tags to NRA cells and have the accountant verify the VAT ledger boxes before the first filing. (Enterprise channel; alternative is l10n_bg_report_vat — mutually exclusive.)</field>
    </record>

    <!-- ═══ V4 — Banking &amp; InfoPay ═══ -->
    <record id="vertical_v4" model="l10n.bg.vertical">
        <field name="code">V4</field>
        <field name="name">Banking &amp; InfoPay (Borica PSD2)</field>
        <field name="sequence">40</field>
        <field name="edition">ce</field>
        <field name="description">Borica InfoPay statements/payments. Pick exactly one framework bridge (OCA or EE).</field>
    </record>
    <record id="v4_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_bank_wallet</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_bank_wallet</field>
    </record>
    <record id="v4_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">20</field>
        <field name="name">Install l10n_bg_live_refresh + l10n_bg_queue_poll</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_queue_poll</field>
    </record>
    <record id="v4_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">30</field>
        <field name="name">Install l10n_bg_infopay</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_infopay</field>
    </record>
    <record id="v4_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">40</field>
        <field name="name">Configure bank journal IBAN(s), InfoPay tokens, import &amp; unlock wallet ZIP</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Set journal IBAN(s), the company InfoPay user-token (write) and admin Fernet token (cron read), import the wallet keys ZIP and unlock. Borica production credentials are provisioned out-of-band.</field>
    </record>
    <record id="v4_s50" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">50</field>
        <field name="name">Pick ONE framework bridge — OCA: statement + payment</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Install exactly ONE pair: OCA (l10n_bg_infopay_oca_statement + _oca_payment) OR EE (l10n_bg_infopay_ee_statement + _ee_payment). They auto-install when the framework counterpart is present.</field>
        <field name="channel_group">infopay_bridge</field>
    </record>
    <record id="v4_s60" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v4"/>
        <field name="sequence">60</field>
        <field name="name">Install l10n_bg_infopay_ui (exactly one copy)</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_infopay_ui</field>
        <field name="channel_group">infopay_ui</field>
    </record>

    <!-- ═══ V5 — Fiscal Devices / ErpNet.FP ═══ -->
    <record id="vertical_v5" model="l10n.bg.vertical">
        <field name="code">V5</field>
        <field name="name">Fiscal Devices (ErpNet.FP)</field>
        <field name="sequence">50</field>
        <field name="edition">ce</field>
        <field name="description">Fiscal-printer integration. Pick the IoT bridge matching the present IoT stack.</field>
    </record>
    <record id="v5_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v5"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_erp_net_fp</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_erp_net_fp</field>
    </record>
    <record id="v5_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v5"/>
        <field name="sequence">20</field>
        <field name="name">Configure ErpNet.FP server URL, map printers, per-printer VAT rates</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Set the ErpNet.FP server URL, map fiscal printers and configure per-printer VAT rates.</field>
    </record>
    <record id="v5_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v5"/>
        <field name="sequence">30</field>
        <field name="name">Optional: install l10n_bg_erp_net_fp_fleet (control plane)</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_erp_net_fp_fleet</field>
        <field name="optional" eval="True"/>
    </record>
    <record id="v5_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v5"/>
        <field name="sequence">40</field>
        <field name="name">IoT bridge auto-installs (OCA iot_oca OR native iot)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">l10n_bg_erp_net_fp_iot_oca (OCA iot_oca) or l10n_bg_erp_net_fp_iot (native iot) auto-installs when its IoT stack is present — do not install manually; just verify the device appears.</field>
        <field name="channel_group">erpnetfp_iot</field>
    </record>

    <!-- ═══ V6 — HR &amp; Payroll (+ НАП payroll declarations) ═══ -->
    <record id="vertical_v6" model="l10n.bg.vertical">
        <field name="code">V6</field>
        <field name="name">HR &amp; Payroll (OPL)</field>
        <field name="sequence">60</field>
        <field name="edition">opl</field>
        <field name="description">Bulgarian payroll + NRA payroll declarations. Requires V3 NRA configured first for the declaration bridges.</field>
    </record>
    <record id="v6_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v6"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_payroll_classifications + l10n_bg_hr_holidays</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_payroll_classifications</field>
    </record>
    <record id="v6_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v6"/>
        <field name="sequence">20</field>
        <field name="name">Install l10n_bg_hr_payroll</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_hr_payroll</field>
        <field name="edition">opl</field>
    </record>
    <record id="v6_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v6"/>
        <field name="sequence">30</field>
        <field name="name">Configure salary structures, contribution rates, minimum thresholds</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Payroll specialist configures salary structures, social-security contribution rates and minimum insurance thresholds.</field>
    </record>
    <record id="v6_s40" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v6"/>
        <field name="sequence">40</field>
        <field name="name">l10n_bg_hr_payroll_account — map salary rules to GL</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_hr_payroll_account</field>
        <field name="skip_if_auto_install" eval="True"/>
    </record>
    <record id="v6_s50" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v6"/>
        <field name="sequence">50</field>
        <field name="name">Install NRA payroll declarations (dec1/dec6/etz/noi) — bridges auto-activate</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Install l10n_bg_api_nra_dec1/_dec6/_etz/_noi (requires V3 l10n_bg_api_nra configured); the l10n_bg_hr_payroll_nra_* bridges auto-install. Test-mode submission before production.</field>
        <field name="edition">opl</field>
    </record>

    <!-- ═══ V7 — Manufacturing ═══ -->
    <record id="vertical_v7" model="l10n.bg.vertical">
        <field name="code">V7</field>
        <field name="name">Manufacturing (601→611 transit)</field>
        <field name="sequence">70</field>
        <field name="edition">opl</field>
        <field name="description">Bulgarian manufacturing valuation: material consumption via 601 transit, cleared to 611 on MO completion.</field>
    </record>
    <record id="v7_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v7"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_mrp_account</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_mrp_account</field>
        <field name="edition">opl</field>
    </record>
    <record id="v7_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v7"/>
        <field name="sequence">20</field>
        <field name="name">Set product-category 601 transit + 611 production account (accountant)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">On the relevant product categories set the Material Consumption Transit Account (601) and Production Account (611). Requires real-time inventory valuation.</field>
    </record>

    <!-- ═══ V8 — Reporting / Theme / Documents ═══ -->
    <record id="vertical_v8" model="l10n.bg.vertical">
        <field name="code">V8</field>
        <field name="name">Reporting / Theme / Documents</field>
        <field name="sequence">80</field>
        <field name="edition">ce</field>
        <field name="description">Professional BG document layouts and delivery/handover reports.</field>
    </record>
    <record id="v8_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v8"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_report_theme</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_report_theme</field>
        <field name="skip_if_auto_install" eval="True"/>
    </record>
    <record id="v8_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v8"/>
        <field name="sequence">20</field>
        <field name="name">Install document add-ons (invoice copy/grif, delivery note, stock reports)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Install the needed ones: l10n_bg_invoice_copy, l10n_bg_invoice_grif, l10n_bg_report_stock (+ comment/description), l10n_bg_sale_order_delivery_note. Configure comment templates / report blocks.</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V9 — Intrastat ═══ -->
    <record id="vertical_v9" model="l10n.bg.vertical">
        <field name="code">V9</field>
        <field name="name">Intrastat</field>
        <field name="sequence">90</field>
        <field name="edition">ee</field>
        <field name="description">Bulgarian Intrastat XML declaration (subset of VAT reporting).</field>
    </record>
    <record id="v9_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v9"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_intrastat</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_intrastat</field>
        <field name="edition">ee</field>
    </record>
    <record id="v9_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v9"/>
        <field name="sequence">20</field>
        <field name="name">Set Intrastat obligation / thresholds / flow (accountant)</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Configure Intrastat obligation, thresholds and flow direction; verify CN8 mapping. Accountant decision.</field>
    </record>

    <!-- ═══ V10 — Tax Assistant (Art.117 / Customs) ═══ -->
    <record id="vertical_v10" model="l10n.bg.vertical">
        <field name="code">V10</field>
        <field name="name">Tax Assistant (Art.117 / Customs)</field>
        <field name="sequence">100</field>
        <field name="edition">opl</field>
        <field name="description">VAT protocols (Art.117), customs DN+MRN, fiscal-position tax-action routing. Paid OPL module.</field>
    </record>
    <record id="v10_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v10"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_tax_admin</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_tax_admin</field>
        <field name="edition">opl</field>
    </record>
    <record id="v10_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v10"/>
        <field name="sequence">20</field>
        <field name="name">Configure fiscal-position tax-actions, EORI, customs offices</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Per fiscal position add Tax-Action rows (target doc type, narration, replacement position/account/factor); set partner/company EORI; create/verify customs offices and nomenclature. Then test with a qualifying vendor bill.</field>
    </record>
    <record id="v10_s30" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v10"/>
        <field name="sequence">30</field>
        <field name="name">Install l10n_bg_tax_admin_manual + customs rate</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_tax_admin_manual</field>
        <field name="edition">opl</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V11 — AI / Tooling ═══ -->
    <record id="vertical_v11" model="l10n.bg.vertical">
