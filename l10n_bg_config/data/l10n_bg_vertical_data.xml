    <record id="v11_s10" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v11"/>
        <field name="sequence">10</field>
        <field name="name">Install l10n_bg_claude_terminal</field>
        <field name="step_type">install_module</field>
        <field name="module_name">l10n_bg_claude_terminal</field>
        <field name="optional" eval="True"/>
    </record>
    <record id="v11_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v11"/>
        <field name="sequence">20</field>
        <field name="name">Provision MCP stack (Claude terminal + Qdrant + Ollama), set keys</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Provision the MCP Docker stack and set connection/provider params. Then optionally install l10n_bg_ai_pipeline, l10n_bg_ai_invoice_glue, taric_ai_classifier.</field>
        <field name="optional" eval="True"/>
    </record>

    <!-- ═══ V12 — Access Control / Attendance ═══ -->
    <record id="vertical_v12" model="l10n.bg.vertical">
