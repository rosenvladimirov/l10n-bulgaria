        <field name="step_type">install_module</field>
        <field name="module_name">hr_attendance_access_control</field>
        <field name="edition">opl</field>
    </record>
    <record id="v12_s20" model="l10n.bg.vertical.step">
        <field name="vertical_id" ref="vertical_v12"/>
        <field name="sequence">20</field>
        <field name="name">Configure credential channel + camera/LPR</field>
        <field name="step_type">checkpoint</field>
        <field name="instruction">Configure the credential channel and camera/LPR. Optionally install access_control_guest for guest/partner vehicle access.</field>
        <field name="optional" eval="True"/>
    </record>

