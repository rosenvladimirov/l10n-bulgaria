#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid ""
"<strong>Text content</strong> – Filter indicating which records the value "
"should be applied to (e.g., by IDs or codes)"
msgstr ""
"<strong>Текстово съдържание</strong> – Филтър, указващ към кои записи трябва"
" да се приложи стойността (напр. по идентификатори или кодове)"

