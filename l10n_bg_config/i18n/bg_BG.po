#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid ""
"<code>&lt;configuration&gt;\n"
"    &lt;settings&gt;\n"
"        &lt;setting model=\"account.account.tag\" "
"field=\"l10n_bg_applicability\" value=\"sale\"&gt;\n"
"            -11,+11,-12_1,-12_2,+12_1,+12_2,-13,+13,-14,+14,-15,+15,-16,"
"+16,-17,+17,-18,+18,-19,+19,-21,+21,-22,+22,-23,+23,-24,+24\n"
"        &lt;/setting&gt;\n"
"        &lt;setting model=\"account.account.tag\" "
"field=\"l10n_bg_applicability\" value=\"purchase\"&gt;\n"
"            -30,+30,-31,+31,-32,+32,-41,+41,-42,+42\n"
"        &lt;/setting&gt;\n"
"    &lt;/settings&gt;\n"
"&lt;/configuration&gt;\n"
"</code>"
msgstr ""
"<code>&lt;configuration&gt;\r\n"
"    &lt;settings&gt;\r\n"
"        &lt;setting model=\"account.account.tag\" "
"field=\"l10n_bg_applicability\" value=\"sale\"&gt;\r\n"
"            -11,+11,-12_1,-12_2,+12_1,+12_2,-13,+13,-14,+14,-15,+15,-16,"
"+16,-17,+17,-18,+18,-19,+19,-21,+21,-22,+22,-23,+23,-24,+24\r\n"
"        &lt;/setting&gt;\r\n"
"        &lt;setting model=\"account.account.tag\" "
"field=\"l10n_bg_applicability\" value=\"purchase\"&gt;\r\n"
"            -30,+30,-31,+31,-32,+32,-41,+41,-42,+42\r\n"
"        &lt;/setting&gt;\r\n"
"    &lt;/settings&gt;\r\n"
"&lt;/configuration&gt;\r\n"
"</code>"

#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid ""
"<strong>Text content</strong> – Filter indicating which records the value "
"should be applied to (e.g., by IDs or codes)"
msgstr ""
"<strong>Текстово съдържание</strong> - Филтър, указващ към кои записи трябва "
"да се приложи стойността (напр. по идентификатори или кодове)"

#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid "<strong>field</strong> – The field where the value will be written"
msgstr "<strong>field</strong> - Полето, в което ще бъде записана стойността"

#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid ""
"<strong>model</strong> – Odoo model where the records are located (e.g., "
"<code>account.account.tag</code>)"
msgstr ""
"<strong>model</strong> - модел на Odoo, в който се намират записите "
"(например <code>account.account.tag</code>)"

#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
msgid "<strong>value</strong> – The value that will be written to the field"
msgstr "<strong>value</strong> - Стойността, която ще бъде записана в полето"

#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_settings_xml_file_form
