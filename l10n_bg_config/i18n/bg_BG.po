#. module: l10n_bg_config
#: model_terms:ir.ui.view,arch_db:l10n_bg_config.view_account_plugins_wizard_form
msgid ""
"<b>Plugin Management</b><br/><br/>\n"
"                        Use this panel to <b>enable or disable plugins</b> that extend the system's functionality.<br/><br/>\n"
"                        ✔️ Use checkboxes to activate or deactivate specific plugins.<br/>\n"
"                        ✔️ Use the <b>force reload checkbox</b> if you've made changes to localization templates and want them to be applied immediately.<br/><br/>\n"
"                        <i>Note: Forcing a reload may take time on large databases.</i>"
msgstr ""
"<b>Управление на добавки</b><br/><br/>\n"
"                        Използвайте този панел, за да <b>активирате или деактивирате добавки</b>, които разширяват функционалността на системата.<br/><br/>\n"
"                        ✔️ Използвайте квадратчетата за отметка, за да активирате или деактивирате конкретни добавки.<br/>\n"
"                        ✔️ Използвайте <b>квадратчето за принудително презареждане</b>, ако сте направили промени в шаблоните за локализация и искате те да бъдат приложени незабавно.<br/><br/>\n"
"                        <i>Забележка: Принудителното презареждане може да отнеме време при големи бази данни.</i>"

