<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Добавяне на тарифни полета в invoice_line_ids list view -->
            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                <field name="l10n_bg_tariff_code" optional="hide" readonly="parent.state != 'draft'"/>
                <field name="l10n_bg_tariff_rate" optional="hide" readonly="parent.state != 'draft'" widget="percentage"/>
            </xpath>

            <!-- Добавяне на тарифни полета в invoice_line_ids form view -->
            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/form//group[last()]" position="after">
                <group string="Customs &amp; Tariff Information">
                    <field name="l10n_bg_tariff_code"/>
                    <field name="l10n_bg_tariff_rate" widget="percentage"/>
                    <field name="l10n_bg_tariff_description" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="l10n_bg_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_ledger.l10n_bg_move_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='l10n_bg_documents']"
                position="inside"
            >
                <field name="l10n_bg_deal_date"/>
            </xpath>
        </field>
    </record>
</odoo>
