<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_bg</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group name="l10n_bg_registers" string="Bulgaria settings">
                    <field name="l10n_bg_uic" readonly="0" />
                    <field name="l10n_bg_uic_type" readonly="0" />
                    <field name="l10n_bg_represent_contact_id" />
                    <field name="l10n_bg_departament_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
