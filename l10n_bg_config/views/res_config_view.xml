<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="45" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="is_l10n_bg_record" invisible="1" />
                <field
                    name="country_code"
                    invisible="1"
                    groups="account.group_account_manager"
                />
                <field
                    name="l10n_bg_config_template"
                    invisible="1"
                />

                <app
                    data-string="Bulgaria Localization"
                    string="Bulgaria Localization"
                    name="l10n_bg_config"
                    groups="account.group_account_manager"
                    invisible="country_code != 'BG'"
                >
                    <block
                        title="Settings"
                        name="l10n_bg_config_settings"
                        groups="base.group_no_one"
                    >
                        <setting
                            id="l10n_bg_config_setting_params"
                            title="Bulgaria settings"
                            string="Bulgaria settings"
                            help="Theatrical section for settings"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_config_is_l10n_bg_setting_container"
                            >
                                <div class="d-flex">
                                    <field name="is_l10n_bg_record" class="ml16" />
                                    <label
                                        for="is_l10n_bg_record"
                                        class="o_light_label"
                                    />
                                </div>
                                <div class="mt16">
                                    <div class="row">
                                        <label for="is_l10n_bg_multilanguage_text" string="Multilanguage Modules" class="col-lg-3 o_light_label" />
                                        <div class="col-lg-9">
                                            <field name="is_l10n_bg_multilanguage_text"
                                                   widget="text"
                                                   readonly="1"
                                                   nolabel="1"
                                                   style="font-family: monospace; white-space: pre-wrap;" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_config_setting_api"
                            title="API key for external functionality"
                            string="API key for external functionality"
                            help="Enter API Key to use additional functionality related to the Bulgaria localization. For more information contact with developer."
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_config_is_l10n_bg_setting_api_container"
                            >
                                <div class="d-flex">
                                    <field name="l10n_bg_key" class="ml16" />
                                    <label
                                        for="l10n_bg_key"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_config_setting_config_params"
                            title="Configuration file settings"
                            string="Configuration file settings"
                            help="Use configuration files to set up different Odoo parameters. For example, changing tags, their configuration. Adding new tags, etc."
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_config_is_l10n_bg_setting_container"
                            >
                                <button name="%(l10n_bg_config.action_account_account_settings_xml_file)d"
                                    string="Upload configuration file"
                                    type="action"
                                    class="oe_highlight"/>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_config_setting_preview_params"
                            title="Preview file settings"
                            string="Preview file settings"
                            help="Preview configuration setting uploaded in system by configuration files."
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_config_is_l10n_bg_setting_preview_container"
                            >
                                <button name="%(l10n_bg_config.action_account_settings_xml_file)d"
                                    string="Preview configuration settings"
                                    type="action"
                                    class="oe_highlight"/>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_config_setting_plugins_params"
                            title="Install/Uninstall Plugins"
                            string="Install/Uninstall Plugins"
                            help="Choose actions for each plugin through the appropriate checkerboards."
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_config_is_l10n_bg_setting_plugins_container"
                            >
                                <button name="%(l10n_bg_config.action_account_plugins_wizard)d"
                                    string="Config Plugins"
                                    type="action"
                                    class="oe_highlight"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Multilang cyrillic support" name="l10n_bg_multilang">
                        <setting
                            id="l10n_bg_partner_multilang_modules"
                            title="Partner multilang"
                            string="Partner multilang"
                            help="Multilang support for partner names and more"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_partner_multilang_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_partner_multilang"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_partner_multilang"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_multilang_modules"
                            title="Other multilang"
                            string="Other multilang"
                            help="Multilang support for other fields"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_other_multilang_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_l10n_bg_multilang"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_l10n_bg_multilang"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Report forms" name="l10n_bg_report_forms">
                        <setting
                            id="l10n_bg_report_forms_modules"
                            title="Report printing forms"
                            string="Report printing forms"
                            help="Reform the reports forms support for Bulgaria"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_report_forms_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_l10n_bg_report_theme"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_l10n_bg_report_theme"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_reports_audit_modules"
                            title="Report audit for tax administration base"
                            string="Report audit for tax administration base"
                            help="The module provides support for financial and tax reporting in compliance with Bulgarian legislation."
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_reports_audit_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_l10n_bg_reports_audit"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_l10n_bg_reports_audit"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_report_vat_modules"
                            title="VAT Report for tax administration (OCA))"
                            string="VAT Report for tax administration (OCA)"
                            help="The module provides files export for VAT reporting in compliance with Bulgarian legislation base on OCA reports"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_report_vat_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_l10n_bg_report_vat"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_l10n_bg_report_vat"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_vat_reports_modules"
                            title="VAT Report for tax administration (EE))"
                            string="VAT Report for tax administration (EE)"
                            help="The module provides files export for VAT reporting in compliance with Bulgarian legislation base on EE reports"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_vat_reports_setting_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_l10n_bg_vat_reports"
                                        class="ml16"
                                        widget="upgrade_boolean"

                                    />
                                    <label
                                        for="module_l10n_bg_vat_reports"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Bank - modules" name="l10n_bg_bank">
                        <setting
                            id="l10n_bg_oca_bank_modules"
                            title="Bank related Modules"
                            string="Bank related Modules"
                            help="Will update daily from cron only if is checked Automatic Currency Rates (OCA) and you added a rate_provider"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_bank_setting_oca_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_currency_rate_update_bg_bnb"
                                        class="ml16"
                                    />
                                    <label
                                        for="module_currency_rate_update_bg_bnb"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_ee_bank_modules"
                            title="Bank currency download fix"
                            string="Bank currency download fix"
                            help="Fix coefficient in Automatic Currency Rates (EE)"
                        >
                            <div
                                class="content-group"
                                name="l10n_bg_bank_setting_ee_container"
                            >
                                <div class="d-flex">
                                    <field
                                        name="module_currency_rate_live_fix"
                                        class="ml16"
                                        widget="upgrade_boolean"
                                    />
                                    <label
                                        for="module_currency_rate_live_fix"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block
                        title="Partners &amp; Addresses"
                        id="l10n_bg_contact_setting_container"
                    >
                        <setting
                            id="l10n_bg_address_setting_container"
                            title="Extend address"
                            string="Extend address"
                            help="Extend address with Bulgaria localization."
                        >
                            <div class="d-flex">
                                <field
                                    name="module_l10n_bg_address_extended"
                                    class="ml16"
                                />
                                <label
                                    for="module_l10n_bg_address_extended"
                                    class="o_light_label"
                                />
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_city_setting_container"
                            title="Bulgarian cites"
                            string="Bulgarian cites"
                            help="Bulgaria cites, melisipalies, states..."
                        >
                            <div class="d-flex">
                                <field name="module_l10n_bg_city" class="ml16" />
                                <label
                                    for="module_l10n_bg_city"
                                    class="o_light_label"
                                />
                            </div>
                        </setting>
                        <setting
                            id="l10n_bg_tax_offices_setting_container"
                            title="National Revenue Agency"
                            string="National Revenue Agency"
                            help="National Revenue Agency departments, offices and head office."
                        >
                            <div class="d-flex">
                                <field name="module_l10n_bg_tax_offices" class="ml16" />
                                <label
                                    for="module_l10n_bg_tax_offices"
                                    class="o_light_label"
                                />
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
