<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Форма на визарда -->

    <record id="view_account_plugins_wizard_form" model="ir.ui.view">
        <field name="name">account.plugins.wizard.form</field>
        <field name="model">account.plugins.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage plugins">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Choose actions for each plugin through the appropriate checkerboards.
                    </div>
                    <group>
                        <field name="force_update"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <field name="plugin_line_ids">
                        <list create="false" delete="false" editable="bottom">
                            <field name="plugin_id" invisible="1"/>
                            <field name="name"/>
                            <field name="state"/>
                            <field name="to_install" invisible="state == 'installed'"/>
                            <field name="to_uninstall" invisible="state == 'uninstalled'"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_plugins_wizard" model="ir.actions.act_window">
        <field name="name">Manage Plugins</field>
        <field name="res_model">account.plugins.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_plugins_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
