<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_plugins_wizard_form" model="ir.ui.view">
        <field name="name">account.plugins.wizard.form</field>
        <field name="model">account.plugins.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p>
                        <b>Plugin Management</b><br/><br/>
                        Use this panel to <b>enable or disable plugins</b> that extend the system's functionality.<br/><br/>
                        ✔️ Use checkboxes to activate or deactivate specific plugins.<br/>
                        ✔️ Use the <b>force reload checkbox</b> if you've made changes to localization templates and want them to be applied immediately.<br/><br/>
                        <i>Note: Forcing a reload may take time on large databases.</i>
                    </p>
                    <group>
                        <field name="force_update"/>
                        <field name="company_id" invisible="1"/><!-- Technical field: used in domain/compute -->
                    </group>
                    <field name="plugin_line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="plugin_id" column_invisible="1" force_save="1"/><!-- Technical field: used in domain/compute -->
                            <field name="name"/>
                            <field name="state"/>
                            <field name="to_install" readonly="state == 'installed'"/>
                            <field name="to_uninstall" readonly="state == 'uninstalled'"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_apply"
                                string="Apply"
                                type="object"
                                class="btn-primary"/>
                        <button special="cancel"
                                string="Cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_plugins_wizard" model="ir.actions.act_window">
        <field name="name">Manage Plugins</field>
        <field name="res_model">account.plugins.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_plugins_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
