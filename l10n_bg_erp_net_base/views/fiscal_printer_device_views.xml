<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Минимален транспортен form за proxy устройство.
         Фискалните полета/бутони (Z/X/PLU) се добавят от
         l10n_bg_erp_net_fp чрез inherit_id на този form. -->
    <record id="view_fiscal_printer_device_base_form" model="ir.ui.view">
        <field name="name">fiscal.printer.device.base.form</field>
        <field name="model">fiscal.printer.device</field>
        <!-- По-нисък приоритет: когато l10n_bg_erp_net_fp е инсталиран,
             неговата фискална форма (с Z/X бутони) печели като default. -->
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="ErpNet.FP Device">
                <header>
                    <button name="action_check_connection" type="object"
                            string="Check connection" class="btn-primary"/>
                    <button name="action_request_status" type="object"
                            string="Request status"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Shop 1 proxy"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="host"/>
                            <field name="connection_mode"/>
                            <field name="printer_id" widget="printer_id_select"/>
                            <field name="ssl_verify"/>
                        </group>
                        <group string="Options">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="timeout"/>
                            <field name="retry_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Proxy status" invisible="connection_mode != 'proxy'">
                        <field name="proxy_connected"/>
                        <field name="proxy_printer_ok"/>
                        <field name="proxy_last_seen"/>
                        <field name="proxy_user_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fiscal_printer_device_base_tree" model="ir.ui.view">
        <field name="name">fiscal.printer.device.base.list</field>
        <field name="model">fiscal.printer.device</field>
        <field name="arch" type="xml">
            <list string="ErpNet.FP Devices">
                <field name="name"/>
                <field name="host"/>
                <field name="connection_mode"/>
                <field name="printer_id"/>
                <field name="proxy_connected" widget="boolean_toggle" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fiscal_printer_device_base_search" model="ir.ui.view">
        <field name="name">fiscal.printer.device.base.search</field>
        <field name="model">fiscal.printer.device</field>
        <field name="arch" type="xml">
            <search string="ErpNet.FP Devices">
                <field name="name"/>
                <field name="host"/>
                <field name="printer_id"/>
                <filter name="proxy" string="Browser Proxy"
                        domain="[('connection_mode','=','proxy')]"/>
                <filter name="direct" string="Direct"
                        domain="[('connection_mode','=','direct')]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fiscal_printer_device_base" model="ir.actions.act_window">
        <field name="name">ErpNet.FP Devices</field>
        <field name="res_model">fiscal.printer.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fiscal_printer_device_base_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an ErpNet.FP proxy device
            </p>
            <p>
                Point it at the Odoo.ErpNet.FP proxy host so the barcode
                reader / weighing scale consumers can reach the hardware.
            </p>
        </field>
    </record>

    <!-- Споделен root за ErpNet.FP — reader/scale плъговете закачат под него -->
    <menuitem id="menu_erpnet_base_root" name="ErpNet.FP"
              groups="base.group_system" sequence="95"/>
    <menuitem id="menu_erpnet_base_devices" name="Devices"
              parent="menu_erpnet_base_root"
              action="action_fiscal_printer_device_base" sequence="10"/>
    <menuitem id="menu_erpnet_base_config" name="Configuration"
              parent="menu_erpnet_base_root" sequence="90"/>

</odoo>
