<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Sequences used by the proxy-aware extensions.
        `noupdate="1"` so the next_number doesn't reset on module upgrade.
    -->

    <record id="seq_fiscal_plu" model="ir.sequence">
        <field name="name">Fiscal PLU number</field>
        <field name="code">fiscal.plu_sequence</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">0</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_fiscal_session" model="ir.sequence">
        <field name="name">Fiscal Session</field>
        <field name="code">fiscal.session.sequence</field>
        <field name="prefix">FP/%(year)s/</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
