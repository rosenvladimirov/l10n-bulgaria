{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "External POS mode telemetry — receipts/h, Z-report durations, push latency, discrepancy histogram. Data sourced from Odoo Postgres (pos_order, fiscal_session, fiscal_frame_log).",
  "editable": true,
  "graphTooltip": 0,
  "iteration": 1,
  "panels": [
    {
      "title": "Receipts per hour (last 24h)",
      "type": "timeseries",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "rawSql": "SELECT date_trunc('hour', date_order) AS time, COUNT(*) AS receipts FROM pos_order WHERE pos_reference LIKE 'FP/%' AND date_order >= NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Open fiscal sessions",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM fiscal_session WHERE state = 'open'",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        }
      }
    },
    {
      "title": "Force-closed (last 7d)",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) FROM fiscal_session WHERE state = 'closed_partial' AND closed_at >= NOW() - INTERVAL '7 days'",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      }
    },
    {
      "title": "Z-report duration distribution (last 7d)",
      "type": "histogram",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "rawSql": "SELECT EXTRACT(EPOCH FROM (closed_at - opened_at)) / 3600 AS hours FROM fiscal_session WHERE state = 'closed' AND closed_at >= NOW() - INTERVAL '7 days'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Discrepancy histogram (last 7d)",
      "type": "histogram",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "rawSql": "SELECT discrepancy FROM fiscal_session WHERE state IN ('closed', 'closed_partial') AND discrepancy IS NOT NULL AND closed_at >= NOW() - INTERVAL '7 days'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": -0.01},
              {"color": "red", "value": 0.01}
            ]
          }
        }
      }
    },
    {
      "title": "Frame-log push success rate (last 24h)",
      "type": "piechart",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "rawSql": "SELECT summary, COUNT(*) AS n FROM fiscal_frame_log WHERE direction = 'out' AND endpoint LIKE '%plu%' AND create_date >= NOW() - INTERVAL '24 hours' GROUP BY summary",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Top PLUs by sales velocity (last 7d)",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "${DS_ODOO_PG}"},
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 10},
      "targets": [
        {
          "rawSql": "SELECT pp.l10n_bg_fiscal_plu_number AS plu, pt.name AS product, SUM(pol.qty) AS qty FROM pos_order_line pol JOIN pos_order po ON po.id = pol.order_id JOIN product_product pp ON pp.id = pol.product_id JOIN product_template pt ON pt.id = pp.product_tmpl_id WHERE po.pos_reference LIKE 'FP/%' AND po.date_order >= NOW() - INTERVAL '7 days' GROUP BY 1,2 ORDER BY qty DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["odoo", "l10n-bg", "external-pos", "fiscal"],
