<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_bg_erp_net_fp.ExternalShift.LiveFeed">
        <div class="o_es_feed border rounded bg-white p-3 d-flex flex-column"
             style="width:24rem; overflow-y:auto;">
            <h5>Live device feed</h5>
            <p class="text-muted small mb-3">
                Phase 1 — real-time receipt poll every 5s.
                For now this panel is a placeholder.
            </p>
            <div t-if="props.shift" class="border-top pt-3 mt-2">
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Receipts</span>
                    <strong><t t-esc="props.shift.receipt_count"/></strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Sales total</span>
                    <strong>
                        <t t-esc="(props.shift.sales_total or 0).toFixed(2)"/>
                    </strong>
                </div>
                <div t-if="props.shift.opened_at"
                     class="d-flex justify-content-between mt-1">
                    <span class="text-muted small">Opened at</span>
                    <span class="small"><t t-esc="props.shift.opened_at"/></span>
                </div>
            </div>
            <div t-if="props.message"
                 class="alert alert-info mt-3 mb-0 small">
                <t t-esc="props.message"/>
            </div>
        </div>
    </t>

</templates>
