<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_bg_erp_net_fp.ExternalShift.ProductsGrid">
        <div class="o_es_products flex-grow-1 d-flex flex-column"
             style="overflow:hidden;">
            <div class="d-flex align-items-baseline mb-2">
                <h5 class="mb-0">Products &amp; PLU coverage</h5>
                <small class="ms-2 text-muted">
                    ✓ programmed · ⚠ stale · ✗ missing
                </small>
            </div>
            <div class="o_es_grid flex-grow-1"
                 style="overflow-y:auto;">
                <t t-if="props.loading">
                    <div class="text-center text-muted p-5">
                        Loading…
                    </div>
                </t>
                <t t-elif="!props.products.length">
                    <div class="text-center text-muted p-5">
                        No POS-enabled products to show.
                    </div>
                </t>
                <t t-else="">
                    <div class="d-flex flex-wrap gap-2">
                        <div t-foreach="props.products" t-as="p"
                             t-key="p.id"
                             class="o_es_card border rounded p-2 bg-white"
                             style="width:14rem;">
                            <div class="d-flex justify-content-between
                                        align-items-start">
                                <strong class="text-truncate"
                                        t-att-title="p.display_name"
                                        style="max-width:10rem;">
                                    <t t-esc="p.display_name"/>
                                </strong>
                                <span class="badge"
                                      t-att-class="badgeClass(p.plu_status)">
                                    <t t-esc="badgeGlyph(p.plu_status)"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <t t-if="p.default_code">
                                    [<t t-esc="p.default_code"/>]
                                </t>
                                <span class="float-end">
                                    <t t-esc="p.lst_price.toFixed(2)"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1"
                                 t-if="p.plu_label">
                                <t t-esc="p.plu_label"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
