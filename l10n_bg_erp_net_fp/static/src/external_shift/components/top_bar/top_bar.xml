<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_bg_erp_net_fp.ExternalShift.TopBar">
        <div class="o_es_topbar d-flex align-items-center bg-white
                    border-bottom px-3 py-2 gap-3 shadow-sm">
            <div class="o_es_branding d-flex flex-column">
                <strong>External Shift</strong>
                <small class="text-muted">cashier rings up sales on the device</small>
            </div>

            <div class="o_es_device-picker d-flex align-items-center gap-2">
                <label class="form-label mb-0 small text-muted">Device</label>
                <select class="form-select form-select-sm"
                        t-on-change="onDeviceChangeHandler"
                        t-att-disabled="props.shift ? 'disabled' : null"
                        style="min-width:18ch;">
                    <option t-foreach="props.devices" t-as="d" t-key="d.id"
                            t-att-value="d.id"
                            t-att-selected="d.id === props.deviceId ? 'selected' : null">
                        <t t-esc="d.name"/>
                    </option>
                </select>
            </div>

            <ShiftStatusBadge state="state"/>

            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-success"
                        t-on-click="props.onOpenShift"
                        t-att-disabled="!canOpen || props.busy.open ? 'disabled' : null">
                    <i class="fa fa-play me-1"/>
                    <t t-if="props.busy.open">Opening…</t>
                    <t t-else="">Open Shift</t>
                </button>
                <button class="btn btn-sm btn-warning"
                        t-on-click="props.onXReport"
                        t-att-disabled="!canFireReport || props.busy.x_report ? 'disabled' : null">
                    <t t-if="props.busy.x_report">…</t>
                    <t t-else="">X-Report</t>
                </button>
                <button class="btn btn-sm btn-warning"
                        t-on-click="props.onZReport"
                        t-att-disabled="!canFireReport || props.busy.z_report ? 'disabled' : null">
                    <t t-if="props.busy.z_report">…</t>
                    <t t-else="">Z-Report</t>
                </button>
                <button class="btn btn-sm btn-danger"
                        t-on-click="props.onCloseShift"
                        t-att-disabled="!canClose || props.busy.close ? 'disabled' : null">
                    <i class="fa fa-stop me-1"/>
                    <t t-if="props.busy.close">Closing…</t>
                    <t t-else="">Close Shift</t>
                </button>
                <button class="btn btn-sm btn-light"
                        t-on-click="props.onRefresh"
                        t-att-disabled="props.busy.refresh ? 'disabled' : null">
                    <i class="fa fa-refresh"/>
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        t-on-click="props.onClose"
                        title="Back to backend">
                    <i class="fa fa-times"/>
                </button>
            </div>
        </div>
    </t>

</templates>
