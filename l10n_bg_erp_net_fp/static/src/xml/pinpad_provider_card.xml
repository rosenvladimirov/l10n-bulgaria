<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- DatecsPay provider card logo: the core img path is
         /point_of_sale/static/img/providers/<sel>.png (core static, which
         we don't ship to). Redirect just our `datecs_pay` selection to the
         module-local logo; everything else keeps the core path. -->
    <t t-inherit="point_of_sale.PosPaymentProviderCards" t-inherit-mode="extension">
        <xpath expr="//img" position="attributes">
            <attribute name="t-att-src">provider.selection === 'datecs_pay' ? '/l10n_bg_erp_net_fp/static/img/datecs_pay.png' : '/point_of_sale/static/img/providers/' + provider.selection + '.png'</attribute>
        </xpath>
    </t>

</templates>
