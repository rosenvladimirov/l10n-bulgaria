<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_fiscal_printer_device_form" model="ir.ui.view">
        <field name="name">fiscal.printer.device.form</field>
        <field name="model">fiscal.printer.device</field>
        <field name="arch" type="xml">
            <form string="Fiscal Printer Device">
                <header>
                    <button name="action_test_z_report"
                            string="Test Z Report"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to generate a Z report?"/>
                    <button name="print_x_report"
                            string="X Report"
                            type="object"
                            class="btn-primary"/>
                    <button name="print_z_report"
                            string="Z Report"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to generate a Z report?"/>
                    <button name="get_printer_status"
                            string="Status"
                            type="object"/>
                    <button name="open_cash_drawer"
                            string="Open Drawer"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Device Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Settings">
                            <field name="host"/>
                            <field name="printer_id"/>
                            <field name="active"/>
                            <field name="ssl_verify"/>
                        </group>
                        <group string="Advanced Settings">
                            <field name="timeout"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Automation">
                        <group>
                            <field name="auto_z_report"/>
                            <field name="z_report_hour" invisible="not auto_z_report"/>
                            <field name="z_report_minute" invisible="not auto_z_report"/>
                            <field name="last_z_report" readonly="1"/>
                        </group>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View (Odoo 18) -->
    <record id="view_fiscal_printer_device_list" model="ir.ui.view">
        <field name="name">fiscal.printer.device.list</field>
        <field name="model">fiscal.printer.device</field>
        <field name="arch" type="xml">
            <list string="Fiscal Printer Devices">
                <field name="name"/>
                <field name="host"/>
                <field name="printer_id"/>
                <field name="active"/>
                <field name="last_z_report"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_fiscal_printer_device_search" model="ir.ui.view">
        <field name="name">fiscal.printer.device.search</field>
        <field name="model">fiscal.printer.device</field>
        <field name="arch" type="xml">
            <search string="Fiscal Printer Devices">
                <field name="name"/>
                <field name="host"/>
                <field name="printer_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Auto Z Report" name="auto_z" domain="[('auto_z_report', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fiscal_printer_device" model="ir.actions.act_window">
        <field name="name">Fiscal Printers</field>
        <field name="res_model">fiscal.printer.device</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_fiscal_printer_device_list"/>
        <field name="search_view_id" ref="view_fiscal_printer_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fiscal printer!
            </p>
            <p>
                Configure fiscal printers for your POS systems.
            </p>
        </field>
    </record>

    <menuitem id="menu_fiscal_printer_root"
          name="Fiscal Printers"
          action="action_fiscal_printer_device"
          parent="point_of_sale.menu_point_config_product"
          sequence="20"/>

    <menuitem id="menu_fiscal_printer_device"
              name="Configure"
              action="action_fiscal_printer_device"
              parent="menu_fiscal_printer_root"
              sequence="10"/>
</odoo>
