<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View (в Odoo 18 вече не е 'tree', а 'list') -->
    <record id="view_fiscal_printer_response_list" model="ir.ui.view">
        <field name="name">fiscal.printer.response.list</field>
        <field name="model">fiscal.printer.response</field>
        <field name="arch" type="xml">
            <list string="Printer Responses" create="false" edit="false">
                <field name="create_date"/>
                <field name="request_id"/>
                <field name="printer_id"/>
                <field name="success"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_fiscal_printer_response_form" model="ir.ui.view">
        <field name="name">fiscal.printer.response.form</field>
        <field name="model">fiscal.printer.response</field>
        <field name="arch" type="xml">
            <form string="Printer Response" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="printer_id"/>
                            <field name="success"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="error_message" invisible="not success"/>
                        </group>
                    </group>
                    <group string="Response Data" invisible="not success">
                        <field name="response_data" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fiscal_printer_response" model="ir.actions.act_window">
        <field name="name">Printer Responses</field>
        <field name="res_model">fiscal.printer.response</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No printer responses found
            </p>
            <p>
                This view shows responses from client-side printer requests.
                Records are automatically deleted after 1 hour.
            </p>
        </field>
    </record>

</odoo>
