<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Fiscal Printer Status List View (Odoo 18) -->
        <record id="view_fiscal_printer_status_list" model="ir.ui.view">
            <field name="name">fiscal.printer.status.list</field>
            <field name="model">fiscal.printer.status</field>
            <field name="arch" type="xml">
                <list string="Status History">
                    <field name="create_date"/>
                    <field name="printer_id"/>
                    <field name="status"/>
                    <field name="error_message"/>
                    <field name="is_ready"/>
                    <field name="paper_available"/>
                    <field name="document_number"/>
                </list>
            </field>
        </record>

        <!-- Fiscal Printer Status Form View -->
        <record id="view_fiscal_printer_status_form" model="ir.ui.view">
            <field name="name">fiscal.printer.status.form</field>
            <field name="model">fiscal.printer.status</field>
            <field name="arch" type="xml">
                <form string="Fiscal Printer Status">
                    <sheet>
                        <group>
                            <group>
                                <field name="printer_id"/>
                                <field name="create_date" readonly="1"/>
                                <field name="status"/>
                                <field name="error_message"/>
                            </group>
                            <group>
                                <field name="is_ready"/>
                                <field name="paper_available"/>
                                <field name="fiscal_memory_available"/>
                                <field name="document_number"/>
                                <field name="serial_number"/>
                                <field name="firmware_version"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_fiscal_printer_status" model="ir.actions.act_window">
            <field name="name">Status History</field>
            <field name="res_model">fiscal.printer.status</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Submenu: Status History -->
        <menuitem id="menu_fiscal_printer_status"
                  name="Status History"
                  parent="menu_fiscal_printer_root"
                  action="action_fiscal_printer_status"
                  sequence="20"/>
    </data>
</odoo>
