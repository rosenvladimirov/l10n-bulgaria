<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- l10n.bg.fiscal.shift.receipt — read-only audit view -->

    <record id="view_l10n_bg_fiscal_shift_receipt_tree" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.shift.receipt.tree</field>
        <field name="model">l10n.bg.fiscal.shift.receipt</field>
        <field name="arch" type="xml">
            <list string="Fiscal Receipts">
                <field name="receipt_number"/>
                <field name="issued_at"/>
                <field name="device_id" optional="show"/>
                <field name="shift_id"/>
                <field name="payment_kind"/>
                <field name="operator_code" optional="hide"/>
                <field name="operator_user_id" optional="show"/>
                <field name="total_amount" widget="monetary" sum="Total"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_bg_fiscal_shift_receipt_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.shift.receipt.form</field>
        <field name="model">l10n.bg.fiscal.shift.receipt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="receipt_number" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="device_id"/>
                            <field name="issued_at"/>
                            <field name="operator_code"/>
                            <field name="operator_user_id"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                            <field name="payment_kind"/>
                            <field name="account_move_id"
                                   invisible="not account_move_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="plu_number"/>
                                    <field name="plu_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"
                                           widget="monetary"/>
                                    <field name="line_total"
                                           widget="monetary" sum="Total"/>
                                    <field name="vat_letter"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw Payload" name="raw_payload">
                            <field name="raw_payload" readonly="1"
                                   widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fiscal_shift_receipt"
            model="ir.actions.act_window">
        <field name="name">Fiscal Receipts</field>
        <field name="res_model">l10n.bg.fiscal.shift.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
