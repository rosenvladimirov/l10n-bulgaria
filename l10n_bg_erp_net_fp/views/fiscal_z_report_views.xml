<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fiscal_z_report_list" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.z.report.list</field>
        <field name="model">l10n.bg.fiscal.z.report</field>
        <field name="arch" type="xml">
            <list string="Z-reports"
                  decoration-success="reconcile_status == 'matched'"
                  decoration-warning="reconcile_status == 'no_device_totals'"
                  decoration-danger="reconcile_status in ('mismatch','error')">
                <field name="z_print_at"/>
                <field name="session_id"/>
                <field name="device_id"/>
                <field name="report_number"/>
                <field name="reconcile_status"/>
                <field name="device_returned_totals" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_bg_fiscal_z_report_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.z.report.form</field>
        <field name="model">l10n.bg.fiscal.z.report</field>
        <field name="arch" type="xml">
            <form string="Z-report">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="device_id"/>
                            <field name="report_number"/>
                            <field name="z_print_at"/>
                        </group>
                        <group>
                            <field name="reconcile_status"/>
                            <field name="device_returned_totals"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Device totals" name="device">
                            <field name="device_totals_json" widget="ace"
                                   options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Odoo aggregate" name="odoo">
                            <field name="odoo_totals_json" widget="ace"
                                   options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Reconcile diff" name="diff"
                              invisible="reconcile_status != 'mismatch'">
                            <field name="reconcile_diff_json" widget="ace"
                                   options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Raw messages" name="raw"
                              invisible="not raw_messages">
                            <field name="raw_messages" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fiscal_z_report" model="ir.actions.act_window">
        <field name="name">Z-reports</field>
        <field name="res_model">l10n.bg.fiscal.z.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Z-reports — moved under "Reporting" (POS Reports submenu) —
         this is a reporting function, not a top-level entry. -->
    <menuitem id="menu_l10n_bg_fiscal_z_report"
              name="Z-reports"
              parent="point_of_sale.menu_point_rep"
              action="action_l10n_bg_fiscal_z_report"
              sequence="50"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
