<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Client action — opens the embedded Grafana dashboard. The OWL
        component reads ir.config_parameter values and builds the
        iframe URL with kiosk + dark theme + auto-refresh.
    -->
    <record id="action_grafana_dashboard" model="ir.actions.client">
        <field name="name">ErpNet.FP Monitoring</field>
        <field name="tag">l10n_bg_erp_net_fp_grafana_dashboard</field>
        <field name="target">main</field>
    </record>

    <!--
        Menu under the existing ErpNet.FP root menu (defined in
        views/menu_items.xml). Visible only to users with POS-manager
        rights — operators don't need a metrics view.
    -->
    <menuitem id="menu_grafana_dashboard"
              name="Monitoring"
              parent="l10n_bg_erp_net_fp.menu_fiscal_printer_root"
              action="action_grafana_dashboard"
              sequence="90"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
