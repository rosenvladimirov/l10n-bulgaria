<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Extend native iot.box form with the connection_mode + ErpNet.FP
        URL fields, plus a "Discover ErpNet.FP devices" header button.
        Visible only when the box is connected to an ErpNet.FP instance
        — i.e. the user has opted into our overlay.

        The action record must come BEFORE the view record so that the
        `%(action_open_iot_discover_wizard)d` button reference resolves
        at parse time. Odoo's XML loader evaluates `%(name)d` lookups
        when it builds each record; forward references aren't resolved.
    -->

    <record id="action_open_iot_discover_wizard" model="ir.actions.act_window">
        <field name="name">Discover ErpNet.FP devices</field>
        <field name="res_model">iot.discover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="iot_box_form_inherit_erp_net_fp" model="ir.ui.view">
        <field name="name">iot.box.form.inherit.erp.net.fp</field>
        <field name="model">iot.box</field>
        <field name="inherit_id" ref="iot.iot_box_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="ErpNet.FP Integration"
                       name="erp_net_fp_group">
                    <field name="erp_net_fp_url"
                           placeholder="https://erp-net-fp.client.com"/>
                    <field name="erp_net_fp_ssl_verify"/>
                    <field name="connection_mode"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_open_iot_discover_wizard)d"
                            type="action"
                            string="Discover ErpNet.FP devices"
                            class="oe_highlight"
                            context="{'default_iot_box_id': active_id}"
                            invisible="not erp_net_fp_url"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
