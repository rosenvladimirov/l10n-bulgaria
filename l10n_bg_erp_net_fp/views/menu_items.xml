<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===========================================================
         External-shift cashier menus — collapsed under a single
         "External POS" submenu under POS root (daily-use).
         =========================================================== -->

    <!-- Sequence 5: slot between POS Dashboard (1) and the
         Orders/Products group (10) — Rosen prefers the External POS
         entry right under Dashboard since it's a daily-use action. -->
    <menuitem id="menu_external_pos_root"
              name="External POS"
              parent="point_of_sale.menu_point_root"
              sequence="5"
              groups="point_of_sale.group_pos_user"/>

    <!-- External Shifts kanban — primary cashier entry point -->
    <menuitem id="menu_l10n_bg_fiscal_shift"
              name="External Shifts"
              parent="menu_external_pos_root"
              action="action_l10n_bg_fiscal_shift"
              sequence="10"
              groups="point_of_sale.group_pos_user"/>

    <!-- Quick "New Shift" launcher → /external-shift -->
    <menuitem id="menu_external_shift_new"
              name="Open Shift Dashboard"
              parent="menu_external_pos_root"
              action="action_external_shift_dashboard_new"
              sequence="20"
              groups="point_of_sale.group_pos_user"/>

    <!-- ===========================================================
         Fiscal-printer settings — under POS → Configuration
         (manager / sysadmin work, not in daily cashier flow)
         =========================================================== -->

    <!-- Root grouping for fiscal-printer config inside POS Configuration -->
    <menuitem id="menu_fiscal_printer_root"
              name="Fiscal Printers"
              parent="point_of_sale.menu_point_config_product"
              sequence="80"/>

    <!-- Devices: list of fiscal printers / ECRs -->
    <menuitem id="menu_fiscal_printer_device"
              name="Devices"
              parent="menu_fiscal_printer_root"
              action="action_fiscal_printer_device"
              sequence="10"/>

    <!-- Past receipts (manager review) -->
    <menuitem id="menu_l10n_bg_fiscal_shift_receipt"
              name="Fiscal Receipts"
              parent="menu_fiscal_printer_root"
              action="action_l10n_bg_fiscal_shift_receipt"
              sequence="20"
              groups="point_of_sale.group_pos_manager"/>

    <!-- Debug-only: raw printer response audit.
         Action е преместен в l10n_bg_erp_net_base (транспортен слой). -->
    <menuitem id="menu_fiscal_printer_response"
              name="Printer Responses"
              parent="menu_fiscal_printer_root"
              action="l10n_bg_erp_net_base.action_fiscal_printer_response"
              groups="base.group_system"
              sequence="99"/>

</odoo>
