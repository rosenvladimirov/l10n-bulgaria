<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds menu entries for the new fiscal session + frame log models
        under the existing fiscal-printer menu (so admins find them
        next to the existing devices/responses lists).
    -->
    <menuitem id="menu_fiscal_session"
              name="Fiscal Sessions"
              parent="menu_fiscal_printer_root"
              action="action_fiscal_session"
              sequence="40"
              groups="point_of_sale.group_pos_manager"/>

    <menuitem id="menu_fiscal_frame_log"
              name="Frame Log"
              parent="menu_fiscal_printer_root"
              action="action_fiscal_frame_log"
              sequence="50"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
