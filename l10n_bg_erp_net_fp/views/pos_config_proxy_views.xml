<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherit-only — appends a settings group at the end of the
        existing pos.config form (which uses <setting> blocks, not
        a notebook). Original layout is preserved.
    -->
    <record id="view_pos_config_form_proxy" model="ir.ui.view">
        <field name="name">pos.config.form.proxy</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="row mt16 o_settings_container" id="l10n_bg_proxy_mode_container">
                    <setting string="External POS mode (BG)"
                             help="Sales are entered on the fiscal device itself; Odoo POS UI manages the shift / fiscal session lifecycle. PLU + logo + parameters are pushed to the device on POS open.">
                        <field name="l10n_bg_external_pos_mode"/>
                    </setting>
                    <setting string="Auto Z on POS close (BG)"
                             help="Automatically print a Z-report on the fiscal device when the POS session is closed.">
                        <field name="l10n_bg_auto_z_on_close"/>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
