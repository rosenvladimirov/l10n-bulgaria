<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Разширение на POS Config Form View -->
        <record id="pos_config_view_form_inherit_fiscal_printer" model="ir.ui.view">
            <field name="name">pos.config.form.inherit.fiscal.printer</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">

                <!-- Добавяме ErpNet.FP секция след IoT Box настройката -->
                <xpath expr="//setting[@id='other_devices']" position="after">
                    <setting id="erp_net_fp" string="Fiscal printer ErpNet.FP">
                        <field name="l10n_bg_fiscal_printer_id"/>
                        <div class="content-group mt16" invisible="not l10n_bg_fiscal_printer_id">
                            <div class="row">
                                <div class="col-lg-5 o_light_label">
                                    <label string="Automatic Z report on closing" for="l10n_bg_auto_z_on_close"/>
                                </div>
                                <div class="col-lg-7">
                                    <field name="l10n_bg_auto_z_on_close"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
