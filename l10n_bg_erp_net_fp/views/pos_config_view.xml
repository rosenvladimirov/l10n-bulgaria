<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_fiscal_printer" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.fiscal.printer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Опция 1: Добави след Payment Methods секцията -->
            <xpath expr="//div[contains(@class, 'o_setting_box') and .//field[@name='payment_method_ids']]" position="after">
                <h2>Fiscal printer</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="auto_fiscal_printing"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="auto_fiscal_printing"/>
                            <div class="text-muted">
                                Automatically print a fiscal voucher upon completion of an order
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="fiscal_printer_id"/>
                            <div class="content-group mt16">
                                <field name="fiscal_printer_id"
                                       options="{'no_create': True}"
                                       context="{'default_active': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
