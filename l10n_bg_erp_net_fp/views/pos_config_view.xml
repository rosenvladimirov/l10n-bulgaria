<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Разширение на POS Config Form View -->
        <record id="pos_config_view_form_inherit_fiscal_printer" model="ir.ui.view">
            <field name="name">pos.config.form.inherit.fiscal.printer</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">

                <!-- Добавяме ErpNet.FP секция в Devices страницата -->
                <xpath expr="//page[@name='devices']" position="inside">
                    <group string="Фискален принтер ErpNet.FP" name="fiscal_printer_group">
                        <field name="l10n_bg_fiscal_printer_id"/>
                        <field name="l10n_bg_auto_z_on_close"
                               invisible="not l10n_bg_fiscal_printer_id"/>
                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
