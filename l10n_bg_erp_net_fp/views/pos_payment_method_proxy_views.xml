<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_payment_method_form_proxy" model="ir.ui.view">
        <field name="name">pos.payment.method.form.proxy.pinpad</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Pinpad (Odoo.ErpNet.FP proxy)" name="pinpad">
                    <group>
                        <field name="l10n_bg_use_pinpad"/>
                        <field name="l10n_bg_pinpad_id" invisible="not l10n_bg_use_pinpad"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
