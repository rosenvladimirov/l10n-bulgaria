<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_payment_method_form_proxy" model="ir.ui.view">
        <field name="name">pos.payment.method.form.proxy.pinpad</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <!-- Pinpad selector + fiscal payment type live INSIDE the
                 Integration section, right after "Integrate with". -->
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="l10n_bg_pinpad_id" widget="pinpad_id_select"
                       string="Pinpad (Odoo.ErpNet.FP proxy)"
                       invisible="use_payment_terminal != 'datecs_pay'"/>
                <field name="l10n_bg_fiscal_payment_type"
                       string="Bulgarian fiscal type"/>
            </xpath>
        </field>
    </record>

</odoo>
