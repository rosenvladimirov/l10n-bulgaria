<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Разширение на POS Session Form -->
        <record id="view_pos_session_form_inherit_fiscal" model="ir.ui.view">
            <field name="name">pos.session.form.fiscal</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">

                <!-- Добавяне на бутони в header -->
                <xpath expr="//header" position="inside">
                    <button name="action_print_x_report"
                            string="X Report"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'opened' or not l10n_bg_fiscal_printer_id"/>
                    <button name="action_print_z_report"
                            string="Z Report"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ['opened', 'closing_control'] or l10n_bg_z_report_printed or not l10n_bg_fiscal_printer_id"
                            confirm="Z отчетът нулира дневните отчети. Продължи?"/>
                    <button name="action_fiscal_withdraw"
                            string="Officially removed"
                            type="object"
                            class="btn-info"
                            invisible="state != 'opened' or not l10n_bg_fiscal_printer_id"/>
                    <button name="action_fiscal_deposit"
                            string="Officially introduced"
                            type="object"
                            class="btn-info"
                            invisible="state != 'opened' or not l10n_bg_fiscal_printer_id"/>
                    <button name="action_l10n_bg_external_push_retry"
                            string="Retry external-mode push"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'opened' or l10n_bg_external_push_status == 'ok'"/>
                    <button name="action_l10n_bg_external_force_close"
                            string="Force-close (no device)"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'closing_control' or not l10n_bg_fiscal_session_ids"
                            confirm="Force-close marks the fiscal sessions as 'closed_partial' without contacting the devices. Use only if the device(s) are offline and reconcile manually later. Proceed?"/>
                </xpath>

                <!-- Добавяне на фискални полета -->
                <xpath expr="//sheet/group[1]" position="after">
                    <group string="Fiscal printer"
                           invisible="not l10n_bg_fiscal_printer_id"
                           name="fiscal_printer_info">
                        <field name="l10n_bg_fiscal_printer_id"/>
                        <field name="l10n_bg_last_x_report" readonly="1"/>
                        <field name="l10n_bg_z_report_printed" readonly="1"/>
                        <field name="l10n_bg_z_report_datetime" readonly="1"
                               invisible="not l10n_bg_z_report_printed"/>
                        <field name="l10n_bg_fiscal_session_ids" readonly="1"
                               invisible="not l10n_bg_fiscal_session_ids">
                            <list>
                                <field name="name"/>
                                <field name="device_id"/>
                                <field name="opened_at"/>
                                <field name="closed_at"/>
                                <field name="z_report_number"/>
                                <field name="z_total_amount"/>
                                <field name="discrepancy"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                        <field name="l10n_bg_external_push_status"
                               widget="badge"
                               readonly="1"
                               decoration-success="l10n_bg_external_push_status == 'ok'"
                               decoration-warning="l10n_bg_external_push_status == 'partial'"
                               decoration-danger="l10n_bg_external_push_status == 'error'"
                               decoration-muted="l10n_bg_external_push_status == 'none'"/>
                        <field name="l10n_bg_external_push_at" readonly="1"
                               invisible="l10n_bg_external_push_status == 'none'"/>
                        <field name="l10n_bg_external_push_summary" readonly="1"
                               invisible="l10n_bg_external_push_status == 'none'"
                               widget="text"/>
                    </group>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
