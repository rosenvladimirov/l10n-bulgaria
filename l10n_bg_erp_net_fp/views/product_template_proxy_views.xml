<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherit-only — adds a sub-group on the POS tab of product form.
        Original POS-tab content stays untouched.
    -->
    <record id="view_product_template_form_proxy_fiscal" model="ir.ui.view">
        <field name="name">product.template.form.proxy.fiscal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="Fiscal device (PLU)" name="fiscal_plu">
                    <group>
                        <field name="l10n_bg_fiscal_plu_number"/>
                        <field name="l10n_bg_fiscal_vat_group_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="l10n_bg_fiscal_vat_group"
                               readonly="1" string="VAT letter"/>
                        <field name="l10n_bg_fiscal_measurement_unit"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
