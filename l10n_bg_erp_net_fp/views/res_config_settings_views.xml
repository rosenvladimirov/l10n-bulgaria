<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Разширение на POS Config Settings - ErpNet.FP секция -->
        <record id="res_config_settings_view_form_inherit_fiscal_printer" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.fiscal.printer</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <!-- Добавяме ErpNet.FP настройка в блока "Connected Devices" -->
                <xpath expr="//block[@id='pos_connected_devices_section']/setting[@id='customer_display']" position="after">
                    <setting id="erp_net_fp_setting"
                             string="Fiscal Printer (ErpNet.FP)"
                             help="Bulgarian fiscal printer integration via ErpNet.FP"
                             documentation="/applications/sales/point_of_sale/configuration/fiscal_printer.html">
                        <field name="l10n_bg_fiscal_printer_id"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Select fiscal printer device..."/>
                        <div class="content-group mt16" invisible="not l10n_bg_fiscal_printer_id">
                            <div class="row">
                                <label string="Automatic Z Report on Session Close"
                                       for="l10n_bg_auto_z_on_close"
                                       class="col-lg-4 o_light_label"/>
                                <field name="l10n_bg_auto_z_on_close"/>
                            </div>
                            <div class="row mt8">
                                <div class="col-12">
                                    <div class="alert alert-info mb-0" role="alert">
                                        <i class="fa fa-info-circle"/>
                                        Fiscal printer will be used for receipt printing.
                                        X/Z reports will be printed automatically during session operations.
                                    </div>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="%(l10n_bg_erp_net_fp.action_fiscal_printer_device)d"
                                        icon="oi-arrow-right"
                                        type="action"
                                        string="Fiscal Printers"
                                        class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
