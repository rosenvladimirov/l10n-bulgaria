<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_erp_net_fp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.erp.net.fp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_other_devices']" position="after">
                <setting id="erp_net_fp" string="ErpNet.FP Printers" help="Connect device to your PoS by ErpNet.FP server">
                    <field name="auto_fiscal_printing"/>
                    <div class="content-group mt16">
                        <div class="row">
                            <div class="col-lg-4 o_light_label ps-4">
                                <label string="Printer Device" for="fiscal_printer_id"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="fiscal_printer_id"
                                       options="{'no_create': True}"
                                       context="{'default_active': True}"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
