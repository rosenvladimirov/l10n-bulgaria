<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds the per-cashier fiscal-printer credentials (operator code
        + 4-digit password) to the user form. Visible on:
          * Settings → Users
          * "My Profile" — every user can edit their own values
            without admin help (SELF_WRITEABLE_FIELDS extension on
            the model side allows this).
    -->
    <record id="view_users_form_inherit_l10n_bg_fp" model="ir.ui.view">
        <field name="name">res.users.form.inherit.l10n.bg.fp</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Bulgarian Fiscal Printer" name="l10n_bg_fp">
                    <group>
                        <group string="Operator credentials">
                            <field name="l10n_bg_fp_operator"
                                   placeholder="1"/>
                            <field name="l10n_bg_fp_operator_password"
                                   password="True"
                                   placeholder="0000"/>
                        </group>
                        <group string="Notes">
                            <div class="text-muted">
                                Sent in every fiscal-receipt request issued
                                by this user. Leave empty to fall back to
                                the ErpNet.FP server defaults
                                (operator=1, password=0000).
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- "My Profile" (form_simple) inherit removed — base view varies
         between Odoo minor releases and fails xpath in some setups. -->

</odoo>
