<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="iot_discover_wizard_form" model="ir.ui.view">
        <field name="name">iot.discover.wizard.form</field>
        <field name="model">iot.discover.wizard</field>
        <field name="arch" type="xml">
            <form string="Discover ErpNet.FP devices">
                <field name="state" invisible="1"/>
                <group>
                    <field name="iot_box_id"
                           options="{'no_create': True, 'no_open': True}"
                           readonly="state != 'draft'"/>
                </group>

                <div invisible="state != 'draft'" class="alert alert-info" role="alert">
                    Click <b>Scan</b> to query the ErpNet.FP instance for
                    its configured scales, displays, scanners, printers
                    and pinpads. You can then choose which ones to
                    register as iot.device records on this IoT Box.
                </div>

                <group invisible="state != 'scanned'" string="Discovered devices">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="kind"/>
                            <field name="device_id_in_proxy"/>
                            <field name="name_suggestion"/>
                            <field name="info_summary"/>
                            <field name="identifier"/>
                            <field name="already_exists" widget="boolean_toggle" readonly="1"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_scan" type="object"
                            string="Scan"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_devices" type="object"
                            string="Create selected devices"
                            class="btn-primary"
                            invisible="state != 'scanned'"/>
                    <button name="action_scan" type="object"
                            string="Re-scan"
                            class="btn-secondary"
                            invisible="state != 'scanned'"/>
                    <button special="cancel" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
