<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fiscal_plu_allocate_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.plu.allocate.wizard.form</field>
        <field name="model">l10n.bg.fiscal.plu.allocate.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Fiscal PLUs">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="source_pricelist_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="skip_existing"/>
                            <field name="auto_validate"/>
                        </group>
                    </group>
                    <group string="Products">
                        <field name="product_ids" nolabel="1">
                            <list>
                                <field name="default_code"/>
                                <field name="display_name"/>
                                <field name="barcode"/>
                                <field name="lst_price"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_allocate" type="object"
                            string="Allocate" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fiscal_plu_allocate" model="ir.actions.act_window">
        <field name="name">Add to fiscal PLU base</field>
        <field name="res_model">l10n.bg.fiscal.plu.allocate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_l10n_bg_fiscal_plu_allocate_template" model="ir.actions.act_window">
        <field name="name">Add to fiscal PLU base</field>
        <field name="res_model">l10n.bg.fiscal.plu.allocate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <menuitem id="menu_fiscal_plu_allocate"
              name="Import PLUs from Products"
              parent="point_of_sale.menu_point_config_product"
              action="action_l10n_bg_fiscal_plu_allocate"
              sequence="16"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
