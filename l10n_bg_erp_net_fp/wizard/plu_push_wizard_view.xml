<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fiscal_plu_push_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.plu.push.wizard.form</field>
        <field name="model">l10n.bg.fiscal.plu.push.wizard</field>
        <field name="arch" type="xml">
            <form string="Push PLUs to Fiscal Device(s)">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="scope" widget="radio"/>
                            <field name="dry_run"/>
                        </group>
                        <group>
                            <field name="device_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Selected PLUs"
                           invisible="scope != 'selected'">
                        <field name="plu_ids" nolabel="1">
                            <list>
                                <field name="plu_number"/>
                                <field name="name"/>
                                <field name="price"/>
                                <field name="vat_group_id"/>
                                <field name="push_state"
                                       decoration-success="push_state == 'pending'"
                                       decoration-info="push_state == 'pushed'"
                                       decoration-warning="push_state in ('stale', 'name_drift')"
                                       decoration-danger="push_state in ('conflict', 'error')"/>
                            </list>
                        </field>
                    </group>
                    <group string="Result"
                           invisible="not summary_html">
                        <field name="last_run_at" readonly="1"/>
                        <field name="summary_html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Run" class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Top-menu / standalone launcher -->
    <record id="action_l10n_bg_fiscal_plu_push" model="ir.actions.act_window">
        <field name="name">Push PLUs to device</field>
        <field name="res_model">l10n.bg.fiscal.plu.push.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Mass action on l10n.bg.fiscal.plu list view -->
    <record id="action_l10n_bg_fiscal_plu_push_binding" model="ir.actions.act_window">
        <field name="name">Push to device...</field>
        <field name="res_model">l10n.bg.fiscal.plu.push.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_l10n_bg_fiscal_plu"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
