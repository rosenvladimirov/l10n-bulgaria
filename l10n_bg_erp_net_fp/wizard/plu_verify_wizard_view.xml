<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fiscal_plu_verify_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.plu.verify.wizard.form</field>
        <field name="model">l10n.bg.fiscal.plu.verify.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify PLUs on devices">
                <p class="text-muted">
                    Re-reads each selected PLU from the chosen fiscal devices
                    and updates the per-device sync state (synced / stale /
                    missing). Leave "Devices" empty to verify on all linked
                    devices.
                </p>
                <group>
                    <field name="plu_ids" widget="many2many_tags"/>
                    <field name="device_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_verify" type="object"
                            string="Verify" class="btn-primary"/>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fiscal_plu_verify" model="ir.actions.act_window">
        <field name="name">Verify on devices</field>
        <field name="res_model">l10n.bg.fiscal.plu.verify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_l10n_bg_fiscal_plu"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <menuitem id="menu_fiscal_plu_verify"
              name="Verify PLUs on devices"
              parent="l10n_bg_erp_net_fp.menu_fiscal_plu_root"
              action="action_l10n_bg_fiscal_plu_verify"
              sequence="40"
              groups="point_of_sale.group_pos_manager"/>

</odoo>
