<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fiscal_x_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.fiscal.x_report.wizard.form</field>
        <field name="model">l10n.bg.fiscal.x_report.wizard</field>
        <field name="arch" type="xml">
            <form string="X-report (mid-shift)">
                <sheet>
                    <group>
                        <field name="pos_session_id" readonly="1"
                               invisible="not pos_session_id"/>
                        <field name="device_id"
                               options="{'no_create': True}"/>
                        <field name="allowed_device_ids" invisible="1"/>
                    </group>
                    <group string="Response" invisible="not has_response">
                        <field name="z_running_total" readonly="1"
                               class="o_text_overflow"/>
                        <field name="has_response" invisible="1"/>
                    </group>
                    <group invisible="not has_response">
                        <field name="response_text" nolabel="1"
                               widget="text" readonly="1"
                               class="font-monospace small"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Run X-report" class="btn-primary"/>
                    <button special="cancel" string="Close"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fiscal_x_report_wizard" model="ir.actions.act_window">
        <field name="name">X-report (mid-shift)</field>
        <field name="res_model">l10n.bg.fiscal.x_report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="point_of_sale.model_pos_session"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
