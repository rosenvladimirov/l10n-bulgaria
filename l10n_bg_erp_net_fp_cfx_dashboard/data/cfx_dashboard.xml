<odoo>

    <!-- Група "CFX Monitoring" в списъка с дашборди -->
    <record id="spreadsheet_dashboard_group_cfx" model="spreadsheet.dashboard.group">
        <field name="name">CFX Monitoring</field>
        <field name="sequence">450</field>
    </record>

    <!-- PARMI инспекции като time-series графики (odoo_line/bar по event_time:day) -->
    <record id="spreadsheet_dashboard_cfx_parmi" model="spreadsheet.dashboard">
        <field name="name">CFX PARMI Tests</field>
        <field name="spreadsheet_binary_data" type="base64"
                file="l10n_bg_erp_net_fp_cfx_dashboard/data/files/cfx_parmi_tests_dashboard.json"/>
        <field name="main_data_model_ids"
                eval="[(4, ref('l10n_bg_erp_net_fp_plugin_cfx.model_cfx_machine_stat'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_cfx"/>
        <field name="sequence">120</field>
        <field name="is_published">True</field>
    </record>

    <!-- Europlacer SMT placement като time-series графики -->
    <record id="spreadsheet_dashboard_cfx_europlacer" model="spreadsheet.dashboard">
        <field name="name">CFX Europlacer Tests</field>
        <field name="spreadsheet_binary_data" type="base64"
                file="l10n_bg_erp_net_fp_cfx_dashboard/data/files/cfx_europlacer_tests_dashboard.json"/>
        <field name="main_data_model_ids"
                eval="[(4, ref('l10n_bg_erp_net_fp_plugin_cfx.model_cfx_machine_stat'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_cfx"/>
        <field name="sequence">130</field>
        <field name="is_published">True</field>
    </record>

</odoo>
