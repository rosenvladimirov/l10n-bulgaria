<odoo>

    <!-- Група "CFX Monitoring" в списъка с дашборди -->
    <record id="spreadsheet_dashboard_group_cfx" model="spreadsheet.dashboard.group">
        <field name="name">CFX Monitoring</field>
        <field name="sequence">450</field>
    </record>

    <!-- Дашбордът: pivot-и + списък над cfx.machine.stat. spreadsheet_data
         се зарежда от предварително генериран o-spreadsheet JSON. -->
    <record id="spreadsheet_dashboard_cfx_traffic" model="spreadsheet.dashboard">
        <field name="name">CFX Traffic Monitor</field>
        <field name="spreadsheet_binary_data" type="base64"
                file="l10n_bg_erp_net_fp_cfx_dashboard/data/files/cfx_traffic_dashboard.json"/>
        <field name="main_data_model_ids"
                eval="[(4, ref('l10n_bg_erp_net_fp_plugin_cfx.model_cfx_machine_stat'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_cfx"/>
        <field name="sequence">100</field>
        <field name="is_published">True</field>
    </record>

    <!-- Отделен дашборд за инспекциите (AOI/SPI defects/units). o-spreadsheet
         dashboard readonly НЕ показва sheet-табове, затова вторият лист е
         самостоятелен dashboard запис вместо втори sheet. -->
    <record id="spreadsheet_dashboard_cfx_inspection" model="spreadsheet.dashboard">
        <field name="name">CFX Inspection Details</field>
        <field name="spreadsheet_binary_data" type="base64"
                file="l10n_bg_erp_net_fp_cfx_dashboard/data/files/cfx_inspection_dashboard.json"/>
        <field name="main_data_model_ids"
                eval="[(4, ref('l10n_bg_erp_net_fp_plugin_cfx.model_cfx_inspection_defect'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_cfx"/>
        <field name="sequence">110</field>
        <field name="is_published">True</field>
    </record>

    <!-- PARMI тестове като time-series графики (odoo_line/bar по event_time:day) -->
    <record id="spreadsheet_dashboard_cfx_parmi" model="spreadsheet.dashboard">
        <field name="name">CFX PARMI Tests</field>
        <field name="spreadsheet_binary_data" type="base64"
                file="l10n_bg_erp_net_fp_cfx_dashboard/data/files/cfx_parmi_tests_dashboard.json"/>
        <field name="main_data_model_ids"
                eval="[(4, ref('l10n_bg_erp_net_fp_plugin_cfx.model_cfx_machine_stat'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_cfx"/>
        <field name="sequence">120</field>
        <field name="is_published">True</field>
    </record>

</odoo>
