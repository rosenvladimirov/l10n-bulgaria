<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- The Fernet key is generated lazily on first encrypt/decrypt;
         the placeholder below documents its name and restricts visibility. -->
    <data noupdate="1">
        <record id="fernet_key_param_doc" model="ir.config_parameter">
            <field name="key">l10n_bg_erp_net_fp_fleet.fernet_key</field>
            <field name="value"></field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
