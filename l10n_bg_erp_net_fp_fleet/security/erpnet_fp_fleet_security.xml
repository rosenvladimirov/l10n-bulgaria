<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="module_category_erpnet_fp_fleet" model="ir.module.category">
            <field name="name">ErpNet.FP Fleet</field>
            <field name="description">Manage distributed ErpNet.FP fiscal-printer proxies.</field>
            <field name="sequence">95</field>
        </record>

        <!-- Odoo 18: res.groups носи category_id директно. Odoo 19 разделя
             на res.groups.privilege — при port към 19 трябва да се възстанови
             privilege records и да се ползва privilege_id вместо category_id. -->
        <record id="group_fleet_user" model="res.groups">
            <field name="name">Fleet Viewer</field>
            <field name="category_id" ref="module_category_erpnet_fp_fleet"/>
            <field name="comment">Read-only access to the proxy fleet.</field>
        </record>

        <record id="group_fleet_manager" model="res.groups">
            <field name="name">Fleet Manager</field>
            <field name="category_id" ref="module_category_erpnet_fp_fleet"/>
            <field name="implied_ids" eval="[(4, ref('group_fleet_user'))]"/>
            <field name="comment">Generate pairing tokens, trigger updates, program VAT, view logs.</field>
        </record>
    </data>
</odoo>
