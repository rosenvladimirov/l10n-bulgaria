<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Kanban — grouped by kind, color by sync_status ─── -->
    <record id="view_erpnet_fp_proxy_config_template_kanban" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.kanban</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kind"
                    class="o_kanban_small_column"
                    sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="proxy_id"/>
                <field name="sync_status"/>
                <field name="last_pushed_at"/>
                <field name="active"/>
                <progressbar field="sync_status"
                             colors='{"in_sync":"success","out_of_sync":"warning","never":"muted"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="proxy_id"/>
                                    </div>
                                </div>
                                <div>
                                    <span t-if="record.sync_status.raw_value == 'in_sync'"
                                          class="badge text-bg-success">in sync</span>
                                    <span t-if="record.sync_status.raw_value == 'out_of_sync'"
                                          class="badge text-bg-warning">drift</span>
                                    <span t-if="record.sync_status.raw_value == 'never'"
                                          class="badge text-bg-secondary">never</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <small t-if="record.last_pushed_at.raw_value">
                                    Pushed <field name="last_pushed_at" widget="relative"/>
                                </small>
                                <small t-if="!record.last_pushed_at.raw_value" class="text-muted">
                                    Not pushed yet
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── List view ─── -->
    <record id="view_erpnet_fp_proxy_config_template_list" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.list</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <list string="Config Templates" sample="1"
                  decoration-success="sync_status == 'in_sync'"
                  decoration-warning="sync_status == 'out_of_sync'"
                  decoration-muted="sync_status == 'never'">
                <field name="sequence" widget="handle"/>
                <field name="proxy_id"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="sync_status"/>
                <field name="last_pushed_at"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ─── Form view ─── -->
    <record id="view_erpnet_fp_proxy_config_template_form" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.form</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <form string="Config Template">
                <header>
                    <button name="action_push_to_proxy" type="object"
                            string="Push to Proxy" class="btn-primary"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"
                            help="Enqueue this YAML as a push_config command on the proxy. The proxy atomically writes config.d/&lt;kind&gt;.yaml and hot-reloads only the affected registry."/>
                    <field name="sync_status" widget="statusbar"
                           statusbar_visible="never,in_sync,out_of_sync"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. parking-cameras"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="proxy_id"/>
                            <field name="kind"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Sync state">
                            <field name="last_pushed_at"/>
                            <field name="last_pushed_version"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="YAML" name="yaml">
                            <field name="yaml_text" widget="ace"
                                   options="{'mode': 'yaml'}"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Search view ─── -->
    <record id="view_erpnet_fp_proxy_config_template_search" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.search</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="proxy_id"/>
                <field name="kind"/>
                <filter string="MQTT"      name="k_mqtt"     domain="[('kind','=','mqtt')]"/>
                <filter string="Cameras"   name="k_cameras"  domain="[('kind','=','cameras')]"/>
                <filter string="Access"    name="k_access"   domain="[('kind','=','access')]"/>
                <filter string="Biometric" name="k_biometric" domain="[('kind','=','biometric')]"/>
                <separator/>
                <filter string="In sync"     name="f_sync"  domain="[('sync_status','=','in_sync')]"/>
                <filter string="Out of sync" name="f_drift" domain="[('sync_status','=','out_of_sync')]"/>
                <filter string="Never pushed" name="f_never" domain="[('sync_status','=','never')]"/>
                <separator/>
                <filter string="Archived" name="f_inactive"
                        domain="[('active','=',False)]"/>
                <group expand="1" string="Group by">
                    <filter string="Proxy" name="g_proxy" context="{'group_by': 'proxy_id'}"/>
                    <filter string="Kind"  name="g_kind"  context="{'group_by': 'kind'}"/>
                    <filter string="Sync status" name="g_sync"
                            context="{'group_by': 'sync_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ─── -->
    <record id="action_erpnet_fp_proxy_config_template" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">erpnet.fp.proxy.config.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id"
               ref="view_erpnet_fp_proxy_config_template_search"/>
        <field name="context">{'search_default_g_kind': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first config template
            </p>
            <p>
                Templates hold the <b>raw YAML</b> for one
                <code>config.d/&lt;kind&gt;.yaml</code> fragment on a proxy.
                Each template knows its <i>kind</i> (mqtt, cameras, access,
                biometric) and its owner proxy. Pushing a template enqueues
                a <code>push_config</code> command — the proxy atomically
                writes the fragment and hot-reloads only that registry,
                fiscal / POS stays untouched.
            </p>
        </field>
    </record>

</odoo>
