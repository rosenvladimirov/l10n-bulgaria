<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Kanban — grouped by kind, color by sync_status ─── -->
    <record id="view_erpnet_fp_proxy_config_template_kanban" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.kanban</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="kind"
                    class="o_kanban_small_column"
                    sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="proxy_id"/>
                <field name="sync_status"/>
                <field name="last_pushed_at"/>
                <field name="active"/>
                <templates>
                    <!-- Odoo 19 kanban uses <t t-name="card"> as the
                         single record template (renamed from
                         "kanban-box" in v18). The wrapper div is no
                         longer needed — the renderer wraps for us. -->
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    <field name="proxy_id"/>
                                </div>
                            </div>
                            <div>
                                <span t-if="record.sync_status.raw_value == 'in_sync'"
                                      class="badge text-bg-success">in sync</span>
                                <span t-if="record.sync_status.raw_value == 'out_of_sync'"
                                      class="badge text-bg-warning">drift</span>
                                <span t-if="record.sync_status.raw_value == 'never'"
                                      class="badge text-bg-secondary">never</span>
                            </div>
                        </div>
                        <div class="mt-2">
                            <small t-if="record.last_pushed_at.raw_value">
                                Pushed <field name="last_pushed_at" widget="relative"/>
                            </small>
                            <small t-if="!record.last_pushed_at.raw_value" class="text-muted">
                                Not pushed yet
                            </small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── List view ─── -->
    <record id="view_erpnet_fp_proxy_config_template_list" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.list</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <list string="Config Templates" sample="1"
                  decoration-success="sync_status == 'in_sync'"
                  decoration-warning="sync_status == 'out_of_sync'"
                  decoration-muted="sync_status == 'never'">
                <field name="sequence" widget="handle"/>
                <field name="proxy_id"/>
                <field name="kind"/>
                <field name="name"/>
                <field name="sync_status"/>
                <field name="last_pushed_at"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ─── Form view ─── -->
    <record id="view_erpnet_fp_proxy_config_template_form" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.config.template.form</field>
        <field name="model">erpnet.fp.proxy.config.template</field>
        <field name="arch" type="xml">
            <form string="Config Template">
                <header>
                    <button name="action_push_to_proxy" type="object"
                            string="Push to Proxy" class="btn-primary"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"
                            help="Enqueue this YAML as a push_config command on the proxy. The proxy atomically writes config.d/&lt;kind&gt;.yaml and hot-reloads only the affected registry."/>
                    <field name="sync_status" widget="statusbar"
                           statusbar_visible="never,in_sync,out_of_sync"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. parking-cameras"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="proxy_id"/>
                            <field name="kind"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Sync state">
                            <field name="last_pushed_at"/>
                            <field name="last_pushed_version"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="YAML" name="yaml">
                            <field name="yaml_text" widget="ace"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Action ─── (search view = Odoo default; we keep the action
         minimal so the install never trips a validation race against
         a freshly-added field that isn't yet schema-migrated.) -->
    <record id="action_erpnet_fp_proxy_config_template" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">erpnet.fp.proxy.config.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first config template
            </p>
            <p>
                Templates hold the <b>raw YAML</b> for one
                <code>config.d/&lt;kind&gt;.yaml</code> fragment on a proxy.
                Each template knows its <i>kind</i> (mqtt, cameras, access,
                biometric) and its owner proxy. Pushing a template enqueues
                a <code>push_config</code> command — the proxy atomically
                writes the fragment and hot-reloads only that registry,
                fiscal / POS stays untouched.
            </p>
        </field>
    </record>

</odoo>
