<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ─── List ────────────────────────────────────────────────── -->
    <record id="view_erpnet_fp_proxy_list" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.list</field>
        <field name="model">erpnet.fp.proxy</field>
        <field name="arch" type="xml">
            <list string="Fleet"
                  decoration-success="alive"
                  decoration-muted="state == 'archived'"
                  decoration-warning="state == 'pairing' and not alive"
                  decoration-danger="not alive and state == 'active'">
                <field name="name"/>
                <field name="state"/>
                <field name="version"/>
                <field name="host"/>
                <field name="url" optional="show"/>
                <field name="devices_summary" string="Devices"/>
                <field name="device_count" string="#" optional="show"/>
                <field name="pending_command_count" string="Pending" optional="show"/>
                <field name="last_seen"/>
                <field name="alive" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- ─── Kanban ──────────────────────────────────────────────── -->
    <record id="view_erpnet_fp_proxy_kanban" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.kanban</field>
        <field name="model">erpnet.fp.proxy</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="alive"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <span t-if="record.alive.raw_value" class="badge text-bg-success">alive</span>
                            <span t-else="" class="badge text-bg-danger">offline</span>
                        </div>
                        <div class="text-muted small">v<field name="version"/></div>
                        <div>Host: <field name="host"/></div>
                        <div>Devices: <field name="devices_summary"/></div>
                        <div class="text-muted small">Last seen: <field name="last_seen"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── Form ────────────────────────────────────────────────── -->
    <record id="view_erpnet_fp_proxy_form" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.form</field>
        <field name="model">erpnet.fp.proxy</field>
        <field name="arch" type="xml">
            <form string="ErpNet.FP Proxy">
                <header>
                    <button name="action_generate_pairing_token"
                            type="object"
                            string="Generate Pairing Token"
                            class="btn-primary"
                            invisible="state == 'archived'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"/>
                    <button name="action_self_update"
                            type="object"
                            string="Queue Self-update"
                            class="btn-secondary"
                            invisible="state != 'active'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"/>
                    <button name="action_view_logs"
                            type="object"
                            string="Queue: Fetch Logs"
                            invisible="state != 'active'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"/>
                    <button name="action_open_program_vat_wizard"
                            type="object"
                            string="Queue: Program VAT"
                            invisible="state != 'active'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"/>
                    <button name="action_reset_secret"
                            type="object"
                            string="Reset Secret"
                            confirm="Forget the registry secret + admin token? The proxy will need to re-pair."
                            invisible="state == 'draft'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"/>
                    <!-- Bulk push — kept on the header because it spans
                         all four AC fragments. The per-kind pushes are
                         smart-buttons in the box below. -->
                    <button name="action_push_config_all"
                            type="object"
                            string="Push All Config"
                            class="btn-secondary"
                            invisible="state != 'active'"
                            groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager"
                            help="Push every AC fragment (cameras/access/mqtt/biometric) whose source model is installed."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pairing,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Per-kind push smart buttons (G1). Soft-resolves
                             source model; UserError if the source module
                             isn't installed yet. -->
                        <button name="action_push_config_mqtt" type="object"
                                class="oe_stat_button" icon="fa-cloud-upload"
                                invisible="state != 'active'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Push</span>
                                <span class="o_stat_value">MQTT</span>
                            </div>
                        </button>
                        <button name="action_push_config_cameras" type="object"
                                class="oe_stat_button" icon="fa-video-camera"
                                invisible="state != 'active'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Push</span>
                                <span class="o_stat_value">Cameras</span>
                            </div>
                        </button>
                        <button name="action_push_config_access" type="object"
                                class="oe_stat_button" icon="fa-key"
                                invisible="state != 'active'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Push</span>
                                <span class="o_stat_value">Access</span>
                            </div>
                        </button>
                        <button name="action_push_config_biometric" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="state != 'active'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Push</span>
                                <span class="o_stat_value">Biometric</span>
                            </div>
                        </button>
                        <button name="action_open_config_templates"
                                type="object"
                                class="oe_stat_button" icon="fa-file-code-o"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_user">
                            <field name="config_template_count" widget="statinfo"
                                   string="Templates"/>
                        </button>
                        <button name="action_archive_proxy" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="state == 'archived'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <span>Archive</span>
                        </button>
                        <button name="action_unarchive_proxy" type="object"
                                class="oe_stat_button" icon="fa-undo"
                                invisible="state != 'archived'"
                                groups="l10n_bg_erp_net_fp_fleet.group_fleet_manager">
                            <span>Reactivate</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            invisible="state != 'archived'"/>
                    <widget name="web_ribbon" title="Alive"
                            bg_color="bg-success"
                            invisible="not alive or state != 'active'"/>
                    <widget name="web_ribbon" title="Offline"
                            bg_color="bg-warning"
                            invisible="alive or state != 'active'"/>
                    <div class="oe_title">
                        <label for="name" string="Proxy"/>
                        <h1><field name="name" placeholder="sofia-shop-1"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="url" placeholder="https://erpnet.shop1.lan.mcpworks.net"/>
                            <field name="host" readonly="1"/>
                            <field name="version" readonly="1"/>
                        </group>
                        <group string="Health">
                            <field name="last_seen" readonly="1"/>
                            <field name="alive" readonly="1"/>
                            <field name="devices_summary" readonly="1"/>
                            <field name="has_admin_token" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list decoration-muted="not active">
                                    <field name="kind"/>
                                    <field name="identifier"/>
                                    <field name="last_seen"/>
                                    <field name="first_seen" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commands" name="commands">
                            <field name="command_ids">
                                <list decoration-success="state == 'completed'"
                                      decoration-danger="state == 'failed'"
                                      decoration-warning="state in ('pending','sent')">
                                    <field name="create_date"/>
                                    <field name="kind"/>
                                    <field name="state"/>
                                    <field name="sent_at" optional="hide"/>
                                    <field name="completed_at" optional="show"/>
                                    <field name="summary"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="kind" readonly="1"/>
                                            <field name="state" readonly="1"/>
                                            <field name="create_date" readonly="1"/>
                                            <field name="sent_at" readonly="1"/>
                                            <field name="completed_at" readonly="1"/>
                                        </group>
                                        <group string="Payload">
                                            <field name="payload_json" widget="ace"
                                                   options="{'mode': 'json'}"
                                                   nolabel="1" readonly="1"/>
                                        </group>
                                        <group string="Result">
                                            <field name="result_json" widget="ace"
                                                   options="{'mode': 'json'}"
                                                   nolabel="1" readonly="1"
                                                   invisible="state != 'completed'"/>
                                            <field name="error" readonly="1"
                                                   invisible="state != 'failed'"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="CORS Origins" name="cors_origins">
                            <p class="text-muted">
                                Browser origins that may call this proxy via AJAX.
                                One origin per line — scheme + host
                                (+ optional <code>:port</code>), no path,
                                no trailing slash. Lines starting with
                                <code>#</code> are comments.
                            </p>
                            <p class="text-muted">
                                Pushed to the proxy on the next heartbeat
                                (≤ 60 s); proxy regenerates Traefik
                                <code>dynamic.yml</code> and the file watcher
                                hot-reloads CORS rules without restart.
                            </p>
                            <field name="cors_origins" nolabel="1"
                                   placeholder="https://my-odoo.example.com&#10;https://www.example.com&#10;# Comments allowed"/>
                        </page>
                        <page string="Pairing"
                              groups="base.group_system">
                            <group>
                                <field name="pairing_token" readonly="1"/>
                                <field name="pairing_expires" readonly="1"/>
                                <field name="registry_secret" readonly="1" password="True"/>
                            </group>
                            <p class="text-muted">
                                Default flow is zero-touch: set
                                <code>server.registry.enabled: true</code> and a stable
                                <code>name</code> in the proxy's
                                <code>config.yaml</code>, then restart. The proxy will
                                auto-enrol using its admin_token. Pairing tokens are
                                only needed for stricter setups.
                            </p>
                        </page>
                        <page string="Configuration drift" name="config_drift">
                            <div class="alert alert-info" role="alert">
                                SHA-256 versions reported by the proxy on its
                                last heartbeat. Compare with
                                <code>last_pushed_version</code> on the source
                                records (<i>MQTT Brokers</i>, <i>Camera Config</i>,
                                etc.) to see if the proxy is in sync. Empty rows
                                mean the proxy hasn't loaded a fragment for that
                                kind — usually because no <code>config.d/&lt;kind&gt;.yaml</code>
                                file exists yet.
                            </div>
                            <group>
                                <group string="AC fragment versions">
                                    <field name="runtime_mqtt_version" readonly="1"/>
                                    <field name="runtime_camera_version" readonly="1"/>
                                    <field name="runtime_access_version" readonly="1"/>
                                    <field name="runtime_biometric_version" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Raw heartbeat" name="raw"
                              groups="base.group_system">
                            <field name="devices_json" widget="ace"
                                   options="{'mode': 'json'}" readonly="1"/>
                            <separator string="Runtime config versions (raw)"/>
                            <field name="runtime_config_versions_json" widget="ace"
                                   options="{'mode': 'json'}" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Search ──────────────────────────────────────────────── -->
    <record id="view_erpnet_fp_proxy_search" model="ir.ui.view">
        <field name="name">erpnet.fp.proxy.search</field>
        <field name="model">erpnet.fp.proxy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="host"/>
                <field name="version"/>
                <filter string="Alive" name="alive" domain="[('alive', '=', True)]"/>
                <filter string="Offline"  name="offline" domain="[('alive', '=', False), ('state', '=', 'active')]"/>
                <filter string="Pairing"  name="pairing" domain="[('state', '=', 'pairing')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <group>
                    <filter string="State"   name="g_state"   context="{'group_by': 'state'}"/>
                    <filter string="Version" name="g_version" context="{'group_by': 'version'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ──────────────────────────────────────────────── -->
    <record id="action_erpnet_fp_proxy" model="ir.actions.act_window">
        <field name="name">Fleet</field>
        <field name="res_model">erpnet.fp.proxy</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_erpnet_fp_proxy_search"/>
        <field name="context">{'search_default_alive': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first ErpNet.FP proxy.
            </p>
            <p>
                Each shop running an ErpNet.FP proxy can heartbeat here. Click
                <b>New</b>, then <b>Generate Pairing Token</b> on the form to enrol it.
            </p>
        </field>
    </record>

</odoo>
