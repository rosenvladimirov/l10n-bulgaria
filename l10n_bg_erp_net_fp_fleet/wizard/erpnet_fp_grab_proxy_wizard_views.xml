<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Grab proxy wizard — emergency takeover using master rescue token. -->
    <record id="view_erpnet_fp_grab_proxy_wizard_form" model="ir.ui.view">
        <field name="name">erpnet.fp.grab.proxy.wizard.form</field>
        <field name="model">erpnet.fp.grab.proxy.wizard</field>
        <field name="arch" type="xml">
            <form string="Grab Proxy">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <h5><i class="fa fa-exclamation-triangle me-1"/>Emergency takeover</h5>
                        <p>
                            This sends the <b>master rescue token</b> (set under
                            <i>Settings → Technical → System Parameters →
                            erpnet_fp.rescue_token</i>) to the target proxy.
                            The proxy will <b>forget its existing pairing</b> and
                            re-enrol against the Fleet URL below on its next
                            heartbeat.
                        </p>
                        <p class="mb-0">
                            Use this only when the proxy is unreachable through
                            normal channels (operator turnover, lost admin
                            tokens, fleet URL migration). The rescue endpoint is
                            disabled by default — it works only if the proxy
                            was built/started with <code>ERPNET_FP_RESCUE_TOKEN</code>
                            set to a token matching this Odoo's stored value.
                        </p>
                    </div>

                    <group>
                        <group string="Target">
                            <field name="target_url"
                                   placeholder="https://erpnet.shop1.lan.mcpworks.net"/>
                            <field name="new_name"
                                   placeholder="e.g. sofia-shop-1 (optional)"/>
                            <field name="timeout"/>
                        </group>
                        <group string="New Fleet">
                            <field name="new_fleet_url"/>
                        </group>
                    </group>

                    <p class="text-muted small">
                        On success, the proxy clears its on-disk
                        <code>registry_secret</code> and auto-enrols against
                        the new Fleet URL. Watch the proxy list — the new
                        record should appear within 2 minutes.
                    </p>
                </sheet>
                <footer>
                    <button string="Grab Proxy" name="action_grab"
                            type="object" class="btn-danger"
                            confirm="Send the master rescue token to this proxy and force it to re-enrol? The proxy will lose its current pairing."/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_erpnet_fp_grab_proxy_wizard" model="ir.actions.act_window">
        <field name="name">Grab Proxy</field>
        <field name="res_model">erpnet.fp.grab.proxy.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
