<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend OCA's iot.communication.system form with ErpNet.FP
         server URL fields. -->
    <record id="view_iot_communication_system_form_erpnet"
            model="ir.ui.view">
        <field name="name">iot.communication.system.form.inherit.erpnet</field>
        <field name="model">iot.communication.system</field>
        <field name="inherit_id"
               ref="iot_oca.iot_communication_system_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="ErpNet.FP" name="erp_net_fp">
                    <field name="erp_net_fp_url"
                           placeholder="https://erpnet-fp.example.com"/>
                    <field name="erp_net_fp_ssl_verify"/>
                    <field name="fiscal_printer_device_id"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
