<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend OCA iot.device form with ErpNet.FP fields + a "Read
         weight" smoke-test button visible only for scales. -->
    <record id="view_iot_device_form_erpnet"
            model="ir.ui.view">
        <field name="name">iot.device.form.inherit.erpnet</field>
        <field name="model">iot.device</field>
        <field name="inherit_id" ref="iot_oca.iot_device_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="ErpNet.FP" name="erp_net_fp">
                    <field name="erp_net_fp_kind"/>
                    <field name="erp_net_fp_identifier"
                           placeholder="scale1 / printer.DT519823 / reader1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
