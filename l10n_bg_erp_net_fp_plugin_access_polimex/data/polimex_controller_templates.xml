<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ══════════════════════════════════════════════════════════════
         Polimex iCON family templates
         Каталог на known controller моделите → автоматизира parts setup.
         За commit: 5 най-чести модели; може да се разширят и в други
         data файлове чрез data inheritance.
         ══════════════════════════════════════════════════════════════ -->

    <!-- ── iCON110: 1 door / 1 reader / 1 magnet ────────────────────── -->
    <record id="template_icon110" model="polimex.controller.template">
        <field name="name">Polimex iCON110</field>
        <field name="code">icon110</field>
        <field name="sequence">10</field>
        <field name="doors">1</field>
        <field name="description">Entry-level 1-door controller. 1 magnet
            output + 1 reader (one-way only — typically external).
            За обикновени врати без необходимост от exit reader.</field>
    </record>
    <record id="template_icon110_l1" model="polimex.controller.template.line">
        <field name="template_id" ref="template_icon110"/>
        <field name="sequence">10</field>
        <field name="name">Magnet</field>
        <field name="kind">magnet</field>
        <field name="io_channel">1</field>
        <field name="access_suffix">_door</field>
    </record>
    <record id="template_icon110_l2" model="polimex.controller.template.line">
        <field name="template_id" ref="template_icon110"/>
        <field name="sequence">20</field>
        <field name="name">External reader</field>
        <field name="kind">reader</field>
        <field name="io_channel">1</field>
    </record>

