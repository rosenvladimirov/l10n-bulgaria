<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── template form / list ── -->
    <record id="view_polimex_template_list" model="ir.ui.view">
        <field name="name">polimex.controller.template.list</field>
        <field name="model">polimex.controller.template</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="doors"/>
                <field name="line_count" string="Parts"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_polimex_template_form" model="ir.ui.view">
        <field name="name">polimex.controller.template.form</field>
        <field name="model">polimex.controller.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Polimex iCON115"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="doors"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="image_url"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Описание на модела…"/>
                    <separator string="Parts (выкл BOM)"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="io_channel"/>
                            <field name="access_suffix"
                                   help="Само за outputs (magnet/strike/motor)."/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_polimex_template" model="ir.actions.act_window">
        <field name="name">Polimex Templates</field>
        <field name="res_model">polimex.controller.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── controller form extension: template_id + Apply button ── -->
    <record id="view_polimex_controller_form_template" model="ir.ui.view">
        <field name="name">polimex.controller.form.template</field>
        <field name="model">polimex.controller</field>
        <field name="inherit_id"
               ref="l10n_bg_erp_net_fp_plugin_access_polimex.view_polimex_controller_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_apply_template" type="object"
                        string="📋 Apply Hardware Template"
                        class="btn-secondary"
                        invisible="not hardware_template_id"
                        confirm="Това ще създаде parts от template-а
                                 (skip-вa съществуващи). Продължи?"/>
                <button name="action_create_virtual_access_controllers"
                        type="object"
                        string="🔗 Create Access Controllers"
                        class="btn-primary"
                        confirm="За всеки output (magnet/strike/motor)
                                 с access_id ще се създаде виртуален
                                 access.controller запис. Idempotent
                                 (skip-вa съществуващи). Продължи?"/>
            </xpath>
            <xpath expr="//field[@name='firmware']" position="after">
                <field name="hardware_template_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
