<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_polimex_controller_list" model="ir.ui.view">
        <field name="name">polimex.controller.list</field>
        <field name="model">polimex.controller</field>
        <field name="arch" type="xml">
            <list string="Polimex Controllers" sample="1">
                <field name="proxy_id"/>
                <field name="bus_id"/>
                <field name="name"/>
                <field name="host"/>
                <field name="mode"/>
                <field name="part_count" string="Parts"/>
                <field name="template_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_polimex_controller_kanban" model="ir.ui.view">
        <field name="name">polimex.controller.kanban</field>
        <field name="model">polimex.controller</field>
        <field name="arch" type="xml">
            <kanban default_group_by="proxy_id" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="bus_id"/>
                <field name="host"/>
                <field name="mode"/>
                <field name="part_count"/>
                <templates>
                    <t t-name="kanban-box"><div t-attf-class="oe_kanban_card oe_kanban_global_click">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    bus <field name="bus_id"/> · <field name="host"/>
                                </div>
                            </div>
                            <div>
                                <span class="badge text-bg-secondary">
                                    <field name="mode"/>
                                </span>
                            </div>
                        </div>
                        <div class="mt-2 small">
                            <i class="fa fa-cog me-1"/>
                            <field name="part_count"/> parts
                        </div>
                    </div></t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_polimex_controller_form" model="ir.ui.view">
        <field name="name">polimex.controller.form</field>
        <field name="model">polimex.controller</field>
        <field name="arch" type="xml">
            <form string="Polimex Controller">
                <header>
                    <button name="action_regenerate_yaml" type="object"
                            string="Regenerate YAML" class="btn-primary"
                            invisible="not template_id"
                            help="Rebuild the linked config template's yaml_text from this controller and any sibling controllers pointing at the same template."/>
                    <button name="action_open_template" type="object"
                            string="Open Template"
                            invisible="not template_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_parts" type="object"
                                class="oe_stat_button" icon="fa-cog">
                            <field name="part_count" widget="statinfo" string="Parts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Front Gate"/></h1>
                    </div>
                    <group>
                        <group string="Proxy + template">
                            <field name="proxy_id"/>
                            <field name="template_id"
                                   domain="[('kind','=','access'),('proxy_id','=',proxy_id)]"
                                   context="{'default_proxy_id': proxy_id, 'default_kind': 'access'}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Bridge">
                            <field name="host" placeholder="http://192.168.3.151"/>
                            <field name="sdk_user"/>
                            <field name="sdk_password" password="True"/>
                        </group>
                        <group string="RS-485 bus">
                            <field name="bus_id"/>
                            <field name="mode"/>
                            <field name="relay_ctrl"/>
                            <field name="firmware"/>
                        </group>
                        <group string="Behaviour">
                            <field name="pulse_seconds"/>
                            <field name="fail_secure"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parts" name="parts">
                            <field name="part_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="io_channel"/>
                                    <field name="access_id" optional="show"/>
                                    <field name="is_output" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_polimex_controller" model="ir.actions.act_window">
        <field name="name">Polimex Controllers</field>
        <field name="res_model">polimex.controller</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Polimex iCON controller
            </p>
            <p>
                One row = one controller on a Web Module's RS-485 bus.
                The controller hosts <i>parts</i> (magnet / reader / motor /
                sensor / button) which get translated into proxy
                <code>access.yaml</code> entries on
                <b>Regenerate YAML</b>.
            </p>
        </field>
    </record>

</odoo>
