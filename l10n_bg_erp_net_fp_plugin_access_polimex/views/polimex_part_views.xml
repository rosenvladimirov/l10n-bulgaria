<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_polimex_part_list" model="ir.ui.view">
        <field name="name">polimex.part.list</field>
        <field name="model">polimex.part</field>
        <field name="arch" type="xml">
            <list string="Polimex Parts" sample="1">
                <field name="controller_id"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="io_channel"/>
                <field name="access_id" optional="show"/>
                <field name="is_output" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_polimex_part_form" model="ir.ui.view">
        <field name="name">polimex.part.form</field>
        <field name="model">polimex.part</field>
        <field name="arch" type="xml">
            <form string="Polimex Part">
                <header>
                    <!-- Open / Deny — synchronous HTTP call to the
                         owning proxy. Visible only for output parts
                         (magnet/strike/motor). Reader / sensor / button
                         are inputs, no actuation. -->
                    <button name="action_open" type="object"
                            string="🔓 Open"
                            class="btn-primary"
                            invisible="not is_output"/>
                    <button name="action_deny" type="object"
                            string="🔒 Deny"
                            invisible="not is_output"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Front gate magnet"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="controller_id"/>
                            <field name="kind"/>
                            <field name="io_channel"/>
                            <field name="access_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_output"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_polimex_part" model="ir.actions.act_window">
        <field name="name">Polimex Parts</field>
        <field name="res_model">polimex.part</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
