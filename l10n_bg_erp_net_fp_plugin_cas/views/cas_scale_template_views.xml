<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cas_scale_template_list" model="ir.ui.view">
        <field name="name">cas.scale.template.list</field>
        <field name="model">cas.scale.template</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="driver"/>
                <field name="default_transport"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_cas_scale_template_form" model="ir.ui.view">
        <field name="name">cas.scale.template.form</field>
        <field name="model">cas.scale.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="driver"/>
                            <field name="default_transport"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cas_scale_template" model="ir.actions.act_window">
        <field name="name">CAS Scales Templates</field>
        <field name="res_model">cas.scale.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
