<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="template_europlacer" model="cfx.endpoint.template">
        <field name="name">Europlacer RC (SMT placement)</field>
        <field name="code">europlacer</field>
        <field name="sequence">10</field>
        <field name="machine_kind">europlacer</field>
        <field name="default_transport">broker</field>
        <field name="default_topics">WorkStarted MaterialsInstalled WorkCompleted StationStateChanged</field>
        <field name="description">Europlacer placement machine (RC). CFX
            traceability: WorkStarted/Completed → europlacer.trac header,
            MaterialsInstalled → europlacer.trac.line rows.</field>
    </record>

    <record id="template_parmi" model="cfx.endpoint.template">
        <field name="name">PARMI SPI / AOI (inspection)</field>
        <field name="code">parmi</field>
        <field name="sequence">20</field>
        <field name="machine_kind">parmi</field>
        <field name="default_transport">broker</field>
        <field name="default_topics">UnitsInspected StationStateChanged FaultOccurred</field>
        <field name="description">PARMI solder-paste inspection (SPI) and
            automated optical inspection (AOI). CFX inspection/measurement
            stats → cfx.machine.stat.</field>
    </record>

    <record id="template_oven" model="cfx.endpoint.template">
        <field name="name">Reflow oven (thermal profile)</field>
        <field name="code">oven</field>
        <field name="sequence">30</field>
        <field name="machine_kind">oven</field>
        <field name="default_transport">broker</field>
        <field name="default_topics">UnitsProcessed StationStateChanged</field>
        <field name="description">Reflow oven. CFX thermal-profile stats
            (peak temperature, zone offsets) → cfx.machine.stat.</field>
    </record>

    <record id="template_laser" model="cfx.endpoint.template">
        <field name="name">Laser (marking / cutting)</field>
        <field name="code">laser</field>
        <field name="sequence">40</field>
        <field name="machine_kind">laser</field>
        <field name="default_transport">p2p</field>
        <field name="default_topics">UnitsProcessed StationStateChanged</field>
        <field name="description">Laser marking / cutting station. CFX
            laser stats → cfx.machine.stat.</field>
    </record>

</odoo>
