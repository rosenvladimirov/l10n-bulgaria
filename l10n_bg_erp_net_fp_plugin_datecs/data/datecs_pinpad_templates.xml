<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="template_bluepad55" model="datecs.pinpad.template">
        <field name="name">Datecs BluePad-55 (ДП50)</field>
        <field name="code">bluepad55</field>
        <field name="sequence">10</field>
        <field name="driver">datecs.pinpad</field>
        <field name="default_transport">bluetooth</field>
        <field name="description">Pinpad terminal с BLE. NDA libdatecs_pinpad.so
            driver. Default port /dev/ttyACM0 ако serial. BLE bridge към
            PTY (memory: project_bluepad55_ble_bridge).</field>
    </record>

    <record id="template_dp50_serial" model="datecs.pinpad.template">
        <field name="name">Datecs DP50 (Serial)</field>
        <field name="code">dp50_serial</field>
        <field name="sequence">20</field>
        <field name="driver">datecs.pinpad</field>
        <field name="default_transport">serial</field>
        <field name="description">Pinpad direct serial connection (без BLE
            bridge). За кабелни setup-и.</field>
    </record>

</odoo>
