<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_datecs_printer_kanban" model="ir.ui.view">
        <field name="name">datecs.printer.kanban</field>
        <field name="model">datecs.printer</field>
        <field name="arch" type="xml">
            <kanban default_group_by="proxy_id" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="template_id"/>
                <field name="driver"/>
                <field name="transport"/>
                <field name="plu_mode"/>
                <field name="has_builtin_scanner"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>
                                    <i class="fa fa-print me-1 text-primary"/>
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    SN: <field name="serial_number"/>
                                </div>
                                <div t-if="record.template_id.raw_value" class="small">
                                    📋 <field name="template_id"/>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge text-bg-secondary">
                                    <field name="transport"/>
                                </span>
                                <div t-if="record.plu_mode.raw_value" class="small mt-1">
                                    <span class="badge text-bg-info">PLU</span>
                                </div>
                                <div t-if="record.has_builtin_scanner.raw_value" class="small mt-1">
                                    <i class="fa fa-barcode text-success" title="Built-in scanner"/>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <field name="driver"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_datecs_printer_list" model="ir.ui.view">
        <field name="name">datecs.printer.list</field>
        <field name="model">datecs.printer</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <header>
                    <button name="action_import_from_proxies" type="object"
                            string="📥 Import from Proxy" class="btn-primary"
                            confirm="Import all printers reported by registered proxies?"/>
                </header>
                <field name="name"/>
                <field name="template_id"/>
                <field name="proxy_id"/>
                <field name="serial_number"/>
                <field name="transport"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_datecs_printer_form" model="ir.ui.view">
        <field name="name">datecs.printer.form</field>
        <field name="model">datecs.printer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_template" type="object"
                            string="📋 Apply Template" class="btn-secondary"
                            invisible="not template_id"/>
                    <button name="action_compare_template" type="object"
                            string="🔍 Compare with Template" class="btn-secondary"
                            invisible="not template_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Front desk DP-150"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="proxy_id" options="{'no_create': True}"/>
                            <field name="serial_number"/>
                            <field name="firmware"/>
                            <field name="has_builtin_scanner"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Connection">
                            <field name="transport"/>
                            <field name="port" invisible="transport != 'serial'"/>
                            <field name="baudrate" invisible="transport != 'serial'"/>
                            <field name="network_host" invisible="transport != 'network'"/>
                            <field name="network_port" invisible="transport != 'network'"/>
                            <field name="bluetooth_address" invisible="transport != 'bluetooth'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Driver / Mode">
                            <field name="driver"/>
                            <field name="plu_mode"/>
                        </group>
                        <group string="Operator">
                            <field name="operator"/>
                            <field name="operator_password" password="True"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_datecs_printer" model="ir.actions.act_window">
        <field name="name">Datecs Printers</field>
        <field name="res_model">datecs.printer</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
