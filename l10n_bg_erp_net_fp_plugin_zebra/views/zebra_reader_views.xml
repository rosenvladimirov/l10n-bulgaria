<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zebra_reader_kanban" model="ir.ui.view">
        <field name="name">zebra.reader.kanban</field>
        <field name="model">zebra.reader</field>
        <field name="arch" type="xml">
            <kanban default_group_by="proxy_id" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="template_id"/>
                <field name="driver"/>
                <field name="transport"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <div>
                                <strong>
                                    <i class="fa fa-barcode me-1 text-primary"/>
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    SN: <field name="serial_number"/>
                                </div>
                                <div t-if="record.template_id.raw_value" class="small">
                                    📋 <field name="template_id"/>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge text-bg-secondary">
                                    <field name="transport"/>
                                </span>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <field name="driver"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_zebra_reader_list" model="ir.ui.view">
        <field name="name">zebra.reader.list</field>
        <field name="model">zebra.reader</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <header>
                    <button name="action_import_from_proxies" type="object"
                            string="📥 Import from Proxy" class="btn-primary"
                            confirm="Import readers matching Zebra/Symbol prefix from proxies?"/>
                </header>
                <field name="name"/>
                <field name="template_id"/>
                <field name="proxy_id"/>
                <field name="serial_number"/>
                <field name="transport"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_zebra_reader_form" model="ir.ui.view">
        <field name="name">zebra.reader.form</field>
        <field name="model">zebra.reader</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="proxy_id" options="{'no_create': True}"/>
                            <field name="serial_number"/>
                            <field name="firmware"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="transport"/>
                            <field name="port" invisible="transport != 'serial'"/>
                            <field name="baudrate" invisible="transport != 'serial'"/>
                            <field name="network_host" invisible="transport != 'network'"/>
                            <field name="network_port" invisible="transport != 'network'"/>
                            <field name="bluetooth_address" invisible="transport != 'bluetooth'"/>
                            <field name="driver"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_zebra_reader" model="ir.actions.act_window">
        <field name="name">Zebra / Symbol Scanners</field>
        <field name="res_model">zebra.reader</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
