<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Hourly cron that fires Z-reports on devices whose configured
        time matches now.hour AND now.minute. Runs frequently (every
        15 min) to give a 15-min window in which to catch the configured
        z_report_minute. The cron self-skips devices whose minute hasn't
        struck yet — see _cron_generate_z_reports().
    -->
    <record id="ir_cron_l10n_bg_fp_datecs_auto_z" model="ir.cron">
        <field name="name">Datecs PM: Auto Z-report</field>
        <field name="model_id" ref="model_l10n_bg_fp_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_z_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
