<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_l10n_bg_fp_datecs_plu" model="ir.sequence">
        <field name="name">Datecs PM PLU number</field>
        <field name="code">l10n_bg_fp_datecs.plu_sequence</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">0</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_l10n_bg_fp_datecs_session" model="ir.sequence">
        <field name="name">Datecs PM Fiscal Session</field>
        <field name="code">l10n_bg_fp_datecs.session_sequence</field>
        <field name="prefix">FP/%(year)s/</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">5</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
