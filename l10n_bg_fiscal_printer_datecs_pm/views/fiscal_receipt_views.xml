<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fp_receipt_tree" model="ir.ui.view">
        <field name="name">l10n.bg.fp.receipt.tree</field>
        <field name="model">l10n.bg.fp.receipt</field>
        <field name="arch" type="xml">
            <list string="Fiscal Receipts" decoration-success="state == 'closed'" decoration-danger="state == 'error'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="device_id"/>
                <field name="session_id"/>
                <field name="nsale"/>
                <field name="slip_number"/>
                <field name="is_invoice"/>
                <field name="opened_at"/>
                <field name="closed_at"/>
                <field name="total" sum="total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_bg_fp_receipt_form" model="ir.ui.view">
        <field name="name">l10n.bg.fp.receipt.form</field>
        <field name="model">l10n.bg.fp.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="session_id"/>
                            <field name="is_invoice"/>
                            <field name="nsale"/>
                            <field name="slip_number"/>
                        </group>
                        <group>
                            <field name="opened_at"/>
                            <field name="closed_at"/>
                            <field name="total"/>
                            <field name="currency_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Error" invisible="state != 'error'">
                        <field name="error_code"/>
                        <field name="error_message"/>
                    </group>
                    <notebook>
                        <page string="Frame log">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="direction"/>
                                    <field name="cmd"/>
                                    <field name="cmd_name"/>
                                    <field name="seq"/>
                                    <field name="data_repr"/>
                                    <field name="status_hex" optional="hide"/>
                                    <field name="error_code"/>
                                    <field name="raw_hex" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_fp_receipt" model="ir.actions.act_window">
        <field name="name">Fiscal Receipts</field>
        <field name="res_model">l10n.bg.fp.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
