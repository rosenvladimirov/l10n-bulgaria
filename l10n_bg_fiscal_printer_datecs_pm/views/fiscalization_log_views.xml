<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fp_frame_log_tree" model="ir.ui.view">
        <field name="name">l10n.bg.fp.frame.log.tree</field>
        <field name="model">l10n.bg.fp.frame.log</field>
        <field name="arch" type="xml">
            <list string="Frame Log" create="false" delete="false">
                <field name="timestamp"/>
                <field name="device_id"/>
                <field name="receipt_id"/>
                <field name="direction"/>
                <field name="cmd"/>
                <field name="cmd_name"/>
                <field name="seq"/>
                <field name="data_repr"/>
                <field name="error_code"/>
                <field name="status_hex" optional="hide"/>
                <field name="raw_hex" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_bg_fp_frame_log" model="ir.actions.act_window">
        <field name="name">Fiscal Frame Log</field>
        <field name="res_model">l10n.bg.fp.frame.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
