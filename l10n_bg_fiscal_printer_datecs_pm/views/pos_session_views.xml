<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_session_form_inherit_l10n_bg_fp_datecs" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.l10n_bg_fp_datecs</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_bg_fp_datecs_check_printer"
                        type="object"
                        string="Check Datecs printer"
                        invisible="not l10n_bg_fp_datecs_device_id"/>
                <button name="action_l10n_bg_fp_datecs_print_x_report"
                        type="object"
                        string="X report"
                        invisible="not l10n_bg_fp_datecs_device_id or state != 'opened'"/>
                <button name="action_l10n_bg_fp_datecs_print_z_report"
                        type="object"
                        string="Z report"
                        invisible="not l10n_bg_fp_datecs_device_id or l10n_bg_fp_datecs_z_report_printed"/>
                <button name="action_l10n_bg_fp_datecs_print_duplicate"
                        type="object"
                        string="Duplicate last receipt"
                        invisible="not l10n_bg_fp_datecs_device_id"/>
                <button name="action_l10n_bg_fp_datecs_cash_in"
                        type="object"
                        string="Cash in"
                        invisible="not l10n_bg_fp_datecs_device_id or state != 'opened'"/>
                <button name="action_l10n_bg_fp_datecs_cash_out"
                        type="object"
                        string="Cash out"
                        invisible="not l10n_bg_fp_datecs_device_id or state != 'opened'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Datecs PM" name="l10n_bg_fp_datecs"
                      invisible="not l10n_bg_fp_datecs_device_id">
                    <group>
                        <group>
                            <field name="l10n_bg_fp_datecs_device_id" readonly="1"/>
                            <field name="l10n_bg_fp_datecs_external_mode" readonly="1"/>
                            <field name="l10n_bg_fp_datecs_session_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_bg_fp_datecs_last_x_report" readonly="1"/>
                            <field name="l10n_bg_fp_datecs_z_report_printed" readonly="1"/>
                            <field name="l10n_bg_fp_datecs_z_report_datetime" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
