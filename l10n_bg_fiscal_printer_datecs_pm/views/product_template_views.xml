<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit_l10n_bg_fp_datecs" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n_bg_fp_datecs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="Datecs PM (касов апарат)" name="l10n_bg_fp_datecs">
                    <group>
                        <field name="l10n_bg_fp_datecs_plu_number"/>
                        <field name="l10n_bg_fp_datecs_vat_group"/>
                        <field name="l10n_bg_fp_datecs_measurement_unit"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
