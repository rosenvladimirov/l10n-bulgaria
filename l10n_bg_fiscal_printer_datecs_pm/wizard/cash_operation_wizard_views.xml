<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_bg_fp_datecs_cash_op_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.fp.datecs.cash.operation.wizard.form</field>
        <field name="model">l10n.bg.fp.datecs.cash.operation.wizard</field>
        <field name="arch" type="xml">
            <form string="Datecs PM cash operation">
                <sheet>
                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="device_id" readonly="1"/>
                        <field name="operation_type"/>
                        <field name="amount"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_execute" type="object" string="Execute" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
