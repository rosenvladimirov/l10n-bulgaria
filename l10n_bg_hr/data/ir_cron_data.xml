<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Активиране и изтичане вървят заедно и с еднаква периодичност:
             ако едното работи, а другото не, срочните ДС ще изтичат, без
             изобщо да са влизали в сила. -->
        <record id="cron_activate_due_amendments" model="ir.cron">
            <field name="name">BG: Activate Due Contract Amendments</field>
            <field name="model_id" ref="l10n_bg_hr.model_l10n_bg_hr_version_amendment"/>
            <field name="state">code</field>
            <field name="code">model.cron_activate_due_amendments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_expire_temporary_amendments" model="ir.cron">
            <field name="name">BG: Expire Temporary Contract Amendments</field>
            <field name="model_id" ref="l10n_bg_hr.model_l10n_bg_hr_version_amendment"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_temporary_amendments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
