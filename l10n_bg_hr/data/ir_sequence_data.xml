<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_l10n_bg_hr_version_amendment" model="ir.sequence">
            <field name="name">BG Contract Amendment</field>
            <field name="code">l10n_bg.hr.version.amendment</field>
            <field name="prefix">AMD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_l10n_bg_contract_number" model="ir.sequence">
            <field name="name">BG Labor Contract Number</field>
            <field name="code">l10n_bg.contract.number</field>
            <field name="prefix">ТД-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
            <field name="implementation">no_gap</field>
        </record>
    </data>
</odoo>
