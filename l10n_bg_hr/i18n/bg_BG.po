#, python-format
msgid ""
"Temporary assignments for %(emp)s in %(year)s would total %(total)d calendar"
" days. Art. 120, para. 1 LC allows 45 per calendar year, except during idle "
"time."
msgstr ""
"Временните премествания на %(emp)s през %(year)s биха станали общо %(total)d"
" календарни дни. Чл. 120, ал. 1 КТ допуска 45 за календарна година, освен "
"при престой."

#. module: l10n_bg_hr
#: model:ir.model.fields.selection,name:l10n_bg_hr.selection__hr_employee__l10n_bg_protection_status__temporary
msgid "Temporary Protection"
msgstr "Временна закрила"

#. module: l10n_bg_hr
#: model:ir.model.fields,field_description:l10n_bg_hr.field_hr_contract__l10n_bg_termination_order_date
