msgid ""
"<strong>Legal Note:</strong>\n"
"                                Art. 120, para. 1 LC: on production necessity or idle time the\n"
"                                employer may assign other work without the employee's consent — in\n"
"                                the same or another undertaking, but\n"
"                                <strong>within the same settlement or locality</strong>, for up to\n"
"                                <strong>45 calendar days per calendar year</strong>. During idle time\n"
"                                the assignment lasts as long as the idle time does.\n"
"                                Art. 267, para. 3 LC: the remuneration is that of the work performed,\n"
"                                but not lower than the gross remuneration for the main job."
msgstr ""

