<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Multi-company правило за допълнителни споразумения (l10n_bg.hr.version.amendment).
         Моделът има company_id поле, но без global rule всички споразумения
         са видими през компании. -->

    <record id="rule_l10n_bg_hr_version_amendment_multi_company" model="ir.rule">
        <field name="name">Allonge / Version Amendment: multi-company</field>
        <field name="model_id" ref="model_l10n_bg_hr_version_amendment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
