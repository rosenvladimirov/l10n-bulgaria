<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extended HR Contract Template Form View -->
    <record id="hr_contract_template_form_view_extended" model="ir.ui.view">
        <field name="name">hr.contract.template.form.extended</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add button_box for smart buttons -->
            <xpath expr="//div[@name='title']" position="before">
                <div name="button_box" class="oe_button_box"/>
            </xpath>

            <!-- Add location info in a top_info_right group -->
            <xpath expr="//group[@name='top_info_right']" position="inside">
                <field name="work_location_id" readonly="0" groups="!hr.group_hr_manager" options="{'no_open': True, 'no_create': True}"/>
                <field name="work_location_id" readonly="0" groups="hr.group_hr_manager"/>
                <field name="work_location" readonly="1"/>
            </xpath>

            <!-- Add NKPD/NKID fields after salary info -->
            <xpath expr="//group[@name='salary_info']" position="after">
                <group name="bg_position_info">
                    <group>
                        <div colspan="2"
                             class="col-lg-6 w-100 mt-4 mb-3 o_horizontal_separator text-uppercase fw-bolder small d-flex">
                            <span>NKPD / KID</span>
                            <button name="action_refresh_nkpd_kid"
                                    type="object"
                                    string="Refresh from Job Position"
                                    class="btn btn-link ms-auto text-end lh-1 h-100 p-0"
                                    invisible="not job_id"/>
                        </div>
                        <field name="l10n_bg_qualification_group" options="{'no_create_edit': True}"/>
                        <field name="l10n_bg_economic_activity_id" options="{'no_create_edit': True}"/>
                        <field name="l10n_bg_economic_activity_code" invisible="1"/>
                        <field name="l10n_bg_workplace_code"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
