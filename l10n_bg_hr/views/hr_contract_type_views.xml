<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Изнесено от l10n_bg_hr_payroll със същото xmlid. -->
    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="before">
                <field name="l10n_bg_contract_duration_type"/>
            </xpath>
        </field>
    </record>

    <!-- От 19 (DEF-172е): ядреното действие „Видове заетост“ отваря само
         списъка (редактируем на място) — без колоната номенклатурата не може
         да се попълни от екрана. -->
    <record id="hr_contract_type_view_tree" model="ir.ui.view">
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="before">
                <field name="l10n_bg_contract_duration_type"/>
            </xpath>
        </field>
    </record>
</odoo>
