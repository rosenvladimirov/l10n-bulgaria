<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- hr.employee form                                                   -->
    <!-- ================================================================== -->

    <!-- Smart Button -->
    <record id="view_employee_form_amendment_button" model="ir.ui.view">
        <field name="name">hr.employee.form.amendment.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(action_l10n_bg_hr_contract_amendment_from_employee)d"
                        context="{'default_employee_id': id}"
                        icon="fa-file-text-o">
                    <field string="Amendments" name="l10n_bg_amendment_count"
                           widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Група в Payroll таба, след Contract Overview — дата, описание, бутон -->
    <record id="view_employee_form_amendment_group" model="ir.ui.view">
        <field name="name">hr.employee.form.amendment.group</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='contract']" position="after">
                <group name="amendments" groups="hr.group_hr_user">
                    <div colspan="2"
                         class="col-lg-6 w-100 mt-4 mb-3 o_horizontal_separator text-uppercase fw-bolder small d-flex">
                        <span>Contract Amendments</span>
                        <button name="%(action_hr_version_amendment_wizard)d"
                                type="action"
                                string="New Amendment"
                                class="btn btn-link ms-auto text-end lh-1 h-100 p-0"
                                invisible="not version_id"/>
                    </div>
                    <field name="l10n_bg_last_amendment_date" string="Last Amendment"/>
                    <field name="l10n_bg_last_amendment_summary" string="Changes"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Page с пълния списък, веднага след Payroll -->
    <record id="view_employee_form_amendment_tab" model="ir.ui.view">
        <field name="name">hr.employee.form.amendment.tab</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='payroll_information']" position="after">
                <page string="Contract Amendments" name="amendments"
                      groups="hr.group_hr_manager">
                    <field name="l10n_bg_amendment_ids" readonly="1">
                        <list>
                            <field name="amendment_number"/>
                            <field name="version_id"/>
                            <field name="amendment_type"/>
                            <field name="subject"/>
                            <field name="date_signed"/>
                            <field name="date_effective"/>
                            <field name="old_wage" optional="hide"/>
                            <field name="new_wage" optional="hide"/>
                            <field name="state"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'to_approve'"
                                   decoration-success="state in ('approved', 'active')"
                                   decoration-muted="state in ('expired', 'cancel')"
                                   widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Заявка Полигруп 28.08.2026 — полетата, които кодът носи, излизат   -->
    <!-- на картона на служителя                                            -->
    <!-- ================================================================== -->

    <!-- Работа: НКПД до „Работна позиция" — полето е на версията, идва от
         длъжността, тук е само за четене -->
    <record id="view_employee_form_l10n_bg_work_nkpd" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_bg.work.nkpd</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']//field[@name='job_id']" position="after">
                <field name="l10n_bg_qualification_group" string="NKPD Position"
                       readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Личен: документите със сроковете им, данъчният номер, личният лекар,
         „Диплома" -->
    <record id="view_employee_form_l10n_bg_personal_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_bg.personal.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Гражданство: данъчният номер до осигурителния (ssnid остава
                 непипнат — решение на Росен, 04.09.2026) -->
            <field name="ssnid" position="after">
                <field name="l10n_bg_tax_number"/>
            </field>
            <!-- Личната карта под паспорта, със същата подредба „номер + срок" -->
            <xpath expr="//field[@name='passport_expiration_date']/.." position="after">
                <label for="l10n_bg_id_card_number"/>
                <div class="o_wrap_label d-flex flex-row gap-3 align-items-baseline">
                    <field name="l10n_bg_id_card_number"/>
                    <label for="l10n_bg_id_card_expiry" class="flex-shrink-0"
                           invisible="not l10n_bg_id_card_number" string="Expires on"/>
                    <field name="l10n_bg_id_card_expiry" invisible="not l10n_bg_id_card_number"/>
                </div>
            </xpath>
            <!-- Виза и разрешение за работа: закрилата е отделно основание -->
            <field name="has_work_permit" position="after">
                <field name="l10n_bg_protection_status"/>
                <field name="l10n_bg_protection_expiry" invisible="not l10n_bg_protection_status"/>
            </field>
            <!-- Личен лекар: отделна група след спешния контакт -->
            <xpath expr="//field[@name='emergency_phone']/.." position="after">
                <group string="Personal Doctor" name="l10n_bg_doctor_group">
                    <field name="l10n_bg_personal_doctor"/>
                    <field name="l10n_bg_personal_doctor_phone" widget="phone"/>
                    <field name="l10n_bg_personal_doctor_address"/>
                </group>
            </xpath>
            <!-- Образование: „Ниво на сертификат" → „Диплома" -->
            <field name="certificate" position="attributes">
                <attribute name="string">Diploma</attribute>
            </field>
        </field>
    </record>

</odoo>
