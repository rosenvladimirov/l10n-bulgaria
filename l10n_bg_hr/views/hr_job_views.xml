<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_bg_kid" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.l10n_bg_hr</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <!-- Add KID after NCOP position in main form -->
            <field name="l10n_bg_ncop_position_id" position="after">
                <field name="l10n_bg_economic_activity_id" options="{'no_create_edit': True}"/>
            </field>

            <!-- Добавяне на КИД информация в job_description_page -->
            <page name="job_description_page" position="inside">
                <group string="Economic Activity (KID)">
                    <group>
                        <field name="l10n_bg_economic_activity_id" readonly="1" string="KID"/>
                        <field name="company_id" readonly="1" string="Company"/>
                    </group>
                    <group>
                        <field name="l10n_bg_qualification_group" string="Qualification Group"/>
                        <field name="l10n_bg_education_level" string="Education Level"/>
                    </group>
                </group>
            </page>
        </field>
    </record>
</odoo>
