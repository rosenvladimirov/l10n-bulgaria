<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_form_bg_kid" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.l10n_bg_hr</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <!-- Add KID after NCOP position in main form -->
            <field name="l10n_bg_ncop_position_id" position="after">
                <field name="l10n_bg_economic_activity_id" options="{'no_create_edit': True}"/>
            </field>

            <!-- Add KID info inside NCOP Information tab -->
            <xpath expr="//page[@name='ncop_info_page']" position="inside">
                <group string="Икономическа дейност (КИД)">
                    <group>
                        <field name="l10n_bg_economic_activity_id" readonly="1" string="КИД"/>
                        <field name="company_id" readonly="1" string="Фирма"/>
                    </group>
                    <group>
                        <field name="l10n_bg_qualification_group" string="Квалификационна група"/>
                        <field name="l10n_bg_education_level" string="Образователно ниво"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
