<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- CONTRACT AMENDMENTS VIEWS                                          -->
    <!-- ================================================================== -->

    <!-- List View -->
    <record id="view_l10n_bg_hr_contract_amendment_list" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.list</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <list string="Contract Amendments" multi_edit="1">
                <field name="amendment_number"/>
                <field name="employee_id"/>
                <field name="version_id"/>
                <field name="amendment_type"/>
                <field name="date_signed"/>
                <field name="date_effective"/>
                <field name="date_end" optional="hide"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'to_approve'"
                       decoration-success="state in ('approved', 'active')"
                       decoration-muted="state in ('expired', 'cancel')"
                       widget="badge"/>
                <field name="is_temporary" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l10n_bg_hr_contract_amendment_form" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.form</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <form string="Contract Amendment">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'to_approve'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('active', 'expired')"
                            groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,active"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-warning"
                            invisible="state != 'cancel'"/>
                    <widget name="web_ribbon" title="Temporary"
                            bg_color="text-bg-info"
                            invisible="not is_temporary"/>

                    <div class="oe_title">
                        <label for="amendment_number" class="oe_edit_only"/>
                        <h1><field name="amendment_number" readonly="1"/></h1>
                        <h2><field name="subject" placeholder="Amendment Subject"/></h2>
                    </div>

                    <group>
                        <group>
                            <field name="version_id" options="{'no_create': True}"/>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="amendment_type"/>
                        </group>
                        <group>
                            <field name="date_signed"/>
                            <field name="date_effective"/>
                            <field name="date_end" invisible="not is_temporary"/>
                            <field name="is_temporary"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Amendment Details -->
                        <page string="Amendment Details" name="details">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Enter amendment details"/>
                                <field name="legal_basis"
                                       placeholder="Legal basis (e.g. чл. 118 от КТ)"/>
                            </group>
                        </page>

                        <!-- Wage Changes -->
                        <page string="Wage Changes" name="wage_changes"
                              invisible="amendment_type not in ('wage_change', 'other')">
                            <group string="Wage Modification">
                                <group>
                                    <field name="old_wage" readonly="1"/>
                                    <field name="new_wage"/>
                                    <field name="wage_difference" readonly="1"/>
                                </group>
                                <group>
                                    <field name="is_wage_increase" readonly="1"
                                           widget="boolean_toggle"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <group string="Change Justification">
                                <field name="wage_change_reason" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Position Changes -->
                        <page string="Position Changes" name="position_changes"
                              invisible="amendment_type not in ('position_change', 'other')">
                            <group string="NKPD Position">
                                <group>
                                    <field name="old_position_id" readonly="1"/>
                                    <field name="new_position_id"/>
                                </group>
                            </group>
                            <group string="Economic Activity">
                                <group>
                                    <field name="old_economic_activity_id" readonly="1"/>
                                    <field name="new_economic_activity_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Working Time Changes -->
                        <page string="Working Time" name="working_time"
                              invisible="amendment_type not in ('working_time_change', 'other')">
                            <group string="Working Time Type">
                                <group>
                                    <field name="old_working_time_type" readonly="1"/>
                                    <field name="new_working_time_type"/>
                                </group>
                            </group>
                            <group string="Working Hours">
                                <group>
                                    <field name="old_daily_hours" readonly="1"/>
                                    <field name="new_daily_hours"/>
                                </group>
                                <group>
                                    <field name="old_weekly_hours" readonly="1"/>
                                    <field name="new_weekly_hours"/>
                                </group>
                            </group>
                        </page>

                        <!-- Workplace Changes -->
                        <page string="Workplace" name="workplace"
                              invisible="amendment_type not in ('workplace_change', 'temporary_assignment', 'other')">
                            <group string="Work Location">
                                <group>
                                    <field name="old_work_location" readonly="1"/>
                                    <field name="new_work_location"/>
                                </group>
                            </group>
                        </page>

                        <!-- Leave Days Changes -->
                        <page string="Leave Days" name="leave_days"
                              invisible="amendment_type not in ('leave_change', 'other')">
                            <group string="Annual Leave">
                                <group>
                                    <field name="old_leave_days" readonly="1"/>
                                    <field name="new_leave_days"/>
                                </group>
                            </group>
                        </page>

                        <!-- Temporary Assignment -->
                        <page string="Temporary Assignment" name="temp_assignment"
                              invisible="not is_temporary_assignment">
                            <group string="Assignment Details">
                                <group>
                                    <field name="temporary_assignment_reason"/>
                                    <field name="assignment_duration_months"/>
                                </group>
                                <group>
                                    <field name="assignment_location"/>
                                    <field name="assignment_compensation"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 style="margin: 16px 0;">
                                <strong>Legal Note:</strong>
                                Temporary assignments are regulated by Articles 106-114
                                of the Bulgarian Labor Code. Maximum duration is
                                12 months without employee consent.
                            </div>
                        </page>

                        <!-- Signatures &amp; Approval -->
                        <page string="Signatures &amp; Approval" name="signatures">
                            <group string="Signatures">
                                <group>
                                    <field name="signed_by_employee" widget="boolean_toggle"/>
                                    <field name="signed_by_employer" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group string="Approval">
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Internal notes about this amendment..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l10n_bg_hr_contract_amendment_search" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.search</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <search string="Search Contract Amendments">
                <field name="amendment_number"/>
                <field name="employee_id"/>
                <field name="version_id"/>
                <field name="amendment_type"/>
                <field name="subject"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="To Approve" name="to_approve"
                        domain="[('state','=','to_approve')]"/>
                <filter string="Approved" name="approved"
                        domain="[('state','=','approved')]"/>
                <filter string="Active" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Expired" name="expired"
                        domain="[('state','=','expired')]"/>
                <separator/>
                <filter string="Temporary" name="temporary"
                        domain="[('is_temporary','=',True)]"/>
                <filter string="Wage Changes" name="wage_changes"
                        domain="[('amendment_type','=','wage_change')]"/>
                <filter string="Position Changes" name="position_changes"
                        domain="[('amendment_type','=','position_change')]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Amendment Type" name="amendment_type_group"
                            context="{'group_by': 'amendment_type'}"/>
                    <filter string="Status" name="state_group"
                            context="{'group_by': 'state'}"/>
                    <filter string="Company" name="company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Effective Date" name="effective_date"
                            context="{'group_by': 'date_effective:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_l10n_bg_hr_contract_amendment_kanban" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.kanban</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="amendment_number"/>
                <field name="employee_id"/>
                <field name="amendment_type"/>
                <field name="date_effective"/>
                <field name="state"/>
                <field name="is_temporary"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong><field name="amendment_number"/></strong>
                                    <span class="text-muted">
                                        <field name="employee_id"/>
                                    </span>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {
                                           'draft': 'secondary',
                                           'to_approve': 'warning',
                                           'approved': 'info',
                                           'active': 'success',
                                           'expired': 'danger',
                                           'cancel': 'dark'
                                       }}"/>
                            </div>
                            <ul>
                                <li><field name="amendment_type"/></li>
                                <li><field name="date_effective"/></li>
                            </ul>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_l10n_bg_hr_contract_amendment_calendar" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.calendar</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <calendar string="Contract Amendments"
                      date_start="date_effective"
                      date_stop="date_end"
                      color="state"
                      event_open_popup="1">
                <field name="amendment_number"/>
                <field name="employee_id"/>
                <field name="amendment_type"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_l10n_bg_hr_contract_amendment_pivot" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.pivot</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="arch" type="xml">
            <pivot string="Contract Amendments Analysis">
                <field name="amendment_type" type="row"/>
                <field name="date_effective" interval="month" type="col"/>
                <field name="wage_difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- ACTIONS                                                            -->
    <!-- ================================================================== -->

    <!-- Main action -->
    <record id="action_l10n_bg_hr_contract_amendment" model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">l10n_bg.hr.version.amendment</field>
        <field name="view_mode">list,kanban,form,calendar,pivot</field>
        <field name="view_id" ref="view_l10n_bg_hr_contract_amendment_list"/>
        <field name="search_view_id" ref="view_l10n_bg_hr_contract_amendment_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Contract Amendment!
            </p>
        </field>
    </record>

    <!-- Action from version -->
    <record id="action_l10n_bg_hr_contract_amendment_from_contract"
            model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">l10n_bg.hr.version.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_version_id': active_id}</field>
        <field name="domain">[('version_id', '=', active_id)]</field>
    </record>

    <!-- Action from employee -->
    <record id="action_l10n_bg_hr_contract_amendment_from_employee"
            model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">l10n_bg.hr.version.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
    </record>

    <!-- ================================================================== -->
    <!-- MENU                                                               -->
    <!-- ================================================================== -->

    <menuitem id="menu_l10n_bg_hr_contract_amendment"
              name="Contract Amendments"
              parent="hr.menu_hr_employee_contract_templates"
              action="action_l10n_bg_hr_contract_amendment"
              sequence="20"/>

    <!-- ================================================================== -->
    <!-- INHERIT hr.version — smart button + amendments tab                 -->
    <!-- ================================================================== -->

    <record id="view_hr_contract_form_amendment_button" model="ir.ui.view">
        <field name="name">hr.version.form.amendment.button</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(action_l10n_bg_hr_contract_amendment_from_contract)d"
                        icon="fa-file-text-o">
                    <field string="Amendments" name="l10n_bg_amendment_count"
                           widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_hr_contract_form_amendment_tab" model="ir.ui.view">
        <field name="name">hr.version.form.amendment.tab</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Amendments" name="amendments">
                    <field name="l10n_bg_amendment_ids"
                           context="{'default_version_id': id}">
                        <list editable="bottom">
                            <field name="amendment_number"/>
                            <field name="subject"/>
                            <field name="amendment_type"/>
                            <field name="date_signed"/>
                            <field name="date_effective"/>
                            <field name="state"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'to_approve'"
                                   decoration-success="state in ('approved', 'active')"
                                   widget="badge"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
