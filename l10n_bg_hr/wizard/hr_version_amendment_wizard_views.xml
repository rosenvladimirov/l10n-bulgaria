<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="view_hr_version_amendment_wizard_form" model="ir.ui.view">
        <field name="name">l10n_bg.hr.version.amendment.wizard.form</field>
        <field name="model">l10n_bg.hr.version.amendment.wizard</field>
        <field name="arch" type="xml">
            <form string="New Contract Amendment">
                <group>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="version_id"/>
                        <field name="amendment_type"/>
                        <field name="subject" placeholder="e.g. Wage Change"/>
                        <field name="date_effective"/>
                        <!-- DEF-116/1в: полето беше на МОДЕЛА, но не и тук —
                             „Временно преместване" отказваше с „иска крайна
                             дата", а нямаше къде да бъде въведена. -->
                        <field name="date_end"
                               invisible="amendment_type not in ('temporary_assignment', 'contract_extension')"
                               required="amendment_type == 'temporary_assignment'"/>
                    </group>
                </group>

                <notebook>
                    <!-- Wage -->
                    <page string="Wage Change" name="wage"
                          invisible="amendment_type != 'wage_change'">
                        <group>
                            <group>
                                <field name="old_wage" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="new_wage"/>
                            </group>
                        </group>
                    </page>

                    <!-- Position -->
                    <page string="Position Change" name="position"
                          invisible="amendment_type != 'position_change'">
                        <!-- Длъжността е носителят и стои първа; шифърът по
                             НКПД се произвежда от нея и е под нея, за четене. -->
                        <group string="Job Position">
                            <group>
                                <field name="old_job_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_job_id"/>
                            </group>
                        </group>
                        <group string="NKPD Code (derived from the job position)">
                            <group>
                                <field name="old_position_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_position_id"
                                       readonly="new_job_id"/>
                            </group>
                        </group>
                    </page>

                    <!-- Working Time -->
                    <page string="Working Time" name="working_time"
                          invisible="amendment_type != 'working_time_change'">
                        <group>
                            <group>
                                <field name="old_working_time_type" readonly="1"/>
                                <field name="old_weekly_hours" readonly="1"/>
                                <field name="old_daily_hours" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_working_time_type"/>
                                <field name="new_weekly_hours"/>
                                <field name="new_daily_hours"/>
                            </group>
                        </group>
                    </page>

                    <!-- Leave Days -->
                    <page string="Leave Days" name="leave"
                          invisible="amendment_type != 'leave_change'">
                        <group>
                            <group>
                                <field name="old_leave_days" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_leave_days"/>
                            </group>
                        </group>
                    </page>

                    <!-- Workplace -->
                    <page string="Workplace" name="workplace"
                          invisible="amendment_type not in ('workplace_change', 'temporary_assignment')">
                        <group>
                            <group>
                                <field name="old_work_location" readonly="1"/>
                            </group>
                            <group>
                                <field name="new_work_location"/>
                            </group>
                        </group>
                    </page>
                    <!-- Типовете без собствено поле за съдържание получават
                         едно място, вместо да отварят чуждите табове. -->
                    <page string="Description" name="description"
                          invisible="amendment_type not in ('other', 'additional_duties', 'contract_extension')">
                        <field name="description" nolabel="1"
                               placeholder="What does this amendment agree?"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_create_amendment" string="Create Amendment"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_hr_version_amendment_wizard" model="ir.actions.act_window">
        <field name="name">New Contract Amendment</field>
        <field name="res_model">l10n_bg.hr.version.amendment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_version_amendment_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>

    <!-- Old link button deactivated — replaced by amendments group -->
    <record id="view_employee_form_new_amendment_link" model="ir.ui.view">
        <field name="name">hr.employee.form.new.amendment.link</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
