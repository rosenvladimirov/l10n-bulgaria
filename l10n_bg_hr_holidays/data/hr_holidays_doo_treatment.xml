<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Flag maternity/NSSI-funded leave types for payroll DOO exclusion.
         Separate from hr_holidays_data.xml (noupdate=1) so on -u upgrade
         the doo_treatment values land on customer DBs without disturbing
         other leave type settings. -->
    <data noupdate="0">

        <!-- Maternity leave (чл. 163 КТ — 410 days) -->
        <record id="holiday_status_kt_maternity_410" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- Paternity leave (чл. 163, ал. 10 КТ — 15 days) -->
        <record id="holiday_status_kt_paternity" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- Childcare leave up to 2 years (чл. 164 КТ) -->
        <record id="holiday_status_kt_childcare_2y" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- Breastfeeding / baby care leave (чл. 166 КТ) -->
        <record id="holiday_status_kt_breastfeeding" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- ===================================================
             Трудова злополука / професионална болест —
             НОИ 90% (КСО чл. 41), без изискване за осиг. стаж
             =================================================== -->

        <!-- NSSI 01: Професионална болест -->
        <record id="holiday_status_nssi_01" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_work_accident</field>
        </record>

        <!-- NSSI 02: Трудова злополука -->
        <record id="holiday_status_nssi_02" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_work_accident</field>
        </record>

        <!-- NSSI 13: Реинтеграция след трудова злополука -->
        <record id="holiday_status_nssi_13" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_work_accident</field>
        </record>

        <!-- ===================================================
             Общо заболяване и приравнени — 3 раб. дни работодател
             70% (КСО чл. 40, ал. 5), после НОИ 80%
             =================================================== -->

        <!-- NSSI 03: Общо заболяване -->
        <record id="holiday_status_nssi_03" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 06: Карантина -->
        <record id="holiday_status_nssi_06" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 07: Придружаване на болен пълнолетен (КСО чл. 45, ал. 1, т. 2) -->
        <record id="holiday_status_nssi_07" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 08: Санаторно-курортно лечение -->
        <record id="holiday_status_nssi_08" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 09: Възстановяване след заболяване -->
        <record id="holiday_status_nssi_09" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 10: Епидемиологична изолация -->
        <record id="holiday_status_nssi_10" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 11: Медицински прегледи и изследвания -->
        <record id="holiday_status_nssi_11" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 12: Донорство на органи -->
        <record id="holiday_status_nssi_12" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 14: Трудоустрояване по медицински причини -->
        <record id="holiday_status_nssi_14" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 16: Ин-витро процедури (КСО чл. 40, ал. 3) -->
        <record id="holiday_status_nssi_16" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 17: премахнат (DEF-27 — няма го в П9) -->

        <!-- NSSI 18: Нетрудова (битова) злополука (КСО чл. 40, ал. 1) -->
        <record id="holiday_status_nssi_18" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- NSSI 19: Гледане на болно дете до 18 г. (КСО чл. 45, ал. 1, т. 1) -->
        <record id="holiday_status_nssi_19" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_sick</field>
        </record>

        <!-- ===================================================
             Майчинство по П9 кодове — НОИ финансирани (КСО чл. 50/53)
             =================================================== -->

        <!-- NSSI 04: Бременност и раждане (КСО чл. 50) -->
        <record id="holiday_status_nssi_04" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- NSSI 05: Гледане на болно дете до 2 г. (КСО чл. 53) -->
        <record id="holiday_status_nssi_05" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- NSSI 15: Осиновяване (КСО чл. 53в) -->
        <record id="holiday_status_nssi_15" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">nssi_maternity</field>
        </record>

        <!-- ===================================================
             Неплатен отпуск — ЗО по платец (ЗЗО чл. 40, ал. 1, т. 1, б. „б").
             ЗО (½ × МОД-СОЛ × 8%) се дължи за ВСЕКИ неплатен ден, когато лицето
             няма друго осигурително основание; прагът 30 раб. дни/год. (КСО
             чл. 9, ал. 2, т. 3) важи САМО за зачитането на осиг. СТАЖ, не за ЗО.
             Платецът се определя от ОСНОВАНИЕТО на неплатения:
               * по желание на работника (чл. 160 КТ) → лицето (unpaid_employee)
               * гледане на дете (чл. 167а КТ), служебен/творчески (чл. 158/161)
                 → работодателят (unpaid_employer)
               * производствена необходимост / престой → поделено (unpaid_split)
             =================================================== -->

        <!-- Неплатен по желание на работника (КТ чл. 160) — ЗО за сметка на лицето -->
        <record id="holiday_status_kt_unpaid" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">unpaid_employee</field>
        </record>

        <!-- Служебен / творчески неплатен (КТ чл. 158/161) — ЗО за сметка на работодателя -->
        <record id="holiday_status_kt_professional_unpaid" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">unpaid_employer</field>
        </record>

        <!-- Неплатен за гледане на дете до 8 г. (КТ чл. 167а) — ЗО за сметка на работодателя -->
        <record id="holiday_status_kt_childcare_8y" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">unpaid_employer</field>
        </record>

        <!-- Производствена необходимост / престой (КТ чл. 267, ал. 3) — ЗО поделено работодател/лице -->
        <record id="holiday_status_kt_production_necessity" model="hr.leave.type">
            <field name="l10n_bg_doo_treatment">unpaid_split</field>
        </record>

    </data>
</odoo>
