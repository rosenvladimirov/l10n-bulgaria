<?xml version="1.0" encoding="utf-8"?>
<!--
    БГ-законови лимити на leave типовете (КТ + КСО).
    Отделен файл за лесна поддръжка и явен audit.

    Pattern: noupdate=False → стойностите се прилагат при всеки upgrade
    на модула. Това гарантира че при промяна на закона е достатъчно да се
    update-не файлът и след upgrade всички DB ще се синхронизират.

    Per-company override: company-specific хидрация може да override-не
    стойностите чрез own ir.model.data record със same XML id.

    Legend:
    - l10n_bg_max_days_per_year — годишен лимит в работни дни
    - l10n_bg_max_days_total — общ лимит (lifetime / per event)
    - l10n_bg_legal_reference — цитат на закон + чл./ал./т.
-->
<odoo>
    <data noupdate="0">

        <!-- ===================================================
             NSSI codes — медицински отпуски
             =================================================== -->

        <!-- NSSI 04: Майчинство — Бременност и раждане (410 дни total) -->
        <record id="holiday_status_nssi_04" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">410</field>
            <field name="l10n_bg_legal_reference">КСО чл. 50, ал. 1; КТ чл. 163</field>
        </record>

        <!-- NSSI 05: Гледане на дете до 2-годишна възраст —
             няма строг законов cap в дни; ограничено от КТ чл. 164
             (до навършване на 2 г.) и общата норма 6 месеца per year.
             Оставяме без cap — controller-ите проверяват по възраст на детето. -->

        <!-- NSSI 07: Придружаване на болен пълнолетен член от семейството —
             10 раб. дни/година (само за лица над 18 г.; за дете → код 19) -->
        <record id="holiday_status_nssi_07" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">10</field>
            <field name="l10n_bg_legal_reference">КСО чл. 45, ал. 1, т. 2</field>
        </record>

        <!-- NSSI 19: Гледане на болно дете до 18 г. — 60 раб. дни/година
             ОБЩО за всички осигурени членове на семейството (системата брои
             per служител — общия семеен лимит се следи организационно) -->
        <record id="holiday_status_nssi_19" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">60</field>
            <field name="l10n_bg_legal_reference">КСО чл. 45, ал. 1, т. 1</field>
        </record>

        <!-- NSSI 11: Карантина — обикновено е свързано с дни на карантина,
             не годишен таван. Не задаваме. -->

        <!-- ===================================================
             KT codes — отпуски по Кодекса на труда
             =================================================== -->

        <!-- KT155: Платен годишен отпуск — годишен таван се определя
             от договора (basic+additional+extended). Тук НЕ задаваме
             фиксиран cap; allocation се прави per-employee. -->

        <!-- KT157-1: Брак — 2 раб. дни per събитие -->
        <record id="holiday_status_kt_marriage" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">2</field>
            <field name="l10n_bg_legal_reference">КТ чл. 157, ал. 1, т. 1</field>
        </record>

        <!-- KT157-2: Кръводаряване — 2 раб. дни per събитие -->
        <record id="holiday_status_kt_blood_donation" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">2</field>
            <field name="l10n_bg_legal_reference">КТ чл. 157, ал. 1, т. 2</field>
        </record>

        <!-- KT157-3: Смърт в семейството — 2 раб. дни per събитие -->
        <record id="holiday_status_kt_bereavement" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">2</field>
            <field name="l10n_bg_legal_reference">КТ чл. 157, ал. 1, т. 3</field>
        </record>

        <!-- KT157-7: Обучение при природни бедствия — до 5 раб. дни/година -->
        <record id="holiday_status_kt_disaster_training" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">5</field>
            <field name="l10n_bg_legal_reference">КТ чл. 157, ал. 1, т. 7</field>
        </record>

        <!-- KT160: НЕПЛАТЕН ОТПУСК — 30 раб. дни/година (за признат стаж);
             над 30 дни се позволяват, но НЕ се броят за стаж и не влизат
             в ДОО база (виж l10n_bg_doo_treatment='unpaid_no_doo'). -->
        <record id="holiday_status_kt_unpaid" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">30</field>
            <field name="l10n_bg_legal_reference">КТ чл. 160, ал. 1 (за признат стаж)</field>
        </record>

        <!-- KT161A: Платен отпуск за проф. квалификация — до 25 дни/година -->
        <record id="holiday_status_kt_professional_paid" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">25</field>
            <field name="l10n_bg_legal_reference">КТ чл. 161, ал. 1</field>
        </record>

        <!-- KT163: Майчинство 410 дни (същия legal-cap като NSSI 04) -->
        <record id="holiday_status_kt_maternity_410" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">410</field>
            <field name="l10n_bg_legal_reference">КТ чл. 163, ал. 1</field>
        </record>

        <!-- KT163-10: Бащинство — 15 дни per дете -->
        <record id="holiday_status_kt_paternity" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">15</field>
            <field name="l10n_bg_legal_reference">КТ чл. 163, ал. 10</field>
        </record>

        <!-- KT167: Гледане на болен в семейството по КТ — 10 дни/година
             (повтаря NSSI 07 от КТ перспектива) -->
        <record id="holiday_status_kt_parent_illness" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">10</field>
            <field name="l10n_bg_legal_reference">КТ чл. 167; КСО чл. 45, ал. 1, т. 2</field>
        </record>

        <!-- KT167A: Гледане на дете до 8 г. — 2 месеца/година ≈ ~44 раб. дни -->
        <record id="holiday_status_kt_childcare_8y" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">44</field>
            <field name="l10n_bg_legal_reference">КТ чл. 167а (2 месеца ≈ 44 раб. дни)</field>
        </record>

        <!-- KT169: Учене с одобрение на работодателя — 25 дни/година -->
        <record id="holiday_status_kt_education_annual" model="hr.leave.type">
            <field name="l10n_bg_max_days_per_year">25</field>
            <field name="l10n_bg_legal_reference">КТ чл. 169</field>
        </record>

        <!-- KT170: Държавен изпит / преддипломна — 30 дни per събитие -->
        <record id="holiday_status_kt_final_exam" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">30</field>
            <field name="l10n_bg_legal_reference">КТ чл. 170</field>
        </record>

        <!-- KT171A: PhD изследване — 6 месеца ≈ 132 раб. дни total -->
        <record id="holiday_status_kt_phd_research" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">132</field>
            <field name="l10n_bg_legal_reference">КТ чл. 171а (6 месеца ≈ 132 раб. дни)</field>
        </record>

        <!-- KT171B: PhD защита — 1 месец ≈ 22 раб. дни total -->
        <record id="holiday_status_kt_phd_defense" model="hr.leave.type">
            <field name="l10n_bg_max_days_total">22</field>
            <field name="l10n_bg_legal_reference">КТ чл. 171б (1 месец ≈ 22 раб. дни)</field>
        </record>

    </data>
</odoo>
