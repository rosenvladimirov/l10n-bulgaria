<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Calendar view dedicated to the annual leave schedule -->
        <record id="hr_leave_view_calendar_schedule" model="ir.ui.view">
            <field name="name">hr.leave.calendar.schedule.bg</field>
            <field name="model">hr.leave</field>
            <field name="arch" type="xml">
                <calendar string="Annual Leave Schedule"
                          date_start="date_from"
                          date_stop="date_to"
                          color="employee_id"
                          mode="year"
                          quick_create="0"
                          hide_time="true">
                    <field name="employee_id"/>
                    <field name="holiday_status_id"/>
                    <field name="number_of_days" widget="float"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- Pivot view: employee × month coverage -->
        <record id="hr_leave_view_pivot_schedule" model="ir.ui.view">
            <field name="name">hr.leave.pivot.schedule.bg</field>
            <field name="model">hr.leave</field>
            <field name="arch" type="xml">
                <pivot string="Annual Leave Schedule" sample="1">
                    <field name="employee_id" type="row"/>
                    <field name="holiday_status_id" type="row"/>
                    <field name="date_from" interval="month" type="col"/>
                    <field name="number_of_days" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Search view with relevant BG filters -->
        <record id="hr_leave_view_search_schedule" model="ir.ui.view">
            <field name="name">hr.leave.search.schedule.bg</field>
            <field name="model">hr.leave</field>
            <field name="arch" type="xml">
                <search string="Annual Leave Schedule">
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="holiday_status_id"/>
                    <filter name="approved"
                            string="Approved"
                            domain="[('state','=','validate')]"/>
                    <filter name="confirmed"
                            string="Pending"
                            domain="[('state','=','confirm')]"/>
                    <separator/>
                    <filter name="bg_paid_annual"
                            string="Paid Annual Leave (KT art. 155-157)"
                            domain="[('holiday_status_id.l10n_bg_code','=like','155%')]"/>
                    <group>
                        <filter name="group_employee"
                                string="Employee"
                                context="{'group_by': 'employee_id'}"/>
                        <filter name="group_department"
                                string="Department"
                                context="{'group_by': 'department_id'}"/>
                        <filter name="group_type"
                                string="Leave Type"
                                context="{'group_by': 'holiday_status_id'}"/>
                        <filter name="group_month"
                                string="Month"
                                context="{'group_by': 'date_from:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hr_leave_schedule_bg" model="ir.actions.act_window">
            <field name="name">Annual Leave Schedule</field>
            <field name="res_model">hr.leave</field>
            <field name="view_mode">calendar,pivot,list,form</field>
            <field name="search_view_id" ref="hr_leave_view_search_schedule"/>
            <field name="context">{
                'search_default_approved': 1,
                'search_default_group_employee': 1
            }</field>
            <field name="domain">[('state','in',['confirm','validate1','validate'])]</field>
        </record>

        <!-- Bind calendar/pivot/search views explicitly to the action -->
        <record id="action_hr_leave_schedule_bg_calendar" model="ir.actions.act_window.view">
            <field name="sequence">1</field>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="hr_leave_view_calendar_schedule"/>
            <field name="act_window_id" ref="action_hr_leave_schedule_bg"/>
        </record>
        <record id="action_hr_leave_schedule_bg_pivot" model="ir.actions.act_window.view">
            <field name="sequence">2</field>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="hr_leave_view_pivot_schedule"/>
            <field name="act_window_id" ref="action_hr_leave_schedule_bg"/>
        </record>

        <!-- Menu under Time Off -->
        <menuitem id="menu_hr_leave_schedule_bg"
                  name="Annual Leave Schedule"
                  parent="hr_holidays.menu_hr_holidays_report"
                  action="action_hr_leave_schedule_bg"
                  sequence="50"/>
    </data>
</odoo>
