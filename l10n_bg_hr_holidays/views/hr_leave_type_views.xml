<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Work Entry Type (ex Leave Type) Form View.
             19.4 (master): hr.leave.type merged into hr.work.entry.type; the
             old 'time_off_requests'/'visual' groups are gone, so anchor the BG
             additions on the always-present `code` field. -->
        <record id="hr_leave_type_view_form_paid_days" model="ir.ui.view">
            <field name="name">hr.work.entry.type.form.paid.days</field>
            <field name="model">hr.work.entry.type</field>
            <field name="inherit_id" ref="hr_holidays.hr_work_entry_type_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="l10n_bg_code" placeholder="e.g. KT155, NSSI01"/>
                    <group>
                        <group name="l10n_bg_config" string="BG Configuration">
                            <field name="l10n_bg_allow_paid_days"
                                   help="Check this if this leave type is unpaid by default"/>
                            <field name="l10n_bg_paid_days_unpaid_leave" invisible="not l10n_bg_allow_paid_days"/>
                            <field name="l10n_bg_leave_reason_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group name="l10n_bg_legal_caps" string="BG Legal Caps">
                            <field name="l10n_bg_max_days_per_year"/>
                            <field name="l10n_bg_max_days_total"/>
                            <field name="l10n_bg_legal_reference"
                                   placeholder="e.g. КТ чл. 160, ал. 1"/>
                            <field name="l10n_bg_carryover_lapse_years"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Extend Work Entry Type Tree View -->
        <record id="hr_leave_type_view_tree_paid_days" model="ir.ui.view">
            <field name="name">hr.work.entry.type.tree.paid.days</field>
            <field name="model">hr.work.entry.type</field>
            <field name="inherit_id" ref="hr_holidays.view_work_entry_type_normal_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="l10n_bg_leave_reason_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="l10n_bg_allow_paid_days" invisible="1"/>
                    <field name="l10n_bg_allow_paid_days" optional="hide" column_invisible="not l10n_bg_allow_paid_days"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
