<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Leave Type Form View -->
        <record id="hr_leave_type_view_form_paid_days" model="ir.ui.view">
            <field name="name">hr.leave.type.form.paid.days</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='time_off_requests']" position="inside">
                    <field name="l10n_bg_code" placeholder="e.g. KT155, NSSI01"/>
                </xpath>
                <xpath expr="//group[@name='visual']" position="before">
                    <group>
                        <group name="l10n_bg_config" string="BG Configuration">
                            <field name="l10n_bg_allow_paid_days"
                                   help="Check this if this leave type is unpaid by default"/>
                            <field name="l10n_bg_paid_days_unpaid_leave" invisible="not l10n_bg_allow_paid_days"/>
                            <field name="l10n_bg_leave_reason_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Extend Leave Type Tree View -->
        <record id="hr_leave_type_view_tree_paid_days" model="ir.ui.view">
            <field name="name">hr.leave.type.tree.paid.days</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="l10n_bg_leave_reason_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="l10n_bg_allow_paid_days" invisible="1"/><!-- Hidden field used in domain filters and search -->
                    <field name="l10n_bg_allow_paid_days" optional="hide" column_invisible="not l10n_bg_allow_paid_days"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
