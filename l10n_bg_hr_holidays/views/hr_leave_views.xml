<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Leave Request Form View -->
        <record id="hr_leave_view_form_paid_days" model="ir.ui.view">
            <field name="name">hr.leave.form.paid.days</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_entry_type_id']" position="after">
                    <field name="l10n_bg_leave_reason_id" readonly="1" force_save="1"/>
                </xpath>

                <!-- Add fields after a duration display -->
                <xpath expr="//field[@name='duration_display']" position="before">
                    <field name="l10n_bg_show_paid_days_fields" invisible="1"/><!-- Technical field used to control visibility of paid days fields via attrs -->
                    <field name="l10n_bg_paid_days_unpaid_leave"
                           invisible="not l10n_bg_show_paid_days_fields"
                           string="Paid Days"/>
                    <field name="l10n_bg_effective_unpaid_days"
                           invisible="not l10n_bg_show_paid_days_fields"
                           string="Effective Unpaid Days"
                           readonly="1"/>
                </xpath>
            </field>
        </record>

        <!-- Extend Leave Request List View -->
        <record id="hr_leave_view_list_paid_days" model="ir.ui.view">
            <field name="name">hr.leave.list.paid.days</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">
                <field name="duration_display" position="after">
                    <field name="l10n_bg_paid_days_unpaid_leave" optional="hide" string="Paid Days"/>
                    <field name="l10n_bg_effective_unpaid_days" optional="hide" string="Effective Unpaid Days"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
