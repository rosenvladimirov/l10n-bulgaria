<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Заплатна структура за служители -->
        <record id="bg_salary_structure_salary_employee" model="hr.payroll.structure">
            <field name="name">Служители - щатна заплата България</field>
            <field name="code">BG_SAL_EMP</field>
            <field name="country_id" ref="base.bg"/>
