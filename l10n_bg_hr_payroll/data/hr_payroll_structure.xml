        </record>

        <!-- Заплатна структура за работници -->
        <record id="bg_salary_structure_hourly_worker" model="hr.payroll.structure">
            <field name="name">Работници - сделна система България</field>
            <field name="code">BG_HOUR_WORK</field>
            <field name="country_id" ref="base.bg"/>
            <field name="type_id" ref="bg_structure_type_hourly_worker"/>
        </record>
    </data>
</odoo>
