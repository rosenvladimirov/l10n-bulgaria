        <!-- Basic Salary -->
        <record id="hr_salary_rule_basic_bg" model="hr.salary.rule">
            <field name="name">Основна заплата</field>
            <field name="code">BG_BASIC</field>
            <field name="category_id" ref="BG_BASE_DOO"/>
            <field name="struct_id" ref="bg_salary_structure_salary_employee"/>
            <field name="sequence">100</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
total_days = 0.0
work_days = 0.0

for line in payslip.worked_days_line_ids:
    if line.code != 'OUT':
        total_days += line.number_of_days
    if line.code == 'WORK100':
        work_days = line.number_of_days
# Изчисления
if total_days > 0:
    result = contract.wage / total_days
else:
    result = 0.0
result_qty = work_days
            ]]></field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

