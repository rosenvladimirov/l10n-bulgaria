            <field name="sequence">150</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
work_days= 0.0
total_days = 0.0
rate = contract.l10n_bg_seniority_allowance_rate
years = contract.l10n_bg_seniority_years
if not years and contract.l10n_bg_class_years_decimal > 0.0:
    years = contract.l10n_bg_class_years_decimal
result_qty = years
result_rate = rate
for line in payslip.worked_days_line_ids:
    if line.code != 'OUT':
        total_days += line.number_of_days
    if line.code == 'WORK100':
        work_days = line.number_of_days

# Изчисления
if total_days > 0:
    result = (contract.wage / total_days) * work_days
else:
    result = 0.0
            ]]></field>
            <field name="appears_on_payslip" eval="True"/>
        </record>

