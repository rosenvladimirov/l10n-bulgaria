                <!-- Other Permanent Allowances -->
        <record id="hr_salary_rule_sick_03_allowances_bg" model="hr.salary.rule">
            <field name="name">Болничен общо заболяване</field>
            <field name="code">BG_SICK_ALLOW</field>
            <field name="category_id" ref="BG_BASE_DOO"/>
            <field name="struct_id" ref="bg_salary_structure_salary_employee"/>
            <field name="sequence">160</field>
            <field name="condition_python"><![CDATA[
result = sum([x.number_of_days for x in payslip.worked_days_line_ids if x.code == 'LEAVE110']) != 0.0
            ]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
total_days = 0.0
work_days = 0.0
result_qty = 0.0
rate = payslip._rule_parameter('BG_INSURANCE_RATE') or 0.0

if 'LEAVE110' in worked_days:
    result_qty = worked_days['LEAVE110']['number_of_days']

for line in payslip.worked_days_line_ids:
    if line.code != 'OUT':
        total_days += line.number_of_days
    if line.code == 'WORK100':
        work_days = line.number_of_days

# Изчисления
if total_days > 0:
    result = (contract.wage / total_days) * rate
else:
    result = 0.0

result_name = 'Болничен общо заболяване за сметка на работодателя'
            ]]></field>
