<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================================== -->
        <!-- RULE CATEGORIES NEEDED -->
        <!-- ================================================================== -->

        <!-- Custom categories for Bulgarian payroll -->
        <!-- Основни типове осигуряване -->
        <record id="BG_BASE_DOO" model="hr.salary.rule.category">
            <field name="name">Осигурен доход общо осигуряване</field>
            <field name="code">BG_BASE_DOO</field>
            <field name="note"></field>
        </record>
        <record id="BG_BASE_DOO_SHORT_TERM" model="hr.salary.rule.category">
            <field name="name">Осигурен доход краткотрайна заетост</field>
            <field name="code">BG_BASE_DOO_SHORT_TERM</field>
            <field name="note"></field>
        </record>
        <record id="BG_BASE_ZO" model="hr.salary.rule.category">
            <field name="name">Осигурен доход здравно осигуряване</field>
            <field name="code">BG_BASE_ZO</field>
            <field name="note"></field>
        </record>

        <record id="BG_GROSS" model="hr.salary.rule.category">
            <field name="name">Общо начисления/осигурителен доход</field>
            <field name="code">BG_GROSS</field>
            <field name="note"></field>
        </record>
         <record id="BG_BASE_PIT" model="hr.salary.rule.category">
            <field name="name">Облагаема сума</field>
            <field name="code">BG_BASE_PIT</field>
            <field name="note"></field>
        </record>
        <record id="BG_DED" model="hr.salary.rule.category">
            <field name="name">Всичко удръжки</field>
            <field name="code">BG_DED</field>
            <field name="note"></field>
        </record>
        <record id="BG_NET" model="hr.salary.rule.category">
            <field name="name">Чиста сума за получване</field>
            <field name="code">BG_NET</field>
            <field name="note"></field>
        </record>

        <record id="BG_DOO_ER" model="hr.salary.rule.category">
            <field name="name">Начисляване на ДОО за рабодателя</field>
            <field name="code">BG_DOO_ER</field>
            <field name="note"></field>
        </record>
        <record id="BG_ZO_ER" model="hr.salary.rule.category">
            <field name="name">Начисляване на ЗО за рабодателя</field>
            <field name="code">BG_ZO_ER</field>
            <field name="note"></field>
        </record>
        <record id="BG_PPF_ER" model="hr.salary.rule.category">
            <field name="name">Начисляване на ППФ за рабодателя</field>
            <field name="code">BG_PPF_ER</field>
            <field name="note"></field>
        </record>
        <record id="BG_UPF_ER" model="hr.salary.rule.category">
            <field name="name">Начисляване на УПФ за рабодателя</field>
            <field name="code">BG_UPF_ER</field>
            <field name="note"></field>
        </record>
        <record id="BG_TRZP_ER" model="hr.salary.rule.category">
            <field name="name">Начисляване на ТРЗБ за рабодателя</field>
            <field name="code">BG_TRZP_ER</field>
            <field name="note"></field>
        </record>
        <record id="BG_COMP_PAY" model="hr.salary.rule.category">
            <field name="name">Ощо осигуровки за сметка на работодателя</field>
            <field name="code">BG_COMP_PAY</field>
            <field name="note"></field>
        </record>

        <record id="BG_DED_DOO_EE" model="hr.salary.rule.category">
            <field name="name">Начисляване на ДОО за работника</field>
            <field name="code">BG_DED_DOO_EE</field>
            <field name="note"></field>
        </record>
        <record id="BG_DED_ZO_EE" model="hr.salary.rule.category">
            <field name="name">Начисляване на ЗО за работника</field>
            <field name="code">BG_DED_ZO_EE</field>
            <field name="note"></field>
        </record>
        <record id="BG_DED_UPF_EE" model="hr.salary.rule.category">
            <field name="name">Начисляване на УПФ за работника</field>
            <field name="code">BG_DED_UPF_EE</field>
            <field name="note"></field>
        </record>
        <record id="BG_EMPL_PAY" model="hr.salary.rule.category">
            <field name="name">Ощо осигуровки за сметка на работника/служителя</field>
            <field name="code">BG_EMPL_PAY</field>
            <field name="note"></field>
        </record>
        <record id="BG_PIT_PAY" model="hr.salary.rule.category">
            <field name="name">Общо за плащане на ДОД</field>
            <field name="code">BG_PIT_PAY</field>
            <field name="note"></field>
        </record>

    </data>
</odoo>
