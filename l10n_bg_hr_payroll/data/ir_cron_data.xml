<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled Action: Monthly Class Period Increment -->
        <record id="ir_cron_increment_class_periods" model="ir.cron">
            <field name="name">BG HR: Monthly Class Period Increment</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._cron_increment_class_periods()]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        </record>

        <!-- Scheduled Action: Daily Class Period Check (Optional - for more frequent checks) -->
        <record id="ir_cron_daily_class_check" model="ir.cron">
            <field name="name">BG HR: Daily Class Period Check</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._cron_increment_class_periods()]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        </record>

        <!-- Scheduled Action: Weekly Payroll Data Sync (Additional helper cron) -->
        <record id="ir_cron_weekly_payroll_sync" model="ir.cron">
            <field name="name">BG HR: Weekly Payroll Data Sync</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
# Weekly sync of payroll-related computed fields
contracts = model.search([('state', '=', 'open')])
for contract in contracts:
    try:
        # Force recalculation of computed fields
        contract._compute_current_class_period()
        contract._compute_seniority_allowance()
        contract._compute_mod()
        contract._compute_effective_mod()
        contract._compute_tzpb_rate()
    except Exception as e:
        import logging
        _logger = logging.getLogger(__name__)
        _logger.error(f"Weekly sync error for contract {contract.name}: {str(e)}")
        continue
            ]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d 03:00:00')"/>
        </record>

    </data>
</odoo>
