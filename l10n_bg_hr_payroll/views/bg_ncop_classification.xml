<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit NCOP Classification Tree View - Add insurance parameter columns -->
    <record id="view_bg_ncop_classification_list_inherit" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.list.inherit</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="inherit_id" ref="l10n_bg_payroll_classifications.view_bg_ncop_classification_list"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="doo_emp_1959_rate" string="SSI Employee %" optional="hide"/>
                <field name="doo_er_1959_rate" string="SSI Employer %" optional="hide"/>
                <field name="doo_emp_1960_rate" string="SSI Employee %" optional="hide"/>
                <field name="doo_er_1960_rate" string="SSI Employer %" optional="hide"/>
                <field name="upf_emp_rate" string="UPF Employee %" optional="hide"/>
                <field name="upf_er_rate" string="UPF Employer %" optional="hide"/>
                <field name="ppf_rate" string="OAD %" optional="hide"/>
                <field name="tzbp_rate" string="OAD %" optional="hide"/>
                <field name="tzbp_param_value_code" string="OAD code" optional="hide"/>
                <field name="zo_emp_rate" string="PHI Employee %" optional="hide"/>
                <field name="zo_er_rate" string="PHI Employer" optional="hide"/>

                <!-- Add update buttons to the list view -->
                <button name="action_update_parameter_references_from_xml"
                        string="Update Parameters"
                        type="object"
                        icon="fa-refresh"
                        help="Update parameter references from XML"/>
            </field>
        </field>
    </record>

    <!-- Inherit NKPD Classification Form View - Add insurance parameters section -->
    <record id="view_bg_ncop_classification_form_inherit" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.form.inherit</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="inherit_id" ref="l10n_bg_payroll_classifications.view_bg_ncop_classification_form"/>
        <field name="arch" type="xml">
            <!-- Add a new page for Insurance Parameters - using xpath to find the last page -->
            <xpath expr="//page[last()]" position="after">
                <page string="Insurance Parameters">
                    <!-- Add action buttons at the top -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                <button name="action_update_parameter_references_from_xml"
                                        string="Update from XML"
                                        type="object"
                                        class="btn btn-secondary"
                                        icon="fa-refresh"
                                        help="Актуализира параметърните връзки според XML дефинициите"/>
                                <button name="action_sync_with_xml_parameters"
                                        string="Sync &amp; Validate"
                                        type="object"
                                        class="btn btn-info"
                                        icon="fa-check-circle"
                                        help="Синхронизира и валидира параметърните настройки"/>
                                <button name="action_validate_parameter_setup"
                                        string="Diagnostics"
                                        type="object"
                                        class="btn btn-warning"
                                        icon="fa-stethoscope"
                                        help="Показва диагностична информация за параметрите"/>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Parameter References">
                            <field name="doo_param_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   context="{'search_default_active': 1}"/>
                            <field name="upf_param_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   context="{'search_default_active': 1}"/>
                            <field name="ppf_param_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   context="{'search_default_active': 1}"/>
                            <field name="ppf_param_value_code"
                                   readonly="0"
                                   invisible="not tzbp_param_id"
                                   placeholder="e.g., A, B, C for OAD categories"/>
                            <field name="zo_param_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   context="{'search_default_active': 1}"/>
                            <field name="tzbp_param_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   context="{'search_default_active': 1}"/>
                            <field name="tzbp_param_value_code"
                                   readonly="0"
                                   invisible="not tzbp_param_id"
                                   placeholder="e.g., A, B, C for OAD categories"/>
                        </group>
                        <group string="Computed Rates (%)">
                            <field name="doo_emp_1959_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="doo_emp_1959_rate > 0"/>
                            <field name="doo_er_1959_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="doo_er_1959_rate > 0"/>
                            <field name="doo_emp_1960_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="doo_emp_1960_rate > 0"/>
                            <field name="doo_er_1960_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="doo_er_1960_rate > 0"/>
                            <field name="upf_emp_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="upf_emp_rate > 0"/>
                            <field name="upf_er_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="upf_er_rate > 0"/>
                            <field name="zo_emp_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="zo_emp_rate > 0"/>
                            <field name="zo_er_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="zo_er_rate > 0"/>
                            <field name="tzbp_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="tzbp_rate > 0"/>
                            <field name="ppf_rate" readonly="1"
                                   widget="percentage"
                                   decoration-info="tzbp_rate > 0"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> Parameters are searched recursively up the hierarchy.
                        If the current record does not have a parameter set, the system will search the parent record.
                        <ul>
                            <li><strong>SSI:</strong> State Social Insurance fond - Employee/Employer</li>
                            <li><strong>UPF:</strong> Universal Pension Fund - Employee/Employer</li>
                            <li><strong>PPF:</strong> Professional pension fund - Employee/Employer</li>
                            <li><strong>PHI:</strong> Public Health Insurance fund - Employee/Employer</li>
                            <li><strong>OAD: </strong> Work accident and occupational disease - Employee/Employer</li>
                        </ul>
                        <p class="mt-2"><strong>Update:</strong> Use the buttons above to update the parameters according to the XML definitions.</p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit NKPD Classification Search View - Add filters for insurance rates -->
    <record id="view_bg_ncop_classification_search_inherit" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.search.inherit</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="inherit_id" ref="l10n_bg_payroll_classifications.view_bg_ncop_classification_search"/>
        <field name="arch" type="xml">
            <!-- Add search fields -->
            <field name="level" position="after">
                <field name="doo_param_id" string="SSI Employee Parameter"/>
                <field name="upf_param_id" string="UPF Parameter"/>
                <field name="ppf_param_id" string="PPF Parameter"/>
                <field name="zo_param_id" string="PHI Parameter"/>
                <field name="tzbp_param_id" string="OAD Parameter"/>
            </field>

            <!-- Add filters for parameter configuration -->
            <xpath expr="//filter[@name='occupation']" position="after">
                <separator/>
                <filter string="With SSI Employee Parameter"
                        name="has_doo_emp_param"
                        domain="[('doo_param_id','!=',False)]"/>
                <filter string="With UPF Parameter"
                        name="has_upf_param"
                        domain="[('upf_param_id','!=',False)]"/>
                <filter string="With PPF Parameter"
                        name="has_ppf_param"
                        domain="[('ppf_param_id','!=',False)]"/>
                <filter string="With PHI Parameter"
                        name="has_zo_param"
                        domain="[('zo_param_id','!=',False)]"/>
                <filter string="With OAD Parameter"
                        name="has_tzbp_param"
                        domain="[('tzbp_param_id','!=',False)]"/>
                <separator/>
                <filter string="With Insurance Rates"
                        name="has_insurance_rates"
                        domain="['|','|','|','|','|',('doo_emp_1959_rate','>',0),('doo_er_1959_rate','>',0),('ppf_rate','>',0),('doo_er_1960_rate','>',0),('upf_er_rate','>',0),('tzbp_rate','>',0)]"/>
                <filter string="No Insurance Configuration"
                        name="no_insurance_config"
                        domain="[('doo_param_id','=',False),('upf_param_id','=',False),('ppf_param_id','=',False),('zo_param_id','=',False),('tzbp_param_id','=',False)]"/>
            </xpath>

            <!-- Add a group of options -->
            <xpath expr="//filter[@name='education_level']" position="after">
                <filter string="SSI Parameter"
                        name="doo_emp_param"
                        context="{'group_by': 'doo_param_id'}"/>
                <filter string="PPF Parameter"
                        name="ppf_param"
                        context="{'group_by': 'ppf_param_id'}"/>
                <filter string="UPF Parameter"
                        name="upf_param"
                        context="{'group_by': 'upf_param_id'}"/>
                <filter string="PHI Parameter"
                        name="zo_param"
                        context="{'group_by': 'zo_param_id'}"/>
                <filter string="OAD Parameter"
                        name="tzbp_param"
                        context="{'group_by': 'tzbp_param_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit NKPD Classification Kanban View - Add insurance rate info -->
    <record id="view_bg_ncop_classification_kanban_inherit" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.kanban.inherit</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="inherit_id" ref="l10n_bg_payroll_classifications.view_bg_ncop_classification_kanban"/>
        <field name="arch" type="xml">
            <!-- Add rate fields to the kanban view -->
            <field name="qualification_group" position="after">
                <field name="doo_emp_1959_rate"/>
                <field name="doo_er_1959_rate"/>
                <field name="doo_emp_1960_rate"/>
                <field name="doo_er_1960_rate"/>
                <field name="upf_emp_rate"/>
                <field name="upf_er_rate"/>
                <field name="ppf_rate"/>
                <field name="tzbp_rate"/>
            </field>

            <!-- Add insurance rates display in kanban template -->
            <xpath expr="//li[last()]" position="after">
                <li t-if="record.doo_emp_1959_rate.raw_value > 0">
                    <strong>DOO Employee:</strong> <field name="doo_emp_1959_rate"/>%
                </li>
                <li t-if="record.doo_er_1959_rate.raw_value > 0">
                    <strong>DOO Employer:</strong> <field name="doo_er_1959_rate"/>%
                </li>
                <li t-if="record.doo_emp_1960_rate.raw_value > 0">
                    <strong>DOO Employee:</strong> <field name="doo_emp_1960_rate"/>%
                </li>
                <li t-if="record.doo_er_1960_rate.raw_value > 0">
                    <strong>DOO Employer:</strong> <field name="doo_er_1960_rate"/>%
                </li>
                <li t-if="record.upf_emp_rate.raw_value > 0">
                    <strong>UPF Employee:</strong> <field name="upf_emp_rate"/>%
                </li>
                <li t-if="record.upf_er_rate.raw_value > 0">
                    <strong>UPF Employer:</strong> <field name="upf_er_rate"/>%
                </li>
                <li t-if="record.ppf_rate.raw_value > 0">
                    <strong>PPF:</strong> <field name="ppf_rate"/>%
                </li>
                <li t-if="record.tzbp_rate.raw_value > 0">
                    <strong>OAD:</strong> <field name="tzbp_rate"/>%
                </li>
            </xpath>
        </field>
    </record>

    <!-- New List View specifically for Insurance Parameter Management -->
    <record id="view_bg_ncop_classification_insurance_list" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.insurance.list</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="arch" type="xml">
            <list string="NCOP Insurance Parameters"
                  expand="0" create="1" edit="1" delete="1"
                  editable="bottom">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="level" readonly="1"/>
                <field name="qualification_group" readonly="1"/>
                <field name="doo_param_id"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="upf_param_id"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="tzbp_param_id"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="tzbp_param_value_code"/>
                <field name="doo_emp_1959_rate" readonly="1" widget="percentage"/>
                <field name="doo_er_1959_rate" readonly="1" widget="percentage"/>
                <field name="doo_emp_1960_rate" readonly="1" widget="percentage"/>
                <field name="doo_er_1960_rate" readonly="1" widget="percentage"/>
                <field name="upf_emp_rate" readonly="1" widget="percentage"/>
                <field name="upf_er_rate" readonly="1" widget="percentage"/>
                <field name="ppf_rate" readonly="1" widget="percentage"/>
                <field name="zo_emp_rate" readonly="1" widget="percentage"/>
                <field name="zo_er_rate" readonly="1" widget="percentage"/>
                <field name="tzbp_rate" readonly="1" widget="percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action for Insurance Parameter Management -->
    <record id="action_bg_ncop_classification_insurance_params" model="ir.actions.act_window">
        <field name="name">NCOP Insurance Parameters</field>
        <field name="res_model">bg.hr.payroll.ncop.classification</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bg_ncop_classification_insurance_list"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Insurance Parameters for NCOP Classifications!
            </p>
            <p>
                Set up insurance parameter references for each NCOP classification.
                The system will automatically compute rates using hierarchical fallback.
            </p>
        </field>
    </record>

    <!-- Server Action for Bulk Parameter Update -->
    <record id="action_server_bulk_update_parameters" model="ir.actions.server">
        <field name="name">Bulk Update Parameter References</field>
        <field name="model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
# Bulk update parameter references from XML
action = records.action_update_parameter_references_from_xml()
        </field>
    </record>

    <!-- Server Action for Parameter Validation -->
    <record id="action_server_validate_parameters" model="ir.actions.server">
        <field name="name">Validate Parameter Setup</field>
        <field name="model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
# Validate parameter setup for selected records
for record in records:
    action = record.action_validate_parameter_setup()
        </field>
    </record>

    <!-- Server Action for Parameter Sync -->
    <record id="action_server_sync_parameters" model="ir.actions.server">
        <field name="name">Sync with XML Parameters</field>
        <field name="model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_model_id" ref="l10n_bg_payroll_classifications.model_bg_hr_payroll_ncop_classification"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
# Sync a single record with XML parameters
for record in records:
    action = record.action_sync_with_xml_parameters()
        </field>
    </record>

    <!-- Window Action for Parameter Management Tools -->
    <record id="action_parameter_management_tools" model="ir.actions.act_window">
        <field name="name">Parameter Management Tools</field>
        <field name="res_model">bg.hr.payroll.ncop.classification</field>
        <field name="view_mode">list</field>
        <field name="context">{
            'search_default_active': 1,
            'search_default_no_insurance_config': 1
        }</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Parameter Management Tools
            </p>
            <p>
                Use the server actions from the "Action" menu to:
                <ul>
                    <li>Bulk update parameter references from XML</li>
                    <li>Validate parameter setup</li>
                    <li>Sync parameters with XML definitions</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>
