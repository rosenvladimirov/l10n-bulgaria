<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Employee Form View -->
    <record id="view_employee_form_inherit_bg_class" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.bg.class</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add Class Information Page -->
            <xpath expr="//page[@name='hr_payroll']" position="inside">
                <!-- Show contract info if available -->
                <group string="Active contract" invisible="not contract_id">
                    <field name="contract_id" readonly="1" options="{'no_create': True}"/>
                    <label for="l10n_bg_contract_wage" string="Basic salary" groups="hr.group_hr_manager"/>
                    <div groups="hr.group_hr_manager">
                        <field name="l10n_bg_contract_wage" readonly="1" class="oe_inline"/>
                        <field name="currency_id" readonly="1" class="oe_inline"/>
                    </div>
                </group>

                <group name="bg_class_info" string="Class and internship" groups="hr.group_hr_user" invisible="not contract_id">
                    <group name="class_period_group" string="Class period">
                        <field name="l10n_bg_initial_class_period" readonly="1"/>
                        <field name="l10n_bg_current_class_period" readonly="1"/>
                        <field name="l10n_bg_auto_class_increment" readonly="1"/>
                        <field name="l10n_bg_class_years_integer" readonly="1"/>
                        <field name="l10n_bg_class_years_decimal" readonly="1"/>
                    </group>
                    <group name="seniority_group" string="Work experience">
                        <field name="l10n_bg_seniority_years" readonly="1"/>
                        <field name="l10n_bg_seniority_allowance_rate" readonly="1" widget="percentage"/>
                        <field name="l10n_bg_computed_seniority_allowance" readonly="1"
                               widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Employee List View -->
    <record id="view_employee_list_inherit_bg_class" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit.bg.class</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <!-- Add a class years column after job_id -->
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="l10n_bg_class_years_integer" string="Класгодини" optional="hide"/>
                <field name="l10n_bg_seniority_years" string="Стаж (г.)" optional="hide"/>
                <field name="l10n_bg_computed_seniority_allowance" string="Добавка стаж" optional="hide"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Fallback Employee List View -->
    <record id="view_employee_list_inherit_bg_class_fallback" model="ir.ui.view">
        <field name="name">hr.employee.list.inherit.bg.class.fallback</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Fallback: Add at the end if specific field not found -->
            <xpath expr="//field[last()]" position="after">
                <field name="l10n_bg_class_years_integer" string="Класгодини" optional="hide"/>
                <field name="l10n_bg_seniority_years" string="Стаж (г.)" optional="hide"/>
                <field name="l10n_bg_computed_seniority_allowance" string="Добавка стаж" optional="hide"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Employee Search View -->
    <record id="view_employee_filter_inherit_bg_class" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.bg.class</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <!-- Add search fields -->
            <field name="department_id" position="after">
                <field name="l10n_bg_class_years_integer" string="Класгодини"/>
                <field name="l10n_bg_seniority_years" string="Стаж"/>
            </field>

            <!-- Add search filters at the end instead of before archived -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="with_seniority" string="Със стажова добавка"
                        domain="[('l10n_bg_computed_seniority_allowance', '>', 0)]"/>
                <filter name="auto_class_increment" string="Автоматично увеличение клас"
                        domain="[('l10n_bg_auto_class_increment', '=', True)]"/>
                <filter name="high_seniority" string="Високо стажови (>15г.)"
                        domain="[('l10n_bg_seniority_years', '>', 15)]"/>
                <filter name="experienced" string="Опитни (>5 класгодини)"
                        domain="[('l10n_bg_class_years_integer', '>', 5)]"/>
            </xpath>

            <!-- Add a group by options -->
            <xpath expr="//group[@expand='0']" position="inside">
                <filter name="group_class_years" string="По класгодини"
                        context="{'group_by': 'l10n_bg_class_years_integer'}"/>
                <filter name="group_seniority_range" string="По стаж (обхват)"
                        context="{'group_by': 'l10n_bg_seniority_years'}"/>
            </xpath>
        </field>
    </record>


    <!-- Fallback Employee Search View -->
    <record id="view_employee_filter_inherit_bg_class_fallback" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.bg.class.fallback</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Fallback: Add at the end of search if specific elements not found -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="with_seniority_fallback" string="Със стажова добавка"
                        domain="[('l10n_bg_computed_seniority_allowance', '>', 0)]"/>
                <filter name="auto_class_increment_fallback" string="Автоматично увеличение клас"
                        domain="[('l10n_bg_auto_class_increment', '=', True)]"/>

                <group expand="0" string="Групиране по български труд">
                    <filter name="group_class_years_fallback" string="По класгодини"
                            context="{'group_by': 'l10n_bg_class_years_integer'}"/>
                    <filter name="group_seniority_fallback" string="По стаж"
                            context="{'group_by': 'l10n_bg_seniority_years'}"/>
                </group>
            </xpath>
        </field>
    </record>
    
</odoo>
