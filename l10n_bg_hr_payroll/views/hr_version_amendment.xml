<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- CONTRACT AMENDMENTS VIEWS -->
    <!-- ================================================================== -->
    <!-- Amendment Form View -->
    <record id="view_l10n_bg_hr_contract_amendment_form" model="ir.ui.view">
        <field name="name">l10n_bg.hr.contract.amendment.form</field>
        <field name="model">l10n_bg.hr.version.amendment</field>
        <field name="inherit_id" ref="l10n_bg_hr.view_l10n_bg_hr_contract_amendment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- NAP Export Tab -->
                <page string="NAP Export" name="nap_export">
                    <group>
                        <group>
                            <field name="l10n_bg_nap_export_status"
                                   widget="badge"
                                   decoration-success="l10n_bg_nap_export_status == 'exported'"
                                   decoration-danger="l10n_bg_nap_export_status == 'error'"
                                   decoration-warning="l10n_bg_nap_export_status == 'pending'"/>
                            <field name="l10n_bg_nap_export_date"/>
                        </group>
                    </group>
                    <group string="Export History" col="1">
                        <field name="l10n_bg_nap_export_history_ids" nolabel="1">
                            <list string="Export History" create="false" edit="false">
                                <field name="export_date"/>
                                <field name="export_type"/>
                                <field name="status"
                                       widget="badge"
                                       decoration-success="status == 'success'"
                                       decoration-danger="status == 'error'"
                                       decoration-warning="status == 'pending'"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>