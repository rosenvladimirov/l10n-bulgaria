<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main Form View -->
        <record id="view_hr_payslip_nssi_declaration_form" model="ir.ui.view">
            <field name="name">hr.payslip.nssi.declaration.form</field>
            <field name="model">hr.payslip.nssi.declaration</field>
            <field name="arch" type="xml">
                <form string="NSSI Declaration">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="main_info" string="Main Information">
                                <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="payslip_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="version_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group name="declaration_info" string="Declaration Information">
                                <field name="month"/>
                                <field name="year"/>
                                <field name="correction_code"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Insurer and Insured Person Data" name="insurer_person">
                                <group>
                                    <group string="Insurer Data">
                                        <field name="company_uic"/>
                                    </group>
                                    <group string="Insured Person Data">
                                        <field name="employee_identification"/>
                                        <field name="identification_type"/>
                                        <field name="family_name"/>
                                        <field name="initials"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Insurance Information" name="insurance_info">
                                <group>
                                    <group string="Basic Data">
                                        <field name="insurance_type"/>
                                    </group>
                                    <group string="Insurance Periods">
                                        <div class="row">
                                            <div class="col-6"><label for="insurance_start_day_1" string="Period 1"/></div>
                                            <div class="col-3"><field name="insurance_start_day_1" nolabel="1" placeholder="Start"/></div>
                                            <div class="col-3"><field name="insurance_end_day_1" nolabel="1" placeholder="End"/></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6"><label for="insurance_start_day_2" string="Period 2"/></div>
                                            <div class="col-3"><field name="insurance_start_day_2" nolabel="1" placeholder="Start"/></div>
                                            <div class="col-3"><field name="insurance_end_day_2" nolabel="1" placeholder="End"/></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6"><label for="insurance_start_day_3" string="Period 3"/></div>
                                            <div class="col-3"><field name="insurance_start_day_3" nolabel="1" placeholder="Start"/></div>
                                            <div class="col-3"><field name="insurance_end_day_3" nolabel="1" placeholder="End"/></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6"><label for="insurance_start_day_4" string="Period 4"/></div>
                                            <div class="col-3"><field name="insurance_start_day_4" nolabel="1" placeholder="Start"/></div>
                                            <div class="col-3"><field name="insurance_end_day_4" nolabel="1" placeholder="End"/></div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6"><label for="insurance_start_day_5" string="Period 5"/></div>
                                            <div class="col-3"><field name="insurance_start_day_5" nolabel="1" placeholder="Start"/></div>
                                            <div class="col-3"><field name="insurance_end_day_5" nolabel="1" placeholder="End"/></div>
                                        </div>
                                    </group>
                                </group>
                            </page>
                            <page string="Worked Days and Hours" name="worked_days_hours">
                                <group>
                                    <group string="Days">
                                        <field name="insured_days_total"/>
                                        <field name="worked_days_with_insurance"/>
                                        <field name="sick_leave_days"/>
                                        <field name="child_care_days"/>
                                        <field name="days_without_insurance"/>
                                        <field name="unpaid_leave_days"/>
                                        <field name="sick_leave_days_with_employer_salary"/>
                                    </group>
                                    <group string="Hours">
                                        <field name="worked_hours_total"/>
                                        <field name="overtime_hours"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Qualification and Economic Activity" name="qualification_activity">
                                <group>
                                    <group string="Qualification">
                                        <field name="qualification_group"/>
                                    </group>
                                    <group string="Economic Activity">
                                        <field name="economic_activity_code"/>
                                        <field name="main_economic_activity"/>
                                        <field name="working_time_code"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Insurance Income" name="insurance_income">
                                <group>
                                    <group string="Health Insurance">
                                        <field name="health_insurance_income"/>
                                        <field name="health_insurance_rate_employer"/>
                                        <field name="health_insurance_rate_base_employer"/>
                                        <field name="health_insurance_rate_base_employee"/>
                                        <field name="health_only_income"/>
                                        <field name="health_only_rate"/>
                                    </group>
                                    <group string="State Social Insurance">
                                        <field name="insurance_income"/>
                                        <field name="doo_insurance_rate_employer"/>
                                        <field name="doo_insurance_rate_employee"/>
                                        <field name="tzpb_rate"/>
                                        <field name="guaranteed_fund_rate"/>
                                    </group>
                                </group>
                                <group string="Pension Funds">
                                    <group>
                                        <field name="teacher_pension_fund_rate"/>
                                        <field name="professional_pension_fund_rate"/>
                                    </group>
                                    <group>
                                        <field name="universal_pension_fund_rate_employer"/>
                                        <field name="universal_pension_fund_rate_employee"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Salary and Tax" name="salary_tax">
                                <group>
                                    <group>
                                        <field name="gross_salary"/>
                                        <field name="taxable_income"/>
                                        <field name="monthly_tax"/>
                                        <field name="net_salary"/>
                                    </group>
                                    <group>
                                        <field name="insurance_fund_code"/>
                                        <field name="source_flag"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter groups="hr_payroll.group_hr_payroll_user"/>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_hr_payslip_nssi_declaration_tree" model="ir.ui.view">
            <field name="name">hr.payslip.nssi.declaration.tree</field>
            <field name="model">hr.payslip.nssi.declaration</field>
            <field name="arch" type="xml">
                <list string="NSSI Declarations" decoration-info="correction_code=='1'" decoration-warning="correction_code=='8'">
                    <field name="employee_id"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="correction_code"/>
                    <field name="insurance_type"/>
                    <field name="gross_salary" sum="Total Gross"/>
                    <field name="insurance_income" sum="Total Insurance Income"/>
                    <field name="insured_days_total" sum="Total Insured Days"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hr_payslip_nssi_declaration_search" model="ir.ui.view">
            <field name="name">hr.payslip.nssi.declaration.search</field>
            <field name="model">hr.payslip.nssi.declaration</field>
            <field name="arch" type="xml">
                <search string="Search NSSI Declarations">
                    <field name="employee_id"/>
                    <field name="year"/>
                    <field name="month"/>
                    <field name="employee_identification"/>
                    <field name="family_name"/>

                    <filter string="Regular Data" name="regular_data" domain="[('correction_code', '=', '0')]"/>
                    <filter string="Corrective Data" name="corrective_data" domain="[('correction_code', '=', '1')]"/>
                    <filter string="Deletion Data" name="deletion_data" domain="[('correction_code', '=', '8')]"/>

                    <filter string="My Department" name="my_department" domain="[('employee_id.department_id.member_ids', 'in', uid)]"/>

                    <separator/>
                    <filter string="Current Year" name="current_year" domain="[('year', '=', time.strftime('%Y'))]"/>
                    <filter string="Current Month" name="current_month" domain="[('month', '=', time.strftime('%m'))]"/>

                    <group>
                        <filter string="Employee" name="employee" domain="[]" context="{'group_by':'employee_id'}"/>
                        <filter string="Year" name="year" domain="[]" context="{'group_by':'year'}"/>
                        <filter string="Month" name="month" domain="[]" context="{'group_by':'month'}"/>
                        <filter string="Correction Type" name="correction" domain="[]" context="{'group_by':'correction_code'}"/>
                        <filter string="Insured Person Type" name="insurance_type" domain="[]" context="{'group_by':'insurance_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Calendar View -->
        <record id="view_hr_payslip_nssi_declaration_calendar" model="ir.ui.view">
            <field name="name">hr.payslip.nssi.declaration.calendar</field>
            <field name="model">hr.payslip.nssi.declaration</field>
            <field name="arch" type="xml">
                <calendar string="NSSI Declarations" date_start="create_date" color="employee_id">
                    <field name="employee_id"/>
                    <field name="month"/>
                    <field name="year"/>
                    <field name="gross_salary"/>
                </calendar>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_hr_payslip_nssi_declaration_graph" model="ir.ui.view">
            <field name="name">hr.payslip.nssi.declaration.graph</field>
            <field name="model">hr.payslip.nssi.declaration</field>
            <field name="arch" type="xml">
                <graph string="NSSI Declarations" type="bar">
                    <field name="month"/>
                    <field name="gross_salary" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hr_payslip_nssi_declaration" model="ir.actions.act_window">
            <field name="name">NSSI Declarations</field>
            <field name="res_model">hr.payslip.nssi.declaration</field>
            <field name="view_mode">tree,form,calendar,graph</field>
            <field name="search_view_id" ref="view_hr_payslip_nssi_declaration_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new NSSI declaration
                </p>
                <p>
                    NSSI declarations contain information about the employee's insurable income and contributions.
                </p>
            </field>
        </record>

        <record id="view_hr_contract_form_nssi_tab" model="ir.ui.view">
            <field name="name">hr.version.form.nssi.certificate.tab</field>
            <field name="model">hr.version</field>
            <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="NSSI Declarations" name="nssi_declarations">
                        <field name="l10n_bg_nssi_declaration_ids" context="{'default_contract_id': id}">
                            <list editable="bottom" multi_edit="1" open_form_view="True">
                                <field name="month"/>
                                <field name="year"/>
                                <field name="correction_code"/>
                                <field name="insurance_type"/>
                                <field name="gross_salary"/>
                                <field name="insurance_income"/>
                                <field name="insured_days_total"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
