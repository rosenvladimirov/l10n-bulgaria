<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extended HR Version List View -->
    <record id="hr_version_list_view_extended" model="ir.ui.view">
        <field name="name">hr.version.list.extended</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_version_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="l10n_bg_ncop_position_id" optional="hide"/>
                <field name="l10n_bg_effective_mod" optional="hide" string="MOD (лв.)"/>
                <field name="l10n_bg_contract_duration_type" optional="hide"/>
                <field name="l10n_bg_nap_export_status" optional="show"
                       badge="success:l10n_bg_nap_export_status == 'exported';danger:l10n_bg_nap_export_status == 'error';warning:l10n_bg_nap_export_status == 'pending'"/>
            </xpath>
        </field>
    </record>

    <!-- Extended HR Version Search View -->
    <record id="hr_version_search_view_extended" model="ir.ui.view">
        <field name="name">hr.version.search.extended</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_version_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="l10n_bg_ncop_position_id"/>
                <field name="l10n_bg_economic_activity_id"/>
                <field name="l10n_bg_qualification_group"/>
            </xpath>

            <xpath expr="//filter[@name='archived']" position="after">
                <separator/>
                <filter string="Fixed Term" name="fixed_term" domain="[('l10n_bg_contract_duration_type','=','fixed_term')]"/>
                <filter string="Indefinite" name="indefinite" domain="[('l10n_bg_contract_duration_type','=','indefinite')]"/>
                <separator/>
                <filter string="Not Exported to NAP" name="not_exported_nap" domain="[('l10n_bg_nap_export_status','=','not_exported')]"/>
                <filter string="Successfully Exported" name="exported_nap" domain="[('l10n_bg_nap_export_status','=','exported')]"/>
                <filter string="Export Errors" name="export_errors" domain="[('l10n_bg_nap_export_status','=','error')]"/>
            </xpath>

            <xpath expr="//filter[@name='group_by_structure_type_id']" position="after">
                <separator/>
                <filter string="NKPD Position" name="ncop_position" context="{'group_by': 'l10n_bg_ncop_position_id'}"/>
                <filter string="Economic Activity" name="economic_activity" context="{'group_by': 'l10n_bg_economic_activity_id'}"/>
                <filter string="NAP Export Status" name="nap_export_status" context="{'group_by': 'l10n_bg_nap_export_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>