<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Дървовиден изглед -->
    <record id="view_nssi_leave_reason_tree" model="ir.ui.view">
        <field name="name">nssi.leave.reason.tree</field>
        <field name="model">nssi.leave.reason</field>
        <field name="arch" type="xml">
            <list string="NSSI Leave Reasons" default_order="code">
                <field name="code" width="80"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Формулярен изглед -->
    <record id="view_nssi_leave_reason_form" model="ir.ui.view">
        <field name="name">nssi.leave.reason.form</field>
        <field name="model">nssi.leave.reason</field>
        <field name="arch" type="xml">
            <form string="NSSI Leave Reason">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Действие -->
    <record id="action_nssi_leave_reason" model="ir.actions.act_window">
        <field name="name">NSSI Leave Reasons</field>
        <field name="res_model">nssi.leave.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new leave reason code
            </p>
            <p>Official list used in Appendix №9 to NSSI.</p>
        </field>
    </record>

</odoo>
