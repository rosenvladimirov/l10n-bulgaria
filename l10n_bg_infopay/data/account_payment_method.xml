<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!--
        Един account.payment.method, който InfoPay payment bridges
        (l10n_bg_infopay_oca_payment + l10n_bg_infopay_ee_payment)
        ползват за маршрутизация.  След 01.01.2026 България е в
        еврозоната и Borica маркира `-bgn` endpoint-ите (domestic
        credit, budget, bulk domestic) като ``deprecated: true`` в
        integration_openapi.yaml — всички плащания минават през
        SEPA EUR endpoint-ите (single + bulk).

        За НАП/мита/община (бюджетни плащания) операторът ползва
        банковия портал ръчно до публикуването на
        `/api/payments/domestic-budget-transfers-eur` от Borica.

        Code naming: `l10n_bg_infopay_<endpoint-shorthand>` per the
        l10n_bg_ prefix rule for new identifiers in БГ localization
        modules.

        payment_type: 'outbound' (we only initiate outgoing transfers;
        InfoPay does not expose an inbound API).
    -->

    <!--
        Кодът остава `l10n_bg_infopay_sepa_eur` (не се преименува —
        чупи references), но display name-ът е „InfoPay Credit Transfer
        (EUR)“ за да не звучи „само за чужбина“: SEPA Credit Transfer
        покрива и вътрешнодържавни (BG→BG в EUR), и трансгранични
        EUR плащания.  Стандартен (SEPA) или Instant (INST) се избира
        per-order чрез `l10n_bg_infopay_service_level`.
    -->
    <record id="account_payment_method_infopay_sepa_eur"
            model="account.payment.method">
        <field name="name">InfoPay Credit Transfer (EUR)</field>
        <field name="code">l10n_bg_infopay_sepa_eur</field>
        <field name="payment_type">outbound</field>
    </record>

</odoo>
