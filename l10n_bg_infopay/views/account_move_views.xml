<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_move_form_infopay_invoice" model="ir.ui.view">
        <field name="name">account.move.form.infopay.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Issue button next to the standard "Send & Print" header
                 group.  Visible only when the journal is configured for
                 InfoPay invoice issuance and the move is posted. -->
            <xpath expr="//header" position="inside">
                <button name="action_l10n_bg_infopay_issue"
                        type="object"
                        string="Issue via InfoPay"
                        invisible="not l10n_bg_infopay_can_issue"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- Status badge in the header chips area. -->
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="l10n_bg_infopay_state"
                       widget="statusbar"
                       statusbar_visible="not_sent,sent"
                       invisible="not journal_id or not l10n_bg_infopay_invoice_id and l10n_bg_infopay_state == 'not_sent'"/>
            </xpath>

            <!-- Detail page in the notebook. -->
            <xpath expr="//notebook" position="inside">
                <page name="l10n_bg_infopay" string="InfoPay"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group>
                            <field name="l10n_bg_infopay_state" readonly="1"/>
                            <field name="l10n_bg_infopay_invoice_id" readonly="1"/>
                            <field name="l10n_bg_infopay_sent_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="l10n_bg_infopay_can_issue" invisible="1"/>
                        </group>
                    </group>
                    <group string="Last error"
                           invisible="l10n_bg_infopay_state != 'error'">
                        <field name="l10n_bg_infopay_error" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
