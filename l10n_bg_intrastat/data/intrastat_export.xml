<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Main intrastat report export for Bulgaria -->
    <template id="intrastat_report_export_xml">
        <INSTAT>
            <Envelope>
                <t t-call="l10n_bg_intrastat.DateTime"/>
                <t t-call="l10n_bg_intrastat.Party">
                    <t t-set="type" t-value="'PSI'"/>
                    <t t-set="role" t-value="'PSI'"/>
                </t>
                <t t-call="l10n_bg_intrastat.Declaration">
                    <t t-set="reception" t-value="True"/>
                    <t t-set="items" t-value="in_vals"/>
                </t>
                <numberOfDeclarations t-out="number_of_declarations"/>
            </Envelope>
        </INSTAT>
    </template>

    <template id="DateTime">
        <DateTime>
            <date t-out="sending_date.strftime('%Y-%m-%d')"/>
            <time t-out="sending_date.strftime('%H:%M:%S')"/>
        </DateTime>
    </template>

    <template id="Party">
        <Party t-att-partyType="type" t-att-partyRole="role">
            <partyId t-out="party_contact.uid"/>
            <partyIdType t-out="party_contact.uid_type"/>
            <t t-call="l10n_bg_intrastat.Address"/>
            <t t-call="l10n_bg_intrastat.ContactPerson"/>
        </Party>
    </template>

    <template id="Address">
        <Address>
            <streetNumber t-out="party_contact.street_number"/>
            <city t-out="party_contact.city"/>
            <postalCode t-if="party_contact.zip" t-out="party_contact.zip"/>
<!--            <adresas t-if="company.street" t-out="company.street"/>-->
            <phoneNumber t-if="party_contact.phone" t-out="party_contact.phone"/>
            <faxNumber t-if="party_contact.fax" t-out="party_contact.fax"/>
        </Address>
    </template>

    <template id="ContactPerson">
        <ContactPerson>
            <contactPersonName t-out="envelope_contact.name"/>
            <t t-call="l10n_bg_intrastat.ContactPersonAddress"/>
        </ContactPerson>
    </template>

    <template id="ContactPersonAddress">
        <ContactPersonAddress>
            <streetNumber t-out="envelope_contact.street_number"/>
            <city t-out="envelope_contact.city"/>
            <postalCode t-if="envelope_contact.zip" t-out="envelope_contact.zip"/>
            <phoneNumber t-if="envelope_contact.phone" t-out="envelope_contact.phone"/>
            <faxNumber t-if="envelope_contact.fax" t-out="envelope_contact.fax"/>
            <e-mail t-if="envelope_contact.email" t-out="envelope_contact.email"/>
        </ContactPersonAddress>
    </template>

    <template id="Declaration">
        <t t-if="items">
            <Declaration>
                <referencePeriod t-out="date"/>
                <PSIId t-out="company.uid"/>
                <PSIIdType t-out="company.uid_type"/>
                <Function t-out="function"/>
                <flowCode t-out="'A' if reception else 'D'" />
                <totalNetMass t-out="total_net_mass"/>
                <totalInvoicedAmount t-out="total_invoiced_amount" />
                <totalStatisticalValue t-out="total_statistical_value"/>
                <totalNumberDetailedLines t-out="len(items)"/>
                <t t-call="l10n_bg_intrastat.Item" />
            </Declaration>
        </t>
    </template>

    <template id="Item">
        <t t-foreach="items" t-as="item">
            <Item>
                <itemNumber t-out="item['itemNumber']"/>
                <CN8>
                    <CN8Code t-out="item['local_code']"/>
                </CN8>
                <goodsDescription t-out="item['goods_description'] or ''" />
                <MSConsDestCode
                    t-out="company.account_fiscal_country_id.code if reception else item['country_code']"
                />
                <vinNumber t-out="item['vat_number']"/>
                <countryOfOriginCode
                    t-out="item['intrastat_product_origin_country_code']"
                />
                <MSConsDestCode t-out="item['src_dest_country']"/>
                <nationalityOfTransportVehicle t-out="item['origin_transport']"/>
                <netMass t-out="item['weight']" />
                <invoicedAmount t-out="item['value']" />
                <statisticalValue t-out="item['statistical_value']"/>
                <supplementaryUnit t-out="item['supplementary_unit']"/>
                <t t-call="l10n_bg_intrastat.NatureOfTransaction" />
                <modeOfTransportCode
                    t-if="item.get('transport_code')"
                    t-out="item['transport_code']"
                />
                <regionCode
                    t-if="item.get('region_code')"
                    t-out="item['region_code']"
                />
                <t t-call="l10n_bg_intrastat.DeliveryTerms" />
                <action t-out="item['action']"/>

            </Item>
        </t>
    </template>

    <template id="NatureOfTransaction">
        <t t-if="item.get('transaction_code')">
            <NatureOfTransaction>
                <natureOfTransactionACode t-out="item['transaction_code'][0]" />
                <natureOfTransactionBCode t-out="item['transaction_code'][1]" />
            </NatureOfTransaction>
        </t>
    </template>

    <template id="DeliveryTerms">
        <t t-if="item.get('incoterm_code')">
            <DeliveryTerms>
                <TODCode t-out="item['incoterm_code']" />
            </DeliveryTerms>
        </t>
    </template>

</odoo>
