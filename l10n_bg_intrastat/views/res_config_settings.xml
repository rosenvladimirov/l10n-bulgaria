<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Bulgarian Intrastat Configuration Settings
    Adds intrastat region field to accounting settings
    -->

    <record id="res_config_settings_view_form_intrastat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bg.intrastat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
            Try to add to an intrastat section if it exists
            Otherwise, will be added elsewhere in the settings
            -->
            <xpath expr="//div[@name='intrastat_right_pane']" position="inside">
                <div class="content-group" invisible="country_code != 'BG'">
                    <div class="mt16">
                        <field name="company_country_id" invisible="1"/>
                        <label for="l10n_bg_intrastat_region_id"/>
                        <field
                            name="l10n_bg_intrastat_region_id"
                            context="{
                                'search_view_ref': 'account_intrastat.view_intrastat_code_restricted_type_search',
                                'form_view_ref': 'account_intrastat.view_intrastat_code_restricted_type_form',
                                'default_type': 'region',
                                'default_country_id': company_country_id
                            }"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            role="img"
                            aria-label="Values set here are company-specific."
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>