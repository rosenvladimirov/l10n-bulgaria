<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- New invoice report template with COPY -->
    <template id="report_invoice_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="original_copies">COPY</t>
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                   t-call="account.report_invoice_document"
                   t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- New invoice report with payments template with COPY -->
    <template id="report_invoice_with_payments_copy">
        <t t-call="l10n_bg_invoice_copy.report_invoice_copy">
            <t t-set="print_with_payments" t-value="True"/>
        </t>
    </template>
</odoo>
