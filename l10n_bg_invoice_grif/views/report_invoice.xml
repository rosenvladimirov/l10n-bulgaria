<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Inject "Гриф" field into the informations section ═══════════ -->
    <template id="report_invoice_document_grif"
              inherit_id="account.report_invoice_document">
        <!-- Default: ОРИГИНАЛ (unless overridden by the copy template) -->
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-if="not original_copies">
                <t t-set="original_copies">ОРИГИНАЛ</t>
            </t>
        </xpath>

        <!-- Add Гриф column at the end of #informations -->
        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col-auto col-3 mw-100 mb-2" name="grif">
                <strong>Гриф:</strong>
                <p class="m-0" t-out="original_copies"/>
            </div>
        </xpath>
    </template>

    <!-- ═══ Copy report: wraps the invoice with КОПИЕ ═══════════════════ -->
    <template id="report_invoice_copy">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="original_copies">КОПИЕ</t>
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                   t-call="account.report_invoice_document"
                   t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_with_payments_copy">
        <t t-call="l10n_bg_invoice_grif.report_invoice_copy">
            <t t-set="print_with_payments" t-value="True"/>
        </t>
    </template>

    <!-- ═══ Report actions ══════════════════════════════════════════════ -->
    <record id="action_report_invoice_copy" model="ir.actions.report">
        <field name="name">Invoice (Copy)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_invoice_grif.report_invoice_copy</field>
        <field name="report_file">l10n_bg_invoice_grif.report_invoice_copy</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_invoice_with_payments_copy" model="ir.actions.report">
        <field name="name">Invoice with Payments (Copy)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_invoice_grif.report_invoice_with_payments_copy</field>
        <field name="report_file">l10n_bg_invoice_grif.report_invoice_with_payments_copy</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
