#. module: l10n_bg_kep_sign
#: model:ir.model,name:l10n_bg_kep_sign.model_l10n_bg_kep_sign
msgid "KEP Signing Engine (pluggable)"
msgstr "Механизъм за подписване с КЕП (разширяем)"

#. module: l10n_bg_kep_sign
#: code:addons/l10n_bg_kep_sign/models/kep_sign.py:0
msgid ""
"No КЕП signing provider configured for company %s (Settings → Accounting → "
"KEP Signing)."
msgstr ""
"Няма конфигуриран доставчик за подписване с КЕП за фирма %s (Настройки → "
"Счетоводство → Подписване с КЕП)."

#. module: l10n_bg_kep_sign
#: model:ir.model.fields.selection,name:l10n_bg_kep_sign.selection__res_company__l10n_bg_kep_sign_provider__none
msgid "None"
msgstr "Няма"

#. module: l10n_bg_kep_sign
#: model:ir.model.fields,help:l10n_bg_kep_sign.field_res_company__l10n_bg_kep_sign_provider
msgid ""
"Which backend signs documents with the qualified e-signature: StampIT "
"(browser) or the local Odoo.ErpNet.FP proxy (server)."
msgstr ""
"Кой backend подписва документите с квалифициран електронен подпис: StampIT "
"(браузър) или локалното Odoo.ErpNet.FP прокси (сървър)."

#. module: l10n_bg_kep_sign
#: code:addons/l10n_bg_kep_sign/models/kep_sign.py:0
msgid ""
"КЕП provider '%(p)s' is not installed or is browser-side only (no server-"
"side signing). Install the matching glue module."
msgstr ""
"КЕП доставчикът '%(p)s' не е инсталиран или е само браузърен (без сървърно "
"подписване). Инсталирайте съответния glue модул."

