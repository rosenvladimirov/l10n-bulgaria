<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Добави полета в производствената поръчка -->
    <record id="view_mrp_production_form_labor_cost" model="ir.ui.view">
        <field name="name">mrp.production.form.labor.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Добави smart button за journal entry -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_labor_journal_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="labor_journal_entry_id == False">
                    <field name="labor_journal_entry_id" invisible="1"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Labor</span>
                        <span class="o_stat_text">Entry</span>
                    </div>
                </button>
            </xpath>

            <!-- Добави групa с labor информация -->
            <xpath expr="//group[@name='group_order_info']" position="after">
                <group string="Labor Costs" name="group_labor_costs">
                    <group>
                        <field name="total_labor_cost"
                               widget="monetary"
                               readonly="1"/>
                        <field name="labor_cost_per_unit"
                               widget="monetary"
                               readonly="1"/>
                    </group>
                    <group>
                        <field name="labor_accounting_enabled" invisible="1"/>
                        <field name="labor_journal_entry_id"
                               readonly="1"
                               invisible="labor_journal_entry_id == False"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Добави колони в tree view -->
    <record id="view_mrp_production_tree_labor_cost" model="ir.ui.view">
        <field name="name">mrp.production.tree.labor.cost</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="total_labor_cost"
                       optional="hide"
                       widget="monetary"/>
                <field name="labor_cost_per_unit"
                       optional="hide"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>

    <!-- Work Order view - покажи labor cost -->
    <record id="view_mrp_workorder_form_labor_cost" model="ir.ui.view">
        <field name="name">mrp.workorder.form.labor.cost</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='time']" position="after">
                <group string="Labor Cost" name="group_labor_cost">
                    <field name="employee_hourly_cost"
                           widget="monetary"
                           readonly="1"/>
                    <field name="real_labor_cost"
                           widget="monetary"
                           readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
