<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Добави конфигурация в Company settings -->
    <record id="view_company_form_labor_accounting" model="ir.ui.view">
        <field name="name">res.company.form.labor.accounting</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account']" position="after">
                <page string="Manufacturing Accounting" name="manufacturing_accounting">
                    <group>
                        <group string="Labor Cost Accounting">
                            <field name="labor_accounting_enabled"/>
                            <field name="labor_expense_account_id"
                                   required="labor_accounting_enabled"/>
                            <field name="wip_account_id"
                                   required="labor_accounting_enabled"/>
                            <field name="manufacturing_journal_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
