
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- NKPD Classification Tree View -->
    <record id="view_bg_ncop_classification_tree" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.tree</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="arch" type="xml">
            <list string="NKPD Classifications" expand="0" create="1" edit="1" delete="1">
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="qualification_group"/>
                <field name="education_level"/>
                <field name="skill_level"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- NKPD Classification Form View -->
    <record id="view_bg_ncop_classification_form" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.form</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="arch" type="xml">
            <form string="NKPD Classification">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Position Name"/></h1>
                        <h2><field name="code" placeholder="NKPD Code"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="level"/>
                            <field name="parent_id" domain="[('level', 'in', ['major_group', 'sub_major_group', 'minor_group', 'unit_group'])]"/>
                            <field name="qualification_group"/>
                            <field name="skill_level"/>
                        </group>
                        <group>
                            <field name="education_level"/>
                            <field name="experience_years"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Validity Period">
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skills Requirements">
                            <field name="skills_requirements" placeholder="Describe required skills and competencies..."/>
                        </page>
                        <page string="Child Positions" invisible="level == 'occupation'">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="qualification_group"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- NKPD Classification Search View -->
    <record id="view_bg_ncop_classification_search" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.search</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="arch" type="xml">
            <search string="Search NKPD Classifications">
                <field name="name" string="Position Name"/>
                <field name="code" string="NKPD Code"/>
                <field name="qualification_group"/>
                <field name="level"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Military" name="military" domain="[('qualification_group','=','military')]"/>
                <filter string="Managers" name="managers" domain="[('qualification_group','=','manager')]"/>
                <filter string="Specialists" name="specialists" domain="[('qualification_group','=','specialist')]"/>
                <filter string="Technicians" name="technicians" domain="[('qualification_group','=','technician')]"/>
                <filter string="Clerks" name="clerks" domain="[('qualification_group','=','clerk')]"/>
                <filter string="Service Workers" name="service" domain="[('qualification_group','=','service')]"/>
                <filter string="Skilled Workers" name="skilled" domain="[('qualification_group','=','skilled')]"/>
                <filter string="Machine Operators" name="operators" domain="[('qualification_group','=','operator')]"/>
                <filter string="Elementary" name="elementary" domain="[('qualification_group','=','elementary')]"/>
                <separator/>
                <filter string="Major Group" name="major_group" domain="[('level','=','major_group')]"/>
                <filter string="Sub-Major Group" name="sub_major_group" domain="[('level','=','sub_major_group')]"/>
                <filter string="Minor Group" name="minor_group" domain="[('level','=','minor_group')]"/>
                <filter string="Unit Group" name="unit_group" domain="[('level','=','unit_group')]"/>
                <filter string="Occupation" name="occupation" domain="[('level','=','occupation')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Level" name="level" context="{'group_by': 'level'}"/>
                    <filter string="Qualification Group" name="qualification_group" context="{'group_by': 'qualification_group'}"/>
                    <filter string="Education Level" name="education_level" context="{'group_by': 'education_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- NKPD Classification Kanban View -->
    <record id="view_bg_ncop_classification_kanban" model="ir.ui.view">
        <field name="name">bg.hr.payroll.ncop.classification.kanban</field>
        <field name="model">bg.hr.payroll.ncop.classification</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="level"/>
                <field name="qualification_group"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="code"/> - <field name="name"/>
                                </strong>
                                <ul>
                                    <li><strong>Level:</strong> <field name="level"/></li>
                                    <li><strong>Qualification:</strong> <field name="qualification_group"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- NKPD Classification Action -->
    <record id="action_bg_ncop_classification" model="ir.actions.act_window">
        <field name="name">NCOP Classifications</field>
        <field name="res_model">bg.hr.payroll.ncop.classification</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="view_bg_ncop_classification_tree"/>
        <field name="search_view_id" ref="view_bg_ncop_classification_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NKPD Classification!
            </p>
            <p>
                NKPD (National Classification of Professions and Positions) is used for:
            </p>
            <ul>
                <li>Defining job positions and their requirements</li>
                <li>MOD (Minimum Insurance Income) calculations</li>
                <li>Labor Code compliance</li>
            </ul>
        </field>
    </record>

</odoo>
