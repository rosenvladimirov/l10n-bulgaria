<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Инхерит на формата за hr.job -->
        <record id="view_hr_job_form_bg_ncop" model="ir.ui.view">
            <field name="name">hr.job.form.bg.ncop</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <!-- Добавяне на НКПД поле след department_id -->
                <field name="department_id" position="after">
                    <field name="l10n_bg_ncop_position_id"
                           options="{'no_create': True, 'no_create_edit': True}"
                           placeholder="Изберете НКПД позиция..."/>
                </field>

                <!-- Добавяне на нов таб за НКПД информация -->
                <page name="job_description_page" position="after">
                    <page string="NCOP Information" name="ncop_info_page">
                        <group>
                            <group name="ncop_basic_info">
                                <field name="l10n_bg_ncop_position_id" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Hierarchy and requirements"/>
                        <field name="description"
                               widget="html"
                               readonly="1"
                               placeholder="Select an NCOP position to view the hierarchy and requirements..."/>
                    </page>
                </page>
            </field>
        </record>

        <!-- Добавяне на НКПД поле в списъчен изглед -->
        <record id="view_hr_job_tree_bg_ncop" model="ir.ui.view">
            <field name="name">hr.job.list.bg.ncop</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="l10n_bg_ncop_position_id" optional="show"/>
                </field>
            </field>
        </record>

        <!-- Добавяне на филтър за търсене по НКПД -->
        <record id="view_job_filter_bg_ncop" model="ir.ui.view">
            <field name="name">hr.job.search.bg.ncop</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_job_filter"/>
            <field name="arch" type="xml">
                <field name="department_id" position="after">
                    <field name="l10n_bg_ncop_position_id" string="НКПД Позиция"/>
                </field>

                <filter name="employment_type" position="after">
                    <filter string="NCOP Position" name="ncop_position" domain="[]" context="{'group_by': 'l10n_bg_ncop_position_id'}"/>
                </filter>
            </field>
        </record>

    </data>
</odoo>
