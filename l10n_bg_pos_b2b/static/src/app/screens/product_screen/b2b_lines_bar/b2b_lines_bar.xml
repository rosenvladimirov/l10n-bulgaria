<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Акордеонът за едро: секция „Редове“ -->
    <t t-name="l10n_bg_pos_b2b.B2bLinesBar">
        <div class="o_l10n_bg_b2b_lines_bar d-flex align-items-center gap-2 px-2 py-1 border-bottom bg-view small" role="button" t-on-click="toggle">
            <span class="fw-bold">Order Lines</span>
            <span class="badge text-bg-secondary" t-esc="order.lines.length"/>
            <span t-if="!expanded" class="text-muted">Total: <t t-esc="total"/></span>
            <span class="ms-auto text-muted"><i t-attf-class="fa {{ expanded ? 'fa-chevron-up' : 'fa-chevron-down' }}"/></span>
        </div>
    </t>
</templates>
