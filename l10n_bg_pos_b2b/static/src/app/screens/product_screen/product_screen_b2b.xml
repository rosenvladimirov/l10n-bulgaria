<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- B2B блокът — над редовете на ядрото, само в режим „Wholesale“ -->
    <t t-name="l10n_bg_pos_b2b.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <!-- Плъзгане наляво/надясно между двата прозореца -->
        <xpath expr="//div[hasclass('leftpane')]" position="attributes">
            <attribute name="t-on-touchstart">l10nBgTouchStart</attribute>
            <attribute name="t-on-touchend">l10nBgTouchEnd</attribute>
        </xpath>
        <xpath expr="//OrderSummary" position="before">
            <L10nBgB2bTabs t-if="currentOrder?.l10n_bg_wholesale"/>
            <L10nBgB2bHeader t-if="currentOrder?.l10n_bg_wholesale and currentOrder.l10nBgPanel === 'header'"/>
        </xpath>
        <!-- „Данни на поръчката“: без редовете, цифровия панел и Payment;
             бутоните (Клиент, Wholesale, Отстъпка...) остават долу -->
        <xpath expr="//OrderSummary" position="attributes">
            <attribute name="t-if">!(currentOrder?.l10n_bg_wholesale and currentOrder.l10nBgPanel === 'header')</attribute>
        </xpath>
        <xpath expr="//div[hasclass('subpads')]" position="attributes">
            <attribute name="t-att-class">{'d-none': currentOrder?.l10n_bg_wholesale and currentOrder.l10nBgPanel === 'header'}</attribute>
        </xpath>
    </t>

    <t t-name="l10n_bg_pos_b2b.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons and l10nBgShowWholesaleButton"
                    class="btn btn-lg o_l10n_bg_wholesale_button text-truncate"
                    t-att-class="currentOrder?.l10n_bg_wholesale ? 'btn-primary active' : 'btn-secondary'"
                    t-on-click="() => this.l10nBgToggleWholesale()">
                <i t-attf-class="fa {{ currentOrder?.l10n_bg_wholesale ? 'fa-check-square-o' : 'fa-building-o' }} me-1"/>Wholesale
            </button>
            <button t-if="!props.showRemainingButtons and currentOrder?.l10n_bg_wholesale"
                    class="btn btn-secondary btn-lg o_l10n_bg_b2b_discount_button text-truncate"
                    t-att-disabled="!currentOrder.lines.length"
                    t-on-click="() => this.l10nBgClickDiscount()">
                <i class="fa fa-tag me-1"/>Discount %
            </button>
        </xpath>
        <!-- Малък екран: бутонът е в диалога „Actions“ -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/button[hasclass('o_pricelist_button')]" position="before">
            <button t-if="this.pos.isSmallProductScreen and l10nBgShowWholesaleButton"
                    class="o_l10n_bg_wholesale_button"
                    t-att-class="buttonClass"
                    t-on-click="() => this.l10nBgToggleWholesale()">
                <i t-attf-class="fa {{ currentOrder?.l10n_bg_wholesale ? 'fa-check-square-o' : 'fa-building-o' }} me-1"/>Wholesale
            </button>
            <button t-if="this.pos.isSmallProductScreen and currentOrder?.l10n_bg_wholesale"
                    class="o_l10n_bg_b2b_discount_button"
                    t-att-class="buttonClass"
                    t-on-click="() => this.l10nBgClickDiscount()">
                <i class="fa fa-tag me-1"/>Discount %
            </button>
        </xpath>
    </t>
</templates>
