<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Офертата (SO) в „Данни на поръчката“ (ADR specs/pos-b2b-wholesale/0003) -->
    <t t-name="l10n_bg_pos_b2b_sale.B2bHeader" t-inherit="l10n_bg_pos_b2b.B2bHeader" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_l10n_bg_b2b_customer')]" position="after">
            <div class="o_l10n_bg_b2b_quotation mt-2 p-2 border rounded bg-100">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-file-text-o"/>
                    <t t-if="quotation">
                        <span class="fw-bold o_l10n_bg_b2b_quotation_name" t-esc="quotation.name"/>
                        <span class="badge text-bg-info" t-esc="quotation.state"/>
                    </t>
                    <span t-else="" class="text-muted">Not saved as a quotation yet</span>
                    <span t-if="isOffline" class="ms-auto text-danger small">Offline: quotations need a connection</span>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary flex-fill o_l10n_bg_b2b_save_quotation"
                            t-att-disabled="!canSaveQuotation" t-on-click="l10nBgSaveQuotation">
                        <i t-attf-class="fa {{ state.saving ? 'fa-spinner fa-spin' : 'fa-save' }} me-1"/>
                        <t t-if="quotation">Update quotation</t><t t-else="">Save as quotation</t>
                    </button>
                    <button class="btn btn-secondary flex-fill o_l10n_bg_b2b_print_quotation"
                            t-att-disabled="!quotation" t-on-click="() => this.l10nBgPrint('quotation')">
                        <i class="fa fa-print me-1"/>Quotation
                    </button>
                    <button class="btn btn-secondary flex-fill o_l10n_bg_b2b_print_pro_forma"
                            t-att-disabled="!quotation" t-on-click="() => this.l10nBgPrint('pro_forma')">
                        <i class="fa fa-print me-1"/>Pro-forma
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
