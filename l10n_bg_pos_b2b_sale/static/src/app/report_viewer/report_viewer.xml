<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_bg_pos_b2b_sale.ReportViewer">
        <div class="o_l10n_bg_report_viewer position-absolute top-0 start-0 w-100 h-100 d-flex flex-column bg-view" style="z-index: 10;">
            <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                <i class="fa fa-print"/>
                <span class="fw-bold text-truncate" t-esc="report.title"/>
                <button class="btn btn-lg btn-secondary ms-auto o_l10n_bg_report_close" t-on-click="close">
                    <i class="fa fa-times me-1"/>Close
                </button>
            </div>
            <iframe class="flex-grow-1 w-100 border-0 o_l10n_bg_report_frame" t-att-src="viewerUrl" t-att-data-report="report.url"/>
        </div>
    </t>

    <!-- Десният екран на касата: печатът е над продуктите -->
    <t t-name="l10n_bg_pos_b2b_sale.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="inside">
            <L10nBgReportViewer t-if="pos.l10nBgReport"/>
        </xpath>
    </t>

    <!-- Едро само с връзка (ADR 0003): „Wholesale“ е заключен офлайн -->
    <t t-name="l10n_bg_pos_b2b_sale.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_l10n_bg_wholesale_button')]" position="attributes">
            <attribute name="t-att-disabled">pos.data.network.offline and !currentOrder?.l10n_bg_wholesale</attribute>
        </xpath>
    </t>
</templates>
