<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_accepted__delivery" model="ir.actions.report">
        <field name="name">Accepted delivery report</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_report_stock.report_accepted_deliveryslip</field>
        <field name="report_file">l10n_bg_report_stock.report_accepted_deliveryslip</field>
        <field name="print_report_name">'Accepted delivery report - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="context">{'l10n_bg_report_stock_accepted': True}</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_handover_protocol" model="ir.actions.report">
        <field name="name">Handover protocol</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_report_stock.report_handover_protocol</field>
        <field name="report_file">l10n_bg_report_stock.report_handover_protocol</field>
        <field name="print_report_name">'Handover protocol - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
