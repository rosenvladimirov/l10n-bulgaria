<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Main category for theme groups -->
        <record id="category_l10n_bg_report_theme" model="ir.module.category">
            <field name="name">BG Report Theme</field>
            <field name="description">Access management for different sections in Bulgarian reports</field>
            <field name="sequence">25</field>
        </record>

        <!-- Group for due date control -->
        <record id="group_control_due_date" model="res.groups">
            <field name="name">Payment Due Date Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control payment due dates in invoices</field>
        </record>

        <!-- Group for delivery date control -->
        <record id="group_control_delivery_date" model="res.groups">
            <field name="name">Delivery Date Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control delivery dates in invoices</field>
        </record>

        <!-- Group for parties signatures control -->
        <record id="group_control_signatures" model="res.groups">
            <field name="name">Parties Signatures Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view the signatures section for deal parties in invoices</field>
        </record>

        <!-- Group for date format control -->
        <record id="group_control_date_format" model="res.groups">
            <field name="name">Date Format Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can control date formats (with or without time)</field>
        </record>

        <!-- Group for deal date control -->
        <record id="l10n_bg_deal_date" model="res.groups">
            <field name="name">Deal Date Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control deal dates in documents</field>
        </record>

        <!-- Group for represent person control -->
        <record id="group_control_represent_person" model="res.groups">
            <field name="name">Represent Person Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control represent person information in documents</field>
        </record>

        <record id="group_control_sale_person" model="res.groups">
            <field name="name">Sale Person Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control sale person information in sales</field>
        </record>

        <record id="group_control_sale_description" model="res.groups">
            <field name="name">Sale Description Control</field>
            <field name="category_id" ref="category_l10n_bg_report_theme"/>
            <field name="comment">Users who can view and control sale order line descriptions in stock reports</field>
        </record>
    </data>
</odoo>
