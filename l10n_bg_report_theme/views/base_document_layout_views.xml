<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_base_document_layout" model="ir.ui.view">
        <field name="name">Document Layout</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='logo']" position="after">
                <field name="logo_print" widget="image" options="{'size': [0, 50]}" />
            </xpath>
            <xpath expr="//field[@name='layout_background_image']" position="replace"/>
            <xpath expr="//label[@for='primary_color']" position="replace"/>
            <xpath expr="//div[hasclass('o_document_layout_colors')]" position="replace"/>
            <xpath expr="//group" position="after">
                <group>
                    <group string="Base &amp; Selection theme Colors">
                        <separator string="Selection theme Colors" colspan="2"/>
                        <field name="selection_colors" nolabel="1" colspan="2">
                            <list create="false" delete="false" editable="top">
                                <field name="name" readonly="1" force_save="1"/>
                                <field name="color" widget="color" force_save="1" on_change="1"/>
                                <field name="color_rgb" column_invisible="1" force_save="1"/>
                            </list>
                        </field>
                        <separator string="Base Colors" colspan="2"/>
                        <div class="o_document_layout_colors d-flex align-items-end mb-4">
                            <field name="primary_color" widget="color" class="w-auto m-0 me-1"/>
                            <field name="secondary_color" widget="color" class="w-auto m-0"/>
                            <button name="action_reset_to_default"
                                    type="object"
                                    string="Reset SCSS Colors"
                                    class="btn btn-link pt-0"
                                    icon="fa-refresh"/>
                            <a class="o_custom_colors btn btn-secondary btn-sm position-relative ms-2" role="button" title="Reset to logo colors" invisible="not custom_colors">
                                <i class="fa fa-repeat"/> Reset
                                <field name="custom_colors" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" nolabel="1"/>
                            </a>
                        </div>
                    </group>
                    <group string="Background images" invisible="layout_background != 'Custom'">
                        <separator string="Portrait" colspan="2" invisible="layout_background != 'Custom'"/>
                        <field
                            name="layout_background_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your article file 247x210mm</field>
                        <field
                            name="layout_background_header_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your header file 30x210mm</field>
                        <field
                            name="layout_background_footer_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your footer file 20x210mm</field>
                        <separator string="Landscape"  colspan="2" invisible="layout_background != 'Custom'"/>
                        <field
                            name="layout_background_l_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your article file</field>
                        <field
                            name="layout_background_l_header_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your header file</field>
                        <field
                            name="layout_background_l_footer_image"
                            options="{'accepted_file_extensions': 'image/*'}"
                            invisible="layout_background != 'Custom'"
                            required="layout_background == 'Custom'"
                        >Upload your footer file</field>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
