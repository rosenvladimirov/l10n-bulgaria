<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw" active="False">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="before">
            <t t-set="o" t-value="doc" />
        </xpath>
    </template>
    <template
        id="report_saleorder_pro_forma"
        inherit_id="sale.report_saleorder_pro_forma"
        active="False"
    >
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="before">
            <t t-set="o" t-value="doc" />
        </xpath>
    </template>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
        priority="99"
        active="False"
    >
        <xpath expr="//t[@t-set='doc']" position="after">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-if="o.name != '/'">
                <t t-set="name" t-value="o.name"/>
            </t>
            <t t-else="">
                <t t-set="name" t-value="''" />
            </t>
            <t t-if="env.context.get('proforma', False) or is_pro_forma">
                <t t-set="sender" t-value="o.company_id.partner_id" />
                <t t-set="recipient" t-value="o.partner_id" />
                <t t-set="name_label">Pro-Forma Invoice #</t>
                <t t-set="no_deal_partner" t-value="False" />
                <t t-set="name_date" t-value="format_date(o.date_order, lang_code=o.partner_id.lang, widget='date')"/>
            </t>
            <t t-else="">
                <t t-if="o.state in ['draft','sent'] and not is_proforma">
                    <t t-set="name_label">Quotation #</t>
                </t>
                <t t-elif="o.state not in ['draft','sent'] and not is_proforma">
                    <t t-set="name_label">Order #</t>
                </t>
                <t t-if="o.name != '/'">
                    <t t-set="no_deal_partner" t-value="True" />
                    <t t-set="sender" t-value="o.company_id.partner_id" />
                    <t t-set="recipient" t-value="o.partner_id" />
                    <t t-set="recipient_invoice_id" t-value="o.partner_invoice_id" />
                    <t t-set="recipient_shipping_id" t-value="o.partner_shipping_id" />
                    <t t-set="name_date" t-value="format_date(o.date_order, lang_code=o.partner_id.lang)"/>
                </t>
            </t>
        </xpath>

        <!-- Добавяме условие към адресната секция -->
        <xpath expr="//t[@t-set='address']" position="attributes">
            <attribute name="t-if">not no_deal_partner and show_address</attribute>
        </xpath>

        <xpath expr="//div[@name='informations_date']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_delivery_date</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_sale_person</attribute>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
    </template>
</odoo>
