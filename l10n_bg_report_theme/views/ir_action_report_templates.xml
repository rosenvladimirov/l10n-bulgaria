<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw" active="False">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="before">
            <t t-set="o" t-value="doc" />
        </xpath>
    </template>
    <template
        id="report_saleorder_pro_forma"
        inherit_id="sale.report_saleorder_pro_forma"
        active="False"
    >
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="before">
            <t t-set="o" t-value="doc" />
        </xpath>
    </template>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
        priority="99"
        active="False"
    >
        <xpath expr="//t[@t-set='doc']" position="after">
            <t t-set="o" t-value="doc.with_context(lang=doc.partner_id.lang)" />
        </xpath>
        <!-- Добавяме данни за изпълнителя и получатела -->
        <xpath expr="//t[@t-set='is_proforma']" position="after">
            <t t-set="sender" t-value="o.company_id.partner_id" />
            <t t-if="not sender_vat_label">
                <t t-set="sender_vat_label" t-value="sender.country_id.vat_label" />
            </t>
            <t t-if="not sender_vat_label">
                <t t-set="sender_vat_label">TIN</t>
            </t>
            <t t-if="env.context.get('proforma', False) or is_pro_forma">
                <t t-set="recipient" t-value="o.partner_id" />
                <t t-set="name_date" t-value="format_date(o.date_order, lang_code=o.partner_id.lang, widget='date')"/>
            </t>
            <t t-else="">
                <t t-if="o.name != '/'">
                    <t t-set="recipient" t-value="None" />
                    <t t-set="name_date" t-value="format_date(o.date_order, lang_code=o.partner_id.lang, widget='date')" groups="!l10n_bg_report_theme.group_control_date_format"/>
                    <t t-set="name_date" t-value="format_date(o.date_order, lang_code=o.partner_id.lang)" groups="l10n_bg_report_theme.group_control_date_format"/>
                </t>
            </t>
            <t groups="l10n_bg_report_theme.group_control_address_swap">
                <t t-set="information_block">
                    <t t-set="recipient_contact_id" t-value="o.partner_id if o.partner_id.parent_id else None" t-if="not recipient_contact_id"/>
                    <t t-set="recipient_invoice_id" t-value="o.partner_invoice_id" t-if="o.partner_id != o.partner_invoice_id"/>
                    <t t-set="recipient_invoice_id" t-value="o.partner_id" t-if="o.partner_id == o.partner_invoice_id"/>
                    <t t-set="recipient_shipping_id" t-value="o.partner_shipping_id" />
                    <t t-if="not recipient_vat_label">
                        <t t-set="recipient_vat_label" t-value="recipient_invoice_id.country_id.vat_label" />
                    </t>
                    <t t-if="not recipient_vat_label">
                        <t t-set="recipient_vat_label">TIN</t>
                    </t>
                    <t t-if="recipient_contact_id">
                        <strong class="o_section_labels">The Attention of:</strong>
                        <div t-field="recipient_contact_id.name" />
                        <div
                            t-out="recipient_contact_id"
                            name="contact_name"
                            t-options="{'widget': 'contact', 'fields': ['phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"
                        />
                    </t>
                    <div
                        name="invoice_shipping_address"
                        t-if="recipient_shipping_id and recipient_invoice_id"
                    >
                        <strong
                            class="o_section_labels"
                            t-if="recipient_shipping_id == recipient_invoice_id"
                        >Invoicing and shipping address:</strong>
                        <strong
                            class="o_section_labels"
                            t-if="recipient_shipping_id != recipient_invoice_id"
                        >Invoicing address:</strong>
                    </div>
                    <t t-if="recipient_invoice_id">
                        <div
                            t-out="recipient_invoice_id"
                            t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"
                            name="invoice_address"
                        />
                        <p t-if="recipient_invoice_id.vat"><t t-esc="recipient_vat_label" />: <span
                                t-field="recipient_invoice_id.vat"
                            /></p>
                    </t>
                    <t
                        t-if="recipient_shipping_id and recipient_invoice_id and recipient_shipping_id != recipient_invoice_id"
                    >
                        <div name="shipping_address">
                            <strong class="o_section_labels">Shipping address:</strong>
                            <div
                                t-out="recipient_shipping_id"
                                t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"
                            />
                        </div>
                    </t>
                </t>
                <t t-set="address" t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                    <strong class="o_section_labels mt-2 d-block" t-if="sender">From:</strong>
                    <div
                        t-if="sender"
                        t-out="sender"
                        t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"
                    />
                    <div name="company_vat_number" t-if="sender and sender.vat"><span
                            t-if="sender"
                            t-esc="sender_vat_label"
                        />: <span t-if="sender" t-field="sender.vat" /></div>
                </t>
                <t t-if="env.context.get('proforma', False) or is_pro_forma">
                    <t t-set="address" t-value="None" />
<!--                    <t t-set="information_block" t-value="None"/>-->
                </t>
            </t>
        </xpath>

        <xpath expr="//div[@name='informations_date']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_delivery_date</attribute>
        </xpath>
        <xpath expr="//div[@t-if='doc.user_id.name']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_sale_person</attribute>
        </xpath>
    </template>
</odoo>
