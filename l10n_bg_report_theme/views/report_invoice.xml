<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" active="False">
        <xpath expr="//t[@t-set='o']" position="after">
            <t t-set="sender" t-value="o.company_id.partner_id"/>
            <t t-set="recipient" t-value="o.partner_id.parent_id and o.partner_id.parent_id or o.partner_id"/>
            <t t-set="original_copies">ORIGINAL</t>
            <t t-set="name_date" t-value="format_date(o.invoice_date, lang_code=o.partner_id.lang, date_format='medium')"/>
        </xpath>

        <xpath expr="//div[@id='informations']" position="inside">
            <div class="col" t-if="o.l10n_bg_deal_date" name="l10n_bg_deal_date" groups="l10n_bg_report_theme.l10n_bg_deal_date">
                <strong>Deal Date</strong>
                <div t-field="o.l10n_bg_deal_date">2023-09-25</div>
            </div>
        </xpath>

        <!-- Add groups attribute to the due_date div -->
        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_due_date</attribute>
        </xpath>

        <!-- Add groups attribute to the delivery_date div -->
        <xpath expr="//div[@name='delivery_date']" position="attributes">
            <attribute name="groups">l10n_bg_report_theme.group_control_delivery_date</attribute>
        </xpath>

    </template>
</odoo>
