l10n_bg_applicability = 'gfo_pl'
l10n_bg_extract_basis = 'turnover' (всички редове на ОПР са оборотни)
l10n_bg_position: expense (10xxx, 11xxx, 14200, 14300) | revenue (15xxx, 16xxx)
Note: subtotals (10000, 11000, 13000, 14000, 14100, 14400, 14500, 15000, 16000,
18000, 19000, 19100, 19200, 19500) са template-computed, не са tags.
-->
