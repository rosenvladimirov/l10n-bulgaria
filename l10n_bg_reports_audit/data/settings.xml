<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <settings>
        <!-- Odoo 19: tax tag-овете в БГ localization нямат +/- префикс (sign-ът се
             определя от repartition_type/document_type). Старият списък
             "-11,+11,..." дублираше всеки tag заради знака; обединено в едно име. -->
        <setting model="account.account.tag" field="l10n_bg_applicability" value="sale">11,12_1,12_2,13,14,15,16,17,18,19,21,22,23,24</setting>
        <setting model="account.account.tag" field="l10n_bg_applicability" value="purchase">30,31,32,41,42</setting>
    </settings>
</configuration>
