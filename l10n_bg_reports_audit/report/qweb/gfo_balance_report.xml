<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report action -->
    <record id="action_report_gfo_balance" model="ir.actions.report">
        <field name="name">ГФО — Счетоводен баланс</field>
        <field name="model">l10n.bg.gfo.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_reports_audit.gfo_balance_pdf</field>
        <field name="report_file">l10n_bg_reports_audit.gfo_balance_pdf</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- QWeb template — pixel-perfect срещу НСИ Прил.1 Балалс -->
    <template id="gfo_balance_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 9pt;">
                    <!-- Header -->
                    <div style="margin-bottom: 12px; display: flex; justify-content: space-between;">
                        <div style="border: 1px solid #000; padding: 6px; width: 60%;">
                            <strong>Отчетна единица:</strong>
                            <span t-out="company.name"/>
                            <br/>
                            <span t-out="company.street or ''"/>
                            <t t-if="company.city">, <span t-out="company.city"/></t>
                        </div>
                        <div style="border: 1px solid #000; padding: 6px; width: 35%; text-align: right;">
                            <strong>ЕИК по БУЛСТАТ:</strong>
                            <span t-out="company.vat or company.company_registry or ''"/>
                        </div>
                    </div>

                    <h2 style="text-align: center; margin: 16px 0;">
                        СЧЕТОВОДЕН БАЛАНС КЪМ
                        <span t-out="wizard.date_to.strftime('%d.%m.%Y')"/>
                        ГОДИНА
                    </h2>

                    <!-- АКТИВ table -->
                    <table class="table table-sm" style="border-collapse: collapse; width: 100%; font-size: 9pt;">
                        <thead>
                            <tr style="background: #f0f0f0;">
                                <th colspan="5" style="text-align: center; border: 1px solid #000;">АКТИВ</th>
                            </tr>
                            <tr style="background: #f8f8f8;">
                                <th style="border: 1px solid #000;">Раздели, групи, статии</th>
                                <th style="border: 1px solid #000; width: 70px;">Код на реда</th>
                                <th style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Сума хил. лв.<br/>текуща година<br/>
                                    (<span t-out="year_current"/>)
                                </th>
                                <th t-if="show_previous" style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Сума хил. лв.<br/>предходна година<br/>
                                    (<span t-out="year_previous"/>)
                                </th>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; text-align: center;">а</td>
                                <td style="border: 1px solid #000; text-align: center;">б</td>
                                <td style="border: 1px solid #000; text-align: center;">1</td>
                                <td t-if="show_previous" style="border: 1px solid #000; text-align: center;">2</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="asset_rows" t-as="row">
                                <td t-att-style="
                                    'border: 1px solid #000; padding: 2px 4px;'
                                    + (' padding-left: %dpx;' % (4 + 14 * row['indent']))
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['label']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: center; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['code']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] != 'section' and row['row_type'] != 'group'">
                                        <span t-out="'%.0f' % (row['value'] / 1000.0) if row['value'] else ''"/>
                                    </t>
                                </td>
                                <td t-if="show_previous" t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] not in ('section', 'group') and row['value_prev'] is not None">
                                        <span t-out="'%.0f' % (row['value_prev'] / 1000.0) if row['value_prev'] else ''"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ПАСИВ table -->
                    <div style="page-break-before: always;"></div>
                    <table class="table table-sm" style="border-collapse: collapse; width: 100%; font-size: 9pt;">
                        <thead>
                            <tr style="background: #f0f0f0;">
                                <th colspan="5" style="text-align: center; border: 1px solid #000;">ПАСИВ</th>
                            </tr>
                            <tr style="background: #f8f8f8;">
                                <th style="border: 1px solid #000;">Раздели, групи, статии</th>
                                <th style="border: 1px solid #000; width: 70px;">Код на реда</th>
                                <th style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Сума хил. лв.<br/>текуща година
                                </th>
                                <th t-if="show_previous" style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Сума хил. лв.<br/>предходна година
                                </th>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; text-align: center;">а</td>
                                <td style="border: 1px solid #000; text-align: center;">б</td>
                                <td style="border: 1px solid #000; text-align: center;">1</td>
                                <td t-if="show_previous" style="border: 1px solid #000; text-align: center;">2</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="liability_rows" t-as="row">
                                <td t-att-style="
                                    'border: 1px solid #000; padding: 2px 4px;'
                                    + (' padding-left: %dpx;' % (4 + 14 * row['indent']))
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['label']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: center; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['code']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] != 'section' and row['row_type'] != 'group'">
                                        <span t-out="'%.0f' % (row['value'] / 1000.0) if row['value'] else ''"/>
                                    </t>
                                </td>
                                <td t-if="show_previous" t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] not in ('section', 'group') and row['value_prev'] is not None">
                                        <span t-out="'%.0f' % (row['value_prev'] / 1000.0) if row['value_prev'] else ''"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Footer signatures -->
                    <div style="margin-top: 24px;">
                        <div style="display: flex; justify-content: space-between;">
                            <div style="width: 48%;">
                                <strong>Ръководител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                                <small>(име, презиме, фамилия)</small>
                            </div>
                            <div style="width: 48%;">
                                <strong>Подпис:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-top: 12px;">
                            <div style="width: 48%;">
                                <strong>Съставител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                                <small>(име, презиме, фамилия)</small>
                            </div>
                            <div style="width: 48%;">
                                <strong>Дата:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
