<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gfo_cf" model="ir.actions.report">
        <field name="name">ГФО — Отчет за паричните потоци (пряк метод)</field>
        <field name="model">l10n.bg.gfo.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_reports_audit.gfo_cf_pdf</field>
        <field name="report_file">l10n_bg_reports_audit.gfo_cf_pdf</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="gfo_cf_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 9pt;">
                    <div style="margin-bottom: 12px; display: flex; justify-content: space-between;">
                        <div style="border: 1px solid #000; padding: 6px; width: 60%;">
                            <strong>Отчетна единица:</strong> <span t-out="company.name"/>
                        </div>
                        <div style="border: 1px solid #000; padding: 6px; width: 35%; text-align: right;">
                            <strong>ЕИК по БУЛСТАТ:</strong>
                            <span t-out="company.vat or company.company_registry or ''"/>
                        </div>
                    </div>

                    <h2 style="text-align: center; margin: 16px 0;">
                        ОТЧЕТ ЗА ПАРИЧНИТЕ ПОТОЦИ ПО ПРЕКИЯ МЕТОД ЗА
                        <span t-out="year_current"/> ГОДИНА
                    </h2>

                    <table style="border-collapse: collapse; width: 100%; font-size: 8pt;">
                        <thead>
                            <tr style="background: #f8f8f8;">
                                <th rowspan="2" style="border: 1px solid #000;">Наименование на паричните потоци</th>
                                <th rowspan="2" style="border: 1px solid #000; width: 60px;">Код</th>
                                <th colspan="3" style="border: 1px solid #000; text-align: center;">Текущ период (хил. лв.)</th>
                            </tr>
                            <tr style="background: #f8f8f8;">
                                <th style="border: 1px solid #000; width: 70px; text-align: right;">Постъпления</th>
                                <th style="border: 1px solid #000; width: 70px; text-align: right;">Плащания</th>
                                <th style="border: 1px solid #000; width: 70px; text-align: right;">Нетен поток</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="cf_rows" t-as="row">
                                <td t-att-style="
                                    'border: 1px solid #000; padding: 2px 4px;'
                                    + (' padding-left: %dpx;' % (4 + 14 * row['indent']))
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['label']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: center; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['code']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] not in ('section', 'leaf_x')">
                                        <span t-out="'%.0f' % (row['inflow'] / 1000.0) if row['inflow'] else ''"/>
                                    </t>
                                    <t t-if="row['row_type'] == 'leaf_x'">х</t>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] not in ('section', 'leaf_x')">
                                        <span t-out="'%.0f' % (row['outflow'] / 1000.0) if row['outflow'] else ''"/>
                                    </t>
                                    <t t-if="row['row_type'] == 'leaf_x'">х</t>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] != 'section'">
                                        <span t-out="'%.0f' % (row['net'] / 1000.0) if row['net'] else ''"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top: 24px;">
                        <div style="display: flex; justify-content: space-between;">
                            <div style="width: 48%;">
                                <strong>Ръководител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                            <div style="width: 48%;">
                                <strong>Съставител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
