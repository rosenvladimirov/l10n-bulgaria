<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gfo_equity" model="ir.actions.report">
        <field name="name">ГФО — Отчет за собствения капитал</field>
        <field name="model">l10n.bg.gfo.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_bg_reports_audit.gfo_equity_pdf</field>
        <field name="report_file">l10n_bg_reports_audit.gfo_equity_pdf</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="gfo_equity_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 9pt;">
                    <div style="margin-bottom: 12px; display: flex; justify-content: space-between;">
                        <div style="border: 1px solid #000; padding: 6px; width: 60%;">
                            <strong>Отчетна единица:</strong> <span t-out="company.name"/>
                        </div>
                        <div style="border: 1px solid #000; padding: 6px; width: 35%; text-align: right;">
                            <strong>ЕИК по БУЛСТАТ:</strong>
                            <span t-out="company.vat or company.company_registry or ''"/>
                        </div>
                    </div>

                    <h2 style="text-align: center; margin: 16px 0;">
                        ОТЧЕТ ЗА СОБСТВЕНИЯ КАПИТАЛ ЗА
                        <span t-out="year_current"/> ГОДИНА
                    </h2>

                    <table style="border-collapse: collapse; width: 100%; font-size: 9pt;">
                        <thead>
                            <tr style="background: #f8f8f8;">
                                <th style="border: 1px solid #000;">Показатели</th>
                                <th style="border: 1px solid #000; width: 70px;">Код на реда</th>
                                <th style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Общо собствен капитал (хил. лв.)
                                </th>
                                <th t-if="show_previous" style="border: 1px solid #000; width: 90px; text-align: right;">
                                    Предходна година
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="equity_rows" t-as="row">
                                <td t-att-style="
                                    'border: 1px solid #000; padding: 2px 4px;'
                                    + (' padding-left: %dpx;' % (4 + 14 * row['indent']))
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['label']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: center; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <span t-out="row['code']"/>
                                </td>
                                <td t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] != 'leaf_x'">
                                        <span t-out="'%.0f' % (row['value'] / 1000.0) if row['value'] else ''"/>
                                    </t>
                                </td>
                                <td t-if="show_previous" t-att-style="
                                    'border: 1px solid #000; text-align: right; padding: 2px 4px;'
                                    + (' font-weight: bold;' if row['is_bold'] else '')
                                ">
                                    <t t-if="row['row_type'] != 'leaf_x' and row['value_prev'] is not None">
                                        <span t-out="'%.0f' % (row['value_prev'] / 1000.0) if row['value_prev'] else ''"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top: 24px;">
                        <div style="display: flex; justify-content: space-between;">
                            <div style="width: 48%;">
                                <strong>Ръководител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                            <div style="width: 48%;">
                                <strong>Съставител:</strong>
                                <div style="border-bottom: 1px solid #000; height: 24px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
