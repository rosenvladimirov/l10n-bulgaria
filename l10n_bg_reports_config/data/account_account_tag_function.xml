    <function name="write" model="account.account.tag">
        <function name="search" model="account.account.tag">
            <value
                eval="[('name', 'in', ['-30','+30','-31','+31','-32','+32','-41','+41','-42','+42'])]"
            />
        </function>
        <value eval="{'l10n_bg_applicability': 'purchase'}"/>
