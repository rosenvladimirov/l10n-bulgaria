            <value
                eval="[('name', 'in', ['-11','+11','-12_1','-12_2','+12_1','+12_2','-13','+13','-14','+14','-15','+15','-16','+16','-17','+17','-18','+18','-19','+19','-21','+21','-22','+22','-23','+23','-24','+24'])]"
            />
        </function>
        <value eval="{'l10n_bg_applicability': 'sale'}"/>
