<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <function name="write" model="account.account.tag">
        <function name="search" model="account.account.tag">
            <value
                eval="[('name', 'in', ['11','12_1','12_2','13','14','15','16','17','18','19','21','22','23','24'])]"
            />
        </function>
        <value eval="{'l10n_bg_applicability': 'sale'}"/>
    </function>
    <function name="write" model="account.account.tag">
        <function name="search" model="account.account.tag">
            <value
                eval="[('name', 'in', ['30','31','32','41','42'])]"
            />
        </function>
        <value eval="{'l10n_bg_applicability': 'purchase'}"/>
    </function>

    <function name="write" model="account.account.tag">
        <function name="search" model="account.account.tag">
            <value
                eval="[('name', 'in', ['50','60','70','71','80','81','82'])]"
            />
        </function>
        <value eval="{'l10n_bg_applicability': 'declaration'}"/>
    </function>
</odoo>
