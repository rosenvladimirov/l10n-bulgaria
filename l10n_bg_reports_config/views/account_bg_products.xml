<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_bg_product_pivot" model="ir.ui.view">
        <field name="name">account.bg.calc.product.line</field>
        <field name="model">account.bg.calc.product.line</field>
        <field name="arch" type="xml">
            <pivot string="Product Trail Balance" display_quantity="true">
                <field name="account_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="initial_balance_debit" type="measure"/>
                <field name="initial_balance_credit" type="measure"/>
                <field name="movement_balance_debit" type="measure"/>
                <field name="movement_balance_credit" type="measure"/>
                <field name="end_balance_debit" type="measure"/>
                <field name="end_balance_credit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_bg_product_pivot_graph" model="ir.ui.view">
        <field name="name">account.bg.calc.product.line.graph</field>
        <field name="model">account.bg.calc.product.line</field>
        <field name="arch" type="xml">
            <graph string="Product Trail Balance" type="line">
                <field name="account_id" type="row"/>
                <field name="movement_balance_debit" type="measure"/>
                <field name="movement_balance_credit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_account_bg_product_pivot" model="ir.actions.act_window">
        <field name="name">Product Trail Balance</field>
        <field name="res_model">account.bg.calc.product.line</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>
