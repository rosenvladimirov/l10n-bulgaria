<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_bg_report_tags" model="ir.ui.view">
        <field name="name">account.move.line.form.bg.report.tags</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information']" position="inside">
                <group string="BG Report Tags" name="l10n_bg_report_tags">
                    <field name="account_tag_ids"
                           widget="many2many_tags"
                           options="{'color_field': 'color'}"
                           readonly="parent_state == 'posted'"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_bg_report_tags" model="ir.ui.view">
        <field name="name">account.move.line.tree.bg.report.tags</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_tag_ids']" position="after">
                <field name="account_tag_ids"
                       widget="many2many_tags"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Преди тук имаше inherit на account.view_move_form за добавяне на
         account_tag_ids колона в Journal Items list. На Odoo SH staging
         (kopcheto-twbulgaria-staging-3268xxxx) XPath не може да намери
         <field name="line_ids">/<list> — друг inheriting view с по-висок
         priority видимо променя структурата преди нашия view да се зареди
         (в локалния dev v19 и в production същата структура е налична).
         BG Report Tags остават достъпни през двата view-а отгоре —
         account.move.line form + tree. -->
</odoo>
