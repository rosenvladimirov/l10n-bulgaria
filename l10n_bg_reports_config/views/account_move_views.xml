<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_config.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='account_bg_vat']"
                position="inside"
            >
                <field name="l10n_bg_name" />
                <field name="l10n_bg_date" />
                <field name="l10n_bg_narration" />
                <field name="l10n_bg_type_vat" />
                <field name="l10n_bg_doc_type" />
                <field name="l10n_bg_delivery_type" />
            </xpath>
            <xpath
                expr="//group[@id='account_bg_vat_entry']"
                position="inside"
            >
                <field name="l10n_bg_name" />
                <field name="l10n_bg_date" />
                <field name="l10n_bg_narration" />
                <field name="l10n_bg_type_vat" />
                <field name="l10n_bg_doc_type" />
                <field name="l10n_bg_delivery_type" />
            </xpath>
        </field>
    </record>
</odoo>
