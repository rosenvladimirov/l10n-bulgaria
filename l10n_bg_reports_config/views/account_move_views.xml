<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_bg_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_ledger.l10n_bg_move_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='l10n_bg_documents']"
                position="inside"
            >
                <field name="l10n_bg_name" invisible="1" force_save="1" />
                <field name="l10n_bg_date" />
                <field name="l10n_bg_narration" />
                <field name="l10n_bg_type_vat" />
                <field name="l10n_bg_doc_type" invisible="1" force_save="1" />
                <field name="l10n_bg_delivery_type" invisible="1" force_save="1" />
            </xpath>
        </field>
    </record>
    <record id="l10n_bg_view_move_form_base" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_config.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='account_bg_vat_entry']"
                position="inside"
            >
                <field name="l10n_bg_name" invisible="1" force_save="1" />
                <field string="Document Number" name="l10n_bg_document_number"/>
                <field name="l10n_bg_date" />
                <field name="l10n_bg_narration" />
                <field name="l10n_bg_type_vat" />
                <field string="Document Type" name="l10n_bg_document_type"/>
                <field string="Exemption reason" name="l10n_bg_exemption_reason"/>
                <field name="l10n_bg_doc_type" invisible="1" force_save="1" />
                <field name="l10n_bg_delivery_type" invisible="1" force_save="1" />
            </xpath>
        </field>
    </record>
</odoo>
