<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_tax_group_tree_l10n_bg_tags" model="ir.ui.view">
        <field name="name">account.tax.group.tree.l10n.bg.tags</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_bg_tax_tag_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_tax_group_form_l10n_bg_tags" model="ir.ui.view">
        <field name="name">account.tax.group.form.l10n.bg.tags</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_bg_tax_tag_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
