<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form" model="ir.ui.view">
            <field name="name">product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='accounting']" position="inside">
                    <group string="Bulgarian NSI Classification" name="l10n_bg_reporting">
                        <field
                            name="l10n_bg_account_tag_ids"
                            widget="many2many_tax_tags"
                            options="{'no_create': True, 'no_edit': True}"
                            groups="account.group_account_readonly"
                        />
                    </group>
                </xpath>
            </field>
        </record>
        <!-- Extend Product Template Search View -->
        <record id="l10n_bg_product_template_search_view" model="ir.ui.view">
            <field name="name">l10n.bg.product.template.search</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="l10n_bg_account_tag_ids"/>
                </field>
                <filter name="group_by_type" position="after">
                    <filter string="NSI Tags"
                            name="group_by_nsi_tags"
                            context="{'group_by': 'l10n_bg_account_tag_ids'}"
                            groups="account.group_account_readonly"/>
                </filter>
            </field>
        </record>
    </data>
</odoo>
