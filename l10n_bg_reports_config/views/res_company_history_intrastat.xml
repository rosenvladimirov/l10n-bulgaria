<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_l10n_bg_intrastat_threshold_list" model="ir.ui.view">
        <field name="name">l10n.bg.intrastat.threshold.list</field>
        <field name="model">l10n.bg.intrastat.threshold</field>
        <field name="arch" type="xml">
            <list string="Intrastat Thresholds">
                <field name="display_name"/>
                <field name="year"/>
                <field name="month"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="threshold_arrivals_standard"/>
                <field name="threshold_arrivals_extended"/>
                <field name="threshold_dispatches_standard"/>
                <field name="threshold_dispatches_extended"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l10n_bg_intrastat_threshold_form" model="ir.ui.view">
        <field name="name">l10n.bg.intrastat.threshold.form</field>
        <field name="model">l10n.bg.intrastat.threshold</field>
        <field name="arch" type="xml">
            <form string="Intrastat Threshold">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Arrivals (Intra-Community Acquisitions)" name="arrivals">
                            <group>
                                <field name="threshold_arrivals_extended" widget="monetary"/>
                                <field name="threshold_arrivals_standard" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Dispatches (Intra-Community Supplies)" name="dispatches">
                            <group>
                                <field name="threshold_dispatches_extended" widget="monetary"/>
                                <field name="threshold_dispatches_standard" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional information about this threshold..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l10n_bg_intrastat_threshold_search" model="ir.ui.view">
        <field name="name">l10n.bg.intrastat.threshold.search</field>
        <field name="model">l10n.bg.intrastat.threshold</field>
        <field name="arch" type="xml">
            <search string="Intrastat Thresholds">
                <field name="year"/>
                <field name="month"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Monthly" name="monthly" domain="[('month', '!=', False)]"/>
                <filter string="Annual" name="annual" domain="[('month', '=', False)]"/>
                <separator/>
                <filter string="Current Year" name="current_year"
                    domain="[('year', '=', context_today().year)]"/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by': 'month'}"/>
                    <filter string="Company" name="group_by_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l10n_bg_intrastat_threshold" model="ir.actions.act_window">
        <field name="name">Intrastat Thresholds</field>
        <field name="res_model">l10n.bg.intrastat.threshold</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_active': 1,
            'search_default_current_year': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Intrastat threshold
            </p>
            <p>
                Define thresholds for Intrastat reporting according to Bulgarian legislation.
                Thresholds determine when companies must submit Intrastat declarations
                for intra-Community acquisitions (arrivals) and supplies (dispatches).
            </p>
        </field>
    </record>

</odoo>
