<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_bg_reports</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="45" />
        <field name="inherit_id" ref="l10n_bg_config.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_bg_config']" position="inside">
                <block title="Settings" name="l10n_bg_audit_report">
                    <setting
                        id="l10n_bg_audit_oca_account_usability"
                        title="Account - Missing Menus"
                        string="Account - Missing Menus"
                        help="OCA: restores missing accounting menus."
                    >
                        <field name="module_account_usability" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_oca_account_financial_report"
                        title="Account Financial Reports (OCA)"
                        string="Account Financial Reports (OCA)"
                        help="OCA accounting financial reports engine."
                    >
                        <field name="module_account_financial_report" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_ee_setting"
                        title="Accounting Reports"
                        string="Accounting Reports"
                        help="EE accounting reports engine."
                    >
                        <field name="module_account_reports" widget="upgrade_boolean" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_assistant_setting"
                        title="Assistant"
                        string="Assistant"
                        help="Assistant to help configure Bulgarian accounting tags manually."
                    >
                        <button name="l10n_bg_reports_config.action_account_tags_bulk_edit"
                            string="Bulk Edit"
                            type="action"
                            class="oe_highlight"
                            groups="account.group_account_manager" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_by_file_setting"
                        title="Re configure"
                        string="Re configure"
                        help="Use the already loaded settings to reset everything to their original state."
                    >
                        <button name="action_update_l10n_bg_report_audit_settings"
                            string="Force re-configure"
                            type="object"
                            class="oe_highlight"
                            groups="account.group_account_manager" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_intra_stat_type"
                        title="Level of registration"
                        string="Level of registration"
                        help="Mandatory declaration thresholds. Calculate VAT base on formula."
                    >
                        <field name="l10n_bg_intra_stat_type" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_odoo_compatible"
                        title="Odoo compatible"
                        string="Odoo compatible"
                        help="Keep the declaration Odoo-compatible."
                    >
                        <field name="l10n_bg_odoo_compatible" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_intra_stat_incomes"
                        title="Intra-Community incomes"
                        string="Intra-Community incomes"
                        help="An obligation to submit intra-Community incomes."
                    >
                        <field name="l10n_bg_intra_stat_incomes" />
                    </setting>
                    <setting
                        id="l10n_bg_audit_intra_stat_outcomes"
                        title="Intra-Community supplies"
                        string="Intra-Community supplies"
                        help="An obligation to submit intra-Community supplies."
                    >
                        <field name="l10n_bg_intra_stat_outcomes" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
