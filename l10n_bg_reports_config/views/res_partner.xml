<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Partner Form View -->
    <record id="l10n_bg_view_partner_form" model="ir.ui.view">
        <field name="name">l10n.bg.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']//group[@name='credit_limits']" position="after">
                <group string="Bulgarian NSI Classification" name="l10n_bg_accounting">
                    <field name="l10n_bg_tax_tag_receivable_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_edit': True}"
                           groups="account.group_account_readonly"
                           placeholder="Select NSI tag for receivable..."
                           nolabel="0"/>
                    <field name="l10n_bg_tax_tag_payable_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_edit': True}"
                           groups="account.group_account_readonly"
                           placeholder="Select NSI tag for payable..."
                           nolabel="0"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Partner Tree View -->
    <record id="l10n_bg_view_partner_tree" model="ir.ui.view">
        <field name="name">l10n.bg.res.partner.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="l10n_bg_tax_tag_receivable_ids"
                       widget="many2many_tags"
                       optional="hide"
                       groups="account.group_account_readonly"/>
                <field name="l10n_bg_tax_tag_payable_ids"
                       widget="many2many_tags"
                       optional="hide"
                       groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>

    <!-- Extend Partner Search View -->
    <record id="l10n_bg_view_res_partner_filter" model="ir.ui.view">
        <field name="name">l10n.bg.res.partner.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_bg_tax_tag_receivable_ids"/>
                <field name="l10n_bg_tax_tag_payable_ids"/>
            </field>
            <filter name="salesperson" position="after">
                <filter string="NSI Receivable Tags"
                        name="group_by_nsi_receivable_tags"
                        context="{'group_by': 'l10n_bg_tax_tag_receivable_ids'}"
                        groups="account.group_account_readonly"/>
                <filter string="NSI Payable Tags"
                        name="group_by_nsi_payable_tags"
                        context="{'group_by': 'l10n_bg_tax_tag_payable_ids'}"
                        groups="account.group_account_readonly"/>
            </filter>
        </field>
    </record>

    <!-- Add to Quick Create Form -->
    <record id="l10n_bg_view_partner_simple_form" model="ir.ui.view">
        <field name="name">l10n.bg.res.partner.simple.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form"/>
        <field name="arch" type="xml">
            <field name="function" position="after">
                <field name="l10n_bg_tax_tag_receivable_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"
                       groups="account.group_account_readonly"
                       placeholder="Select NSI tag for receivable..."/>
                <field name="l10n_bg_tax_tag_payable_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_edit': True}"
                       groups="account.group_account_readonly"
                       placeholder="Select NSI tag for payable..."/>
            </field>
        </field>
    </record>
</odoo>
