<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_account_tag_bulk_edit_wizard_form" model="ir.ui.view">
        <field name="name">account.account.tag.bulk.edit.wizard.form</field>
        <field name="model">account.account.tag.bulk.edit.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Edit Account Tags">
                <group>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="l10n_bg_applicability"/>
                </group>
                <footer>
                    <button string="Apply by choice" type="object" name="action_apply" class="btn-primary" invisible="not l10n_bg_applicability"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_account_tags_bulk_edit" model="ir.actions.act_window">
        <field name="name">Bulk Edit Account Tags</field>
        <field name="res_model">account.account.tag.bulk.edit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_account_account_tag_bulk_edit_wizard_form"/>
    </record>
</odoo>
