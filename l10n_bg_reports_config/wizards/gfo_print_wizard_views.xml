<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_bg_gfo_print_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.gfo.print.wizard.form</field>
        <field name="model">l10n.bg.gfo.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print GFO / GOD NSI Annex 1">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="show_previous_year"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Generates the NSI Annex 1 PDF in pixel-perfect layout from
                        the materialized aml tags. Values in thousands BGN.
                        Currently implemented: Balance Sheet. P&amp;L, Cash Flow,
                        Equity, GOD annexes — coming next.
                    </p>
                </sheet>
                <footer>
                    <button name="action_print" type="object"
                            string="Print PDF" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_gfo_print_wizard" model="ir.actions.act_window">
        <field name="name">Print GFO / GOD</field>
        <field name="res_model">l10n.bg.gfo.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
