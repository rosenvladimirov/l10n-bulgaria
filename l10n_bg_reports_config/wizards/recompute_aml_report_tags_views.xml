<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_bg_recompute_aml_report_tags_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.recompute.aml.report.tags.wizard.form</field>
        <field name="model">l10n.bg.recompute.aml.report.tags.wizard</field>
        <field name="arch" type="xml">
            <form string="Recompute BG Report Tags on Move Lines">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="posted_only"/>
                        </group>
                        <group>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="processed_count" readonly="1"
                                   invisible="processed_count == 0"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Recomputes <code>l10n_bg_account_tag_ids</code> on move
                        lines as the layered set:
                        <code>account.tag_ids</code> ∪
                        <code>product.l10n_bg_account_tag_ids</code>,
                        with partner-sector override
                        (<code>partner.l10n_bg_tax_tag_(receivable|payable)_ids</code>)
                        on receivable/payable lines. Run after changing
                        product/partner NSI tags or after the
                        auto-map wizard.
                    </p>
                </sheet>
                <footer>
                    <button name="action_recompute" type="object"
                            string="Recompute" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_bg_recompute_aml_report_tags_wizard"
            model="ir.actions.act_window">
        <field name="name">Recompute BG Report Tags on Lines</field>
        <field name="res_model">l10n.bg.recompute.aml.report.tags.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
