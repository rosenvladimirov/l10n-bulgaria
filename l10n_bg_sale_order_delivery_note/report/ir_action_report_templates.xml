<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
        active="True"
    >
        <!-- Insert delivery-specific variables before page -->
        <xpath expr="//div[hasclass('oe_structure')]" position="before">
            <t t-if="is_delivery">
                <t t-set="sender" t-value="doc.company_id.partner_id"/>
                <t t-if="not sender_vat_label">
                    <t t-set="sender_vat_label" t-value="sender.country_id.vat_label"/>
                </t>
                <t t-if="not sender_vat_label">
                    <t t-set="sender_vat_label">TIN</t>
                </t>
                <t t-set="address">
                    <div t-field="doc.partner_invoice_id"
                         t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                    <p t-if="doc.partner_invoice_id.vat">
                        <t t-out="doc.partner_invoice_id.country_id.vat_label or 'TIN'"/>:
                        <span t-field="doc.partner_invoice_id.vat"/>
                    </p>
                    <div t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_invoice_id"
                         class="mt-2">
                        <strong>Shipping address:</strong>
                        <div t-field="doc.partner_shipping_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                    </div>
                </t>
                <t t-set="name_label">Accepted delivery report  #</t>
                <t t-if="doc.name != '/'">
                    <t t-set="name_date"
                       t-value="format_date(doc.date_order, lang_code=doc.partner_id.lang, widget='date')"
                       groups="!l10n_bg_report_theme.group_control_date_format"/>
                    <t t-set="name_date"
                       t-value="format_date(doc.date_order, lang_code=doc.partner_id.lang)"
                       groups="l10n_bg_report_theme.group_control_date_format"/>
                </t>
                <t t-set="information_block">
                    <t t-set="recipient_contact_id"
                       t-value="doc.partner_id if doc.partner_id.parent_id else None"
                       t-if="not recipient_contact_id"/>
                    <t t-set="recipient_invoice_id"
                       t-value="doc.partner_invoice_id"
                       t-if="doc.partner_id != doc.partner_invoice_id"/>
                    <t t-set="recipient_invoice_id"
                       t-value="doc.partner_id"
                       t-if="doc.partner_id == doc.partner_invoice_id"/>
                    <t t-set="recipient_shipping_id" t-value="doc.partner_shipping_id"/>
                    <t t-if="not recipient_vat_label">
                        <t t-set="recipient_vat_label"
                           t-value="recipient_invoice_id.country_id.vat_label"/>
                    </t>
                    <t t-if="not recipient_vat_label">
                        <t t-set="recipient_vat_label">TIN</t>
                    </t>
                    <t t-if="recipient_contact_id">
                        <strong class="o_section_labels">The Attention of:</strong>
                        <div t-field="recipient_contact_id.name"/>
                        <div t-out="recipient_contact_id"
                             name="contact_name"
                             t-options="{'widget': 'contact', 'fields': ['phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"/>
                    </t>
                    <div name="invoice_shipping_address"
                         t-if="recipient_shipping_id and recipient_invoice_id">
                        <strong class="o_section_labels"
                                t-if="recipient_shipping_id == recipient_invoice_id">
                            Invoicing and shipping address:</strong>
                        <strong class="o_section_labels"
                                t-if="recipient_shipping_id != recipient_invoice_id">
                            Invoicing address:</strong>
                    </div>
                    <t t-if="recipient_invoice_id">
                        <div t-out="recipient_invoice_id"
                             t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"
                             name="invoice_address"/>
                        <p t-if="recipient_invoice_id.vat">
                            <t t-esc="recipient_vat_label"/>: <span t-field="recipient_invoice_id.vat"/>
                        </p>
                    </t>
                    <t t-if="recipient_shipping_id and recipient_invoice_id and recipient_shipping_id != recipient_invoice_id">
                        <div name="shipping_address">
                            <strong class="o_section_labels">Shipping address:</strong>
                            <div t-out="recipient_shipping_id"
                                 t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'mobile'], 'no_marker': True, 'phone_icons': True}"/>
                        </div>
                    </t>
                </t>
            </t>
        </xpath>

        <!-- Hide informations when delivery -->
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Unit Price header -->
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Discount header -->
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">display_discount and not is_delivery</attribute>
        </xpath>

        <!-- Hide Taxes header -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Amount header -->
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Unit Price cell -->
        <xpath expr="//td[@name='td_priceunit']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Discount cell -->
        <xpath expr="//td[@t-if='display_discount']" position="attributes">
            <attribute name="t-if">display_discount and not is_delivery</attribute>
        </xpath>

        <!-- Hide Taxes cell -->
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide Subtotal cell -->
        <xpath expr="//td[@name='td_subtotal']" position="attributes">
            <attribute name="t-if">not line.is_downpayment and not is_delivery</attribute>
        </xpath>

        <!-- Hide section subtotal row -->
        <xpath expr="//tr[hasclass('is-subtotal')]" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Hide total summary -->
        <xpath expr="//div[@name='so_total_summary']" position="attributes">
            <attribute name="t-if">not is_delivery</attribute>
        </xpath>

        <!-- Top comments (before lines) -->
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <t t-if="is_delivery">
                <t t-foreach="doc.comment_template_ids.filtered(lambda x: x.position == 'before_lines')"
                   t-as="comment_template_top">
                    <div class="mt-3" t-out="doc.render_comment(comment_template_top)"/>
                </t>
            </t>
        </xpath>

        <!-- Bottom comments (after lines) -->
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <t t-if="is_delivery">
                <t t-foreach="doc.comment_template_ids.filtered(lambda x: x.position == 'after_lines')"
                   t-as="comment_template_bottom">
                    <div class="mt-3" t-out="doc.render_comment(comment_template_bottom)"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="report_saleorder_delivery_note">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="False"/>
            <t t-set="is_delivery" t-value="True"/>
            <t t-set="docs" t-value="docs.with_context(proforma=False)"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>