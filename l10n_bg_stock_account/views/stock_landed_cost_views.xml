<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Показва BG записа (auto_post) до стандартния Journal Entry. -->
    <record id="view_stock_landed_cost_form_l10n_bg" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.l10n.bg</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <field name="account_move_id" position="after">
                <field name="l10n_bg_account_move_id" invisible="not l10n_bg_account_move_id"/>
            </field>
        </field>
    </record>
</odoo>
