<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_l10n_bg_stock_account" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n_bg_stock_account</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="l10n_bg_action_view_account_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="l10n_bg_account_move_count == 0">
                    <div class="o_stat_info">
                        <field name="l10n_bg_account_move_count" class="o_stat_value"/>
                        <span class="o_stat_text">Journal Entries</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
