<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Бутон към счетоводните статии на брака — същият като на пикинга. -->
    <record id="stock_scrap_form_view_l10n_bg_stock_account" model="ir.ui.view">
        <field name="name">stock.scrap.form.inherit.l10n_bg_stock_account</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="l10n_bg_action_view_account_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="l10n_bg_account_move_count == 0"
                        groups="account.group_account_readonly">
                    <div name="l10n_bg_account_move_count_div" class="o_stat_info">
                        <field name="l10n_bg_account_move_count" class="o_stat_value"/>
                        <span class="o_stat_text">Journal Entries</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
