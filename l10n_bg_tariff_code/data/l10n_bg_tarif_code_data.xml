<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron Job -->
    <record id="ir_cron_taric_cleanup" model="ir.cron">
        <field name="name">TARIC: Cleanup Expired Entries</field>
        <field name="model_id" ref="model_l10n_bg_taric_cache"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_expired_entries()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>
</odoo>
