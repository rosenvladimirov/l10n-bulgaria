<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TARIC Cache Tree View -->
    <record id="view_l10n_bg_taric_cache_tree" model="ir.ui.view">
        <field name="name">l10n_bg.taric.cache.tree</field>
        <field name="model">l10n_bg.taric.cache</field>
        <field name="arch" type="xml">
            <list string="TARIC Cache" create="false">
                <field name="cn_code"/>
                <field name="country_code"/>
                <field name="duty_rate"/>
                <field name="measure_type"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="source"/>
                <field name="last_update"/>
            </list>
        </field>
    </record>

    <!-- TARIC Cache Form View -->
    <record id="view_l10n_bg_taric_cache_form" model="ir.ui.view">
        <field name="name">l10n_bg.taric.cache.form</field>
        <field name="model">l10n_bg.taric.cache</field>
        <field name="arch" type="xml">
            <form string="TARIC Cache Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="cn_code"/>
                            <field name="country_code"/>
                            <field name="duty_rate"/>
                            <field name="measure_type"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="source"/>
                            <field name="last_update"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TARIC Cache Search View -->
    <record id="view_l10n_bg_taric_cache_search" model="ir.ui.view">
        <field name="name">l10n_bg.taric.cache.search</field>
        <field name="model">l10n_bg.taric.cache</field>
        <field name="arch" type="xml">
            <search string="Search TARIC Cache">
                <field name="cn_code"/>
                <field name="country_code"/>
                <field name="description"/>
                <filter string="Valid Today" name="valid_today"
                        domain="[('valid_from', '&lt;=', context_today().strftime('%Y-%m-%d')), ('valid_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="From API" name="source_api" domain="[('source', '=', 'api')]"/>
                <filter string="From CIRCABC" name="source_circabc" domain="[('source', '=', 'circabc')]"/>
                <filter string="Manual" name="source_manual" domain="[('source', '=', 'manual')]"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_code'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Valid From" name="group_valid_from" context="{'group_by': 'valid_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for TARIC Cache -->
    <record id="action_l10n_bg_taric_cache" model="ir.actions.act_window">
        <field name="name">TARIC Cache</field>
        <field name="res_model">l10n_bg.taric.cache</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_valid_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No TARIC data cached yet
            </p>
            <p>
                Import TARIC data from CIRCABC or it will be automatically populated from API calls.
            </p>
        </field>
    </record>

</odoo>
