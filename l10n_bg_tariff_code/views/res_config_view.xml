<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tariff" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tariff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="TARIC Integration" name="taric_integration_container">
                    <setting help="Configure access to download from EU TARIC system" name="l10n_bg_taric_setting">
                        <field name="l10n_bg_taric_api_enabled"/>
                        <div class="content-group" invisible="not l10n_bg_taric_api_enabled">
                            <label for="l10n_bg_taric_api_url"/>
                            <div class="mt8">
                                <field name="l10n_bg_taric_api_url"
                                       placeholder="https://ec.europa.eu/taxation_customs/dds2/taric/services/taricws"/>
                            </div>
                            <label for="l10n_bg_taric_cache_duration" string="Cache Duration"/>
                            <div class="mt8">
                                <field name="l10n_bg_taric_cache_duration" class="oe_inline"/> hours
                            </div>
                            <label for="l10n_bg_default_tariff_rate" string="Default Tariff Rate"/>
                            <div class="mt16">
                                <div class="text-muted">
                                    Default tariff rate when TARIC lookup fails
                                </div>
                                <div class="mt8">
                                    <field name="l10n_bg_default_tariff_rate" class="oe_inline"/> %
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
