<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TARIC Import Wizard -->
    <record id="view_l10n_bg_taric_import_wizard" model="ir.ui.view">
        <field name="name">l10n_bg.taric.import.wizard.form</field>
        <field name="model">l10n_bg.taric.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import TARIC Data">
                <group>
                    <field name="import_method" widget="radio"/>
                    <field name="file_data" filename="filename" invisible="import_method" required="not import_method"/>
                    <field name="filename" invisible="1"/>
                    <field name="circabc_url" invisible="import_method != 'url'" required="import_method == 'url'"
                           placeholder="https://circabc.europa.eu/sd/a/[file-id]/TARIC_data.xlsx"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="action_import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Import Wizard -->
    <record id="action_l10n_bg_taric_import" model="ir.actions.act_window">
        <field name="name">Import TARIC Data</field>
        <field name="res_model">l10n_bg.taric.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
