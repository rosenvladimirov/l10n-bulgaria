<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Update existing product for transport costs -->
        <record id="stock_landed_costs.product_product_freight_external" model="product.template">
            <field name="l10n_bg_is_customs_expense" eval="True"/>
        </record>

        <!-- Loading and unloading activities -->
        <record id="product_customs_loading" model="product.template">
            <field name="name">Loading and Unloading Services</field>
            <field name="type">service</field>
            <field name="l10n_bg_is_customs_expense" eval="True"/>
            <field name="landed_cost_ok" eval="True"/>
            <field name="purchase_ok" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">0.0</field>
            <field name="image_1920" type="base64" file="l10n_bg_tax_admin/static/img/forklift.png"/>
        </record>

