<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_bg_customs_form" model="ir.ui.view">
            <field name="name">account.move.bg.customs.form</field>
            <field name="model">account.move.bg.customs</field>
            <field name="arch" type="xml">
                <form string="Customs declaration for VAT" create="false" edit="true" delete="false">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancel" readonly="1"/>
                        <button name="action_post" string="Post" class="oe_highlight" type="object" invisible="state != 'draft'"/>
                        <button name="button_draft" string="Reset to Draft" type="object" invisible="state != 'posted'"/>
                        <button name="button_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'posted')"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_business_doc" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="l10n_bg_customs_move_id" string="Related document" widget="statinfo" readonly="1"/>
                            </button>
                        </div>
                        <field name="currency_id" invisible="1"/>
                        <div class="oe_title">
                            <span class="o_form_label" invisible="l10n_bg_customs_name">Чернова</span>
                            <h1>
                                <field name="l10n_bg_customs_name" placeholder="Declaration number" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="customs_main_info" string="Main information">
                                <field name="partner_id" required="1" readonly="1"/>
                                <field name="declaration_number" required="1"/>
                                <field name="declaration_date" required="1"/>
                                <field name="mrn"
                                       placeholder="25BG001234E123456"
                                       maxlength="18"
                                       class="text-uppercase o_uppercase_field"/>

                                <field name="container_number"
                                       placeholder="MSCU1234567"
                                       maxlength="11"
                                       class="text-uppercase o_uppercase_field"/>

                                <field name="lrn"
                                       class="text-uppercase o_uppercase_field"/>

                                <field name="transit_declaration_number"
                                       class="text-uppercase o_uppercase_field"/>
                                <field name="invoice_date" readonly="1"/>
                                <field name="ref" readonly="1"/>
                                <field name="responsible_id"/>
                            </group>
                            <group name="customs_accounting" string="Accounting information">
                                <field name="journal_id" required="1" domain="[('type', '=', 'general')]" readonly="1"/>
                                <field name="company_id" invisible="1" readonly="1"/>
                                <field name="currency_id" groups="base.group_multi_currency" readonly="1"/>
                                <field name="l10n_bg_customs_date_creation" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group name="customs_transport" string="Transport and delivery">
                                <field name="transport_mode" options="{'no_create': True, 'no_open': True}"/>
                                <field name="invoice_incoterm_id"/>
                                <field name="incoterm_location"/>
                            </group>
                            <group name="customs_countries" string="Country's">
                                <field name="country_of_origin_id"/>
                                <field name="country_of_dispatch_id"/>
                            </group>
                        </group>

                        <group>
                            <group name="customs_packaging" string="Packaging">
                                <field name="package_type" options="{'no_create': True, 'no_open': True}"/>
                                <field name="package_count"/>
                                <field name="package_description"/>
                            </group>
                            <group name="customs_procedure" string="Customs mode">
                                <field name="customs_procedure" options="{'no_create': True, 'no_open': True}"/>
                                <field name="customs_documents" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </group>

                        <field name="narration" placeholder="Additional notes..." readonly="1"/>

                        <notebook>
                            <page string="Declaration lines" name="invoice_lines">
                                <field name="invoice_line_ids" readonly="1">
                                    <list create="0" delete="0" edit="0" multi_edit="1">
                                        <field name="product_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="quantity" readonly="1"/>
                                        <field name="l10n_bg_customs_value" string="Customs value" readonly="1"/>
                                        <field name="l10n_bg_weight_gross" string="Gross weight (kg)" readonly="1"/>
                                        <field name="l10n_bg_is_customs_expense" string="Additional costs" readonly="1"/>
                                        <field name="tax_ids" widget="many2many_tags" readonly="1"/>
                                        <field name="balance" string="Tax base" readonly="1" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="company_currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                                <group col="12" class="oe_invoice_lines_tab overflow-hidden">
                                    <group colspan="8"/>
                                    <group colspan="4">
                                        <field name="total_customs_value" readonly="1"/>
                                        <field name="total_expenses" readonly="1"/>
                                        <field name="total_gross_weight" readonly="1"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Related invoices" name="related_invoices">
                                <field name="l10n_bg_customs_invoice_ids" readonly="1">
                                    <list create="0" delete="0" edit="0" multi_edit="1">
                                        <field name="name"/>
                                        <field name="invoice_date"/>
                                        <field name="partner_id"/>
                                        <field name="amount_total"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_bg_customs_list" model="ir.ui.view">
            <field name="name">account.move.bg.customs.list</field>
            <field name="model">account.move.bg.customs</field>
            <field name="arch" type="xml">
                <list string="Customs declarations for VAT" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" default_order="l10n_bg_customs_date_creation desc" create="false" edit="true" delete="false">
                    <field name="l10n_bg_customs_name"/>
                    <field name="declaration_number"/>
                    <field name="declaration_date"/>
                    <field name="partner_id"/>
                    <field name="country_of_origin_id"/>
                    <field name="l10n_bg_customs_move_id"/>
                    <field name="company_currency_id" column_invisible="1"/>
                    <field name="total_customs_value" sum="Обща митническа стойност"/>
                    <field name="amount_total" sum="Обща сума" string="Сума"/>
                    <field name="state" decoration-success="state == 'posted'" decoration-warning="state == 'draft'"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_bg_customs_search" model="ir.ui.view">
            <field name="name">account.move.bg.customs.search</field>
            <field name="model">account.move.bg.customs</field>
            <field name="arch" type="xml">
                <search string="Search for customs declarations">
                    <field name="l10n_bg_customs_name"/>
                    <field name="declaration_number"/>
                    <field name="l10n_bg_customs_move_id"/>
                    <field name="partner_id"/>
                    <field name="country_of_origin_id"/>
                    <field name="responsible_id"/>
                    <separator/>
                    <filter string="Drafts" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Published" name="posted" domain="[('state','=','posted')]"/>
                    <filter string="Cancelled" name="canceled" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter string="My declarations" name="my_customs" domain="[('create_uid','=',uid)]"/>
                    <filter string="Responsible" name="responsible_me" domain="[('responsible_id','=',uid)]"/>
                    <filter string="Overdue activities" name="activities_overdue"
                            domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="Declaration date" name="filter_declaration_date" date="declaration_date"/>
                    <group expand="0" string="Grouping by">
                        <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
                        <filter string="Country of origin" name="country_origin" context="{'group_by':'country_of_origin_id'}"/>
                        <filter string="Customs procedure" name="customs_procedure" context="{'group_by':'customs_procedure'}"/>
                        <filter string="Responsible person" name="responsible" context="{'group_by':'responsible_id'}"/>
                        <filter string="Status" name="status" context="{'group_by':'state'}"/>
                        <filter string="Declaration date" name="date" context="{'group_by':'declaration_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_bg_customs" model="ir.actions.act_window">
            <field name="name">Customs declarations for VAT</field>
            <field name="res_model">account.move.bg.customs</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_bg_customs_list"/>
            <field name="search_view_id" ref="view_bg_customs_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first VAT customs declaration
                </p>
                <p>
                    Customs VAT declarations are used to document the importation of goods
                    and calculation of the VAT payable, according to Bulgarian legislation.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_bg_customs"
                  name="Customs declarations for VAT"
                  action="action_bg_customs"
                  parent="account.menu_finance_payables"
                  sequence="6"/>
    </data>
</odoo>
