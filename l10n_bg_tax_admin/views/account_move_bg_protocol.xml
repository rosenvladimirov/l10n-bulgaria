<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_bg_protocol_form" model="ir.ui.view">
            <field name="name">account.move.bg.protocol.form</field>
            <field name="model">account.move.bg.protocol</field>
            <field name="arch" type="xml">
                <form string="VAT Protocol" create="false" edit="true" delete="false">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancel" readonly="1"/>
                        <button name="action_post" string="Post" class="oe_highlight" type="object" invisible="state != 'draft'"/>
                        <button name="button_draft" string="Reset to Draft" type="object" invisible="state != 'posted'"/>
                        <button name="button_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'posted')"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_business_doc" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="l10n_bg_protocol_move_id" string="Related Document" widget="statinfo" readonly="1"/>
                            </button>
                        </div>
                        <field name="currency_id" invisible="1"/>
                        <div class="oe_title">
                            <span class="o_form_label" invisible="l10n_bg_protocol_name">Draft</span>
                            <h1>
                                <field name="l10n_bg_protocol_name" placeholder="Protocol Number" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="partner_info" string="Document data">
                                <field name="partner_id" required="1" readonly="1"/>
                                <field name="invoice_date" readonly="1"/>
                                <field name="ref" readonly="1"/>
                                <field name="journal_id" required="1" domain="[('type', '=', 'general')]" readonly="1"/>
                                <field name="company_id" invisible="1" readonly="1"/>
                                <field name="currency_id" groups="base.group_multi_currency" readonly="1"/>
                            </group>
                            <group name="bulgaria_accounting" string="Bulgarian Accounting">
                                <field name="l10n_bg_protocol_move_id" readonly="1"/>
                                <field name="l10n_bg_date" required="1" readonly="0"/>
                                <field name="l10n_bg_protocol_date_creation" readonly="1"/>
                                <field name="l10n_bg_protocol_type_vat" readonly="1"/>
                                <field name="l10n_bg_protocol_currency_id" required="1" readonly="1"/>
                            </group>
                        </group>
                        <field name="narration" placeholder="Additional Notes..." readonly="1"/>
                        <notebook>
                            <page string="Protocol Lines" name="invoice_lines">
                                <field name="invoice_line_ids" readonly="1">
                                    <list create="false" delete="false" edit="false">
                                        <field name="product_id" readonly="1"/>
                                        <field name="name" readonly="1"/>
                                        <field name="quantity" readonly="1"/>
                                        <field name="l10n_bg_price_unit" readonly="1"/>
                                        <field name="tax_ids" widget="many2many_tags" readonly="1"/>
                                        <field name="balance" string="Total Amount" readonly="1" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                        <field name="currency_id" column_invisible="True"/>
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="company_currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                                <group col="12" class="oe_invoice_lines_tab overflow-hidden">
                                    <group colspan="8"/>
                                        <group colspan="4">
                                            <group class="oe_subtotal_footer">
                                                <field name="l10n_bg_tax_totals" widget="signed-tax-totals" nolabel="1" colspan="2" readonly="1"/>
                                            </group>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_bg_protocol_list" model="ir.ui.view">
            <field name="name">account.move.bg.protocol.list</field>
            <field name="model">account.move.bg.protocol</field>
            <field name="arch" type="xml">
                <list string="VAT Protocols" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" default_order="l10n_bg_date desc" create="false" edit="true" delete="false">
                    <field name="l10n_bg_name"/>
                    <field name="l10n_bg_date"/>
                    <field name="partner_id"/>
                    <field name="l10n_bg_protocol_type_vat"/>
                    <field name="l10n_bg_protocol_move_id"/>
                    <field name="company_currency_id" column_invisible="1"/>
                    <field name="amount_total" sum="Total" string="Amount"/>
                    <field name="state" decoration-success="state == 'posted'" decoration-warning="state == 'draft'"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_bg_protocol_search" model="ir.ui.view">
            <field name="name">account.move.bg.protocol.search</field>
            <field name="model">account.move.bg.protocol</field>
            <field name="arch" type="xml">
                <search string="Search VAT Protocols">
                    <field name="l10n_bg_protocol_name"/>
                    <field name="l10n_bg_protocol_move_id"/>
                    <field name="partner_id"/>
                    <field name="l10n_bg_protocol_type_vat"/>
                    <separator/>
                    <filter string="Drafts" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Posted" name="posted" domain="[('state','=','posted')]"/>
                    <filter string="Cancelled" name="canceled" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter string="My Protocols" name="my_protocols" domain="[('create_uid','=',uid)]"/>
                    <filter string="Late Activities" name="activities_overdue"
                            domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
                        <filter string="Protocol Type" name="protocol_type" context="{'group_by':'l10n_bg_protocol_type_vat'}"/>
                        <filter string="Status" name="status" context="{'group_by':'state'}"/>
                        <filter string="Protocol Date" name="date" context="{'group_by':'l10n_bg_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_bg_protocol" model="ir.actions.act_window">
            <field name="name">VAT Protocols</field>
            <field name="res_model">account.move.bg.protocol</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_bg_protocol_list"/>
            <field name="search_view_id" ref="view_bg_protocol_search"/>
            <field name="domain">[('l10n_bg_move_type', 'in', ['private', 'protocol'])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first VAT Protocol
                </p>
                <p>
                    VAT Protocols are used to document specific transactions according to Bulgarian legislation.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_bg_protocol"
                  name="VAT Protocols"
                  action="action_bg_protocol"
                  parent="account.menu_finance_payables"
                  sequence="5"/>
    </data>
</odoo>
