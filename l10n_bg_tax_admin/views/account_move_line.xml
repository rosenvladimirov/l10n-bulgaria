<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_tariff_enhanced" model="ir.ui.view">
        <field name="name">account.move.line.form.tariff.enhanced</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_ids']" position="after">
                <group string="Тарифен код (CN/HS/Intrastat)" attrs="{'invisible': [('display_type', '!=', False)]}">
                    <group>
                        <field name="l10n_bg_tariff_code"
                               widget="char"
                               placeholder="85333900 (CN) / 853339 (HS)"
                               help="Автоматично се извлича от продукта или Intrastat"/>
                        <field name="l10n_bg_tariff_code_manual"
                               attrs="{'invisible': [('l10n_bg_tariff_code_manual', '=', False)]}"
                               placeholder="Ръчно въведен код"/>
                        <label for="l10n_bg_tariff_rate" string="Тарифна ставка"/>
                        <div class="o_row">
                            <field name="l10n_bg_tariff_rate"
                                   widget="percentage"
                                   decoration-success="l10n_bg_tariff_rate == 0.0"
                                   decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                                   decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                            <button name="action_update_tariff_rate"
                                    string="🔄"
                                    type="object"
                                    class="btn btn-link"
                                    title="Обнови от TARIC"
                                    attrs="{'invisible': [('l10n_bg_tariff_code', '=', False)]}"/>
                        </div>
                    </group>
                    <group>
                        <field name="l10n_bg_country_origin_id"
                               options="{'no_create': True}"
                               help="Влияе върху тарифната ставка"/>
                        <field name="l10n_bg_customs_value"
                               attrs="{'required': [('l10n_bg_is_customs_expense', '=', False)]}"
                               help="Стойност за митническо облагане"/>
                        <field name="l10n_bg_tariff_last_update" readonly="1"/>
                    </group>
                </group>

                <group string="Митнически режим" attrs="{'invisible': [('display_type', '!=', False)]}">
                    <field name="l10n_bg_customs_procedure_id"
                           domain="[('type', '=', 'procedure')]"
                           options="{'no_create': True}"/>
                    <field name="l10n_bg_is_customs_expense"/>
                </group>

                <group string="Тегла и размери" attrs="{'invisible': [('display_type', '!=', False)]}">
                    <field name="l10n_bg_weight_gross"/>
                    <field name="l10n_bg_weight_net"/>
                </group>

                <field name="l10n_bg_tariff_description"
                       attrs="{'invisible': [('l10n_bg_tariff_description', '=', False)]}"
                       readonly="1"
                       widget="text"/>
            </xpath>
        </field>
    </record>

    <!-- Enhanced tree view със compatibility badges -->
    <record id="view_move_line_tree_tariff_enhanced" model="ir.ui.view">
        <field name="name">account.move.line.tree.tariff.enhanced</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_total']" position="after">
                <field name="l10n_bg_tariff_code"
                       string="Тарифен код"
                       optional="hide"/>
                <field name="l10n_bg_tariff_rate"
                       widget="percentage"
                       string="Ставка"
                       optional="hide"
                       decoration-success="l10n_bg_tariff_rate == 0.0"
                       decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                       decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                <field name="l10n_bg_customs_value"
                       string="Митн. стойност"
                       optional="hide"/>
                <field name="l10n_bg_country_origin_id"
                       string="Произход"
                       optional="hide"/>
            </xpath>

            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_update_tariff_rate"
                            string="Обнови тарифни ставки"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_validate_tariff_code"
                            string="✓ Валидирай кодове"
                            type="object"
                            class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
