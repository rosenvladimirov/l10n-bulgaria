<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_tariff_enhanced" model="ir.ui.view">
        <field name="name">account.move.line.form.tariff.enhanced</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="l10n_bg_move_type" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='information']" position="inside">
                <group string="Tariff code (CN/HS/Intrastat)" invisible="not display_type">
                    <group>
                        <field name="l10n_bg_tariff_code"
                               widget="char"
                               placeholder="85333900 (CN) / 853339 (HS)"
                               help="It is automatically extracted from the product or Intrastat"/>
                        <field name="l10n_bg_tariff_code_manual"
                               invisible="not l10n_bg_tariff_code_manual"
                               placeholder="Manually entered code"/>
                        <field name="l10n_bg_tariff_description" invisible="not l10n_bg_tariff_description"
                               readonly="1"
                               widget="text"/>
                        <label for="l10n_bg_tariff_rate" string="Tariff rate"/>
                        <div class="o_row">
                            <field name="l10n_bg_tariff_rate"
                                   widget="percentage"
                                   decoration-success="l10n_bg_tariff_rate == 0.0"
                                   decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                                   decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                            <button name="action_update_tariff_rate"
                                    string="🔄"
                                    type="object"
                                    class="btn btn-link"
                                    title="Updated by TARIC"
                                    invisible="not l10n_bg_tariff_code"/>
                        </div>
                    </group>
                    <group string="Customs procedure" invisible="l10n_bg_move_type != 'customs'">
                        <field name="l10n_bg_customs_procedure_id"
                               domain="[('type', '=', 'procedure')]"
                               options="{'no_create': True}"/>
                        <field name="l10n_bg_is_customs_expense"/>
                    </group>
                    <group string="Weight and dimensions" invisible="l10n_bg_move_type != 'customs'">
                        <field name="l10n_bg_weight_gross"/>
                        <field name="l10n_bg_weight_net"/>
                    </group>
                    <group invisible="l10n_bg_move_type != 'customs'">
                        <field name="l10n_bg_customs_value" required="l10n_bg_move_type == 'customs' and not l10n_bg_is_customs_expense"
                               help="Customs value"/>
                        <field name="l10n_bg_tariff_last_update" readonly="1"/>
                    </group>
                </group>

            </xpath>
        </field>
    </record>

    <!-- Enhanced tree view със compatibility badges -->
    <record id="view_move_line_tree_tariff_enhanced" model="ir.ui.view">
        <field name="name">account.move.line.tree.tariff.enhanced</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_id']" position="after">
                <field name="l10n_bg_move_type" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='amount_currency']" position="before">
                <field name="l10n_bg_tariff_code"
                       string="Tariff code"
                       optional="hide"/>
                <field name="l10n_bg_tariff_rate"
                       widget="percentage"
                       string="Rate"
                       optional="hide"
                       decoration-success="l10n_bg_tariff_rate == 0.0"
                       decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                       decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                <field name="l10n_bg_customs_value"
                       string="Customs value"
                       column_invisible="l10n_bg_move_type != 'customs'"
                       optional="hide"/>
            </xpath>

            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_update_tariff_rate"
                            string="Update tariff rates"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_sync_hs_codes"
                            string="🔄 Sync HS codes"
                            type="object"
                            class="btn-secondary"
                            help="Copies the rate codes into product.hs code"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
