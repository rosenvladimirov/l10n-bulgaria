<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_bg_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_ledger.l10n_bg_move_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_protocol" type="object" class="oe_stat_button" icon="fa-book" invisible="not l10n_bg_protocol_move_id">
                    <field name="l10n_bg_name" string="Related Protocol" widget="statinfo" readonly="1"/>
                </button>
                <button name="action_open_private" type="object" class="oe_stat_button" icon="fa-book" invisible="not l10n_bg_private_move_id">
                    <field name="l10n_bg_name" string="Related Self signed" widget="statinfo" readonly="1"/>
                </button>
                <button name="action_open_customs" type="object" class="oe_stat_button" icon="fa-ship" invisible="not l10n_bg_customs_move_id">
                    <field name="l10n_bg_name" string="Customs declaration" widget="statinfo" readonly="1"/>
                </button>
            </xpath>
            <xpath
                expr="//group[@name='l10n_bg_documents']"
                position="inside"
            >
                <field name="l10n_bg_move_type" readonly="state != 'draft'"/>
                <field name="l10n_bg_private_percentage" readonly="state != 'draft'"/>
                <field name="l10n_bg_currency_rate" readonly="state != 'draft'"/>
                <field name="l10n_bg_currency_rate_manual" invisible="1" force_save="1"/>
                <field name="l10n_bg_customs_date" invisible="1" force_save="1"/>
                <field name="l10n_bg_customs_number" invisible="1" force_save="1"/>
            </xpath>
        </field>
    </record>
    <record id="l10n_bg_vat_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_bg_config.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@id='account_bg_vat_entry']"
                position="inside"
            >
                <field name="l10n_bg_move_type" readonly="state != 'draft'"/>
                <field name="l10n_bg_private_percentage" readonly="state != 'draft'"/>
                <field name="l10n_bg_currency_rate" readonly="state != 'draft'"/>
                <field name="l10n_bg_currency_rate_manual" invisible="1" force_save="1"/>
                <field name="l10n_bg_customs_date" invisible="1" force_save="1"/>
                <field name="l10n_bg_customs_number" invisible="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
