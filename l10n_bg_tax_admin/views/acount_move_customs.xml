<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_tariff_corrected" model="ir.ui.view">
        <field name="name">account.move.line.form.tariff.corrected</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_ids']" position="after">
                <group string="HS/Тарифен код" invisible="display_type">
                    <group>
                        <field name="l10n_bg_tariff_code"
                               widget="char"
                               placeholder="85333900 (CN) / 853339 (HS)"
                               help="Automatically from product.hs_code or Intrastat"/>
                        <field name="l10n_bg_tariff_code_manual" invisible="not l10n_bg_tariff_code_manual"
                               placeholder="Manually entered code"/>
                        <label for="l10n_bg_tariff_rate" string="Tariff rate"/>
                        <div class="o_row">
                            <field name="l10n_bg_tariff_rate"
                                   widget="percentage"
                                   decoration-success="l10n_bg_tariff_rate == 0.0"
                                   decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                                   decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                            <button name="action_update_tariff_rate"
                                    string="🔄"
                                    type="object"
                                    class="btn btn-link"
                                    title="Updated by TARIC"
                                    invisible="not l10n_bg_tariff_code"/>
                        </div>
                    </group>
                    <group>
                        <!-- Използваме product_id.country_of_origin вместо отделно поле -->
                        <label for="product_id" string="Страна на произход"/>
                        <div class="o_row">
                            <field name="product_id"
                                   readonly="1"
                                   invisible="1"/>
                            <field name="product_id"
                                   string=""
                                   context="{'form_view_ref': 'product.product_template_only_form_view'}"
                                   readonly="parent_state != 'draft'"
                                   options="{'no_create': True}"
                                   invisible="1"/>
                            <span attrs="{'invisible': [('product_id', '=', False)]}">
                                <field name="product_id"
                                       string=""
                                       readonly="1"
                                       options="{'no_open': True}"/>
                                →
                                <field name="product_id"
                                       string=""
                                       readonly="1"
                                       options="{'no_open': True, 'no_create': True}"
                                       widget="many2one"
                                       context="{'show_country_of_origin': True}"/>
                            </span>
                        </div>
                        <field name="l10n_bg_customs_value"
                               attrs="{'required': [('l10n_bg_is_customs_expense', '=', False)]}"
                               help="Стойност за митническо облагане"/>
                        <field name="l10n_bg_tariff_last_update" readonly="1"/>
                    </group>
                </group>

                <group string="Митнически режим" attrs="{'invisible': [('display_type', '!=', False)]}">
                    <field name="l10n_bg_customs_procedure_id"
                           domain="[('type', '=', 'procedure')]"
                           options="{'no_create': True}"/>
                    <field name="l10n_bg_is_customs_expense"/>
                </group>

                <group string="Тегла и размери" attrs="{'invisible': [('display_type', '!=', False)]}">
                    <field name="l10n_bg_weight_gross"/>
                    <field name="l10n_bg_weight_net"/>
                </group>

                <field name="l10n_bg_tariff_description"
                       attrs="{'invisible': [('l10n_bg_tariff_description', '=', False)]}"
                       readonly="1"
                       widget="text"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_tariff_corrected" model="ir.ui.view">
        <field name="name">account.move.line.tree.tariff.corrected</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_total']" position="after">
                <field name="l10n_bg_tariff_code"
                       string="HS/Тарифен код"
                       optional="hide"/>
                <field name="l10n_bg_tariff_rate"
                       widget="percentage"
                       string="Ставка"
                       optional="hide"
                       decoration-success="l10n_bg_tariff_rate == 0.0"
                       decoration-info="l10n_bg_tariff_rate &lt; 5.0"
                       decoration-warning="l10n_bg_tariff_rate >= 10.0"/>
                <field name="l10n_bg_customs_value"
                       string="Митн. стойност"
                       optional="hide"/>
            </xpath>

            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_update_tariff_rate"
                            string="🔄 Обнови тарифни ставки"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_sync_hs_codes"
                            string="🔄 Синхронизирай HS кодове"
                            type="object"
                            class="btn-secondary"
                            help="Копира тарифните кодове в product.hs_code"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
