<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_l10n_bg_customs_nomenclature_tree" model="ir.ui.view">
        <field name="name">l10n.bg.customs.nomenclature.tree</field>
        <field name="model">l10n.bg.customs.nomenclature</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
                <field name="unece_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_l10n_bg_customs_nomenclature_form" model="ir.ui.view">
        <field name="name">l10n.bg.customs.nomenclature.form</field>
        <field name="model">l10n.bg.customs.nomenclature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Архивиран" bg_color="bg-danger" invisible="active"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="unece_code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_l10n_bg_customs_nomenclature_search" model="ir.ui.view">
        <field name="name">l10n.bg.customs.nomenclature.search</field>
        <field name="model">l10n.bg.customs.nomenclature</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="unece_code"/>
                <filter string="Mode of transport" name="transport" domain="[('type', '=', 'transport')]"/>
                <filter string="Type of packaging" name="packaging" domain="[('type', '=', 'packaging')]"/>
                <filter string="Document type" name="document" domain="[('type', '=', 'document')]"/>
                <filter string="Customs mode" name="procedure" domain="[('type', '=', 'procedure')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Grouping by">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_l10n_bg_customs_nomenclature" model="ir.actions.act_window">
        <field name="name">Customs nomenclature</field>
        <field name="res_model">l10n.bg.customs.nomenclature</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customs nomenclature
            </p>
            <p>
                Here you can manage the different types of customs nomenclatures such as transport, packaging, documents and regimes.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_l10n_bg_customs_nomenclature"
              name="Customs nomenclature"
              action="action_l10n_bg_customs_nomenclature"
              parent="account.menu_finance_configuration"
              sequence="100"/>
</odoo>
