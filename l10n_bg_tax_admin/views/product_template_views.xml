<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_bg_product_template_form_view" model="ir.ui.view">
        <field name="name">l10n.bg.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='landed_cost_ok']" position="after">
                <field name="l10n_bg_is_customs_expense"/>
            </xpath>
        </field>
    </record>
</odoo>
