<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bg_protocol">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="sender" t-value="o.company_id.partner_id" />
                    <t t-set="recipient" t-value="o.partner_id" />

                    <!-- Fixed: Added fallback for name_label and improved conditions -->
                    <t t-if="o.l10n_bg_protocol_type_vat == '117_protocol_82_2'">
                        <t t-set="name_label">Protocol under Art. 117(2) connection with Art. 82(2) item 3</t>
                    </t>
                    <t t-elif="o.l10n_bg_protocol_type_vat == '117_protocol_84'">
                        <t t-set="name_label">Protocol under Art. 117(2) connection Art. 84</t>
                    </t>
                    <t t-elif="o.l10n_bg_protocol_type_vat == '117_protocol_6_4'">
                        <t t-set="name_label">Protocol under Art. 117(2) connection Art. 6(4)</t>
                    </t>
                    <t t-elif="o.l10n_bg_protocol_type_vat == '117_protocol_15'">
                        <t t-set="name_label">Protocol under Art. 117(2) connection Art. 15</t>
                    </t>
                    <t t-elif="o.l10n_bg_protocol_type_vat == '117_protocol_82_2_2'">
                        <t t-set="name_label">Protocol under Art. 117(2) connection Art. 82(2) item 2</t>
                    </t>
                    <t t-else="">
                        <t t-set="name_label">VAT Protocol</t>
                    </t>

                    <!-- Fixed: Use correct field name -->
                    <t t-if="o.l10n_bg_protocol_name and o.l10n_bg_protocol_name != '/'">
                        <t t-set="name" t-value="o.l10n_bg_protocol_name" />
                        <t t-set="name_date" t-value="format_date(o.l10n_bg_date, lang_code=o.company_id.lang, date_format='medium')" />
                    </t>
                    <t t-else="">
                        <t t-set="name" t-value="'Draft'" />
                        <t t-set="name_date" t-value="''" />
                    </t>

                    <div class="clearfix invoice_main">
                        <div class="page mb-4">
                            <!-- Added missing header -->
                            <h2 class="text-center mb-4">
                                <span t-esc="name_label"/>
                            </h2>

                            <!-- Document information section -->
                            <div id="informations" class="row mb-4"
                                 t-if="o.invoice_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id">
                                <div class="col" t-if="o.invoice_date" name="invoice_date">
                                    <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date</strong></t>
                                    <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date</strong></t>
                                    <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date</strong></t>
                                    <t t-else=""><strong>Date</strong></t>
                                    <!-- Fixed: Removed hardcoded test data -->
                                    <div t-field="o.invoice_date"/>
                                </div>
                                <div class="col" t-if="o.invoice_origin" name="origin">
                                    <strong>Source</strong>
                                    <!-- Fixed: Removed hardcoded test data -->
                                    <div t-field="o.invoice_origin"/>
                                </div>
                                <div class="col" t-if="o.partner_id.ref" name="customer_code">
                                    <strong>Customer Code</strong>
                                    <div t-field="o.partner_id.ref"/>
                                </div>
                                <div class="col" t-if="o.ref" name="reference">
                                    <strong>Reference</strong>
                                    <!-- Fixed: Removed hardcoded test data -->
                                    <div t-field="o.ref"/>
                                </div>
                                <div class="col" t-if="o.invoice_incoterm_id" name="incoterm_id">
                                    <strong>Incoterm</strong>
                                    <div t-if="o.incoterm_location">
                                        <span t-field="o.invoice_incoterm_id.code"/> <br/>
                                        <span t-field="o.incoterm_location"/>
                                    </div>
                                    <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                                </div>
                            </div>

                            <!-- Invoice lines table -->
                            <table class="o_has_total_table table o_main_table table-borderless" name="invoice_line_table">
                                <thead>
                                    <tr>
                                        <th name="th_description" class="text-start">Description</th>
                                        <th name="th_quantity" class="text-end">Quantity</th>
                                        <th name="th_priceunit" t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">Unit price</th>
                                        <th name="th_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">Taxes</th>
                                        <th name="th_subtotal" class="text-end">Taxation</th>
                                    </tr>
                                </thead>
                                <tbody class="invoice_tbody">
                                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                                    <t t-foreach="lines" t-as="line">
                                        <tr>
                                            <td>
                                                <span t-if="line.product_id" t-field="line.product_id.name"/>
                                                <span t-else="" t-field="line.name"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.quantity"/>
                                                <span t-if="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                            </td>
                                            <td class="text-end">
                                                <!-- Kept your custom field as requested -->
                                                <span t-field="line.l10n_bg_price_unit"
                                                      t-options='{"widget": "monetary", "display_currency": o.l10n_bg_protocol_currency_id}'/>
                                            </td>
                                            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                            <td name="td_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <!-- Fixed: Removed hardcoded test data -->
                                                <span t-out="taxes" id="line_tax_ids"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.balance"
                                                      t-options='{"widget": "monetary", "display_currency": o.l10n_bg_protocol_currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Tax totals section -->
                            <div class="clearfix">
                                <div id="right-elements" t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-auto d-inline-block float-end">
                                    <!-- Tax totals summary (company currency) -->
                                    <t t-set="tax_totals" t-value="o.l10n_bg_tax_totals"/>
                                    <t t-if="tax_totals" t-call="account.document_tax_totals_company_currency_template"/>
                                </div>
                            </div>

                            <!-- Signature section -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <strong>Created by:</strong> <span t-field="o.create_uid.name"/>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date:</strong> <span t-field="o.l10n_bg_protocol_date_creation"/>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-6">
                                    <div class="text-center mt-5">
                                        <strong>Authorized Person:</strong>
                                        <br/><br/>
                                        _____________________
                                        <br/>
                                        <small class="text-muted">Signature</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center mt-5">
                                        <strong>Company Stamp:</strong>
