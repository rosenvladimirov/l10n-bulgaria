<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.l10n_bg_telegram</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="l10n_bg_telegram_user_id" invisible="not l10n_bg_telegram_user_id"
                       groups="base.group_system"/>
            </xpath>
        </field>
    </record>

</odoo>
