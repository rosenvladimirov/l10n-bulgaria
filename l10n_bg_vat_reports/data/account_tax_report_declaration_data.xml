                <field name="name">[03–30] DO-no tax credit</field>
                <field name="expression_label">account_tag_30</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_31"
                model="account.report.column"
            >
                <field name="name">[03–31] TO-full tax credit</field>
                <field name="expression_label">account_tag_31</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_41"
                model="account.report.column"
            >
                <field name="name">[03-41] VAT-full tax credit</field>
                <field name="expression_label">account_tag_41</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_32"
                model="account.report.column"
            >
                <field name="name">[03-32] DO-partial tax credit</field>
                <field name="expression_label">account_tag_32</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_42"
                model="account.report.column"
            >
                <field name="name">[03-42] VAT-partial tax credit</field>
                <field name="expression_label">account_tag_42</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_43"
                model="account.report.column"
            >
                <field
                    name="name"
                >[03-43] Annual adjustment - art. 73, paragraph 8
                </field>
                <field name="expression_label">account_tag_43</field>
                <field name="figure_type">monetary</field>
                <field name="blank_if_zero">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_44"
                model="account.report.column"
            >
                <field name="name">[03–44] TO-trilateral operations</field>
                <field name="expression_label">account_tag_44</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_45"
                model="account.report.column"
            >
                <field name="name">[03-45] DO-art. 163a</field>
                <field name="expression_label">account_tag_45</field>
                <field name="figure_type">string</field>
            </record>
        </field>
    </record>
