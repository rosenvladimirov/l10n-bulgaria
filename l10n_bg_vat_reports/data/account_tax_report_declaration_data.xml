<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="vies_line_template">
        <t t-foreach="lines" t-as="line">
            <t t-set="l10n_bg_vat_vies" t-value="line['l10n_bg_vat_vies']"/>
            <t t-set="info_tag_ttr" t-value="line['info_tag_ttr']"/>
            <table class="table table-condensed" style="background-color: white;">
                <tbody class="invoice_tbody">
                    <tr>
                        <td colspan="3" rowspan="3">
                            <h1>VIES</h1>
                            <h1>DECLARATION</h1>
                        </td>
                        <td colspan="3">
                            <span>TA/office:</span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <span>Incoming №:</span>
                        </td>
                        <td>
                            <span>/</span>
                            <span>г.</span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <span>Tax period:</span>
                        </td>
                        <td>
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vhr_2']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vhr_2']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h4>A. Details of the registered person</h4>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>VAT identification number BG</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vtr_2']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vtr_2']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Title/Name</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vtr_2']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vtr_3']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Mailing address</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vtr_4']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vtr_4']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h4
                            >B. Details of the person submitting the declaration:
                            </h4>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Name</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_3']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_3']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5
                            >PIN/ICF/official number from the register of the National Revenue Agency
                            </h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_2']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_2']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5>Mailing address:</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Address (quarter, residential complex, street №)</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_6']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_6']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Populated place (city/village)</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_4']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_4']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>ZIP code</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_5']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_5']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>As</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vdr_7']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vdr_7']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5
                            >C. Made intra-community supplies of goods, supplies of goods as an intermediary in a
                                tripartite operation, as well as supply of services under Art. 21, para. 2 VAT with a
                                place of performance in the territory of another member state, for which recipients are
                                taxable persons registered for VAT purposes in another member state.
                            </h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Tax base - total in BGN</h5>
                        </td>
                        <td colspan="3">
                            <h5>01</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(sum of columns k3 + k4 + k5),</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['account_tag_ttr_2']['class']"
                                t-out="l10n_bg_vat_vies['account_tag_ttr_2']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5>including</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Tax base of ICA</h5>
                        </td>
                        <td colspan="3">
                            <h5>17</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(sum of column k3)</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['account_tag_ttr_3']['class']"
                                t-out="l10n_bg_vat_vies['account_tag_ttr_3']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h4>Total number of lines in section "B" of the declaration</h4>
                        </td>
                        <td colspan="3">
                            <h5>02</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(count of column k3)</h5>
                        </td>
                        <td colspan="3">
                            <span
                                t-att-class="l10n_bg_vat_vies['info_tag_vhr_3']['class']"
                                t-out="l10n_bg_vat_vies['info_tag_vhr_3']['name']"
                            />
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="2" style="width: 5%;">Line No</td>
                        <td
                            rowspan="2"
                            style="width: 15%;"
                        >VAT number of the recipient/acquirer (including the sign)
                        </td>
                        <td colspan="3">Tax base in BGN</td>
                        <td
                            rowspan="2"
                            style="width: 20%;"
                        >Tax period during which the tax became due* (mm/yyyy)
                        </td>
                    </tr>
                    <tr>
                        <td
                            colspan="1"
                            style="width: 20%;"
                        >Intra-Community supplies of goods
                        </td>
                        <td
                            colspan="1"
                            style="width: 20%;"
                        >supplies of goods as an intermediary in a tripartite operation
                        </td>
                        <td
                            colspan="1"
                            style="width: 20%;"
                        >delivery of services under Art. 21, para. 2 VAT with a place of performance on the territory of
                            another member state
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 5%;">k1</td>
                        <td style="width: 15%;">k2</td>
                        <td style="width: 20%;">k3</td>
                        <td style="width: 20%;">k4</td>
                        <td style="width: 20%;">k5</td>
                        <td style="width: 20%;">k6</td>
                    </tr>
                    <t t-foreach="info_tag_ttr" t-as="line_detail">
                        <tr>
                            <td style="width: 15%;">
                                <span
                                    t-att-class="line_detail['info_tag_vir_2']['class']"
                                    t-out="line_detail['info_tag_vir_2']['name']"
                                />
                            </td>
                            <td style="width: 20%;">
                                <span
                                    t-att-class="line_detail['info_tag_vir_3']['class']"
                                    t-out="line_detail['info_tag_vir_3']['name']"
                                />
                            </td>
                            <td style="width: 20%;">
                                <span
                                    t-att-class="line_detail['account_tag_vir_4']['class']"
                                    t-out="line_detail['account_tag_vir_4']['name']"
                                />
                            </td>
                            <td style="width: 20%;">
                                <span
                                    t-att-class="line_detail['account_tag_vir_5']['class']"
                                    t-out="line_detail['account_tag_vir_5']['name']"
                                />
                            </td>
                            <td style="width: 20%;">
                                <span
                                    t-att-class="line_detail['account_tag_vir_6']['class']"
                                    t-out="line_detail['account_tag_vir_6']['name']"
                                />
                            </td>
                            <td style="width: 20%;">
                                <span
                                    t-att-class="line_detail['info_tag_vir_7']['class']"
                                    t-out="line_detail['info_tag_vir_7']['name']"
                                />
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>
    <record id="l10n_bg_nra_tax_report_declaration" model="account.report">
        <field name="name">Report-Declaration</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.bg"/>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field
            name="custom_handler_model_id"
            ref="model_bg_account_report_vat_declaration_custom_handler"
        />
    </record>
    <record id="l10n_bg_nra_tax_report_purchases" model="account.report">
        <field name="name">Report Purchases</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.bg"/>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field
