            >
                <field
                    name="name"
                >[03-00] VAT identification number of the person
                </field>
                <field name="expression_label">info_tag_2</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_account_period"
                model="account.report.column"
            >
                <field name="name">[03-01] Tax period</field>
                <field name="expression_label">info_tag_1</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_branch"
                model="account.report.column"
            >
                <field name="name">[03-02] Branch</field>
                <field name="expression_label">info_tag_3</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_counter"
                model="account.report.column"
            >
                <field name="name">[03-03] Counter</field>
                <field name="expression_label">info_tag_4</field>
                <field name="figure_type">integer</field>
