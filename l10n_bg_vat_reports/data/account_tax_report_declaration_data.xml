                <field name="expression_label">info_tag_5</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_number"
                model="account.report.column"
            >
                <field name="name">[03-05] Document number</field>
                <field name="expression_label">info_tag_6</field>
                <field name="figure_type">string</field>
                <field name="sortable">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_invoice_date"
                model="account.report.column"
            >
                <field name="name">[03-06] Date</field>
                <field name="expression_label">info_tag_7</field>
                <field name="figure_type">date</field>
                <field name="sortable">True</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_partner_vat"
                model="account.report.column"
            >
                <field
                    name="name"
                >[03–07] Identification number of the counterparty
                </field>
                <field name="expression_label">info_tag_8</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_partner_name"
                model="account.report.column"
            >
                <field name="name">[03–08] Name of counterparty</field>
                <field name="expression_label">info_tag_9</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_narration"
                model="account.report.column"
            >
                <field name="name">[03–10] Narration</field>
                <field name="expression_label">info_tag_10</field>
                <field name="figure_type">string</field>
            </record>
            <record
                id="l10n_bg_vat_purchases_book_report_column_tag_30"
