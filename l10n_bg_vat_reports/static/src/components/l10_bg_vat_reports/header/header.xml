<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="l10n_bg_vat_reports.VatReportLineTemplateVies">
        <thead id="table_header">
            <t t-foreach="columnHeaders || []" t-as="columnHeader" t-key="columnHeader_index">
                <t t-foreach="columnHeader || []" t-as="header" t-key="header_index">
                    <tr>
                        <td colspan="3" rowspan="3">
                            <h4>VIES</h4>
                            <h4>DECLARATION</h4>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <span>Incoming №:</span>
                        </td>
                        <td>
                            <span>____________/</span><span>________ г.</span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <span>Tax period:</span>
                        </td>
                        <td>
                            <span t-out="(header || {}).info_tag_vhr_2 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h4>A. Details of the registered person</h4>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>VAT identification number BG</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vtr_2 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Title/Name</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vtr_3 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Mailing address</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vtr_4 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5>B. Details of the person submitting the declaration:</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Name</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_3 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>PIN/ICF/official number from the register of the National Revenue Agency</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_2 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5>Mailing address:</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Address (quarter, residential complex, street №)</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_6 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Populated place (city/village)</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_4 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>ZIP code</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_5 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>As</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vdr_7 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5
                            >C. Made intra-community supplies of goods, supplies of goods as an intermediary in a
                                tripartite operation, as well as supply of services under Art. 21, para. 2 VAT with
                                a place of performance in the territory of another member state, for which
                                recipients are taxable persons registered for VAT purposes in another member state.
                            </h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Tax base - total in BGN</h5>
                        </td>
                        <td colspan="3">
                            <h5>01</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(sum of columns k3 + k4 + k5),</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).account_tag_ttr_2 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <h5>including</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>Tax base of ICA</h5>
                        </td>
                        <td colspan="3">
                            <h5>17</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(sum of column k3)</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).account_tag_ttr_3 || ''"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h4>Total number of lines in section "B" of the declaration</h4>
                        </td>
                        <td colspan="3">
                            <h5>02</h5>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <h5>(count of column k3)</h5>
                        </td>
                        <td colspan="3">
                            <span t-out="(header || {}).info_tag_vhr_3 || ''"/>
                        </td>
                    </tr>
                </t>
                <tr>
                    <t t-foreach="subheaders || []" t-as="subheader" t-key="subheader_index">
                        <th
                            t-att-colspan="(subheader || {}).colspan || 1"
                            t-att-data-expression_label="(subheader || {}).expression_label || ''"
                        >
                            <!-- Sortable -->
                            <t t-if="(subheader || {}).sortable">
                                <button
                                    class="btn btn_sortable"
                                    t-on-click="() => this.sortLinesByColumn(subheader_index, subheader)"
                                >
                                    <i t-att-class="sortableClasses(subheader_index)"/>
                                </button>
                            </t>

                            <t t-if="(subheader || {}).template">
                                <t t-call="{{ (subheader || {}).template }}"/>
                            </t>
                            <t t-else="">
                                <t t-out="(subheader || {}).name || ''"/>
                            </t>
                        </th>
                    </t>
                </tr>
            </t>
        </thead>
    </t>
</templates>