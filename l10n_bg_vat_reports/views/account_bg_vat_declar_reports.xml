<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_bg_vat_declar_search" model="ir.ui.view">
         <field name="name">account.bg.vat.declar.search</field>
         <field name="model">account.bg.vat.declar</field>
         <field name="arch" type="xml">
            <search>
                <group expand="0" string="Group By...">
                    <filter
                        name="groupby_date"
                        string="Date"
                        context="{'group_by': 'date'}"
                    />
               </group>
               <filter
                    name="filter_date_last_month"
                    invisible="1"
                    string="Date: Last month"
                    domain="[('date', '&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d'))]"
                />
            </search>
         </field>
    </record>

    <record id="view_account_bg_vat_declar_tree" model="ir.ui.view">
         <field name="name">account.bg.vat.declar.tree</field>
         <field name="model">account.bg.vat.declar</field>
         <field name="arch" type="xml">
            <tree string="Declaration">
                <field name="company_vat" />
                <field name="company_name" />
                <field name="person_info" />
                <field name="sales_count" />
                <field name="purchases_count" />
                <field name="account_tag_10" sum="Total" />
                <field name="account_tag_20" sum="Total" />
                <field name="account_tag_11" sum="Total" />
                <field name="account_tag_21" sum="Total" />
                <field name="account_tag_12" sum="Total" />
                <field name="account_tag_22" sum="Total" />
                <field name="account_tag_23" sum="Total" />
                <field name="account_tag_24" sum="Total" />
                <field name="account_tag_14" sum="Total" />
                <field name="account_tag_15" sum="Total" />
                <field name="account_tag_16" sum="Total" />
                <field name="account_tag_17" sum="Total" />
                <field name="account_tag_18" sum="Total" />
                <field name="account_tag_19" sum="Total" />
                <field name="account_tag_30" sum="Total" />
                <field name="account_tag_31" sum="Total" />
                <field name="account_tag_41" sum="Total" />
                <field name="account_tag_32" sum="Total" />
                <field name="account_tag_42" sum="Total" />
                <field name="account_tag_43" sum="Total" />
                <field name="account_tag_33" sum="Total" />
                <field name="account_tag_40" sum="Total" />
                <field name="account_tag_50" sum="Total" />
                <field name="account_tag_60" sum="Total" />
                <field name="account_tag_70" sum="Total" />
                <field name="account_tag_71" sum="Total" />
                <field name="account_tag_80" sum="Total" />
                <field name="account_tag_81" sum="Total" />
                <field name="account_tag_82" sum="Total" />
                <button
                    name="open_journal_entry"
                    string="Open"
                    type="object"
                    icon="fa-external-link"
                    help="Open journal entry"
                />
            </tree>
         </field>
    </record>

    <record id="view_account_bg_vat_declar_pivot" model="ir.ui.view">
        <field name="name">account.bg.vat.declar.pivot</field>
        <field name="model">account.bg.vat.declar</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" />
                <field name="company_id" groups="base.group_multi_company" />
            </pivot>
        </field>
    </record>

    <record id="action_account_bg_vat_declar" model="ir.actions.act_window">
        <field name="name">VAT Declaration BG</field>
        <field name="res_model">account.bg.vat.declar</field>
        <field name="view_mode">pivot,tree</field>
        <field name="context">{'search_default_posted': 1}</field>
    </record>

    <menuitem
        id="menu_current_account_vat_declar_report"
        parent="account.account_account_menu"
        sequence="61"
        action="action_account_bg_vat_declar"
    />

</odoo>
