"Отпадъци от механично обработване на отпадъци (напр. сортиране, трошене, "
"уплътняване, гранулиране), неупоменати другаде"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_20_01
msgid "Separately collected fractions (except 15 01)"
msgstr "Разделно събирани фракции (с изключение на 15 01)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_02_01_04
msgid "Waste plastics (excluding packaging)"
msgstr "Отпадъци от пластмаси (с изключение на опаковки)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_07_02_13
msgid "Waste plastic"
msgstr "Отпадъци от пластмаси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_12_01_05
msgid "Plastic shavings and turnings"
msgstr "Стърготини и стружки от пластмаси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_15_01_02
msgid "Plastic packaging"
msgstr "Пластмасови опаковки"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,description:l10n_bg_waste_base.waste_code_15_01_02
