#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_16_01_19
msgid "Plastic (from end-of-life vehicles)"
msgstr "Пластмаса (от излезли от употреба превозни средства)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_17_02_03
msgid "Plastic (from construction and demolition)"
msgstr "Пластмаса (от строителство и събаряне)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_19_12_04
