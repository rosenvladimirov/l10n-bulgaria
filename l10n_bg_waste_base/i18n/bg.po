#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_01
msgid ""
"Wastes resulting from exploration, mining, quarrying, and physical and "
"chemical treatment of minerals"
msgstr ""
"Отпадъци от проучване, добив, разработване на кариери и физическо и "
"химическо обработване на полезни изкопаеми"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_02
msgid ""
"Wastes from agriculture, horticulture, aquaculture, forestry, hunting and "
"fishing, food preparation and processing"
msgstr ""
"Отпадъци от земеделие, градинарство, аквакултури, горско стопанство, лов и "
"риболов, приготвяне и преработка на храни"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_03
msgid ""
"Wastes from wood processing and the production of panels and furniture, "
"pulp, paper and cardboard"
msgstr ""
"Отпадъци от обработка на дървесина и производство на плоскости и мебели, "
"целулоза, хартия и картон"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_04
msgid "Wastes from the leather, fur and textile industries"
msgstr "Отпадъци от кожарската, кожухарската и текстилната промишленост"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_05
msgid ""
"Wastes from petroleum refining, natural gas purification and pyrolytic "
"treatment of coal"
msgstr ""
"Отпадъци от рафиниране на нефт, пречистване на природен газ и пиролиза на "
"въглища"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_06
msgid "Wastes from inorganic chemical processes"
msgstr "Отпадъци от неорганични химични процеси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_07
msgid "Wastes from organic chemical processes"
msgstr "Отпадъци от органични химични процеси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_08
msgid ""
"Wastes from the manufacture, formulation, supply and use of coatings, "
"adhesives, sealants and printing inks"
msgstr ""
"Отпадъци от производство, формулиране, доставяне и употреба на покрития, "
"лепила, уплътняващи материали и печатарски мастила"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_09
msgid "Wastes from the photographic industry"
msgstr "Отпадъци от фотографската промишленост"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_10
msgid "Wastes from thermal processes"
msgstr "Отпадъци от топлинни процеси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_11
msgid ""
"Wastes from chemical surface treatment and coating of metals and other "
"materials; non-ferrous hydrometallurgy"
msgstr ""
"Отпадъци от химично повърхностно обработване и нанасяне на покрития върху "
"метали и други материали; хидрометалургия на цветни метали"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_12
msgid ""
"Wastes from shaping and physical and mechanical surface treatment of metals "
"and plastics"
msgstr ""
"Отпадъци от формоване и физическо и механично повърхностно обработване на "
"метали и пластмаси"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_13
msgid "Oil wastes and wastes of liquid fuels (except edible oils)"
msgstr ""
"Отпадъци от масла и отпадъци от течни горива (с изключение на хранителни "
"масла)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_14
msgid "Waste organic solvents, refrigerants and propellants"
msgstr "Отпадъчни органични разтворители, охлаждащи течности и пропеланти"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_15
msgid ""
"Waste packaging; absorbents, wiping cloths, filter materials and protective "
"clothing not otherwise specified"
msgstr ""
"Отпадъци от опаковки; абсорбенти, кърпи за изтриване, филтърни материали и "
"предпазни облекла, неупоменати другаде"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_16
msgid "Wastes not otherwise specified in the list"
msgstr "Отпадъци, неупоменати другаде в списъка"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_17
msgid ""
"Construction and demolition wastes (including excavated soil from "
"contaminated sites)"
msgstr ""
"Отпадъци от строителство и събаряне (включително изкопани земни маси от "
"замърсени терени)"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_18
msgid "Wastes from human or animal health care and/or related research"
msgstr ""
"Отпадъци от хуманното или ветеринарното здравеопазване и/или свързани с тях "
"научни изследвания"

#. module: l10n_bg_waste_base
#: model:l10n.bg.waste.code,name:l10n_bg_waste_base.waste_code_19
msgid ""
"Wastes from waste management facilities, off-site waste water treatment "
"plants and the preparation of water intended for human consumption"
