        id="menu_waste_root"
        name="Waste Management"
        sequence="120"
        web_icon="l10n_bg_waste_base,static/description/icon.png"
        groups="group_waste_user"/>

    <menuitem
        id="menu_waste_operations"
        name="Operations"
        parent="menu_waste_root"
