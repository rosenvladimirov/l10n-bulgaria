<odoo>

    <record id="view_company_form_waste" model="ir.ui.view">
        <field name="name">res.company.form.waste</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Waste Management" name="waste_management" groups="l10n_bg_waste_base.group_waste_manager">
                    <group>
                        <field name="waste_manager_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
