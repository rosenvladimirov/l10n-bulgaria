<odoo>

    <record id="view_waste_activity_list" model="ir.ui.view">
        <field name="name">l10n.bg.waste.activity.list</field>
        <field name="model">l10n.bg.waste.activity</field>
        <field name="arch" type="xml">
            <list string="Treatment Activities" default_order="type,sequence,code">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="view_waste_activity_form" model="ir.ui.view">
        <field name="name">l10n.bg.waste.activity.form</field>
        <field name="model">l10n.bg.waste.activity</field>
        <field name="arch" type="xml">
            <form string="Treatment Activity">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_waste_activity" model="ir.actions.act_window">
        <field name="name">R/D Activities</field>
        <field name="res_model">l10n.bg.waste.activity</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
