<odoo>

    <record id="view_product_template_form_waste" model="ir.ui.view">
        <field name="name">product.template.form.waste</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Waste Management" groups="l10n_bg_waste_base.group_waste_user">
                    <field name="is_waste_product"/>
                    <field name="default_waste_code_id" invisible="not is_waste_product"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
