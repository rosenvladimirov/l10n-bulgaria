<odoo>

    <record id="view_waste_monthly_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bg.waste.monthly.report.wizard.form</field>
        <field name="model">l10n.bg.waste.monthly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Annex 4 Monthly Report">
                <group>
                    <group>
                        <field name="site_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="period_year"/>
                        <field name="period_month"/>
                    </group>
                </group>
                <group>
                    <field name="waste_code_ids" widget="many2many_tags"/>
                    <field name="recipient_partner_id"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate XLSX" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_waste_monthly_report_wizard" model="ir.actions.act_window">
        <field name="name">Monthly Report (Annex 4)</field>
        <field name="res_model">l10n.bg.waste.monthly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
