<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- „Искам фактура“ в checkout: отваря на място фирмата и адреса за фактуриране -->
    <template id="billing_address_list_invoice_request" inherit_id="website_sale.billing_address_list">
        <xpath expr="//div[@id='billing_address_list']" position="before">
            <div class="form-check form-switch mb-2">
                <label id="l10n_bg_invoice_requested_label">
                    <input
                        type="checkbox"
                        id="l10n_bg_invoice_requested"
                        class="form-check-input"
                        t-att-checked="order.l10n_bg_invoice_requested"
                    />
                    <span>I want an invoice</span>
                </label>
            </div>
            <t t-set="ic" t-value="l10n_bg_company_values or {}"/>
            <div id="l10n_bg_invoice_company_block"
                 t-attf-class="border rounded p-3 mb-3 #{'' if order.l10n_bg_invoice_requested else 'd-none'}">
                <h5 class="mb-2">Invoice company and billing address</h5>
                <!-- как ще се запишат адресите в поръчката -->
                <div class="alert alert-info py-2 small mb-3">
                    <div><strong>How the addresses are saved on the order:</strong></div>
                    <div>• Customer and billing address: the company below, with its registered address — the invoice is issued to it.</div>
                    <div>• Delivery address: <strong t-out="l10n_bg_delivery_person and l10n_bg_delivery_person.name or ''"/>
                        <span t-if="l10n_bg_delivery_person">(<t t-out="', '.join(filter(None, [l10n_bg_delivery_person.street, l10n_bg_delivery_person.city]))"/>)</span>
                        — stays as a delivery contact of the company.</div>
                </div>
                <div class="row">
                    <div class="col-12 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_name">Company name *</label>
                        <input id="l10n_bg_ic_name" data-field="name" class="form-control" t-att-value="ic.get('name')"/>
                    </div>
                    <div class="col-lg-6 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_uic">UIC (EIK / BULSTAT)</label>
                        <input id="l10n_bg_ic_uic" data-field="l10n_bg_uic" class="form-control" t-att-value="ic.get('l10n_bg_uic')"/>
                    </div>
                    <div class="col-lg-6 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_vat">VAT number</label>
                        <input id="l10n_bg_ic_vat" data-field="vat" class="form-control" t-att-value="ic.get('vat')"/>
                    </div>
                    <div class="col-12 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_street">Billing (registered) address *</label>
                        <input id="l10n_bg_ic_street" data-field="street" class="form-control" t-att-value="ic.get('street')"/>
                    </div>
                    <div class="col-lg-6 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_city">City *</label>
                        <input id="l10n_bg_ic_city" data-field="city" class="form-control" t-att-value="ic.get('city')"/>
                    </div>
                    <div class="col-lg-6 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_zip">Zip</label>
                        <input id="l10n_bg_ic_zip" data-field="zip" class="form-control" t-att-value="ic.get('zip')"/>
                    </div>
                    <div class="col-12 mb-2">
                        <label class="col-form-label" for="l10n_bg_ic_country">Country</label>
                        <select id="l10n_bg_ic_country" data-field="country_id" class="form-select">
                            <t t-foreach="l10n_bg_countries or []" t-as="c">
                                <option t-att-value="c.id" t-att-selected="c.id == ic.get('country_id')" t-out="c.name"/>
                            </t>
                        </select>
                    </div>
                </div>
                <div id="l10n_bg_ic_error" class="text-danger small mb-2 d-none"/>
                <div>
                    <button type="button" id="l10n_bg_ic_save" class="btn btn-primary btn-sm">Save company</button>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
