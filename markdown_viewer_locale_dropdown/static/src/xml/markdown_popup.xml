
<t t-name="markdown_viewer_locale_dropdown.MarkdownModal">
  <div class="o_markdown_modal modal fade" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Markdown Contents</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="overflow-y:auto;">
          <div style="margin-bottom:10px;">
            <select class="o_markdown_lang"></select>
            <select class="o_markdown_file"></select>
            <select class="o_markdown_module"></select>
            <button class="btn btn-primary o_markdown_load_btn">Load it</button>
          </div>
          <input type="text" class="o_markdown_search" placeholder="Search the table of contents..."/>
          <div class="o_markdown_content"></div>
        </div>
      </div>
    </div>
  </div>
</t>
