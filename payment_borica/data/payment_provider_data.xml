<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_borica" model="payment.provider">
        <field name="name">Borica APGW</field>
        <field name="code">borica</field>
        <field name="state">disabled</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <!-- Борика приема само карти; Bancontact (Белгия) не се поддържа от шлюза -->
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment.payment_method_card')])]"/>
    </record>

</odoo>
