#. module: payment_borica
#: model:ir.model.fields,help:payment_borica.field_payment_provider__borica_merchant
msgid "10-char merchant identifier issued by the acquirer bank."
msgstr "10-символен идентификатор на търговец, издаден от банката acquirer."

#. module: payment_borica
#: model:ir.model.fields,help:payment_borica.field_payment_transaction__borica_order
msgid "6-digit order number sent to Borica and echoed back in its response."
