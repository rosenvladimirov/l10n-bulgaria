<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.borica</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'borica'">
                    <field name="borica_terminal" required="code == 'borica' and state != 'disabled'"/>
                    <field name="borica_merchant" required="code == 'borica' and state != 'disabled'"/>
                    <field name="borica_merch_name"/>
                    <field name="borica_merch_url"/>
                    <field name="borica_email"/>
                    <field name="borica_country"/>
                    <field name="borica_merch_gmt"/>
                    <field name="borica_lang"/>
                    <field name="borica_private_key" widget="text" password="True"/>
                    <field name="borica_public_cert" widget="text"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
