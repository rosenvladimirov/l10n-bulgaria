#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS provider requires: %s"
msgstr "Доставчикът myPOS изисква: %s"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid ""
"myPOS: Application ID and Partner ID are required for refunds under Checkout"
" API v1.4.1. Set them on the payment provider."
msgstr ""
"myPOS: Application ID и Partner ID се изискват за възстановявания по "
"Checkout API v1.4.1. Задайте ги в доставчика на плащания."

#. module: payment_mypos
#: model:ir.model,name:payment_mypos.model_mypos_load_credentials_wizard
msgid "myPOS: Load Partner API Credentials into Wallet"
msgstr "myPOS: Зареждане на Partner API данни за достъп в портфейла"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: both clientId and clientSecret are required"
msgstr "myPOS: изискват се и clientId, и clientSecret"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid ""
"myPOS: cannot refund — the source transaction has no IPC_Trnref "
"(provider_reference). It was never confirmed by the gateway, so there is "
"nothing to refund."
msgstr ""
"myPOS: възстановяването е невъзможно — изходната транзакция няма IPC_Trnref "
"(provider_reference). Тя никога не е била потвърдена от гейтуея, така че "
"няма какво да се възстанови."

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_transaction.py:0
msgid "myPOS: invalid response signature"
msgstr "myPOS: невалиден подпис на отговора"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: merchant private key is not configured"
msgstr "myPOS: частният ключ на търговеца не е конфигуриран"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_transaction.py:0
msgid "myPOS: notification missing signature"
msgstr "myPOS: известието е без подпис"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_transaction.py:0
msgid "myPOS: payment failed — status %(code)s (%(label)s)"
msgstr "myPOS: плащането е неуспешно — статус %(code)s (%(label)s)"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: public certificate is not configured"
msgstr "myPOS: публичният сертификат не е конфигуриран"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_transaction.py:0
msgid "myPOS: refund declined — status %(code)s (%(label)s)"
msgstr "myPOS: възстановяването е отказано — статус %(code)s (%(label)s)"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: refund request failed — %s"
msgstr "myPOS: заявката за възстановяване е неуспешна — %s"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: refund response missing signature"
msgstr "myPOS: отговорът на възстановяването е без подпис"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: refund response signature invalid"
msgstr "myPOS: невалиден подпис на отговора на възстановяването"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_provider.py:0
msgid "myPOS: refund response was not JSON: %s"
msgstr "myPOS: отговорът на възстановяването не е JSON: %s"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/models/payment_transaction.py:0
msgid ""
"myPOS: web.base.url must be HTTPS for production transactions (current: %s)."
" The gateway reverses transactions whose URL_Notify is not SSL-enabled."
msgstr ""
"myPOS: web.base.url трябва да е HTTPS за продукционни транзакции (текущо: "
"%s). Гейтуеят сторнира транзакции, чийто URL_Notify не е с SSL."

#. module: payment_mypos
#: model_terms:ir.ui.view,arch_db:payment_mypos.view_mypos_load_credentials_wizard_form
