#: model:ir.model.fields,field_description:payment_mypos.field_mypos_load_credentials_wizard__write_uid
msgid "Last Updated by"
msgstr "Последно актуализирано от"

#. module: payment_mypos
#: model:ir.model.fields,field_description:payment_mypos.field_mypos_load_credentials_wizard__write_date
msgid "Last Updated on"
msgstr "Последно актуализирано на"

#. module: payment_mypos
#: model:ir.actions.act_window,name:payment_mypos.action_mypos_load_credentials_wizard
#: model_terms:ir.ui.view,arch_db:payment_mypos.view_mypos_load_credentials_wizard_form
msgid "Load myPOS API Credentials"
msgstr "Зареждане на myPOS API данни за достъп"

#. module: payment_mypos
#: model:ir.model.fields,field_description:payment_mypos.field_payment_provider__mypos_private_key
msgid "Merchant Private Key (RSA, PEM)"
msgstr "Частен ключ на търговеца (RSA, PEM)"

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_private_key
msgid "PEM-encoded RSA private key used to sign requests."
msgstr "RSA частен ключ в PEM формат, използван за подписване на заявките."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_public_cert
msgid "PEM-encoded myPOS certificate used to verify response signatures."
msgstr ""
"myPOS сертификат в PEM формат, използван за проверка на подписите на "
"отговорите."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_mypos_load_credentials_wizard__client_id
msgid "Partner-API client identifier (visible, not a secret on its own)"
msgstr ""
"Клиентски идентификатор за Partner API (видим, сам по себе си не е тайна)"

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_mypos_load_credentials_wizard__client_secret
msgid ""
"Partner-API secret. Goes straight to the wallet; never stored on this "
"wizard."
msgstr ""
"Тайна за Partner API. Отива директно в портфейла; никога не се съхранява в "
"този помощник."

#. module: payment_mypos
#: model:ir.model.fields.selection,name:payment_mypos.selection__mypos_load_credentials_wizard__input_mode__json
msgid "Paste JSON (from mypos_browser credentials)"
msgstr "Поставяне на JSON (от mypos_browser credentials)"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/wizards/mypos_load_credentials_wizard.py:0
msgid "Paste the JSON payload first."
msgstr "Първо поставете JSON съдържанието."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_mypos_load_credentials_wizard__raw_json
msgid "Paste the entire JSON file (clientId, clientSecret, etc.)"
msgstr "Поставете целия JSON файл (clientId, clientSecret и др.)"

#. module: payment_mypos
#: model:ir.model,name:payment_mypos.model_payment_provider
msgid "Payment Provider"
msgstr "Доставчик на плащания"

#. module: payment_mypos
#: model:ir.model,name:payment_mypos.model_payment_transaction
msgid "Payment Transaction"
msgstr "Платежна транзакция"

#. module: payment_mypos
#: model_terms:ir.ui.view,arch_db:payment_mypos.view_mypos_load_credentials_wizard_form
msgid ""
"Stash the partner-level API credentials (clientId / clientSecret)\n"
"                    into the company-owner's encrypted wallet. The secret is shown\n"
"                    by myPOS only once at generation time — paste it here immediately\n"
"                    after running <code>mypos credentials --integration-id N</code>."
msgstr ""
"Запазете партньорските API данни за достъп (clientId / clientSecret)\n"
"                    в шифрования портфейл на собственика на фирмата. Тайната се показва\n"
"                    от myPOS само веднъж при генерирането — поставете я тук веднага\n"
"                    след изпълнение на <code>mypos credentials --integration-id N</code>."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_sid
msgid "Store ID provided by myPOS. Sandbox default: 000000000000010"
msgstr ""
"Store ID, предоставен от myPOS. По подразбиране за sandbox: 000000000000010"

#. module: payment_mypos
#: model_terms:ir.ui.view,arch_db:payment_mypos.view_mypos_load_credentials_wizard_form
msgid "Store in Wallet"
msgstr "Запис в портфейла"

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr "Техническият код на този доставчик на плащания."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_wallet
msgid ""
"Wallet number associated with the merchant. Sandbox default: 61938166610"
msgstr ""
"Номер на портфейл, свързан с търговеца. По подразбиране за sandbox: "
"61938166610"

#. module: payment_mypos
#: model_terms:payment.provider,auth_msg:payment_mypos.payment_provider_mypos
msgid "Your payment has been authorized."
msgstr "Плащането Ви е упълномощено."

#. module: payment_mypos
#: model_terms:payment.provider,cancel_msg:payment_mypos.payment_provider_mypos
msgid "Your payment has been cancelled."
msgstr "Вашето плащане е отменено."

#. module: payment_mypos
#: model_terms:payment.provider,pending_msg:payment_mypos.payment_provider_mypos
msgid "Your payment has been processed but is waiting for approval."
msgstr "Вашето плащане е обработено, но изчаква одобрение."

#. module: payment_mypos
#: model_terms:payment.provider,done_msg:payment_mypos.payment_provider_mypos
msgid "Your payment has been processed."
msgstr "Вашето плащане е обработено."

