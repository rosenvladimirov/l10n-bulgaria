msgstr "Номер (ID)"

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_key_index
msgid "Index of the RSA key pair registered in myPOS."
msgstr "Индекс на RSA ключовата двойка, регистрирана в myPOS."

#. module: payment_mypos
#: model:ir.model.fields,field_description:payment_mypos.field_mypos_load_credentials_wizard__input_mode
msgid "Input Mode"
msgstr "Режим на въвеждане"

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_application_id
msgid ""
"Integration Application ID (e.g. mps-app-XXXXXXXX). Required for refund/void"
" under Checkout API v1.4.1."
msgstr ""
"Application ID на интеграцията (напр. mps-app-XXXXXXXX). Изисква се за "
"възстановяване/анулиране по Checkout API v1.4.1."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_payment_provider__mypos_partner_id
msgid ""
"Integration Partner ID (e.g. mps-p-XXXXXXXX). Required for refund/void under"
" Checkout API v1.4.1."
msgstr ""
"Partner ID на интеграцията (напр. mps-p-XXXXXXXX). Изисква се за "
"възстановяване/анулиране по Checkout API v1.4.1."

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/wizards/mypos_load_credentials_wizard.py:0
msgid "Invalid JSON: %s"
msgstr "Невалиден JSON: %s"

#. module: payment_mypos
#. odoo-python
#: code:addons/payment_mypos/wizards/mypos_load_credentials_wizard.py:0
msgid ""
"JSON does not contain clientId/clientSecret. Expected the file produced by "
"`mypos credentials --integration-id N`."
msgstr ""
"JSON не съдържа clientId/clientSecret. Очаква се файлът, генериран от `mypos"
" credentials --integration-id N`."

#. module: payment_mypos
#: model:ir.model.fields,help:payment_mypos.field_mypos_load_credentials_wizard__input_mode
msgid ""
"JSON mode accepts the file produced by `mypos credentials --integration-id "
"N` — paste its contents into the field below."
msgstr ""
"JSON режимът приема файла, генериран от `mypos credentials --integration-id "
"N` — поставете съдържанието му в полето по-долу."

#. module: payment_mypos
#: model:ir.model.fields,field_description:payment_mypos.field_mypos_load_credentials_wizard__raw_json
msgid "JSON payload"
msgstr "JSON съдържание"

#. module: payment_mypos
#: model:ir.model.fields,field_description:payment_mypos.field_payment_provider__mypos_key_index
msgid "Key Index"
msgstr "Индекс на ключ"

