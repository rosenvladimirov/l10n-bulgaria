<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mypos_load_credentials_wizard_form" model="ir.ui.view">
        <field name="name">mypos.load.credentials.wizard.form</field>
        <field name="model">mypos.load.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Load myPOS API Credentials">
                <p class="text-muted">
                    Stash the partner-level API credentials (clientId / clientSecret)
                    into the company-owner's encrypted wallet. The secret is shown
                    by myPOS only once at generation time — paste it here immediately
                    after running <code>mypos credentials --integration-id N</code>.
                </p>
                <group>
                    <field name="provider_id"/>
                    <field name="input_mode" widget="radio"/>
                </group>
                <group invisible="input_mode != 'json'">
                    <field name="raw_json" nolabel="1" widget="ace" options="{'mode': 'json'}"
                           placeholder='{"clientId": "client_...", "clientSecret": "secret_...", ...}'/>
                </group>
                <group invisible="input_mode != 'manual'">
                    <field name="client_id"/>
                    <field name="client_secret" password="True"/>
                </group>
                <footer>
                    <button name="action_store" type="object"
                            string="Store in Wallet" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mypos_load_credentials_wizard" model="ir.actions.act_window">
        <field name="name">Load myPOS API Credentials</field>
        <field name="res_model">mypos.load.credentials.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
