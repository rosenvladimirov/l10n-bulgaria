<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_mypos_embedded" model="ir.ui.view">
        <field name="name">payment.provider.form.mypos.embedded</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <!-- Surface the flow selector next to the existing myPOS
                 credential fields. invisible unless code == 'mypos'. -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="mypos_flow"
                        invisible="code != 'mypos'"
                        required="code == 'mypos'"/>
            </xpath>
        </field>
    </record>

</odoo>
