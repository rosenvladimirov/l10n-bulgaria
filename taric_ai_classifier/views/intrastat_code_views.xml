<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- INTRASTAT Code inherits from TARIC Code -->
    <record id="intrastat_code_tree_view" model="ir.ui.view">
        <field name="name">intrastat.code.tree</field>
        <field name="model">intrastat.code</field>
        <field name="arch" type="xml">
            <tree string="INTRASTAT Codes">
                <field name="cn8_code"/>
                <field name="description_bg"/>
                <field name="supplementary_unit"/>
                <field name="transaction_nature_code"/>
                <field name="delivery_terms"/>
                <field name="statistical_value_required" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="intrastat_code_form_view" model="ir.ui.view">
        <field name="name">intrastat.code.form</field>
        <field name="model">intrastat.code</field>
        <field name="inherit_id" ref="taric_code_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@string='Customs Information']" position="after">
                <page string="INTRASTAT Bulgaria">
                    <group>
                        <group string="Required Fields">
                            <field name="statistical_value_required"/>
                            <field name="invoice_value_required"/>
                            <field name="net_mass_required"/>
                        </group>
                        <group string="Default Values">
                            <field name="transaction_nature_code"/>
                            <field name="delivery_terms"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_intrastat_code" model="ir.actions.act_window">
        <field name="name">INTRASTAT Codes</field>
        <field name="res_model">intrastat.code</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create INTRASTAT codes for Bulgarian reporting
            </p>
            <p>
                INTRASTAT codes (CN8) are required for trade statistics within the EU.
                These codes are used in monthly INTRASTAT declarations to Bulgarian NSI.
            </p>
        </field>
    </record>

    <menuitem id="menu_intrastat_codes"
              name="INTRASTAT Codes"
              parent="menu_taric_root"
              action="action_intrastat_code"
              sequence="20"/>
</odoo>
