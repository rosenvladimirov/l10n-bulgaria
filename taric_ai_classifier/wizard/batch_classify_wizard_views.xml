<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Classification Wizard -->
    <record id="taric_classify_wizard_form_view" model="ir.ui.view">
        <field name="name">taric.classify.wizard.form</field>
        <field name="model">taric.classify.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Classification Suggestions">
                <sheet>
                    <group>
                        <field name="product_id" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="AI Suggestions">
                            <field name="suggestion_ids" mode="list" readonly="1">
                                <list decoration-success="confidence&gt;90"
                                      decoration-info="confidence&gt;70 and confidence&lt;=90"
                                      decoration-warning="confidence&lt;=70">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="description_en"/>
                                    <field name="description_bg"/>
                                    <field name="confidence" widget="progressbar"/>
                                    <field name="supplementary_unit"/>
                                    <field name="reasoning"/>
                                </list>
                            </field>
                            <group>
                                <field name="selected_suggestion_id"
                                       domain="[('wizard_id', '=', id)]"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </page>
                        <page string="Manual Entry">
                            <group>
                                <field name="custom_code" placeholder="e.g., 12345678"/>
                                <field name="notes" placeholder="Reason for manual classification..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Apply Classification"
                            name="action_apply_classification"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Batch Classification Wizard -->
    <record id="batch_classify_wizard_form_view" model="ir.ui.view">
        <field name="name">batch.classify.wizard.form</field>
        <field name="model">batch.classify.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Product Classification">
                <sheet>
                    <group>
                        <group string="Filters">
                            <field name="filter_unclassified"/>
                            <field name="category_id"/>
                        </group>
                        <group string="Options">
                            <field name="auto_apply_high_confidence"/>
                        </group>
                    </group>

                    <group>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>

                    <group invisible="progress == 0">
                        <field name="progress" widget="progressbar"/>
                        <field name="status" readonly="1"/>
                    </group>

                    <notebook invisible="not result_ids">
                        <page string="Results">
                            <field name="result_ids" readonly="1">
                                <list decoration-success="status=='success'"
                                      decoration-danger="status=='error'"
                                      decoration-warning="status=='pending'">
                                    <field name="product_id"/>
                                    <field name="status"/>
                                    <field name="taric_code"/>
                                    <field name="confidence" widget="progressbar"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Start Classification"
                            name="action_classify_batch"
                            type="object"
                            class="btn-primary"
                            invisible="progress &gt; 0"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Classification Wizard -->
    <record id="action_taric_classify_wizard" model="ir.actions.act_window">
        <field name="name">AI Classification</field>
        <field name="res_model">taric.classify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Action for Batch Classification -->
    <record id="action_batch_classify_wizard" model="ir.actions.act_window">
        <field name="name">Batch Classification</field>
        <field name="res_model">batch.classify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
