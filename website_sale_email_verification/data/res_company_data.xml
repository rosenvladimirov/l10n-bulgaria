<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Default company-level settings for email verification. Wrapped in
        noupdate=1 so admins can change them from Settings without being
        reset on module upgrades.
    -->
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field name="email_verification_method">disabled</field>
            <field name="email_verification_otp_length">6</field>
            <field name="email_verification_expiry_minutes">30</field>
            <field name="email_verification_max_attempts">5</field>
            <field name="email_verification_resend_cooldown">60</field>
            <field name="email_verification_block_disposable" eval="True"/>
        </record>
    </data>
</odoo>
