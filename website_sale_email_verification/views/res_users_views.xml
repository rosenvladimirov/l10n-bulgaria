<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_view_form_email_verification" model="ir.ui.view">
        <field name="name">res.users.form.inherit.email.verification</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Email Verification"
                      name="email_verification"
                      groups="base.group_system">
                    <group>
                        <group>
                            <field name="email_verified"/>
                            <field name="email_verification_attempts"/>
                            <field name="email_verification_last_sent"/>
                            <field name="email_verification_expiry"/>
                        </group>
                        <group>
                            <button name="action_force_email_verified"
                                    type="object"
                                    string="Force Verify"
                                    class="btn-secondary"
                                    invisible="email_verified"/>
                            <button name="action_reset_email_verification"
                                    type="object"
                                    string="Reset Verification"
                                    class="btn-warning"
                                    confirm="Reset this user's email verification and resend the verification email?"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
