<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.website.download</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_website_downloads"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-download"
                    invisible="not website_download"
                    groups="sales_team.group_sale_salesman"
                >
                    <field name="website_download_count" widget="statinfo" string="Downloads" />
                </button>
            </div>
            <field name="public_categ_ids" position="after">
                <field name="website_download" />
            </field>
        </field>
    </record>
</odoo>
