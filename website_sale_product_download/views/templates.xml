<odoo>
    <!-- Безплатен продукт за сваляне: бутон „Свали“ вместо „Добави в количката“.
         Бутонът изпраща формата на продукта към /shop/download, а скритото поле
         product_id вече държи избрания вариант. -->
    <template id="cta_wrapper" inherit_id="website_sale.cta_wrapper">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="t-if">not (product and product._name == 'product.template' and product.website_download)</attribute>
        </xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <div
                t-if="product and product._name == 'product.template' and product.website_download"
                id="o_wsale_download_wrap"
                t-attf-class="d-flex flex-grow-1 flex-lg-grow-0 flex-wrap align-items-center gap-2 {{'' if is_50_pc else ' w-100'}}"
            >
                <button
                    type="submit"
                    id="o_wsale_download"
                    formaction="/shop/download"
                    formmethod="get"
                    formnovalidate="formnovalidate"
                    class="btn btn-primary flex-grow-1"
                >
                    <i class="fa fa-download me-2"/>
                    Download
                </button>
                <span
                    t-if="product.sudo().website_download_count"
                    class="text-muted small"
                    title="Downloads"
                >
                    <i class="fa fa-download me-1"/>
                    <t t-out="product.sudo().website_download_count"/>
                </span>
            </div>
        </xpath>
    </template>
    <!-- Страница след натискане на „Свали“ (и след вход или регистрация):
         файлът тръгва сам след секунда, а линкът е резервен. -->
    <template id="download_started" name="Download Started">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="product.display_name"/>
            <t t-set="head">
                <meta http-equiv="refresh" t-att-content="'1;url=%s' % file_url"/>
            </t>
            <div id="wrap" class="o_wsale_download_started">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-7 text-center">
                            <img
                                t-att-src="image_data_uri(product.image_256) if product.image_256 else '/web/static/img/placeholder.png'"
                                class="mb-4"
                                style="max-width: 128px;"
                                t-att-alt="product.display_name"
                            />
                            <h1 class="h2">Your download has started</h1>
                            <p class="lead">
                                <t t-out="product.display_name"/>
                            </p>
                            <p class="text-muted">
                                <i class="fa fa-file-o me-1"/>
                                <t t-out="document.name"/>
                                (<t t-out="file_size"/>)
                            </p>
                            <p>
                                If the download does not start, <a t-att-href="file_url" id="o_wsale_download_file">click here</a>.
                            </p>
                            <a t-att-href="product.product_tmpl_id.website_url" class="btn btn-secondary mt-3">
                                <i class="fa fa-chevron-left me-2"/>Back to the product
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
