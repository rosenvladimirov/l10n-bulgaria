<odoo>
    <record id="website_product_download_view_list" model="ir.ui.view">
        <field name="name">website.product.download.list</field>
        <field name="model">website.product.download</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="file_name" />
                <field name="website_id" groups="website.group_multi_website" />
            </list>
        </field>
    </record>

    <record id="website_product_download_view_search" model="ir.ui.view">
        <field name="name">website.product.download.search</field>
        <field name="model">website.product.download</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="product_tmpl_id" />
                <field name="product_id" />
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}" />
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}" />
            </search>
        </field>
    </record>

    <record id="action_website_product_download" model="ir.actions.act_window">
        <field name="name">Downloads</field>
        <field name="res_model">website.product.download</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No downloads yet</p>
            <p>Mark a free product as Free Download: its Download button appears on the product page.</p>
        </field>
    </record>

    <menuitem
        id="menu_website_product_download"
        name="Downloads"
        parent="website_sale.menu_orders"
        action="action_website_product_download"
        sequence="5"
        groups="sales_team.group_sale_salesman"
    />
</odoo>
